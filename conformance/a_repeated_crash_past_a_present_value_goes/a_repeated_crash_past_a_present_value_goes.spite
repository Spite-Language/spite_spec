var console = Console()

func ARepeatedCrashPastAPresentValueGoes() {
    load "../../../spite_standard_library/windows"
    var rack = Rack()
    var first = Item()
    var filled = Shelf()
    filled.item = first
    rack.shelf = filled
    show(rack, rack)
}

func show(rack: Rack, alias: Rack) {
    fallback rack.shelf.item
    var other = Item()
    other.number = 2
    alias.shelf.item = other
    crash rack.shelf.item
    console.print(rack.shelf.item.number)
    if alias.shelf.item {
        console.print("there")
    } else {
        console.print("gone")
    }
}
