var console = Console()

func ARepeatedFallbackPastANewObjectGoes() {
    load "../../../spite_standard_library/windows"
    var rack = Rack()
    var first = Item()
    var filled = Shelf()
    filled.item = first
    rack.shelf = filled
    show(rack, rack)
}

func show(rack: Rack, alias: Rack) {
    fallback rack.shelf.item
    var other = Shelf()
    other.item = null
    if other.item {
        console.print("never")
    }
    fallback rack.shelf.item
    console.print(rack.shelf.item.number)
    if alias.shelf.item {
        console.print("there")
    } else {
        console.print("gone")
    }
}
