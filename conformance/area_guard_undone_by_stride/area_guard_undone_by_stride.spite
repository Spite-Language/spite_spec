var console = Console()
var cells = List<Integer>()

func AreaGuardUndoneByStride() {
    var filled = 0
    while filled < 6 {
        cells.append(filled * 10)
        filled = filled + 1
    }
    show(2, 3)
}

func show(rows: Integer, stride: Integer) {
    crash rows * stride <= cells.count()
    stride = stride + 1
    var row = 0
    while row < rows {
        var column = 0
        while column < stride {
            console.print(cells[row * stride + column] + 1)
            column = column + 1
        }
        row = row + 1
    }
}
