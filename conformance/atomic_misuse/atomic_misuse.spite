var console = Console()

func AtomicMisuse() {
    load "../../../SpiteCompiler/.spite/library/common"
    load "../../../SpiteCompiler/.spite/library/windows"
    var name = Atomic<Float>(1.5)
    var flag = Atomic<Boolean>(false)
    var raised = flag.add(true)
    var held = name.read()
    console.print(held, raised)
}
