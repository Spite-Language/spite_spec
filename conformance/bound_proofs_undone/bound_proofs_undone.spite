var console = Console()

func BoundProofsUndone() {
    load "../../../SpiteCompiler/.spite/library/common"
    load "../../../SpiteCompiler/.spite/library/windows"
    var spans = [1, 2, 3, 4]
    var at = 0
    while at + 1 < spans.count() {
        console.print(spans[at + 2].absolute())
        at = at + 2
    }
    var names = ["ada", "bo"]
    var count = names.count()
    names.remove_last()
    var index = 0
    while index < count {
        console.print(names[index].upper_case())
        index = index + 1
    }
    var ages = Dictionary<Integer, Integer>()
    ages[3] = 36
    var known = ages.count()
    var key = 0
    while key < known {
        console.print(ages[key].absolute())
        key = key + 1
    }
}
