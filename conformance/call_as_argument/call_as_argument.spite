var console = Console()
var source = "12 apples"
var tokens = List<Token>()
var counts = List<Integer>()

func CallAsArgument() {
    load "../../../spite_standard_library/common"
    rejected()
    allowed()
}

func rejected() {
    console.print(count_words(source))
    counts.append(count_words(source) + 1)
    var number = Text(source.upper_case())
    var token = Token(source.trim(), number)
    console.print(token.kind, source.trim().upper_case())
}

func allowed() {
    var token_slice = source.slice(0, 2)
    crash token_slice
    var number = Text(token_slice)
    var number_token = Token("number", number)
    tokens.append(number_token)
    var word_text = Text(source)
    var word = Token("word", word_text)
    tokens.append(word)
    var word_count = count_words(source)
    counts.append(word_count + 1)
    console.print("{count_words(source)} words, the first is {source.trim().upper_case()}")
}

func count_words(text: String): Integer {
    var words = text.split(" ")
    return words.count()
}
