var console = Console()

func CallBeforeALaterReadInAText() {
    load "../../../spite_standard_library/windows"
    var rack = Rack()
    rack.item = Item()
    show(rack, rack)
}

func cleared_count(rack: Rack): Integer {
    rack.item = null
    return 0
}

func show(rack: Rack, alias: Rack) {
    fallback rack.item
    var words = "{cleared_count(alias)} {rack.item.number}"
    console.print(words)
}
