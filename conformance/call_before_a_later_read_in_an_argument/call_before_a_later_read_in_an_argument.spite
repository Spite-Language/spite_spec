var console = Console()

func CallBeforeALaterReadInAnArgument() {
    load "../../../spite_standard_library/windows"
    var rack = Rack()
    rack.item = Item()
    show(rack, rack)
}

func cleared_item(rack: Rack): Item {
    rack.item = null
    return Item()
}

func show(rack: Rack, alias: Rack) {
    fallback rack.item
    var sum = cleared_item(alias).add(rack.item.number)
    console.print(sum)
}
