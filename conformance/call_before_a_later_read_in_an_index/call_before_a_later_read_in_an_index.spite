var console = Console()

func CallBeforeALaterReadInAnIndex() {
    var rack = Rack()
    rack.item = Item()
    show(rack, rack)
}

func cleared_list(rack: Rack): List<Integer> {
    rack.item = null
    return [1, 2]
}

func show(rack: Rack, alias: Rack) {
    fallback rack.item
    var read = cleared_list(alias)[rack.item.number]
    console.print(read)
}
