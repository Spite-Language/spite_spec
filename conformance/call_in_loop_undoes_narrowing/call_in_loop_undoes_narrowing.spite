var console = Console()
var keeper = Keeper()

func CallInLoopUndoesNarrowing() {
    run()
}

func run() {
    keeper.target = Monster()
    fallback keeper.target
    var passes = 0
    while passes < 2 {
        console.print(keeper.target.name)
        keeper.forget()
        passes = passes + 1
    }
}
