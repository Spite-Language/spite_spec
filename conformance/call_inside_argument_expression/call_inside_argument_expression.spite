var console = Console()

func CallInsideArgumentExpression() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var counts = List<Integer>()
    var text = "one two"
    counts.append(count_words(text) + 1)
    console.print(counts.count())
}

func count_words(text: String): Integer {
    var words = text.split(" ")
    return words.count()
}
