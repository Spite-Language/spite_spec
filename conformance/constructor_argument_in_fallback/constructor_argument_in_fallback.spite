var console = Console()

func ConstructorArgumentInFallback() {
    load "../../../spite_standard_library/windows"
    check()
    console.print("ok")
}

func check() {
    fallback reads(Counter(1))
}

func reads(counter: Counter): Boolean {
    return counter.count > 0
}

func show(counter: Counter) {
    console.print(counter.count)
}
