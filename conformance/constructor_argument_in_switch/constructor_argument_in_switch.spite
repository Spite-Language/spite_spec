var console = Console()

func ConstructorArgumentInSwitch() {
    load "../../../spite_standard_library/windows"
    switch reads(Counter(1)) {
        true: console.print("yes")
        false: console.print("no")
    }
}

func reads(counter: Counter): Boolean {
    return counter.count > 0
}

func show(counter: Counter) {
    console.print(counter.count)
}
