enum Light {
    'red'
    'green'
}

var console = Console()

func ControlSwitchClassCaseOnEnum() {
    load "../../../spite_standard_library/windows"
    var kind = kind_of('red')
    console.print(kind)
}

func kind_of(light: Light): String {
    switch light {
        'red': return "red"
        'green': return "green"
        Light: return "a light"
    }
}
