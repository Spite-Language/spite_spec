union Creature {
    Cat
    Dog
}

var console = Console()

func ControlSwitchValueCaseOnUnion() {
    load "../../../spite_standard_library/windows"
    var cat = Cat()
    var name = name_of(cat)
    console.print(name)
}

func name_of(creature: Creature): String {
    switch creature {
        "cat": return "a cat"
        Cat: return "a real cat"
        _: return "a dog"
    }
}
