enum Light {
    'red'
    'green'
}

var console = Console()

func ControlSwitchValueOnNullable() {
    var name = name_of('red')
    console.print(name)
}

func name_of(light: Light?): String {
    switch light {
        'red': return "stop"
        'green': return "go"
        Null: return "dark"
    }
}
