var console = Console()

func CopyToNarrowOfAKeptCopy() {
    load "../../../spite_standard_library/windows"
    var top = Node()
    kept(top)
}

func kept(call: Node) {
    var receiver = call.inner
    fallback receiver
    call.clear()
    var source = receiver.inner
    fallback source
    console.print(source.name)
}
