var console = Console()

func CountTimesTwoProvesNothing() {
    load "../../../spite_standard_library/windows"
    var names = ["ada", "bo", "cy"]
    var doubled = names.count() * 2
    var index = 0
    while index < doubled {
        var shout = names[index].upper_case()
        console.print(shout)
        index = index + 1
    }
}
