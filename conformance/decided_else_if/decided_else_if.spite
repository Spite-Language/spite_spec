var console = Console()

func DecidedElseIf() {
    var counts = List<Integer>()
    counts.append(3)
    var count = counts.count()
    if 1 > 2 {
        console.print("never")
    } else if count > 2 {
        console.print("many")
    } else {
        console.print("few")
    }
    if 2 > 1 {
        console.print("always")
    } else {
        console.print("never")
    }
    if count > 5 {
        console.print("huge")
    } else if 1 > 2 {
        console.print("never")
    }
    if count > 6 {
        console.print("giant")
    } else if 2 > 1 {
        console.print("first")
        console.print("second")
    }
    if 3 > 1 {
        if 1 > 3 {
            console.print("never")
        }
        console.print("kept")
    }
}
