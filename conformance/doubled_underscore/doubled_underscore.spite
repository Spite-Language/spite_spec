var console = Console()
var hit__count = 0

func DoubledUnderscore() {
    load "../../../SpiteCompiler/.spite/library/common"
    __strike(1)
    strike_(2)
    console.print(hit__count)
}

func __strike(amount: Integer) {
    hit__count = hit__count + amount
}

func strike_(amount: Integer) {
    hit__count = hit__count + amount
}
