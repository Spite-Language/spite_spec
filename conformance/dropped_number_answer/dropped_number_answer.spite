var console = Console()
var scores = [3, 5, 8]

func DroppedNumberAnswer() {
    report()
}

func report() {
    total()
    var listed = scores.count()
    console.print(listed)
}

func total(): Integer {
    var sum = 0
    var index = 0
    while index < scores.count() {
        sum = sum + scores[index]
        index = index + 1
    }
    return sum
}
