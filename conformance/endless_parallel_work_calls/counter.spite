var program = Program()

func count_forever(): Integer {
    var counting = true
    var counted = 0
    while counting {
        counted = counted + step(counted)
    }
    return counted
}

func step(counted: Integer): Integer {
    return counted.bits_and(1) + 1
}

func count_and_wait(): Integer {
    var one_millisecond = Duration(1, 'milliseconds')
    var counted = 0
    while counted < 1000 {
        counted = counted + step(counted)
        program.sleep(one_millisecond)
    }
    return counted
}
