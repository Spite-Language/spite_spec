enum Light {
    'red'
    'green'
}

var console = Console()

func EnumSwitchCallAsCase() {
    show('red')
}

func stop(): Light {
    return 'red'
}

func go(): Light {
    return 'green'
}

func show(light: Light) {
    switch light {
        stop(): console.print("stop")
        go(): console.print("go")
    }
}
