enum Shade {
    'light'
    'dark'
}

var console = Console()
var total = 0

# ../../../spite_documentation/style.md#the-file-content-budget
func FileContentBudget() {
    nested(1)
    fill_part_1()
    fill_part_2()
    fill_part_3()
    fill_part_4()
    fill_part_5()
    fill_part_6()
    console.print(total)
    console.print("filled")
    var name = name_of('dark')
    console.print(name)
}

func name_of(shade: Shade): String {
    switch shade {
        'light': total = total + 1
        'dark': return "dark"
    }
    return "light"
}

func nested(amount: Integer) {
    if amount > 1 {
        total = total + 1
    } else if amount > 0 {
        total = total + 1
    } else {
        var left = 2
        while left > 0 {
            left = left - 1
            total = total + 1
        }
    }
}

