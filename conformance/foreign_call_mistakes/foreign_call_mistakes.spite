var console = Console()
var library = DynamicLibrary(
    "fixture.dll",
    "",
    {"store": DynamicLibrary.FunctionDeclaration("store", [DynamicLibrary.Argument("value", Console)], Integer)},
)

func ForeignCallMistakes() {
    call_through(library)
    var stored = store(console)
    console.print(stored, library.fixture_answer)
}

func call_through(passed: DynamicLibrary) {
    var sum = passed.add_numbers(1, 2)
    console.print(sum)
}

func store(value: Console): Integer {
    var call = DynamicLibrary.Call(library.functions["store"])
    call.arguments["value"] = value
    return call.call()
}
