var console = Console()
var c_runtime = DynamicLibrary("ucrtbase.dll", 'identity', "")
var kernel = DynamicLibrary("kernel32.dll", 'identity', "")

func ForeignCallOutsideItsDeclaration() {
    var text_length = c_runtime.strlen("spite")
    var size = 260
    var room = Buffer(size * 2)
    var written = kernel.GetCurrentDirectoryW(size, room)
    console.print(text_length, written)
}
