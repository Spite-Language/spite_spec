var console = Console()
var library = DynamicLibrary(
    "fixture.dll",
    "",
    {
        "keep": DynamicLibrary.FunctionDeclaration("keep", [DynamicLibrary.Argument("procedure", Long)], Nothing),
        "keep_with_context": DynamicLibrary.FunctionDeclaration(
            "keep",
            [
                DynamicLibrary.Argument("procedure", Long),
                DynamicLibrary.Argument("context", Long),
            ],
            Nothing,
        ),
        "each_name": DynamicLibrary.FunctionDeclaration(
            "each_name",
            [
                DynamicLibrary.Argument("each", Spite.Function<String, Nothing>),
            ],
            Nothing,
        ),
    },
)
var marks = List<Integer>()

func ForeignCallbackMistakes() {
    through_a_variable()
    nowhere()
    not_a_singleton()
    text_from_c()
    shared_list()
    each_name(named)
}

func through_a_variable() {
    var chosen = counted
    var calling = ForeignCallback(chosen, 'no_context')
    keep(calling.address)
}

func nowhere() {
    var calling = ForeignCallback(counted, 'somewhere')
    keep(calling.address)
}

func not_a_singleton() {
    var calling = ForeignCallback(counted, 'no_context')
    keep(calling.address)
}

func text_from_c() {
    var calling = ForeignCallback(named, 'context_last')
    keep_with_context(calling.address, calling.context)
}

func shared_list() {
    var calling = ForeignCallback(marked, 'context_first')
    keep_with_context(calling.address, calling.context)
}

func counted(value: Integer): Integer {
    return value
}

func named(name: String) {
    console.print(name)
}

func marked(value: Integer) {
    marks.append(value)
}

func keep(procedure: Long) {
    var call = DynamicLibrary.Call(library.functions["keep"])
    call.arguments["procedure"] = procedure
    call.call()
}

func keep_with_context(procedure: Long, context: Long) {
    var call = DynamicLibrary.Call(library.functions["keep_with_context"])
    call.arguments["procedure"] = procedure
    call.arguments["context"] = context
    call.call()
}

func each_name(each: Spite.Function<String, Nothing>) {
    var call = DynamicLibrary.Call(library.functions["each_name"])
    call.arguments["each"] = each
    call.call()
}
