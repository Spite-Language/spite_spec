var library = DynamicLibrary(
    "fixture.dll",
    "",
    {
        "keep": DynamicLibrary.FunctionDeclaration(
            "keep",
            [
                DynamicLibrary.Argument("procedure", Long),
                DynamicLibrary.Argument("context", Long),
            ],
            Nothing,
        ),
    },
)

func ForeignCallbackTextResult() {
    var namer = Namer()
    var calling = ForeignCallback(namer.label, 'context_last')
    keep(calling.address, calling.context)
}

func keep(procedure: Long, context: Long) {
    var call = DynamicLibrary.Call(library.functions["keep"])
    call.arguments["procedure"] = procedure
    call.arguments["context"] = context
    call.call()
}
