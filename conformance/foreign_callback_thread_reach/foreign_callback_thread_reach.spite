var library = DynamicLibrary(
    "fixture.dll",
    "",
    {
        "keep": DynamicLibrary.FunctionDeclaration("keep", [DynamicLibrary.Argument("procedure", Long), DynamicLibrary.Argument("context", Long)], Nothing)
    },
)

func ForeignCallbackThreadReach() {
    var recorder = Recorder()
    var calling = ForeignCallback(recorder.marked, 'context_first')
    keep(calling.address, calling.context)
}

func keep(procedure: Long, context: Long) {
    var call = DynamicLibrary.Call(library.functions["keep"])
    call.arguments["procedure"] = procedure
    call.arguments["context"] = context
    call.call()
}
