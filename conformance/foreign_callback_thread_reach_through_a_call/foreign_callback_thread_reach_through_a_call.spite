var library = DynamicLibrary("fixture.dll", 'identity', "")

func ForeignCallbackThreadReachThroughACall() {
    var recorder = Recorder()
    var calling = ForeignCallback(recorder.marked, 'context_first')
    keep(calling.address, calling.context)
}

func keep(procedure: Long, context: Long) {
    library.keep(procedure, context)
}
