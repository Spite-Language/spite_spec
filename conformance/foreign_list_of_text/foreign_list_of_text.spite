var console = Console()
var library = DynamicLibrary(
    "fixture.dll",
    "",
    {
        "store_names": DynamicLibrary.FunctionDeclaration("store_names", [DynamicLibrary.Argument("names", List<String>), DynamicLibrary.Argument("count", Integer)], Integer)
    },
)

func ForeignListOfText() {
    var names = ["ada", "grace"]
    var count = names.count()
    var stored = store_names(names, count)
    console.print(stored)
}

func store_names(names: List<String>, count: Integer): Integer {
    var call = DynamicLibrary.Call(library.functions["store_names"])
    call.arguments["names"] = names
    call.arguments["count"] = count
    return call.call()
}
