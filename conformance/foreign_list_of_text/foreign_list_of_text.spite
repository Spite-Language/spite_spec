var console = Console()
var library = DynamicLibrary("fixture.dll", 'identity', "")

func ForeignListOfText() {
    var names = ["ada", "grace"]
    var count = names.count()
    var stored = store_names(names, count)
    console.print(stored)
}

func store_names(names: List<String>, count: Integer): Integer {
    return library.store_names(names, count)
}
