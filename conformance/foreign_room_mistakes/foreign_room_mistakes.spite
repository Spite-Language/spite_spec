type PathRoom {
    text: DynamicLibrary.WideText
}

var console = Console()
var kernel = DynamicLibrary(
    "kernel32.dll",
    "",
    {
        "current_directory": DynamicLibrary.FunctionDeclaration("GetCurrentDirectoryW", [DynamicLibrary.Argument("size", Integer), DynamicLibrary.Room("room", PathRoom, 'grown_by_hand')], Integer)
        "system_directory": DynamicLibrary.FunctionDeclaration("GetSystemDirectoryW", [DynamicLibrary.Room("room", Integer, 'doubled_until_it_fits'), DynamicLibrary.Argument("size", Integer)], Integer)
    },
)

func ForeignRoomMistakes() {
    var directory_call = DynamicLibrary.Call(kernel.functions["current_directory"])
    var directory = directory_call.call()
    console.print(directory)
    system_directory()
}

func system_directory() {
    var directory_call = DynamicLibrary.Call(kernel.functions["system_directory"])
    var directory = directory_call.call()
    console.print(directory)
}
