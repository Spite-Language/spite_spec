type PointPair {
    down: Integer
    across: Integer
    depth: Integer
}

var console = Console()
var windows = DynamicLibrary(
    "conformance/foreign_struct_size_differs/fixture.dll",
    "fixture.h",
    {
        "move_point": DynamicLibrary.FunctionDeclaration("MovePoint", [DynamicLibrary.Argument("point", PointPair)], Nothing)
    },
)

func ForeignStructSizeDiffers() {
    var spot: PointPair = {down: 0, across: 0, depth: 0}
    move_point(spot)
    console.print(spot.down, spot.across, spot.depth)
}

func move_point(point: PointPair) {
    var call = DynamicLibrary.Call(windows.functions["move_point"])
    call.arguments["point"] = point
    call.call()
}
