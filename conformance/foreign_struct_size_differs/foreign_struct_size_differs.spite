type PointPair {
    down: Integer
    across: Integer
    depth: Integer
}

var console = Console()
var windows = DynamicLibrary("conformance/foreign_struct_size_differs/fixture.dll", 'windows', "fixture.h")

func ForeignStructSizeDiffers() {
    var spot: PointPair = {down: 0, across: 0, depth: 0}
    windows.move_point(spot)
    console.print(spot.down, spot.across, spot.depth)
}
