type Labelled {
    count: Integer
    values: List<Integer>
}

var console = Console()
var c_runtime = DynamicLibrary(
    "ucrtbase.dll",
    "",
    {
        "length_of": DynamicLibrary.FunctionDeclaration("strlen", [DynamicLibrary.Argument("labelled", Labelled)], Integer)
    },
)

func ForeignTypeWithAList() {
    var labelled: Labelled = Tray()
    var sum = length_of(labelled)
    console.print(sum)
}

func length_of(labelled: Labelled): Integer {
    var call = DynamicLibrary.Call(c_runtime.functions["length_of"])
    call.arguments["labelled"] = labelled
    return call.call()
}
