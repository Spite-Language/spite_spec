type Labelled {
    label: String
    count: Integer
}

var console = Console()
var library = DynamicLibrary(
    "fixture.dll",
    "",
    {
        "store": DynamicLibrary.FunctionDeclaration("store", [DynamicLibrary.Argument("labelled", Labelled)], Integer),
    },
)

func ForeignTypeWithText() {
    var labelled: Labelled = {label: "one", count: 1}
    var stored = store(labelled)
    console.print(stored)
}

func store(labelled: Labelled): Integer {
    var call = DynamicLibrary.Call(library.functions["store"])
    call.arguments["labelled"] = labelled
    return call.call()
}
