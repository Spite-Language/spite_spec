var console = Console()
var windows = DynamicLibrary(
    "fixture.dll",
    "fixture.h",
    {
        "forget": DynamicLibrary.FunctionDeclaration("Forget", [DynamicLibrary.Argument("value", Integer)], Nothing)
        "forget_read": DynamicLibrary.FunctionDeclaration("Forget", [DynamicLibrary.Argument("value", Integer)], Integer)
    },
)

func ForeignVoidAnswerRead() {
    forget(1)
    var forgotten = forget_read(2)
    console.print(forgotten)
}

func forget(value: Integer) {
    var call = DynamicLibrary.Call(windows.functions["forget"])
    call.arguments["value"] = value
    call.call()
}

func forget_read(value: Integer): Integer {
    var call = DynamicLibrary.Call(windows.functions["forget_read"])
    call.arguments["value"] = value
    return call.call()
}
