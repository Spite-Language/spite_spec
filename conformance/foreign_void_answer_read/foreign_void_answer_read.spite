var console = Console()
var windows = DynamicLibrary("fixture.dll", 'windows', "fixture.h")

func ForeignVoidAnswerRead() {
    forget(1)
    var forgotten = forget_read(2)
    console.print(forgotten)
}

func forget(value: Integer) {
    windows.forget(value)
}

func forget_read(value: Integer): Integer {
    return windows.forget(value)
}
