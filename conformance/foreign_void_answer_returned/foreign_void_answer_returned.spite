var console = Console()
var windows = DynamicLibrary(
    "fixture.dll",
    "fixture.h",
    {"forgotten": DynamicLibrary.FunctionDeclaration("QuietForget", [DynamicLibrary.Argument("value", Integer)], Long)},
)

func ForeignVoidAnswerReturned() {
    var answer = forgotten(2)
    console.print(answer)
}

func forgotten(value: Integer): Long {
    var call = DynamicLibrary.Call(windows.functions["forgotten"])
    call.arguments["value"] = value
    return call.call()
}
