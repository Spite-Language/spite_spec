var console = Console()

func GetterBeforeALaterReadInAStatement() {
    load "../../../spite_standard_library/windows"
    var rack = Rack()
    rack.item = Item()
    show(rack, rack)
}

func show(rack: Rack, alias: Rack) {
    fallback rack.item
    var sum = alias.writing + rack.item.number
    console.print(sum)
}
