var console = Console()

func IndexStoreUndoesNarrowing() {
    load "../../../spite_standard_library/windows"
    run()
}

func run() {
    var labels = List<String?>()
    labels.append("first")
    var at = 0
    fallback labels[at]
    labels[0] = null
    console.print(labels[at].upper_case())
}
