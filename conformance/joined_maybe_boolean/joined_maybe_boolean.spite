var console = Console()
var clock = Clock()

func JoinedMaybeBoolean() {
    load "../../../spite_standard_library/windows"
    var ready = answer()
    if ready {
        console.print("ready")
    }
    console.print("after")
}

func answer(): Boolean? {
    var now = clock.elapsed()
    var zero = Duration(0, 'seconds')
    fallback now >= zero
    return false
}
