var console = Console()

func JsxAttributeNamingNoParameter() {
    load "../../../spite_standard_library/windows"
    var made = built()
    var shown = made.describe()
    console.print(shown)
}

func built(): View {
    return <View title="parts">
        <health_bar filled={1} colour="red"/>
    </View>
}

func render_health_bar(filled: Integer): Anything? {
    var bar = Label()
    bar.content = "{filled}"
    return bar
}
