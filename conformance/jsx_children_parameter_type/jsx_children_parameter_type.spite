var console = Console()

func JsxChildrenParameterType() {
    load "../../../spite_standard_library/windows"
    var made = built()
    var shown = made.describe()
    console.print(shown)
}

func built(): View {
    return <View title="parts">
        <framed title="box">
            <Label content="inside"/>
        </framed>
    </View>
}

func render_framed(title: String, children: List<Label>): Anything? {
    var frame = View()
    frame.title = title
    var index = 0
    while index < children.count() {
        var child = children[index]
        frame.append_child(child)
        index = index + 1
    }
    return frame
}
