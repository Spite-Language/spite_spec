var console = Console()

func JsxChildrenSetAndHeld() {
    load "../../../spite_standard_library/windows"
    var made = built()
    var shown = made.describe()
    console.print(shown)
}

func built(): View {
    var parts = List<Anything?>()
    return <View title="parts">
        <framed title="box" children={parts}>
            <Label content="inside"/>
        </framed>
    </View>
}

func render_framed(title: String, children: List<Anything?>): Anything? {
    var frame = View()
    frame.title = title
    frame.append_children(children)
    return frame
}
