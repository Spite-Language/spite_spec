var console = Console()

func JsxChildrenSetAndHeld() {
    var made = built()
    var shown = made.describe()
    console.print(shown)
}

func built(): View {
    var parts = List<View.Component>()
    return <View title="parts">
        <View title="box" children={parts}>
            <Label content="inside" />
        </View>
    </View>
}
