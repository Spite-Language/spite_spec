var console = Console()

func JsxLowercaseTagWithChildren() {
    var made = built()
    var shown = made.describe()
    console.print(shown)
}

func built(): View {
    return <View title="parts">
        <framed title="box">
            <Label content="inside"/>
        </framed>
    </View>
}

func render_framed(title: String): View {
    var frame = View()
    frame.title = title
    return frame
}
