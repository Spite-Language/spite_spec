var console = Console()
var alpha = Part.Alpha()
var beta = Other.Beta()

func KnownListWalkCrash() {
    load "../../../spite_standard_library/windows"
    console.print(alpha.first, beta.second)
    var stages = [Part, Other]
    stages.each(check_a_stage)
}

func check_a_stage(stage: Spite.Namespace) {
    var names = stage.classes.map_names()
    var has_the_alpha = names.contains("Alpha")
    crash has_the_alpha
}
