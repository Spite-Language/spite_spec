enum Light {
    'red'
    'green'
}

var console = Console()

func LeftOverAfterSwitch() {
    load "../../../spite_standard_library/windows"
    show('red')
}

func show(light: Light) {
    switch light {
        'red': console.print("stop")
        'green': console.print("go")
    } console.print("done")
}
