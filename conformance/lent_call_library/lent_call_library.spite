var console = Console()
var mice = Vector<Mouse>()
var others = List<Mouse>()

func LentCallLibrary() {
    load "../../../spite_standard_library/windows"
    var made = Mouse()
    mice.append(made)
    others.append(made)
    crash mice[0]
    var first = mice[0]
    var found = others.contains(first)
    console.print(found, first.left)
}
