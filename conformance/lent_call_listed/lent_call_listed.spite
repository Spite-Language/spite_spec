var console = Console()
var mice = Vector<Mouse>()
var input = Input()

func LentCallListed() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var made = Mouse()
    mice.append(made)
    crash mice[0]
    var mouse = mice[0]
    input.list(mouse)
    var seen_count = input.seen.count()
    console.print(mouse.left, seen_count)
}
