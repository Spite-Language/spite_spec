var console = Console()
var mice = Vector<Mouse>()
var input = Input()

func LentCallPassedOn() {
    load "../../../spite_standard_library/windows"
    var made = Mouse()
    mice.append(made)
    crash mice[0]
    var mouse = mice[0]
    input.handle(mouse)
    crash input.last
    console.print(mouse.left, input.last.left)
}
