union Device {
    Mouse
    Keyboard
}

var console = Console()
var mice = Vector<Mouse>()

func LentCallPassedOnUnion() {
    load "../../../spite_standard_library/windows"
    var made = Mouse()
    mice.append(made)
    crash mice[0]
    var first = mice[0]
    handle(first)
    console.print(first.left)
}

func handle(mouse: Mouse) {
    mouse.left = 2
    var described = describe(mouse)
    console.print(described)
}

func describe(device: Device): String {
    if device == Mouse {
        return "mouse at {device.left}"
    }
    return "another device"
}
