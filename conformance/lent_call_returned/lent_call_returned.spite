var console = Console()
var mice = Vector<Mouse>()
var input = Input()

func LentCallReturned() {
    load "../../../spite_standard_library/windows"
    var made = Mouse()
    mice.append(made)
    crash mice[0]
    var mouse = mice[0]
    var back = input.hand_back(mouse)
    console.print(mouse.left, back.left)
}
