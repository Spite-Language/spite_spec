union Device {
    Mouse
    Keyboard
}

var console = Console()
var mice = Vector<Mouse>()

func LentCallUnion() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var made = Mouse()
    mice.append(made)
    crash mice[0]
    var first = mice[0]
    var described = describe(first)
    console.print(described)
}

func describe(device: Device): String {
    if device == Mouse {
        return "mouse at {device.left}"
    }
    return "another device"
}
