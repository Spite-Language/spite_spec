var console = Console()
var mice = Vector<Mouse>()

func LentCallVariadic() {
    load "../../../spite_standard_library/windows"
    var made = Mouse()
    mice.append(made)
    crash mice[0]
    var first = mice[0]
    var total = count_left(first)
    console.print(total)
}

func count_left(...gathered: List<Mouse>): Integer {
    var total = 0
    var index = 0
    while index < gathered.count() {
        var mouse = gathered[index]
        crash mouse
        total = total + mouse.left
        index = index + 1
    }
    return total
}
