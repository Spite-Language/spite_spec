type Finder {
    of(Integer): Layout?
}

var console = Console()
var layouts = Column<Layout>()

func LentFunctionType() {
    load "../../../spite_standard_library/windows"
    var first = Layout()
    layouts.insert(first)
    var lookup = Lookup<Layout>()
    var found = found_through(lookup)
    console.print(found)
}

func found_through(finder: Finder): Boolean {
    var layout = finder.of(0)
    if layout {
        return true
    }
    return false
}
