var console = Console()
var layouts = Column<Layout>()
var lookup = Lookup<Layout>()

func LentResultReturnedThroughAName() {
    load "../../../spite_standard_library/windows"
    var first = Layout()
    layouts.insert(first)
    var handed = handed_on()
    crash handed
    console.print(handed.order)
}

func handed_on(): Layout? {
    var found = lookup.of(0)
    if found {
        console.print("found", found.order)
    }
    return found
}
