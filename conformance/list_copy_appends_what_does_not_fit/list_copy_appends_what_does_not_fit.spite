type Shown {
    to_debug: Spite.Function<String>
}

var console = Console()

func ListCopyAppendsWhatDoesNotFit() {
    var healths = List<Health>()
    var counted = stocked(healths)
    console.print(counted)
}

func stocked(items: List<Shown>): Integer {
    var sword = Sword()
    items.append(sword)
    return items.count()
}
