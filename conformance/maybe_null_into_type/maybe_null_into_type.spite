union Pet {
    Cat
    Dog
}

var console = Console()

func MaybeNullIntoType() {
    var held = pick(false)
    show(held)
    var box = Box()
    var cat = Cat()
    box.pet = cat
    crash box.pet
    empty(box)
    keep(box.pet)
}

func pick(flag: Boolean): Pet? {
    if flag {
        return Cat()
    }
    return null
}

func show(value: Pet) {
    console.print(value.class == Dog)
}

func empty(box: Box) {
    box.pet = null
}

func keep(pet: Pet) {
    console.print(pet.class == Cat)
}
