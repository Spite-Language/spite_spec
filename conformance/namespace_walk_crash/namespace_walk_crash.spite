var console = Console()
var alpha = Passes.Alpha.Pass()
var beta = Passes.Beta.Helper()

func NamespaceWalkCrash() {
    console.print(alpha.runs, beta.runs)
    Spite.Namespace.instances.each(check_a_folder)
    console.print("never printed")
}

func check_a_folder(namespace: Spite.Namespace) {
    var path = namespace.name_with_namespaces
    var names = namespace.classes.map_names()
    var depth = path.split(".").count()
    fallback depth == 2 and path.starts_with("Passes.")
    var has_a_pass = names.contains("Pass")
    crash has_a_pass
}
