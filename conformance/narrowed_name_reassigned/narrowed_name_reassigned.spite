var console = Console()
var held: Box? = null

func NarrowedNameReassigned() {
    load "../../../spite_standard_library/windows"
    after_null()
    in_a_loop()
}

func after_null() {
    var maybe: Box? = Box()
    fallback maybe
    maybe = null
    console.print(maybe.label)
}

func in_a_loop() {
    fallback held
    var passes = 0
    while passes < 2 {
        console.print(held.label)
        held = held.inner
        passes = passes + 1
    }
}
