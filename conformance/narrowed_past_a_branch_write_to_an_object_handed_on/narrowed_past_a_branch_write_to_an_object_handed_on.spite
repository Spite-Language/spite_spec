var kept: Shelf? = null
var console = Console()

func NarrowedPastABranchWriteToAnObjectHandedOn() {
    var first = Item()
    run(first)
}

func run(first: Item) {
    var fresh = Shelf()
    fresh.item = first
    kept = fresh
    crash kept
    fallback kept.item
    if first.number == 1 {
        fresh.item = null
    }
    console.print(kept.item.number)
}
