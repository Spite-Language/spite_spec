var console = Console()

func NarrowedPastALoopWriteToAnEarlierAttribute() {
    var rack = Rack()
    var first = Item()
    var filled = Shelf()
    filled.item = first
    rack.shelf = filled
    show(rack, rack)
}

func show(rack: Rack, alias: Rack) {
    fallback rack.shelf.item
    var empty = Shelf()
    var passes = 0
    while passes < 2 {
        console.print(rack.shelf.item.number)
        alias.shelf = empty
        passes = passes + 1
    }
}
