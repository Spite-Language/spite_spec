var console = Console()

func NarrowedPastANullableWriteToAnEarlierAttribute() {
    var rack = Rack()
    var first = Item()
    var filled = Shelf()
    filled.item = first
    rack.shelf = filled
    show(rack, rack)
}

func show(rack: Rack, alias: Rack) {
    fallback rack.shelf
    fallback rack.shelf.item
    var empty: Shelf? = null
    alias.shelf = empty
    console.print(rack.shelf.item.number)
}
