var kept: Shelf? = null
var console = Console()

func NarrowedPastANullableWriteToAnObjectHandedOn() {
    var first = Item()
    run(first)
}

func run(first: Item) {
    var fresh = Shelf()
    fresh.item = first
    kept = fresh
    crash kept
    fallback kept.item
    var gone: Item? = null
    fresh.item = gone
    console.print(kept.item.number)
}
