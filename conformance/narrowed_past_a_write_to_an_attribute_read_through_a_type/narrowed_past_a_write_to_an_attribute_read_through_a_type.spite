type Holding {
    shelf: Shelf
}

var console = Console()

func NarrowedPastAWriteToAnAttributeReadThroughAType() {
    load "../../../spite_standard_library/windows"
    var rack = Rack()
    var first = Item()
    var filled = Shelf()
    filled.item = first
    rack.shelf = filled
    show(rack, rack)
}

func show(holder: Holding, alias: Rack) {
    fallback holder.shelf.item
    var empty = Shelf()
    alias.shelf = empty
    console.print(holder.shelf.item.number)
}
