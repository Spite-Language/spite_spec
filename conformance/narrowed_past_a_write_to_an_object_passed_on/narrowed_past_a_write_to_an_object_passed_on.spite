var kept: Shelf? = null
var console = Console()

func NarrowedPastAWriteToAnObjectPassedOn() {
    var first = Item()
    run(first)
}

func run(first: Item) {
    var fresh = Shelf()
    fresh.item = first
    keep(fresh)
    crash kept
    fallback kept.item
    fresh.item = null
    console.print(kept.item.number)
}

func keep(shelf: Shelf) {
    kept = shelf
}
