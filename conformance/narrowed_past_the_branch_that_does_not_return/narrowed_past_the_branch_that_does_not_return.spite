var console = Console()

func NarrowedPastTheBranchThatDoesNotReturn() {
    load "../../../spite_standard_library/windows"
    var rack = Rack()
    var first = Item()
    var filled = Shelf()
    filled.item = first
    rack.shelf = filled
    show(rack, rack)
}

func show(rack: Rack, alias: Rack) {
    fallback rack.shelf.item
    if rack.shelf.item.number > 90 {
        return
    } else {
        alias.shelf.item = null
    }
    console.print(rack.shelf.item.number)
    if alias.shelf.item {
        console.print("there")
    } else {
        console.print("gone")
    }
}
