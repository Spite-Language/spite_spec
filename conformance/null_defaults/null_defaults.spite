var console = Console()
var target: Monster = null
var holder = Holder<Monster>()
var names: List<String> = null

func NullDefaults() {
    load "../../../spite_standard_library/common"
    var count: Integer = null
    var held = holder.value()
    var name_count = names.count()
    console.print(count, target.health, held.health, name_count)
}
