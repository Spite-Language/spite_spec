var console = Console()
var ratio = 0.5

func NullIntoAPlainNumber() {
    show(null)
    var half = halved()
    console.print(half)
    keep()
    measure()
}

func show(count: Integer) {
    console.print(count)
}

func halved(): Double {
    return null
}

func keep() {
    var flags = List<Boolean>()
    flags.append(null)
    var count = flags.count()
    console.print(count)
}

func measure() {
    ratio = null
    console.print(ratio)
}
