var console = Console()
var kept = 1
var seen = List<Integer>()

func NullableByteAdded() {
    load "../../../spite_standard_library/windows"
    seen.append(kept)
    kept = seen.count()
    var total: Integer = 5
    var pair = maybe()
    var answer = total + pair
    console.print(answer)
}

func maybe(): Byte? {
    fallback kept == seen.count()
    var one: Byte = 1
    return one
}
