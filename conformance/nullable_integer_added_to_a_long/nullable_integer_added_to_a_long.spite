var console = Console()
var kept = 1
var seen = List<Integer>()

func NullableIntegerAddedToALong() {
    load "../../../spite_standard_library/windows"
    seen.append(kept)
    kept = seen.count()
    var total: Long = 5
    var pair = maybe()
    var answer = total + pair
    console.print(answer)
}

func maybe(): Integer? {
    fallback kept == seen.count()
    var one: Integer = 1
    return one
}
