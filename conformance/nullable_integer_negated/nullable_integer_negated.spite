var console = Console()
var kept = 1
var seen = List<Integer>()

func NullableIntegerNegated() {
    seen.append(kept)
    kept = seen.count()
    var total: Integer = 5
    var pair = maybe()
    var answer = -pair
    console.print(answer, total)
}

func maybe(): Integer? {
    fallback kept == seen.count()
    var one: Integer = 1
    return one
}
