var console = Console()
var kept = 1
var seen = List<Integer>()

func NullableShortAsAnIndex() {
    seen.append(kept)
    kept = seen.count()
    var total: Integer = 5
    var pair = maybe()
    var numbers = [1, 2]
    var read = numbers[pair]
    console.print(read, total)
}

func maybe(): Short? {
    fallback kept == seen.count()
    var one: Short = 1
    return one
}
