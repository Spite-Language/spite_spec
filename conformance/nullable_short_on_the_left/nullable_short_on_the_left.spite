var console = Console()
var kept = 1
var seen = List<Integer>()

func NullableShortOnTheLeft() {
    seen.append(kept)
    kept = seen.count()
    var total: Short = 5
    var pair = maybe()
    var answer = pair + total
    console.print(answer)
}

func maybe(): Short? {
    fallback kept == seen.count()
    var one: Short = 1
    return one
}
