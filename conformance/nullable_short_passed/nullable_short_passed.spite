var console = Console()
var kept = 1
var seen = List<Integer>()

func NullableShortPassed() {
    seen.append(kept)
    kept = seen.count()
    var total: Integer = 5
    var pair = maybe()
    console.print(total)
    takes(pair)
}

func maybe(): Short? {
    fallback kept == seen.count()
    var one: Short = 1
    return one
}

func takes(number: Integer) {
    console.print(number)
}
