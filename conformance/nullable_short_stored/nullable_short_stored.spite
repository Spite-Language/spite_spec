var console = Console()
var kept = 1
var seen = List<Integer>()

func NullableShortStored() {
    load "../../../spite_standard_library/windows"
    seen.append(kept)
    kept = seen.count()
    var total: Integer = 5
    var pair = maybe()
    total = pair
    console.print(total)
}

func maybe(): Short? {
    fallback kept == seen.count()
    var one: Short = 1
    return one
}
