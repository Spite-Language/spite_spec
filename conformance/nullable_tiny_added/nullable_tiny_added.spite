var console = Console()
var kept = 1
var seen = List<Integer>()

func NullableTinyAdded() {
    seen.append(kept)
    kept = seen.count()
    var total: Integer = 5
    var pair = maybe()
    var answer = total + pair
    console.print(answer)
}

func maybe(): Tiny? {
    fallback kept == seen.count()
    var one: Tiny = 1
    return one
}
