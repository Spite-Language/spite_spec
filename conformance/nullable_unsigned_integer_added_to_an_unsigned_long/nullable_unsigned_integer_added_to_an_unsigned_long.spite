var console = Console()
var kept = 1
var seen = List<Integer>()

func NullableUnsignedIntegerAddedToAnUnsignedLong() {
    seen.append(kept)
    kept = seen.count()
    var total: UnsignedLong = 5
    var pair = maybe()
    var answer = total + pair
    console.print(answer)
}

func maybe(): UnsignedInteger? {
    fallback kept == seen.count()
    var one: UnsignedInteger = 1
    return one
}
