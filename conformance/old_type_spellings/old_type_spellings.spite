var console = Console()
var _sample_year = 2024

func OldTypeSpellings() {
    load "../../../spite_standard_library/windows"
    var count: Int = 3
    var ready: Bool = true
    var mask: UnsignedInt = 7
    var text = "42"
    var parsed = text.to_int()
    var day = LocalDate(_sample_year, 3, 10)
    var clock: LocalTime? = null
    var reading = "2024-03-10".to_local_date()
    console.print(count, ready, mask, parsed, day, clock, reading)
}
