func largest_by_member(member: Spite.AttributeDeclaration<$element_type>): $element_type? {
    assert count() != 0
    var best = 0
    var index = 1
    while index < count() {
        var item = get_at(index)
        crash item
        var leader = get_at(best)
        crash leader
        if item.attributes[member] > leader.attributes[member] {
            best = index
        }
        index = index + 1
    }
    var largest = get_at(best)
    crash largest
    return largest
}

func kept_member(member: Spite.AttributeDeclaration<$element_type>): List<$element_type> {
    var kept = List<$element_type>()
    var index = 0
    while index < count() {
        var item = get_at(index)
        crash item
        if item.attributes[member] {
            kept.append(item)
        }
        index = index + 1
    }
    return kept
}
