var console = Console()

func PathNarrowLoop() {
    load "../../../SpiteCompiler/.spite/library/common"
    load "../../../SpiteCompiler/.spite/library/windows"
    probe()
}

func probe() {
    var outer = Box()
    outer.inner = Box()
    assert outer.inner
    var passes = 0
    while passes < 2 {
        console.print(outer.inner.label)
        outer.inner = null
        passes = passes + 1
    }
}
