var console = Console()

func ReflectionHasNoCasing() {
    load "../../../spite_standard_library/windows"
    var price = Price()
    console.print(price.buy_price)
    price.attributes.each(show)
}

func show(attribute: Spite.Attribute) {
    var pascal = attribute.declaration.pascal_case_name
    console.print(pascal)
}
