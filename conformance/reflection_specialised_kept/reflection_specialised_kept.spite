var console = Console()
var kept = List<Spite.AttributeDeclaration>()

func ReflectionSpecialisedKept() {
    load "../../../spite_standard_library/windows"
    var monster = Monster()
    console.print(monster.health, monster.name)
    Monster.attributes.each(remember)
    var count = kept.count()
    console.print(count)
}

func remember(attribute: Spite.AttributeDeclaration) {
    kept.append(attribute)
}
