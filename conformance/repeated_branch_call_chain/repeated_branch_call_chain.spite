var console = Console()

func RepeatedBranchCallChain() {
    load "../../../spite_standard_library/windows"
    var source = "spite"
    var end = 2
    var kind = describe(source, end)
    console.print(kind)
}

func describe(source: String, end: Integer): String {
    if source.is_empty() {
        var part = source.slice(0, end)
        crash part
        return "empty {part}"
    } else if source.starts_with("s") {
        var part = source.slice(0, end)
        crash part
        return "s {part}"
    } else {
        var part = source.slice(0, end)
        crash part
        return "other {part}"
    }
}
