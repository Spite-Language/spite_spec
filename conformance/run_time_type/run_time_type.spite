var console = Console()

func RunTimeType() {
    var gadget = Gadget()
    var anything: Anything = gadget
    var attributes = anything.attributes
    var first = attributes.values().first()
    crash first
    var made = fresh(first)
    console.print(made)
}

func fresh(attribute: Spite.Attribute): attribute.class {
    return attribute.class()
}
