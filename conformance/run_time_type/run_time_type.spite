var console = Console()

func RunTimeType() {
    var power = Gadget.attributes["power"]
    var kept = List<Spite.AttributeDeclaration>()
    kept.append(power)
    var first = kept.first()
    crash first
    var made = fresh(first)
    console.print(made)
}

func fresh(attribute: Spite.AttributeDeclaration): attribute.class {
    return attribute.class()
}
