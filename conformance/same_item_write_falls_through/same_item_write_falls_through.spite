enum Light {
    'red'
    'green'
}

var console = Console()
var held: Item? = null

func SameItemWriteFallsThrough() {
    var rack = Rack()
    var first = Item()
    var filled = Shelf()
    filled.item = first
    rack.shelf = filled
    rack.item = first
    held = first
    var other: Item? = first
    touch(rack)
    show(rack, rack, first, other, 1)
}

func light_of(code: Integer): Light {
    if code > 0 {
        return 'red'
    }
    return 'green'
}

func touch(rack: Rack) {
    if rack.item {
        console.print(rack.item.number)
        var seen = rack.item.read_it()
        console.print(seen)
    }
    if rack.shelf.item {
        console.print(rack.shelf.item.number)
    }
    console.print(rack.turns)
}

func clear(rack: Rack) {
    rack.item = null
    rack.shelf.item = null
}

func cleared(rack: Rack): Boolean {
    rack.item = null
    rack.shelf.item = null
    return true
}

func show(_rack: Rack, _alias: Rack, first: Item, _given: Item?, code: Integer) {
    var things = List<Item?>()
    things.append(first)
    fallback things[0]
    if code > 90 {
        things[0] = null
    }
    console.print(things[0].number)
}
