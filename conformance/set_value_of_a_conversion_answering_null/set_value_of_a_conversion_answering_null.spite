var console = Console()

func SetValueOfAConversionAnsweringNull() {
    var meter = Meter()
    var three = 3
    write_named(meter, "reading", three)
    console.print(meter.reading.length)
}

func write_named(held: Anything, name: String, given: Anything) {
    var attributes = held.attributes
    var found = attributes[name]
    crash found
    found.value = given
}
