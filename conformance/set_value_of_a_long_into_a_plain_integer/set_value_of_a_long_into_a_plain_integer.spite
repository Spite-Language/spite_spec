var console = Console()
var _big: Long = 5000000000

func SetValueOfALongIntoAPlainInteger() {
    var meter = Meter()
    var large: Long = _big
    write_named(meter, "whole", large)
    console.print(meter.whole)
}

func write_named(held: Anything, name: String, given: Anything) {
    var attributes = held.attributes
    var found = attributes[name]
    crash found
    found.value = given
}
