type Shown {
    to_debug: Spite.Function<String>
}

var console = Console()

func SetValueOfNullIntoAPlainAttribute() {
    var meter = Meter()
    write_whole(meter)
    console.print("whole", meter.whole)
}

func write_whole(held: Shown) {
    var attributes = held.attributes
    var whole = attributes["whole"]
    crash whole
    whole.value = null
}
