type Shown {
    to_debug: Spite.Function<String>
}

var console = Console()

func SetValuePinnedByADeclarationName() {
    var meter = Meter()
    var gadget = Gadget()
    write_one(meter, gadget)
    console.print(meter.whole, meter.label)
}

func write_one(held: Meter, given: Shown) {
    var declaration = Meter.attributes["whole"]
    var whole = held.attributes[declaration.name]
    whole.value = given
    var label = held.attributes["label"]
    label.value = given
}
