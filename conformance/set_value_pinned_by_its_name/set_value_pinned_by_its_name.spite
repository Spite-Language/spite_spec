var console = Console()

func SetValuePinnedByItsName() {
    var meter = Meter()
    var gadget = Gadget()
    write_one(meter, gadget)
    console.print(meter.whole, meter.label)
}

func write_one(held: Anything, given: Anything) {
    var whole = held.attributes["whole"]
    crash whole
    whole.value = given
    var label = held.attributes["label"]
    crash label
    label.value = given
}
