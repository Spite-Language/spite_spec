type Shown {
    to_debug: Spite.Function<String>
}

var console = Console()

func SetValuePinnedInAList() {
    var meter = Meter()
    var gadget = Gadget()
    write_one(meter, gadget)
    console.print(meter.whole, meter.label)
}

func write_one(held: Shown, given: Shown) {
    var chosen = [held.attributes["whole"]]
    var whole = chosen[0]
    crash whole
    whole.value = given
    var label = held.attributes["label"]
    crash label
    label.value = given
}
