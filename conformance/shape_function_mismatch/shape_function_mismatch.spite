type Renderable {
    render: Spite.Function<String>
}

var console = Console()

func ShapeFunctionMismatch() {
    load "../../../spite_standard_library/windows"
    var silent = Silent()
    show(silent)
    var numbered = Numbered()
    show(numbered)
}

func show(part: Renderable) {
    var rendered = part.render()
    console.print(rendered)
}
