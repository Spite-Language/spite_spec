var console = Console()
var items = ["a", "b"]
var shelf = Shelf()

func ShrinkUndoesProofThroughAHandedList() {
    work()
    var left = shelf.items.count()
    console.print(left)
    var kept = items.count()
    console.print(kept)
}

func work() {
    var mine = ["a", "b"]
    shelf.items = mine
    crash shelf.items[0]
    mine.clear()
