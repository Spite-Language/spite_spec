enum Light {
    'red'
    'green'
}

var console = Console()
var stop_light: Light = 'red'

func SwitchCaseIsAName() {
    load "../../../spite_standard_library/windows"
    var wait = seconds_for('red')
    console.print(wait)
}

func seconds_for(light: Light): Integer {
    switch light {
        stop_light: return 30
        'green': return 20
    }
}
