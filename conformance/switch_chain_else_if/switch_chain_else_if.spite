enum Light {
    'red'
    'amber'
    'green'
    'off'
}

func SwitchChainElseIf(): Integer {
    load "../../../spite_standard_library/common"
    return seconds_for('green')
}

func seconds_for(light: Light): Integer {
    if light == 'red' {
        return 30
    } else if light == 'amber' {
        return 5
    } else if light == 'green' {
        return 20
    } else {
        return 0
    }
}
