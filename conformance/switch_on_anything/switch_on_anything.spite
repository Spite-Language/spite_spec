var console = Console()
var kept = List<Anything>()

func SwitchOnAnything() {
    kept.append("text")
    var first = kept[0]
    crash first
    var shown = shown_of(first)
    console.print(shown)
}

func shown_of(held: Anything): String {
    switch held {
        String: return "text"
        Boolean: return "truth"
    }
}
