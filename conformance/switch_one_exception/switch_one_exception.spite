union Creature {
    Cat
    Dog
    Fish
}

var console = Console()

func SwitchOneException() {
    var creature: Creature = Cat()
    show(creature)
}

func show(creature: Creature) {
    switch creature {
        Cat: console.print("walks")
        Dog: console.print("walks")
        Fish: console.print("swims")
    }
}
