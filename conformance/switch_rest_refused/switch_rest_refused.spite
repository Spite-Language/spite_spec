union Creature {
    Cat
    Dog
    Fish
}

var console = Console()

func SwitchRestRefused() {
    load "../../../spite_standard_library/windows"
    var creature: Creature = Cat()
    describe(creature)
}

func describe(creature: Creature) {
    switch creature {
        Fish: console.print("swims")
        _: console.print("walks")
    }
}
