var console = Console()

func TerminalIfWithAProvenCheck() {
    load "../../../spite_standard_library/windows"
    var holder = Holder()
    holder.inner = "inside"
    show(holder)
}

func show(receiver: Holder) {
    console.print("start")
    if receiver.inner {
        crash receiver.inner
        console.print(receiver.inner)
    }
}
