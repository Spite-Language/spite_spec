var console = Console()
var clock = Clock()
var _sample_year = 2024

func TimeInstantAgainstLocal() {
    load "../../../spite_standard_library/windows"
    var now = clock.now()
    var day = Date(_sample_year, 1, 1)
    var noon = Time(12, 0, 0, 0)
    var reading = DateTime(day, noon)
    var same = now == reading
    console.print(same)
}
