var console = Console()
var program = Program()

func UnsteppedPoll() {
    load "../../../spite_standard_library/windows"
    var napping = Concurrent(nap)
    var polls = 0
    while not napping.finished {
        polls = polls + 1
    }
    console.print(polls)
}

func nap() {
    var five_milliseconds = Duration(5, 'milliseconds')
    program.sleep(five_milliseconds)
}
