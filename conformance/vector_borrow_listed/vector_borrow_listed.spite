var console = Console()
var velocities = Vector<Velocity>()
var history = List<Velocity>()

func VectorBorrowListed() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var first = Velocity(1, "first")
    velocities.append(first)
    crash velocities[0]
    var stored = velocities[0]
    history.append(stored)
    var names = history.map_names().join(",")
    console.print(names, stored.across)
}
