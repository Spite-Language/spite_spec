var console = Console()

func VectorBorrowLocalAssigned() {
    load "../../../spite_standard_library/windows"
    var velocities = Vector<Velocity>()
    var first = Velocity(1, "first")
    velocities.append(first)
    crash velocities[0]
    var velocity = velocities[0]
    velocities = Vector<Velocity>()
    console.print(velocity.across, velocity.name, velocities.count())
}
