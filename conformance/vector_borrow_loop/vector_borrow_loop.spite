var console = Console()
var velocities = Vector<Velocity>()

func VectorBorrowLoop() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var index = 0
    while index < 4 {
        var made = Velocity(index, "made")
        velocities.append(made)
        index = index + 1
    }
    crash velocities[0]
    var looped = velocities[0]
    var pass = 0
    while pass < 2 {
        looped.across = pass
        velocities.remove_at(1)
        pass = pass + 1
    }
    var count = velocities.count()
    console.print(count, looped.name)
}
