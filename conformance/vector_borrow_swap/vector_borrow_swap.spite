var console = Console()
var velocities = Vector<Velocity>()

func VectorBorrowSwap() {
    load "../../../spite_standard_library/windows"
    var first = Velocity(1, "first")
    velocities.append(first)
    var second = Velocity(2, "second")
    velocities.append(second)
    crash velocities[0]
    var velocity = velocities[0]
    velocities.swap(0, 1)
    console.print(velocity.across, velocity.name)
}
