var console = Console()

func WalkCallsAHeldFunction() {
    load "../../../spite_standard_library/windows"
    var names = ["ada", "alan"]
    var shout = loud
    var index = 0
    while index < names.count() {
        var name = names[index]
        shout(name)
        index = index + 1
    }
}

func loud(name: String) {
    console.print(name.upper_case())
}
