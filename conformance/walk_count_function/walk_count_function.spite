var console = Console()
var items = List<Item>()

func WalkCountFunction() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var apple = Item("apple", 3, true)
    items.append(apple)
    var pear = Item("pear", 5, false)
    items.append(pear)
    var answer = walk()
    console.print(answer, apple.name, apple.price, apple.in_stock)
}

func is_cheap(item: Item): Boolean {
    return item.price < 4
}

func price_of(item: Item): Integer {
    return item.price
}

func walk(): Integer {
    var total = 0
    var index = 0
    while index < items.count() {
        var item = items[index]
        if is_cheap(item) {
            total = total + 1
        }
        index = index + 1
    }
    return total
}
