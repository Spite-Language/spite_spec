var console = Console()
var items = List<Item>()

func WalkEachFunctionOnIntegers() {
    load "../../../spite_standard_library/windows"
    var apple = Item("apple", 3, true)
    items.append(apple)
    var pear = Item("pear", 5, false)
    items.append(pear)
    var answer = walk()
    console.print(answer, apple.name, apple.price, apple.in_stock)
}

func is_cheap(item: Item): Boolean {
    return item.price < 4
}

func price_of(item: Item): Integer {
    return item.price
}

func walk(): Integer {
    var numbers = List<Integer>()
    numbers.append(1)
    numbers.append(2)
    var index = 0
    while index < numbers.count() {
        announce(numbers[index])
        index = index + 1
    }
    return numbers.count()
}

func announce(number: Integer) {
    console.print("number", number)
}
