var console = Console()
var _sample_flags: Byte = 200
var _wide_mask: Long = 4294967311
var _wider_than_tiny = 300

func WiderBitwiseOperand() {
    load "../../../spite_standard_library/windows"
    var flags: Byte = _sample_flags
    var mask: Long = _wide_mask
    var kept = flags.bits_and(mask)
    var small: Tiny = 3
    var joined = small.bits_or(_wider_than_tiny)
    console.print(kept, joined)
}
