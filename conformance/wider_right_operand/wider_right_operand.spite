var console = Console()
var _large_total: Long = 5000000000
var _wider_than_byte = 300

func WiderRightOperand() {
    load "../../../spite_standard_library/windows"
    var count = 3
    var total: Long = _large_total
    var ratio: Double = 0.5
    var small: Byte = 7
    var product = count * total
    var sum = count + ratio
    var difference = count - total
    var fits = small + 1
    var too_big = small + _wider_than_byte
    var wide_first = total * count
    var compared = count < total
    var wrapped = (65536 - 128) * 65536
    var widened: Long = 65536
    var kept = widened * 65536
    console.print(product, sum, difference, fits, too_big, wide_first, compared, wrapped, kept)
}
