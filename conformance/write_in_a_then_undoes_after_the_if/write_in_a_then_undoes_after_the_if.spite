var console = Console()

func WriteInAThenUndoesAfterTheIf() {
    load "../../../spite_standard_library/windows"
    var rack = Rack()
    rack.item = Item()
    show(rack, rack)
}

func show(rack: Rack, alias: Rack) {
    if alias.item {
        console.print("alias")
    }
    fallback rack.item
    if rack.item.number > 1 {
        rack.item = null
    } else {
        console.print(rack.item.number)
    }
    console.print(rack.item.number)
}
