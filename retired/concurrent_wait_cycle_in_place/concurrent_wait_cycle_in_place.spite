var console = Console()
var program = Program()
var board = Board()

func ConcurrentWaitCycleInPlace() {
    load "../../../spite_standard_library/windows"
    var one_millisecond = Duration(1, 'milliseconds')
    start_both()
    board.both_held = true
    while board.both_held {
        program.sleep(one_millisecond)
    }
    console.print("never printed")
}

func start_both() {
    var first = Concurrent(board.release_second)
    board.first_holder.handles.append(first)
    var second = Concurrent(board.release_first)
    board.second_holder.handles.append(second)
}
