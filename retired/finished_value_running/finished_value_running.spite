var console = Console()
var program = Program()

func FinishedValueRunning() {
    load "../../../spite_standard_library/windows"
    var napping = Concurrent(nap)
    var early = napping.finished_value()
    if early {
        console.print("finished at once with", early)
    } else {
        console.print("no value while it runs")
    }
    var napped: Integer = napping
    var late = napping.finished_value()
    crash late
    console.print("joined", napped, "and then finished_value answers", late)
}

func nap(): Integer {
    var twenty_milliseconds = Duration(20, 'milliseconds')
    program.sleep(twenty_milliseconds)
    return 20
}
