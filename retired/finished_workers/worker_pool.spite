var program = Program()
var workers = List<Concurrent<Nothing>>()
var pending = 0
var done = 0

func start(items: Integer) {
    pending = items
    var worker = Concurrent(drain)
    workers.append(worker)
}

func drain() {
    var five_milliseconds = Duration(5, 'milliseconds')
    while pending > 0 {
        pending = pending - 1
        program.sleep(five_milliseconds)
        done = done + 1
    }
}
