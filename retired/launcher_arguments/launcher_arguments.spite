var console = Console()
var program = Program()

func LauncherArguments() {
    load "../../../spite_standard_library/windows"
    var arguments = program.arguments()
    show(arguments)
}

func show(arguments: List<String>) {
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        console.print("[{argument}]")
        index = index + 1
    }
}
