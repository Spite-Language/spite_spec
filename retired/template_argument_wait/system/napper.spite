type Nap {
    length: Integer
}

var program = Program()
var console = Console()
var naps = 0
var awake = true

func update_each(nap: Nap) {
    naps = naps + 1
    awake = false
    console.print("nap", naps, "for", nap.length, "ms")
    var pause = Duration(nap.length, 'milliseconds')
    program.sleep(pause)
    awake = true
}
