var kernel = DynamicLibrary(
    "kernel32.dll",
    "",
    {
        "create_job_object": DynamicLibrary.FunctionDeclaration("CreateJobObjectA", [DynamicLibrary.Argument("security", Long), DynamicLibrary.Argument("name", Long)], Long)
        "set_information_job_object": DynamicLibrary.FunctionDeclaration("SetInformationJobObject", [DynamicLibrary.Argument("job", Long), DynamicLibrary.Argument("kind", Integer), DynamicLibrary.Argument("information", Buffer), DynamicLibrary.Argument("size", Integer)], Nothing)
        "create_process": DynamicLibrary.FunctionDeclaration("CreateProcessA", [DynamicLibrary.Argument("application", Long), DynamicLibrary.Argument("command_line", Buffer), DynamicLibrary.Argument("process_security", Long), DynamicLibrary.Argument("thread_security", Long), DynamicLibrary.Argument("inherits_handles", Integer), DynamicLibrary.Argument("flags", Integer), DynamicLibrary.Argument("environment", Long), DynamicLibrary.Argument("directory", Long), DynamicLibrary.Argument("startup", Buffer), DynamicLibrary.Argument("information", Buffer)], Integer)
        "assign_process_to_job_object": DynamicLibrary.FunctionDeclaration("AssignProcessToJobObject", [DynamicLibrary.Argument("job", Long), DynamicLibrary.Argument("process", Long)], Nothing)
        "resume_thread": DynamicLibrary.FunctionDeclaration("ResumeThread", [DynamicLibrary.Argument("thread", Long)], Nothing)
        "close_handle": DynamicLibrary.FunctionDeclaration("CloseHandle", [DynamicLibrary.Argument("handle", Long)], Nothing)
        "tick_count": DynamicLibrary.FunctionDeclaration("GetTickCount64", [], Long)
        "wait_for_single_object": DynamicLibrary.FunctionDeclaration("WaitForSingleObject", [DynamicLibrary.Argument("handle", Long), DynamicLibrary.Argument("milliseconds", Integer)], Integer)
        "exit_code_of_process": DynamicLibrary.FunctionDeclaration("GetExitCodeProcess", [DynamicLibrary.Argument("process", Long), DynamicLibrary.Argument("code", Buffer)], Integer)
        "terminate_job_object": DynamicLibrary.FunctionDeclaration("TerminateJobObject", [DynamicLibrary.Argument("job", Long), DynamicLibrary.Argument("code", Integer)], Nothing)
        "wait_for_process": DynamicLibrary.FunctionDeclaration("WaitForSingleObject", [DynamicLibrary.Argument("handle", Long), DynamicLibrary.Argument("milliseconds", Integer)], Nothing)
    },
)
var job: Long = 0
var process: Long = 0
var started: Long = 0
var startup_size = 104
var information_size = 24
var limit_size = 144
var kills_on_close = 8192
var extended_limits = 9
var starts_suspended = 4
var finished_waiting = 0
var folder: String
var output_path: String

func Child(starting_folder: String, starting_output_path: String) {
    folder = starting_folder
    output_path = starting_output_path
}

func start(command: String): Boolean {
    var no_value: Long = 0
    job = create_job_object(no_value, no_value)
    fallback job != 0
    var limits = zeroed(limit_size)
    limits.write_integer_little_endian_at(16, kills_on_close)
    set_information_job_object(job, extended_limits, limits, limit_size)
    var line = command.to_buffer()
    var ending: Byte = 0
    line.append(ending)
    var startup = zeroed(startup_size)
    startup.write_integer_little_endian_at(0, startup_size)
    var information = zeroed(information_size)
    var made = create_process(
        no_value,
        line,
        no_value,
        no_value,
        0,
        starts_suspended,
        no_value,
        no_value,
        startup,
        information,
    )
    fallback made != 0
    var made_process = information.read_long_little_endian_at(0)
    var made_thread = information.read_long_little_endian_at(8)
    crash made_process and made_thread
    process = made_process
    assign_process_to_job_object(job, process)
    resume_thread(made_thread)
    close_handle(made_thread)
    started = tick_count()
    return true
}

func zeroed(size: Integer): Buffer {
    var room = Buffer(size)
    var zero: Byte = 0
    var index = 0
    while index < size {
        room.append(zero)
        index = index + 1
    }
    return room
}

func has_finished(): Boolean {
    var waited = wait_for_single_object(process, 0)
    return waited == finished_waiting
}

func seconds_running(): Long {
    var now = tick_count()
    return (now - started) / 1000
}

func exit_code(): Integer {
    var answer = zeroed(4)
    var read = exit_code_of_process(process, answer)
    crash read != 0
    var code = answer.read_integer_little_endian_at(0)
    crash code
    return code
}

func stop() {
    terminate_job_object(job, 1)
    wait_for_process(process, -1)
}

func close() {
    close_handle(process)
    close_handle(job)
}

func create_job_object(security: Long, name: Long): Long {
    var call = DynamicLibrary.Call(kernel.functions["create_job_object"])
    call.arguments["security"] = security
    call.arguments["name"] = name
    return call.call()
}

func set_information_job_object(job: Long, kind: Integer, information: Buffer, size: Integer) {
    var call = DynamicLibrary.Call(kernel.functions["set_information_job_object"])
    call.arguments["job"] = job
    call.arguments["kind"] = kind
    call.arguments["information"] = information
    call.arguments["size"] = size
    call.call()
}

func create_process(
    application: Long,
    command_line: Buffer,
    process_security: Long,
    thread_security: Long,
    inherits_handles: Integer,
    flags: Integer,
    environment: Long,
    directory: Long,
    startup: Buffer,
    information: Buffer,
): Integer {
    var call = DynamicLibrary.Call(kernel.functions["create_process"])
    call.arguments["application"] = application
    call.arguments["command_line"] = command_line
    call.arguments["process_security"] = process_security
    call.arguments["thread_security"] = thread_security
    call.arguments["inherits_handles"] = inherits_handles
    call.arguments["flags"] = flags
    call.arguments["environment"] = environment
    call.arguments["directory"] = directory
    call.arguments["startup"] = startup
    call.arguments["information"] = information
    return call.call()
}

func assign_process_to_job_object(job: Long, process: Long) {
    var call = DynamicLibrary.Call(kernel.functions["assign_process_to_job_object"])
    call.arguments["job"] = job
    call.arguments["process"] = process
    call.call()
}

func resume_thread(thread: Long) {
    var call = DynamicLibrary.Call(kernel.functions["resume_thread"])
    call.arguments["thread"] = thread
    call.call()
}

func close_handle(handle: Long) {
    var call = DynamicLibrary.Call(kernel.functions["close_handle"])
    call.arguments["handle"] = handle
    call.call()
}

func tick_count(): Long {
    var call = DynamicLibrary.Call(kernel.functions["tick_count"])
    return call.call()
}

func wait_for_single_object(handle: Long, milliseconds: Integer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["wait_for_single_object"])
    call.arguments["handle"] = handle
    call.arguments["milliseconds"] = milliseconds
    return call.call()
}

func exit_code_of_process(process: Long, code: Buffer): Integer {
    var call = DynamicLibrary.Call(kernel.functions["exit_code_of_process"])
    call.arguments["process"] = process
    call.arguments["code"] = code
    return call.call()
}

func terminate_job_object(job: Long, code: Integer) {
    var call = DynamicLibrary.Call(kernel.functions["terminate_job_object"])
    call.arguments["job"] = job
    call.arguments["code"] = code
    call.call()
}

func wait_for_process(handle: Long, milliseconds: Integer) {
    var call = DynamicLibrary.Call(kernel.functions["wait_for_process"])
    call.arguments["handle"] = handle
    call.arguments["milliseconds"] = milliseconds
    call.call()
}
