var console = Console()
var program = Program()
var compiler = "..\\SpiteCompiler\\.spite\\spite.exe"
var passed = 0
var failed = 0
var found_folders = List<String>()
var failed_folders = List<String>()
var failures_file = "runner/.spite/failed.txt"
var parent_folder = ""

func Runner() {
    var named = named_folders()
    if named.is_empty() {
        named = every_folder()
    }
    named.each(run_one)
    keep_the_failures()
    console.print("{passed} passed, {failed} failed")
    if failed > 0 {
        program.exit(1)
    }
}

func named_folders(): List<String> {
    var named = List<String>()
    var arguments = Arguments()
    var index = 0
    while index < arguments.count() {
        var argument = arguments.get(index)
        add_named(named, argument)
        index = index + 1
    }
    return named
}

func add_named(named: List<String>, argument: String) {
    if argument == "--failed" {
        var last = last_failures()
        var failure_index = 0
        while failure_index < last.count() {
            var failure = last[failure_index]
            named.append(failure)
            failure_index = failure_index + 1
        }
        return
    }
    var without_slash = trimmed_slash(argument)
    if not without_slash.ends_with("*") {
        named.append(without_slash)
        return
    }
    var prefix_length = without_slash.length() - 1
    var prefix = without_slash.slice(0, prefix_length)
    var every = every_folder()
    var index = 0
    while index < every.count() {
        var folder = every[index]
        if folder.starts_with(prefix) {
            named.append(folder)
        }
        index = index + 1
    }
}

func last_failures(): List<String> {
    var file = File(failures_file)
    var text = file.read()
    var found = List<String>()
    if not text {
        return found
    }
    var lines = text.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var trimmed = line.trim()
        if not trimmed.is_empty() {
            found.append(trimmed)
        }
        index = index + 1
    }
    return found
}

func keep_the_failures() {
    var folder = Directory("runner/.spite")
    if not folder.exists() {
        folder.create()
    }
    var joined = failed_folders.join("\n")
    var file = File(failures_file)
    file.write(joined)
}

func every_folder(): List<String> {
    found_folders = List<String>()
    keep_folders_in("tests")
    keep_folders_in("conformance")
    return found_folders
}

func keep_folders_in(parent: String) {
    parent_folder = parent
    var directory = Directory(parent)
    var entries = directory.entries()
    entries.each(keep_folder)
}

func keep_folder(entry: Directory.Entry) {
    if entry == Directory {
        var name = entry.name
        found_folders.append("{parent_folder}/{name}")
    }
}

func trimmed_slash(folder: String): String {
    var forward = folder.replace("\\", "/")
    if forward.ends_with("/") {
        var last = forward.length() - 1
        return forward.slice(0, last)
    }
    return forward
}

func run_one(folder: String) {
    if folder.starts_with("tests/") {
        run_test(folder)
        return
    }
    if folder.starts_with("conformance/") {
        run_conformance(folder)
        return
    }
    fail(folder, "a test is tests/<name> or conformance/<name>")
}

func run_test(folder: String) {
    var wanted = expected_text(folder, "expected_exit_code.txt")
    assert wanted
    var flags = optional_text(folder, "flags.txt")
    var no_arguments = List<String>()
    var compile = Process("{compiler} {folder} {flags} 2>&1 1>nul", no_arguments)
    var compiled = compile.run()
    if compiled != 0 {
        var errors = compile.output()
        fail(folder, "it did not compile: {errors}")
        return
    }
    var executable = executable_of(folder)
    var input = "<nul"
    var input_file = File("{folder}/input.txt")
    if input_file.exists() {
        input = "<{folder}/input.txt"
    }
    var program_arguments = optional_text(folder, "arguments.txt")
    var running = Process("{executable} {program_arguments} {input} 2>&1", no_arguments)
    var answered = running.run()
    var answer = answered.to_string()
    if answer != wanted {
        fail(folder, "it answered {answer}, and {wanted} was expected")
        return
    }
    var output_file = File("{folder}/expected_output.txt")
    if output_file.exists() {
        var expected_output = optional_text(folder, "expected_output.txt")
        var printed = running.output()
        var output = cleaned(printed)
        if not matches(output, expected_output) {
            fail(folder, "the output differs\n  expected: {expected_output}\n  got:      {output}")
            return
        }
    }
    passed = passed + 1
}

func optional_text(folder: String, name: String): String {
    var file = File("{folder}/{name}")
    var text = file.read()
    if not text {
        return ""
    }
    return cleaned(text)
}

func run_conformance(folder: String) {
    var wanted = expected_text(folder, "expected_errors.txt")
    assert wanted
    var flags = optional_text(folder, "flags.txt")
    var no_arguments = List<String>()
    var compile = Process("{compiler} {folder} {flags} 2>&1 1>nul", no_arguments)
    var compiled = compile.run()
    if compiled == 0 {
        fail(folder, "it compiled, and it must fail")
        return
    }
    var output = compile.output()
    var errors = cleaned(output)
    if not matches(errors, wanted) {
        fail(folder, "the errors differ\n  expected: {wanted}\n  got:      {errors}")
        return
    }
    passed = passed + 1
}

func expected_text(folder: String, name: String): String? {
    var file = File("{folder}/{name}")
    var text = file.read()
    if not text {
        fail(folder, "it has no {name}")
        return null
    }
    return cleaned(text)
}

func executable_of(folder: String): String {
    var directory = Directory(folder)
    var name = directory.name
    var windows_folder = folder.replace("/", "\\")
    return "{windows_folder}\\.spite\\build\\{name}.exe"
}

func matches(got: String, wanted: String): Boolean {
    var got_lines = got.split("\n")
    var wanted_lines = wanted.split("\n")
    if got_lines.count() != wanted_lines.count() {
        return false
    }
    var index = 0
    while index < wanted_lines.count() {
        var wanted_line = wanted_lines[index]
        var got_line = got_lines[index]
        crash got_line
        if not line_matches(got_line, wanted_line) {
            return false
        }
        index = index + 1
    }
    return true
}

func line_matches(got: String, wanted: String): Boolean {
    if not wanted.contains("...") {
        return got == wanted
    }
    var pieces = wanted.split("...")
    var first = pieces[0]
    crash first
    if not got.starts_with(first) {
        return false
    }
    var at = first.length()
    var index = 1
    while index < pieces.count() {
        var piece = pieces[index]
        var got_length = got.length()
        var rest = got.slice(at, got_length)
        var found = rest.index_of(piece)
        if index == pieces.count() - 1 {
            return rest.ends_with(piece)
        }
        if found < 0 {
            return false
        }
        at = at + found + piece.length()
        index = index + 1
    }
    return true
}

func cleaned(text: String): String {
    var without_returns = text.replace("\r", "")
    return without_returns.trim()
}

func fail(folder: String, why: String) {
    failed_folders.append(folder)
    console.print("FAILED {folder}: {why}")
    failed = failed + 1
}
