union Entry {
    Directory
    File
}

var console = Console()
var program = Program()
var compiler = "..\\spite_compiler\\.spite\\spite.exe"
var passed = 0
var failed = 0
var found_folders = List<String>()
var failed_folders = List<String>()
var failures_file = "runner/.spite/failed.txt"
var parent_folder = ""
var copies_folder = ".copies"
var outputs_folder = ".spite/runner"
var environment = Environment()
var running = List<Child>()
var waiting = List<String>()
var started_count = 0

func Runner() {
    load "../../spite_standard_library/windows"
    make_the_working_folder()
    if not environment.one_test.is_empty() {
        run_alone(environment.one_test)
        return
    }
    var named = named_folders()
    if named.is_empty() {
        named = every_folder()
    }
    waiting = named
    run_in_parallel()
    keep_the_failures()
    console.print("{passed} passed, {failed} failed")
    if failed > 0 {
        program.exit(1)
    }
}

func run_alone(folder: String) {
    run_one(folder)
    if failed > 0 {
        program.exit(1)
    }
}

func run_in_parallel() {
    var twenty_milliseconds = Duration(20, 'milliseconds')
    var at_once = jobs_at_once()
    var next = 0
    while next < waiting.count() or not running.is_empty() {
        while next < waiting.count() and running.count() < at_once {
            var folder = waiting[next]
            start_one(folder)
            next = next + 1
        }
        var finished_any = collect_the_finished()
        if not finished_any {
            program.sleep(twenty_milliseconds)
        }
    }
}

func jobs_at_once(): Integer {
    if environment.jobs > 0 {
        return environment.jobs
    }
    var processors = program.environment("NUMBER_OF_PROCESSORS")
    if not processors {
        return 4
    }
    var number: Integer? = processors
    if not number or number < 1 {
        return 4
    }
    return number
}

func start_one(folder: String) {
    var executable = program.executable_path()
    crash executable
    started_count = started_count + 1
    var output_path = "{outputs_folder}/{started_count}.txt"
    var windows_output = output_path.replace("/", "\\")
    var command = "cmd /d /s /c \"\"{executable}\" --one-test={folder} >\"{windows_output}\" 2>&1\""
    var child = Child(folder, output_path)
    if child.start(command) {
        running.append(child)
        return
    }
    child.close()
    fail(folder, "the runner could not start a process to run it: {command}")
}

func collect_the_finished(): Boolean {
    var still = List<Child>()
    var finished_any = false
    var index = 0
    while index < running.count() {
        var child = running[index]
        if child.has_finished() {
            finish_one(child)
            finished_any = true
        } else if child.seconds_running() >= environment.time_limit {
            child.stop()
            child.close()
            fail(child.folder, "stopped after {environment.time_limit} seconds, the program did not finish")
            finished_any = true
        } else {
            still.append(child)
        }
        index = index + 1
    }
    running = still
    return finished_any
}

func finish_one(child: Child) {
    var code = child.exit_code()
    child.close()
    var file = File(child.output_path)
    var printed = file.read_as_string()
    var text = ""
    if printed {
        text = cleaned(printed)
    }
    if code == 0 {
        passed = passed + 1
        return
    }
    failed_folders.append(child.folder)
    failed = failed + 1
    if text.is_empty() {
        console.print("FAILED {child.folder}: its run ended with exit code {code} and printed nothing")
    } else {
        console.print(text)
    }
}

func make_the_working_folder() {
    make_a_folder(".spite")
    make_a_folder(outputs_folder)
}

func make_a_folder(path: String) {
    var folder = Directory(path)
    if not folder.exists() {
        crash folder.create()
    }
}

func named_folders(): List<String> {
    var named = List<String>()
    var arguments = program.arguments()
    var index = 0
    while index < arguments.count() {
        var argument = arguments[index]
        add_named(named, argument)
        index = index + 1
    }
    return named
}

func add_named(named: List<String>, argument: String) {
    var is_a_setting = argument.starts_with("--") and argument != "--failed"
    fallback not is_a_setting
    if argument == "--failed" {
        var last = last_failures()
        var failure_index = 0
        while failure_index < last.count() {
            var failure = last[failure_index]
            named.append(failure)
            failure_index = failure_index + 1
        }
        return
    }
    var without_slash = trimmed_slash(argument)
    if not without_slash.ends_with("*") {
        named.append(without_slash)
        return
    }
    var prefix_length = without_slash.length() - 1
    var prefix = without_slash.slice(0, prefix_length)
    crash prefix
    var every = every_folder()
    var index = 0
    while index < every.count() {
        var folder = every[index]
        if folder.starts_with(prefix) {
            named.append(folder)
        }
        index = index + 1
    }
}

func last_failures(): List<String> {
    var file = File(failures_file)
    var text = file.read_as_string()
    var found = List<String>()
    if not text {
        return found
    }
    var lines = text.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var trimmed = line.trim()
        if not trimmed.is_empty() {
            found.append(trimmed)
        }
        index = index + 1
    }
    return found
}

func keep_the_failures() {
    var folder = Directory("runner/.spite")
    if not folder.exists() {
        crash folder.create()
    }
    var joined = failed_folders.join("\n")
    var file = File(failures_file)
    crash file.write_string(joined)
}

func every_folder(): List<String> {
    found_folders = List<String>()
    keep_folders_in("tests")
    keep_folders_in("conformance")
    return found_folders
}

func keep_folders_in(parent: String) {
    parent_folder = parent
    var directory = Directory(parent)
    var entries = directory.entries()
    crash entries
    entries.each(keep_folder)
}

func keep_folder(entry: Entry) {
    if entry.class == Directory {
        var name = entry.folder_name
        found_folders.append("{parent_folder}/{name}")
    }
}

func trimmed_slash(folder: String): String {
    var forward = folder.replace("\\", "/")
    if forward.ends_with("/") {
        var last = forward.length() - 1
        var sliced = forward.slice(0, last)
        crash sliced
        return sliced
    }
    return forward
}

func run_one(folder: String) {
    if folder.starts_with("tests/") {
        run_test(folder)
        return
    }
    if folder.starts_with("conformance/") {
        run_conformance(folder)
        return
    }
    fail(folder, "a test is tests/<name> or conformance/<name>")
}

func run_test(folder: String) {
    var wanted = expected_text(folder, "expected_exit_code.txt")
    fallback wanted
    var copy = copy_of(folder)
    fallback copy
    var flags = optional_text(folder, "flags.txt")
    var no_arguments = List<String>()
    var compile = Process("{compiler} {copy} {flags} --build 2>&1 1>nul", no_arguments)
    var compiled = compile.run()
    if compiled != 0 {
        var output = compile.read_output_as_string()
        crash output
        var errors = in_the_folder(output, copy, folder)
        fail(folder, "it did not compile: {errors}")
        return
    }
    var built = build_moved_back(copy, folder)
    fallback built
    var executable = executable_of(folder)
    var input = "<nul"
    var input_file = File("{folder}/input.txt")
    if input_file.exists() {
        input = "<{folder}/input.txt"
    }
    var program_arguments = optional_text(folder, "arguments.txt")
    var running = Process("{executable} {program_arguments} {input} 2>&1", no_arguments)
    var answered = running.run()
    crash answered
    var answer = answered.to_string()
    if answer != wanted {
        fail(folder, "it answered {answer}, and {wanted} was expected")
        return
    }
    var output_file = File("{folder}/expected_output.txt")
    if output_file.exists() {
        var expected_output = optional_text(folder, "expected_output.txt")
        var printed = running.read_output_as_string()
        crash printed
        var moved = in_the_folder(printed, copy, folder)
        var output = cleaned(moved)
        if not matches(output, expected_output) {
            fail(folder, "the output differs\n  expected: {expected_output}\n  got:      {output}")
            return
        }
    }
    passed = passed + 1
}

func optional_text(folder: String, name: String): String {
    var file = File("{folder}/{name}")
    var text = file.read_as_string()
    fallback text
    return cleaned(text)
}

func run_conformance(folder: String) {
    var wanted = expected_text(folder, "expected_errors.txt")
    fallback wanted
    var copy = copy_of(folder)
    fallback copy
    var flags = built_only(folder)
    var no_arguments = List<String>()
    var compile = Process("{compiler} {copy} {flags} 2>&1 1>nul", no_arguments)
    var compiled = compile.run()
    var only_formats = only_formatting(wanted)
    if compiled == 0 and not only_formats {
        fail(folder, "it compiled, and it must fail")
        return
    }
    var output = compile.read_output_as_string()
    crash output
    var moved = in_the_folder(output, copy, folder)
    var errors = cleaned(moved)
    if not wanted.starts_with("formatted ") {
        errors = without_formatting(errors)
    }
    if not matches(errors, wanted) {
        fail(folder, "the errors differ\n  expected: {wanted}\n  got:      {errors}")
        return
    }
    if only_formats {
        check_formatted_once(folder, copy, flags)
        return
    }
    passed = passed + 1
}

func built_only(folder: String): String {
    var flags = optional_text(folder, "flags.txt")
    if flags.contains("--check") or flags.contains("--build") {
        return flags
    }
    return "{flags} --build"
}

func check_formatted_once(folder: String, copy: String, flags: String) {
    var no_arguments = List<String>()
    var again = Process("{compiler} {copy} {flags} 2>&1 1>nul", no_arguments)
    var compiled = again.run()
    var output = again.read_output_as_string()
    crash output
    var moved = in_the_folder(output, copy, folder)
    var printed = cleaned(moved)
    if compiled != 0 or not printed.is_empty() {
        fail(folder, "compiling the formatted program again did not pass silently: {printed}")
        return
    }
    passed = passed + 1
}

func only_formatting(wanted: String): Boolean {
    var lines = wanted.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        fallback line.starts_with("formatted ")
        index = index + 1
    }
    return true
}

func without_formatting(errors: String): String {
    var lines = errors.split("\n")
    var kept = List<String>()
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if not line.starts_with("formatted ") and not line.starts_with("fetched ") {
            kept.append(line)
        }
        index = index + 1
    }
    return kept.join("\n")
}

func copy_of(folder: String): String? {
    var directory = Directory(folder)
    var name = directory.folder_name
    var copies = copies_folder
    if folder.starts_with("conformance/") {
        copies = "{copies_folder}_conformance"
    }
    var copy = "{copies}/{name}"
    var windows_folder = folder.replace("/", "\\")
    var windows_copy = copy.replace("/", "\\")
    var no_arguments = List<String>()
    var copying = Process(
        "robocopy {windows_folder} {windows_copy} /MIR /XD .spite /NFL /NDL /NJH /NJS /NP 2>&1",
        no_arguments,
    )
    var copied = copying.run()
    crash copied
    if copied >= 8 {
        var output = copying.read_output_as_string()
        crash output
        fail(
            folder,
            "it could not be copied into {copy}, which the compiler formats instead of the checked-in files: {output}",
        )
        return null
    }
    return copy
}

func build_moved_back(copy: String, folder: String): Boolean {
    var windows_copy = copy.replace("/", "\\")
    var windows_folder = folder.replace("/", "\\")
    var no_arguments = List<String>()
    var moving = Process(
        "robocopy {windows_copy}\\.spite\\build {windows_folder}\\.spite\\build /MIR /NFL /NDL /NJH /NJS /NP 2>&1",
        no_arguments,
    )
    var moved = moving.run()
    crash moved
    if moved >= 8 {
        var output = moving.read_output_as_string()
        crash output
        fail(folder, "its build could not be copied back from {copy}: {output}")
        return false
    }
    return true
}

func in_the_folder(output: String, copy: String, folder: String): String {
    var windows_copy = copy.replace("/", "\\")
    var windows_folder = folder.replace("/", "\\")
    var forward = output.replace(copy, folder)
    return forward.replace(windows_copy, windows_folder)
}

func expected_text(folder: String, name: String): String? {
    var file = File("{folder}/{name}")
    var text = file.read_as_string()
    if not text {
        fail(folder, "it has no {name}")
        return null
    }
    return cleaned(text)
}

func executable_of(folder: String): String {
    var directory = Directory(folder)
    var name = directory.folder_name
    var windows_folder = folder.replace("/", "\\")
    return "{windows_folder}\\.spite\\build\\{name}.exe"
}

func matches(got: String, wanted: String): Boolean {
    var got_lines = got.split("\n")
    var wanted_lines = wanted.split("\n")
    fallback got_lines.count() == wanted_lines.count()
    var index = 0
    while index < wanted_lines.count() {
        var wanted_line = wanted_lines[index]
        var got_line = got_lines[index]
        crash got_line
        fallback line_matches(got_line, wanted_line)
        index = index + 1
    }
    return true
}

func line_matches(got: String, wanted: String): Boolean {
    if not wanted.contains("...") {
        return got == wanted
    }
    var pieces = wanted.split("...")
    var first = pieces[0]
    crash first
    fallback got.starts_with(first)
    var at = first.length()
    var index = 1
    while index < pieces.count() {
        var piece = pieces[index]
        var got_length = got.length()
        var rest = got.slice(at, got_length)
        crash rest
        var found = rest.index_of(piece)
        if index == pieces.count() - 1 {
            return rest.ends_with(piece)
        }
        fallback found
        at = at + found + piece.length()
        index = index + 1
    }
    return true
}

func cleaned(text: String): String {
    var without_returns = text.replace("\r", "")
    return without_returns.trim()
}

func fail(folder: String, why: String) {
    failed_folders.append(folder)
    console.print("FAILED {folder}: {why}")
    failed = failed + 1
}
