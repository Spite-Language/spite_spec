func if_not_after_an_earlier_attribute(rack: Rack, alias: Rack) {
    fallback rack.shelf.item
    var empty = Shelf()
    alias.shelf = empty
    if not rack.shelf.item {
        console.print("skipped")
        return
    }
    console.print(rack.shelf.item.number)
}

