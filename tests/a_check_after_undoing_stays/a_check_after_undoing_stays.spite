var kept: Shelf? = null
var console = Console()

func ACheckAfterUndoingStays() {
    console.print("fallback_after_an_earlier_attribute")
    var rack_0 = filled_rack()
    fallback_after_an_earlier_attribute(rack_0, rack_0)
    console.print("fallback_after_the_last_attribute")
