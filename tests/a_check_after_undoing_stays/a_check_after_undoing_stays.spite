func a_class_test_after_checking_again(holder: Holder, alias: Holder) {
    fallback holder.figure
    fallback holder.figure.class == Circle
    var square = Square()
    alias.figure = square
    fallback holder.figure
    if holder.figure.class == Circle {
        console.print("a circle")
    } else {
        console.print("not a circle")
    }
}

func a_link_checked_again(rack: Rack, alias: Rack) {
    fallback rack.held
    fallback rack.held.item
    alias.held = null
    fallback rack.held
    fallback rack.held.item
    console.print(rack.held.item.number)
}

func a_check_inside_a_loop(rack: Rack, alias: Rack) {
    fallback rack.shelf.item
    var empty = Shelf()
    var passes = 0
    while passes < 2 {
        fallback rack.shelf.item
        console.print(rack.shelf.item.number)
        alias.shelf = empty
        passes = passes + 1
    }
}

func a_copy_keeps_its_value(rack: Rack, alias: Rack) {
    var held = rack.shelf.item
    fallback held
    var empty = Shelf()
    alias.shelf = empty
    console.print(held.number)
}

func filled_rack(): Rack {
    var rack = Rack()
    var first = Item()
    var filled = Shelf()
    filled.item = first
    rack.shelf = filled
    rack.held = filled
    return rack
}

func replace(alias: Rack) {
    var empty = Shelf()
    alias.shelf = empty
}

func forget(alias: Rack) {
    alias.shelf.item = null
}
