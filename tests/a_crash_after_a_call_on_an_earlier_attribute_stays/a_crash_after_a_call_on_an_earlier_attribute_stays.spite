var console = Console()

func ACrashAfterACallOnAnEarlierAttributeStays() {
    load "../../../spite_standard_library/windows"
    var rack = Rack()
    var first = Item()
    var filled = Shelf()
    filled.item = first
    rack.shelf = filled
    show(rack, rack)
    console.print("never")
}

func show(rack: Rack, alias: Rack) {
    fallback rack.shelf.item
    replace(alias)
    console.print("before")
    crash rack.shelf.item
    console.print(rack.shelf.item.number)
}

func replace(alias: Rack) {
    var empty = Shelf()
    alias.shelf = empty
}
