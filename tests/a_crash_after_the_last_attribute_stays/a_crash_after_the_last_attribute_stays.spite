var console = Console()

func ACrashAfterTheLastAttributeStays() {
    var rack = Rack()
    var first = Item()
    var filled = Shelf()
    filled.item = first
    rack.shelf = filled
    show(rack, rack)
    console.print("never")
}

func show(rack: Rack, alias: Rack) {
    fallback rack.shelf.item
    alias.shelf.item = null
    console.print("before")
    crash rack.shelf.item
    console.print(rack.shelf.item.number)
}
