union Pet {
    Cat
    Dog
}

union Patient {
    Cat
    Dog
    Bird
}

var console = Console()

func AListIsCastToAWiderList() {
    load "../../../spite_standard_library/windows"
    var healths = List<Health>()
    var first = Health()
    healths.append(first)
    var second = Health()
    second.points = 7
    healths.append(second)
    var shown = show(healths)
    console.print("anything", shown)
    var added = add_one(healths)
    var kept = healths.count()
    console.print("added to the cast list", added, "kept", kept)
    var maybe = maybe_points(healths)
    console.print("maybe", maybe)
    var numbers = [3, 4]
    var longs = long_sum(numbers)
    console.print("longs", longs)
    var boxed = show(numbers)
    console.print("numbers as anything", boxed)
    var pets = List<Pet>()
    var cat = Cat()
    pets.append(cat)
    var seen = see_all(pets)
    console.print("patients", seen)
    var shelves = List<List<Health>>()
    shelves.append(healths)
    var stacked = count_inside(shelves)
    console.print("nested", stacked)
}

func show(items: List<Anything>): String {
    var names = List<String>()
    var index = 0
    while index < items.count() {
        var item = items[index]
        names.append(item.class.name)
        index = index + 1
    }
    return names.join(" ")
}

func add_one(items: List<Anything>): Integer {
    var other = Cat()
    items.append(other)
    return items.count()
}

func maybe_points(items: List<Health?>): Integer {
    var total = 0
    var index = 0
    while index < items.count() {
        var item = items[index]
        if item {
            total = total + item.points
        }
        index = index + 1
    }
    return total
}

func long_sum(values: List<Long>): Long {
    var total: Long = 0
    var index = 0
    while index < values.count() {
        var value = values[index]
        crash value
        total = total + value
        index = index + 1
    }
    return total
}

func see_all(patients: List<Patient>): Integer {
    return patients.count()
}

func count_inside(shelves: List<List<Anything>>): Integer {
    var shelf = shelves[0]
    crash shelf
    return shelf.count()
}
