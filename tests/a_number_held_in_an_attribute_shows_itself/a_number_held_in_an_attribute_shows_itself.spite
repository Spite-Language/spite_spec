var console = Console()

func ANumberHeldInAnAttributeShowsItself() {
    var edges = Edges()
    edges.attributes.each(show)
    var flag = edges.attributes["low_boolean"]
    var said = flag.value.to_string()
    console.print(said, edges.low_boolean)
}

func show(found: Spite.Attribute<Console.Printable>) {
    fallback not found.name.starts_with("_")
    var narrowed = found.value.to_string()
    console.print(found.name, narrowed, "held {found.value}")
}
