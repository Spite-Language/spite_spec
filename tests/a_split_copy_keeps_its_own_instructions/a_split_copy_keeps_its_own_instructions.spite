var console = Console()
var library = DynamicLibrary(
    "ucrtbase.dll",
    "",
    {
        "long_magnitude": DynamicLibrary.FunctionDeclaration("labs", [DynamicLibrary.Argument("value", Integer)], Integer)
        "magnitude": DynamicLibrary.FunctionDeclaration("abs", [DynamicLibrary.Argument("value", Integer)], Integer)
    },
)
var _ten = 10

func ASplitCopyKeepsItsOwnInstructions() {
    var plain = Meter(false)
    var squared = Meter(true)
    var start = long_magnitude(-1)
    measure(start, plain)
    measure(start, squared)
    console.print(plain.total, squared.total)
}

func measure(start: Integer, meter: Meter) {
    var index = start
    while index < _ten {
        var negative = 0 - index
        var size = magnitude(negative)
        if meter.is_squared {
            meter.total = meter.total + size * size
        } else {
            meter.total = meter.total + size
        }
        index = index + 1
    }
}

func long_magnitude(value: Integer): Integer {
    var call = DynamicLibrary.Call(library.functions["long_magnitude"])
    call.arguments["value"] = value
    return call.call()
}

func magnitude(value: Integer): Integer {
    var call = DynamicLibrary.Call(library.functions["magnitude"])
    call.arguments["value"] = value
    return call.call()
}
