var balance = 0
var history = List<String>()
var owner: String

func Account(starting_owner: String) {
    owner = starting_owner
}

func set_balance(new_balance: Integer) {
    if new_balance < 0 {
        history.append("rejected {new_balance}")
        return
    }
    attributes["balance"].value = new_balance
    history.append("balance {new_balance}")
}

func get_owner(): String {
    return "owner:{attributes["owner"].value}"
}

func set_attribute(attribute: Spite.AttributeDeclaration, value: attribute.class) {
    attributes[attribute].value = value
    history.append("set {attribute.name}")
}
