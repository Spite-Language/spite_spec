var console = Console()

func AnOrOfClassTestsNarrows() {
    var badge = Badge("gold")
    var hero = Hero("ada", badge, 3)
    hero.attributes.each(show_text)
    hero.attributes.each(show_held)
    console.print("level", hero.level)
    var number = 4
    var counted = Holder(number)
    counted.show()
    var named = Holder("text")
    named.show()
    var flagged = Holder(true)
    flagged.show()
    var pen = Pen()
    pen.draw()
}

func show_text(attribute: Spite.Attribute<String>) {
    console.print(attribute.name, attribute.value)
}

func show_held(attribute: Spite.Attribute<Badge>) {
    var value = attribute.value
    var shown = "skipped"
    if value.class == String or value.class == Badge {
        shown = value
    }
    console.print(attribute.name, shown)
}
