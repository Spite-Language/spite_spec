type Held {
    to_debug: Spite.Function<String>
}

var console = Console()
var held: Held

func Holder(starting_held: Held) {
    held = starting_held
}

func show() {
    if held.class == String or held.class == Integer {
        var shown: String = held
        console.print("text or number", shown)
    } else {
        console.print("neither")
    }
}
