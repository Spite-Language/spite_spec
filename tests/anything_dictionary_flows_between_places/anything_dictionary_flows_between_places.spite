var console = Console()

func AnythingDictionaryFlowsBetweenPlaces() {
    var bag = Bag()
    var held = bag.values
    held["one"] = 1
    var runner = Runner(counted)
    var count = runner.run(bag)
    console.print(count)
}

func counted(values: Dictionary<String, Anything?>): Integer {
    return values.count()
}
