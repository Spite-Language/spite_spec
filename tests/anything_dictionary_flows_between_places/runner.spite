var _counter: Spite.Function<Dictionary<String, Anything?>, Integer>

func Runner(starting_counter: Spite.Function<Dictionary<String, Anything?>, Integer>) {
    _counter = starting_counter
}

func run(bag: Bag): Integer {
    var values = bag.passed()
    return through(values)
}

func through(values: Dictionary<String, Anything?>): Integer {
    var counter = _counter
    return counter(values)
}
