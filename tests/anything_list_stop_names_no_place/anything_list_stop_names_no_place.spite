var console = Console()
var _past_the_end = 4

func AnythingListStopNamesNoPlace() {
    var held = List<Anything?>()
    held.append(1)
    var position = held.count() + _past_the_end
    console.print("before")
    held.remove_at(position)
    var counted = held.count()
    console.print(counted)
}
