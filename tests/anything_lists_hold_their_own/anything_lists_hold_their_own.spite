var console = Console()

func AnythingListsHoldTheirOwn() {
    var crates = List<Anything?>()
    var crate = Crate()
    crates.append(crate)
    var gauges = List<Anything?>()
    var gauge = Gauge()
    gauges.append(gauge)
    var shown = gauges.last()
    console.print("last {shown}")
    var kept = kept_with_another(gauges)
    print_each(kept)
    var crate_count = crates.count()
    console.print(crate_count)
    var count_it: Spite.Function<Anything?, Integer> = counted
    var count = count_it(crate)
    console.print(count)
    var show: Spite.Function<Anything?, String> = described
    var told = show(gauge)
    console.print(told)
}

func kept_with_another(given: List<Anything?>): List<Anything?> {
    var another = Gauge()
    given.append(another)
    return given
}

func print_each(items: List<Anything?>) {
    var index = 0
    while index < items.count() {
        var item = items[index]
        console.print("item {item}")
        index = index + 1
    }
}

func counted(value: Anything?): Integer {
    if value {
        return 1
    }
    return 0
}

func described(value: Anything?): String {
    return "described {value}"
}
