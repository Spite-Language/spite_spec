var console = Console()
var walked = List<String>()

func AnythingMembers() {
    var members = Anything.members
    var member_names = members.keys().join(" ")
    var instances = Spite.Class.instances.map_names()
    var instance_names = instances.join(" ")
    console.print("members", member_names)
    console.print("same as instances", member_names == instance_names)
    var empty = Nothing.members
    var empty_count = empty.count()
    console.print("nothing has", empty_count)
    Anything.members.each(visit)
    var walked_names = walked.join(" ")
    console.print("walked", walked_names)
    console.print("walked the same", walked_names == instance_names)
}

func visit(member: Spite.Class) {
    walked.append(member.name_with_namespaces)
}
