var console = Console()
var cells = List<Integer>()

func AreaGuardNegativeCounterHalts() {
    var filled = 0
    while filled < 6 {
        cells.append(filled * 10)
        filled = filled + 1
    }
    show(2, 3, 0)
    show(2, 3, -1)
}

func show(rows: Integer, stride: Integer, first_row: Integer) {
    crash rows * stride <= cells.count()
    var row = first_row
    while row < rows {
        var column = 0
        while column < stride {
            var cell: Integer = cells[row * stride + column]
            console.print(cell)
            column = column + 1
        }
        row = row + 1
    }
}
