var console = Console()
var environment = Environment()
var program = Program()

func Arsenal() {
    load "../../../spite_standard_library/windows"
    var arguments = program.arguments()
    var sword = Weapon<Integer, true>(10)
    sword.hit()
    if environment.name == "server" {
        console.print("environment is server")
    } else {
        console.print("environment is not server")
    }
    var player = program.argument_named("player")
    if player {
        console.print("player", player)
    }
    var arguments_count = arguments.count()
    console.print("argument count", arguments_count)
    var argument = arguments[0]
    crash argument
    console.print("first argument", argument)
}
