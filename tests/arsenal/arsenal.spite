var console = Console()
var environment = Environment()

func Arsenal() {
    load "../../../spite_standard_library/windows"
    var sword = Weapon<Integer, true>(10)
    sword.hit()
    if environment.name == "server" {
        console.print("environment is server")
    } else {
        console.print("environment is not server")
    }
    if not environment.player.is_empty() {
        console.print("player", environment.player)
    }
}
