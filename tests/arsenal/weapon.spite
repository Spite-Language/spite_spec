generic $damage_type

var console = Console()
var is_magic: Boolean
var damage: $damage_type

func Weapon(new_damage: $damage_type, magic: Boolean) {
    damage = new_damage
    is_magic = magic
}

func hit() {
    if is_magic {
        console.print("magic hit for", damage)
    } else {
        console.print("normal hit for", damage)
    }
}
