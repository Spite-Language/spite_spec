var loaded = List<String>()

func load_each(path: String, into: List<String>) {
    var file_path: Path? = path
    crash file_path
    var file = File(file_path)
    var text = file.read_as_string()
    fallback text
    into.append(path)
    loaded.append(text)
}

func tick_each(amount: Integer) {
    loaded.append("tick {amount}")
}
