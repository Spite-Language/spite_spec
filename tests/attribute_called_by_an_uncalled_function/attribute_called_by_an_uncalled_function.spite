var console = Console()

func AttributeCalledByAnUncalledFunction() {
    var chore = Chore.Chore(three)
    var said = chore.name()
    console.print(said)
}

func three(): Integer {
    return 3
}

func unused(callback: Spite.Function<Integer>, chore: Chore.Chore): Boolean {
    var answer = callback()
    var done = chore.job()
    return answer > done
}
