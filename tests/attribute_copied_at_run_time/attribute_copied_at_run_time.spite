var console = Console()

func AttributeCopiedAtRunTime() {
    var source = Button()
    source.label = "go"
    source.clicks = 3
    source.part = Gadget("shiny")
    source.spare = Gadget("extra")
    source.on_press = pressed
    source.hide("changed")
    var target = Button()
    copy_every_attribute(source, target)
    var secret = target.secret()
    console.print(target.label, target.clicks, target.part.name, secret)
    show_the_spare(target)
    press_it(target)
    source.part.name = "shared"
    console.print("same part", target.part.name)
    clear_every_attribute(target)
    if target.spare {
        console.print("spare held")
    } else {
        console.print("spare cleared")
    }
    if target.on_press {
        console.print("on_press held")
    } else {
        console.print("on_press cleared")
    }
}

func show_the_spare(target: Button) {
    fallback target.spare
    console.print("spare", target.spare.name)
}

func press_it(target: Button) {
    var action: Spite.Function<Nothing> = nothing_pressed
    if target.on_press {
        action = target.on_press
    }
    action()
}

func nothing_pressed() {
    console.print("nothing pressed")
}

func pressed() {
    console.print("pressed")
}

func copy_every_attribute(source: Anything, target: Anything) {
    var from = source.attributes.values()
    var into = target.attributes
    var index = 0
    while index < from.count() {
        var attribute = from[index]
        var destination = into[attribute.name]
        crash destination
        destination.value = attribute.value
        index = index + 1
    }
}

func clear_every_attribute(target: Anything) {
    var held = target.attributes.values()
    var index = 0
    while index < held.count() {
        var attribute = held[index]
        if attribute.name == "spare" or attribute.name == "on_press" {
            attribute.value = null
            if not attribute.value {
                console.print(attribute.name, "now empty")
            }
        }
        index = index + 1
    }
}
