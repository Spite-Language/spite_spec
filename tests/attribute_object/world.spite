var building = Entity()

func create_entity(): Entity {
    return Entity()
}

func create_entity_from_bundle(bundle: PlayerBundle): Entity {
    var entity = create_entity()
    building = entity
    bundle.attributes.each(add_to_the_entity)
    return entity
}

func add_to_the_entity(attribute: Spite.Attribute<Entity.Component>) {
    building.add_component(attribute.value)
}
