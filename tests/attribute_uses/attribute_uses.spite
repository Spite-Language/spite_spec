var console = Console()
var lamp = Lamp()
var shelf = Shelf()

func AttributeUses() {
    var lines = List<String>()
    show_attributes(lamp, lines)
    var joined = lines.join(", ")
    console.print(joined)
    var first = shelf.attributes["books"]
    var first_text = text_of(first)
    console.print(first.name, first_text)
}

func show_attribute(attribute: Spite.AttributeDeclaration, shown: Lamp, lines: List<String>) {
    lines.append("{attribute.name} = {shown.attributes[attribute].value}")
}

func text_of(attribute: Spite.Attribute<Integer>): String {
    return attribute.value.to_string()
}
