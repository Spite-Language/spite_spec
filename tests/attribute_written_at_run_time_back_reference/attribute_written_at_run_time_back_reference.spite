var console = Console()

func AttributeWrittenAtRunTimeBackReference() {
    visit()
    console.print("the family is gone")
}

func visit() {
    var first = Parent("ada")
    var second = Parent("lin")
    first.adopt("grace")
    second.adopt("ida")
    var grace = first.children.first()
    crash grace
    var ida = second.children.first()
    crash ida
    copy_every_attribute(grace, ida)
    crash ida.parent
    console.print(ida.name, "now names", ida.parent.name)
}

func copy_every_attribute(source: Anything, target: Anything) {
    var from = source.attributes.values()
    var into = target.attributes
    var index = 0
    while index < from.count() {
        var attribute = from[index]
        var destination = into[attribute.name]
        crash destination
        destination.value = attribute.value
        index = index + 1
    }
}
