var console = Console()

func AttributeWrittenAtRunTimeCasts() {
    var meter = Meter()
    write_by_name(meter)
    console.print(meter.reading, meter.whole, meter.shown, meter.answer)
}

func write_by_name(held: Meter) {
    var attributes = held.attributes
    var reading = attributes["reading"]
    crash reading
    reading.value = 7
    var whole = attributes["whole"]
    crash whole
    whole.value = 2.75
    var shown = attributes["shown"]
    crash shown
    shown.value = 42
    var answer = attributes["answer"]
    crash answer
    answer.value = true
}
