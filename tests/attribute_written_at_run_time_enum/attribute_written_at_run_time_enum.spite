enum Mood {
    'calm'
    'loud'
}

var console = Console()

func AttributeWrittenAtRunTimeEnum() {
    var meter = Meter()
    var mood: Mood = 'loud'
    write_label(meter, mood)
    console.print(meter.label)
}

func write_label(held: Meter, given: Mood) {
    var label = held.attributes["label"]
    crash label
    label.value = given
}
