type Given {
    to_debug: Spite.Function<String>
}

var console = Console()

func AttributeWrittenAtRunTimeMisfit() {
    var meter = Meter()
    var five = 5
    var yes = true
    write_named(meter, "whole", five)
    write_named(meter, "flag", yes)
    console.print(meter.whole, meter.flag)
    write_named(meter, "whole", yes)
    console.print("whole", meter.whole)
}

func write_named(held: Meter, name: String, given: Given) {
    var attributes = held.attributes
    var found = attributes[name]
    crash found
    found.value = given
}
