var console = Console()

func AttributeWrittenAtRunTimeNull() {
    var meter = Meter()
    var nothing: Integer? = null
    write_whole(meter, nothing)
    console.print("whole", meter.whole)
}

func write_whole(held: Meter, given: Integer?) {
    var attributes = held.attributes
    var whole = attributes["whole"]
    crash whole
    whole.value = given
}
