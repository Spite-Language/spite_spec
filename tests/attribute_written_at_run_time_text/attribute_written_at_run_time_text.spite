type Given {
    to_debug: Spite.Function<String>
}

var console = Console()

func AttributeWrittenAtRunTimeText() {
    var meter = Meter()
    var reading = Reading()
    write_label(meter, reading)
    console.print(meter.label)
    var whole = 4
    write_label(meter, whole)
    console.print(meter.label)
    write_ratio(meter, whole)
    console.print(meter.ratio)
}

func write_label(held: Meter, given: Given) {
    var attributes = held.attributes
    var label = attributes["label"]
    crash label
    label.value = given
}

func write_ratio(held: Meter, given: Integer) {
    var ratio = held.attributes["ratio"]
    crash ratio
    ratio.value = given
}
