var console = Console()

func AttributeWrittenPinnedThroughLocals() {
    var thing = Thing()
    var gadget = Gadget()
    var widget = Widget()
    write_both(thing, widget, gadget)
    console.print(thing.held)
    show_other(thing)
}

func show_other(thing: Thing) {
    fallback thing.other
    console.print("other is set")
}

func write_both(thing: Thing, shown: Widget, kept: Gadget) {
    var attributes = thing.attributes
    var held = attributes["held"]
    crash held
    held.value = shown
    var chosen = [thing.attributes["other"]]
    var other = chosen[0]
    crash other
    other.value = kept
}
