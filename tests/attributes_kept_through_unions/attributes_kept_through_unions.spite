union Figure {
    Circle
    Square
}

var console = Console()
var program = Program()

func AttributesKeptThroughUnions() {
    load "../../../spite_standard_library/windows"
    var circle = Circle()
    var figure: Figure = circle
    var square = Square()
    add_up(figure, 1000)
    add_up(square, 10)
    console.print(circle.total, square.total, circle.radius)
    var union_away = accesses_away_from_calls("function AttributesKeptThroughUnions.add_up:", "bits_32 at r")
    console.print("accesses in the loop away from its calls:", union_away)
}

func add_up(figure: Figure, limit: Integer) {
    var step = 0
    while step < limit {
        figure.add(step)
        step = step + 1
    }
}

func accesses_away_from_calls(heading: String, marker: String): Integer {
    var path = program.executable_path()
    crash path
    var low_path = path.replace(".exe", ".low_ir.txt")
    var written_path: Path? = low_path
    crash written_path
    var written = File(written_path).read_as_string()
    crash written
    var lines = written.split("\n")
    var in_the_function = false
    var block_accesses = 0
    var block_calls = false
    var block_ends = false
    var block_first = false
    var away = 0
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var starts_a_block = line.starts_with("  block ")
        if line.starts_with("function ") or starts_a_block {
            if in_the_function and not block_calls and not block_ends and not block_first {
                away = away + block_accesses
            }
            block_accesses = 0
            block_calls = false
            block_ends = false
            block_first = line == "  block 0"
        }
        if line.starts_with("function ") {
            in_the_function = line.starts_with(heading)
        } else if in_the_function {
            if line.contains(marker) {
                block_accesses = block_accesses + 1
            }
            if line.contains("(") {
                block_calls = true
            }
            if line.contains("return") or line.contains("stop with") {
                block_ends = true
            }
        }
        index = index + 1
    }
    if in_the_function and not block_calls and not block_ends and not block_first {
        away = away + block_accesses
    }
    return away
}
