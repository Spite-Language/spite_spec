var name = ""
var players = List<Player>()
var console = Console()

func Team(new_name: String) {
    name = new_name
}

func sign(player: Player) {
    enlist(player)
    player.play_for(this)
}

func enlist(player: Player) {
    enroll(player)
}

func enroll(player: Player) {
    admit(player)
}

func admit(player: Player) {
    recruit(player)
}

func recruit(player: Player) {
    players.append(player)
}

func drop() {
    console.print(name, "is freed")
}
