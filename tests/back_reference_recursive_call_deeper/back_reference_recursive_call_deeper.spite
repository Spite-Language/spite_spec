var console = Console()

func BackReferenceRecursiveCallDeeper() {
    hold_a_chain()
    console.print("the chain is out of reach")
}

func hold_a_chain() {
    var head = Link("ay")
    var middle = Link("be")
    var last = Link("ce")
    head.next = middle
    middle.next = last
    pair(head)
    var last_first = last.first
    crash last_first.beta
    crash last_first.beta.alpha
    console.print(
        last_first.name,
        "holds",
        last_first.beta.name,
        "and",
        last_first.beta.name,
        "holds",
        last_first.beta.alpha.name,
    )
}

func pair(head: Link) {
    var second = Beta("bee")
    pair_down(head, second, 2)
}

func pair_down(link: Link, second: Beta, steps: Integer) {
    if steps == 0 {
        link.first.beta = second
        second.alpha = link.first
        return
    }
    crash link.next
    pair_down(link.next, second, steps - 1)
}
