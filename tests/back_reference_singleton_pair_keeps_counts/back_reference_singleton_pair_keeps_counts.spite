var console = Console()
var clerk = Clerk()

func BackReferenceSingletonPairKeepsCounts() {
    load "../../../spite_standard_library/windows"
    link()
    console.print("linked pair is out of reach")
}

func link() {
    var desk = Desk()
    clerk.desk = desk
    desk.clerks.append(clerk)
    crash clerk.desk
    console.print(clerk.desk.number, desk.number)
}
