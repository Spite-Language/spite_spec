union Entry {
    Paper
    Folder
}

var entries = List<Entry>()
var console = Console()
var name: String

func Folder(new_name: String) {
    name = new_name
}

func add_file(paper_name: String) {
    var paper = Paper(paper_name, this)
    entries.append(paper)
    paper.describe()
}

func drop() {
    console.print(name, "is freed")
}
