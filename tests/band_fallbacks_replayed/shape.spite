var total = 0
var _corner_count = 40
var _kinds = 11
var seed: Integer
var weights: Weights

func Shape(starting_seed: Integer, starting_weights: Weights) {
    seed = starting_seed
    weights = starting_weights
}

func settle() {
    var made = List<Corner>()
    var step = 0
    while step < _corner_count {
        var weight = weights.weight_at(step)
        var corner = Corner(step * seed % 97, weight)
        made.append(corner)
        step = step + 1
    }
    var sum = made.sum_weighed()
    var kind = seed % _kinds
    var noted = noted_kind(kind)
    total = total + sum % 1000 + noted
}

func noted_kind(kind: Integer): Integer {
    fallback kind != 3
    fallback kind != 5
    fallback kind % 2 == 0 or kind == 1
    return kind
}
