var console = Console()
var _element_count = 20000

func BandFallbacksTraced() {
    var weights = Weights()
    var shapes = List<Shape>()
    var index = 0
    while index < _element_count {
        var shape = Shape(index, weights)
        shapes.append(shape)
        index = index + 1
    }
    console.print("walked")
    shapes.each_settle()
    var settled = shapes.sum_total()
    console.print("settled:", settled)
    var position = 0
    while position < shapes.count() {
        var held = shapes[position]
        held.settle()
        held.mark(position)
        position = position + 1
    }
    var looped = shapes.sum_total()
    console.print("looped:", looped)
}
