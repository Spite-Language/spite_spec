var total = 0
var place = 0
var _corner_count = 40
var _rare = 997
var _second_rare = 500
var seed: Integer
var weights: Weights

func Shape(starting_seed: Integer, starting_weights: Weights) {
    seed = starting_seed
    weights = starting_weights
}

func settle() {
    var made = List<Corner>()
    var step = 0
    while step < _corner_count {
        var weight = weights.weight_at(step)
        var corner = Corner(step * seed % 97, weight)
        made.append(corner)
        step = step + 1
    }
    var sum = made.sum_weighed()
    var noted = noted_seed()
    total = total + sum % 1000 + noted
}

func mark(position: Integer) {
    place = position
    total = total + place % 3
}

func noted_seed(): Integer {
    fallback seed % _rare != 3
    fallback seed % _rare != _second_rare
    return 1
}
