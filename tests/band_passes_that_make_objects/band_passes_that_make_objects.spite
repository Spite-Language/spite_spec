var console = Console()
var _element_count = 20000

func BandPassesThatMakeObjects() {
    var weights = Weights()
    var shapes = List<Shape>()
    var index = 0
    while index < _element_count {
        var shape = Shape(index, weights)
        shapes.append(shape)
        index = index + 1
    }
    shapes.each_settle()
    var settled = shapes.sum_total()
    console.print("settled:", settled)
    var first = shapes.first()
    crash first
    var first_corners = first.corners.count()
    console.print("first weight:", first.weight_sum, "first corners:", first_corners)
    var last = shapes.last()
    crash last
    var last_corners = last.corners.count()
    console.print("last weight:", last.weight_sum, "last corners:", last_corners)
    shapes.append(first)
    shapes.each_settle()
    var held_twice = shapes.sum_total()
    console.print("one shape held twice:", held_twice)
    var round = 0
    while round < 3 {
        shapes.each_settle()
        round = round + 1
    }
    var rounds = shapes.sum_total()
    console.print("three more rounds:", rounds, "round:", round)
}
