var total = 0
var _corner_count = 40
var journal = Journal()
var rules = Rules()
var seed: Integer
var weights: Weights

func Shape(starting_seed: Integer, starting_weights: Weights) {
    seed = starting_seed
    weights = starting_weights
}

func settle() {
    var made = List<Corner>()
    var step = 0
    while step < _corner_count {
        var weight = weights.weight_at(step)
        var corner = Corner(step * seed % 97, weight)
        made.append(corner)
        step = step + 1
    }
    var sum = made.sum_weighed()
    total = total + sum % 1000
    var kind = rules.kind_of(seed)
    if kind == 0 {
        journal.note("a multiple of seven")
    } else if kind < 3 {
        journal.note("just past seven")
    } else {
        journal.note("the rest")
    }
}
