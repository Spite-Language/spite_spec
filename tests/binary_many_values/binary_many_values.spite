var console = Console()

func BinaryManyValues() {
    load "../../../spite_standard_library/windows"
    var points = List<Point>()
    var first = Point()
    first.across = 3
    points.append(first)
    var second = Point()
    second.across = 8
    points.append(second)
    var writer = BinaryWriter<List<Point>>()
    var frame = writer.write(points)
    var reader = BinaryReader<List<Point>>()
    var read = reader.read(frame)
    crash read
    crash read.count() == 2
    var single = BinaryReader<Point>()
    var whole = single.read(frame)
    console.print(read[0].across, read[1].across, not whole)
}
