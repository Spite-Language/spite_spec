var console = Console()

func BufferPositionReads() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var bytes = Buffer(0)
    bytes.append_integer_little_endian(5)
    bytes.append_short_big_endian(258)
    bytes.append(1)
    var first = bytes.read_integer_little_endian()
    var after_first = bytes.position
    var second = bytes.read_short_big_endian()
    var left = bytes.remaining()
    var too_wide = bytes.read_integer_little_endian()
    var still = bytes.position
    var last = bytes.read_byte()
    var at_end = bytes.remaining()
    console.print(first, after_first, second, left, too_wide, still, last, at_end)
}
