var console = Console()

func BufferReadRuns() {
    load "../../../spite_standard_library/windows"
    var bytes = Buffer(0)
    bytes.append(10)
    bytes.append(20)
    bytes.append(30)
    var front = bytes.read_buffer_at(0, 2)
    crash front
    var front_count = front.count()
    var anywhere = bytes.read_buffer_at(1, 2)
    crash anywhere
    var anywhere_first = anywhere[0]
    var outside = bytes.read_buffer_at(2, 2)
    console.print(front_count, anywhere_first, not outside)
    var copied = Buffer(0)
    copied.append_buffer(bytes, 1, 2)
    var copied_count = copied.count()
    var copied_last = copied[1]
    console.print(copied_count, copied_last)
}
