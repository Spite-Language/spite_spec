var console = Console()

func BufferTextRuns() {
    load "../../../spite_standard_library/windows"
    var word = "héllo"
    var bytes = word.to_buffer()
    var count = bytes.count()
    var whole = bytes.read_string_at(0, 6)
    var cut = bytes.read_string_at(0, 2)
    var tail = bytes.read_string_at(3, 3)
    console.print(count, whole, cut, tail)
    var outside = bytes.read_string_at(4, 9)
    console.print("never printed", outside)
}
