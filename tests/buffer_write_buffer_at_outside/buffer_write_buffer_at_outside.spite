var console = Console()

func BufferWriteBufferAtOutside() {
    var table = Buffer()
    table.append_string("abcd")
    var patch = Buffer()
    patch.append_string("XY")
    table.write_buffer_at(2, patch, 0, 2)
    var text = table.read_as_string()
    console.print(text)
    table.write_buffer_at(3, patch, 0, 2)
    console.print("never printed")
}
