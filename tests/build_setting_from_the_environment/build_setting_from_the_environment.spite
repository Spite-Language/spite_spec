var console = Console()
var program = Program()
var folder = ".spite/volumed"

func BuildSettingFromTheEnvironment() {
    load "../../../spite_standard_library/windows"
    write_the_program()
    var variables = Dictionary<String, String>()
    variables["VOLUME"] = "7"
    console.print("from the environment")
    compile_and_run(variables)
    var settings_path: Path? = "{folder}/.env"
    crash settings_path
    var settings = File(settings_path)
    crash settings.write_string("# the program's own Build field\nVOLUME = 9\n")
    console.print("from .env")
    var no_variables = Dictionary<String, String>()
    compile_and_run(no_variables)
    console.print("the environment over .env")
    compile_and_run(variables)
}

func compile_and_run(variables: Dictionary<String, String>) {
    var here = program.working_directory()
    crash here
    var compiler = "{here}\\..\\spite_compiler\\.spite\\spite.exe"
    var no_arguments = List<String>()
    var running = Process(compiler, no_arguments)
    running.working_directory = folder
    running.environment_variables = variables
    running.with_errors = true
    var code = running.run()
    crash code
    var printed_text = running.read_output_as_string()
    crash printed_text
    var printed = printed_text.trim()
    console.print(printed)
    console.print("exit code", code)
}

func write_the_program() {
    var made_path: Path? = folder
    crash made_path
    var made = Directory(made_path)
    if not made.exists() {
        crash made.create()
    }
    var lines = List<String>()
    lines.append("var console = Console()")
    lines.append("var build = Build()")
    lines.append("")
    lines.append("func Volumed() \{")
    lines.append("    console.print(\"volume\", build.volume)")
    lines.append("}")
    lines.append("")
    var entry_path: Path? = "{folder}/volumed.spite"
    crash entry_path
    var entry = File(entry_path)
    var joined = lines.join("\n")
    crash entry.write_string(joined)
    var settings_path_text: Path? = "{folder}/build.spite"
    crash settings_path_text
    var settings = File(settings_path_text)
    crash settings.write_string("var volume = 1\n")
    var stale_path: Path? = "{folder}/.env"
    crash stale_path
    var stale = File(stale_path)
    if stale.exists() {
        crash stale.remove()
    }
}
