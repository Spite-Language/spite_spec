var console = Console()
var server = Http.Server()
var listener = Tcp.Server()
var _http_port = 47915
var _tcp_port = 47916
var _udp_port = 47917
var _letter_h_code: Byte = 104
var _largest_byte: Byte = 255

func ByteHolders() {
    load "../../../spite_standard_library/windows"
    binary_body()
    split_character()
    datagram_text()
    process_output()
}

func binary_body() {
    crash server.listen_locally(_http_port)
    var loopback: IpAddress? = "127.0.0.1"
    crash loopback
    var asking = Tcp.Client()
    crash asking.connect(loopback, _http_port)
    var body = Buffer(0)
    body.append(_letter_h_code)
    body.append(_largest_byte)
    var head = "POST /bytes HTTP/1.1\r\nhost: 127.0.0.1\r\ncontent-length: 2\r\n\r\n"
    var request_bytes = head.to_buffer()
    request_bytes.append_buffer(body, 0, 2)
    crash asking.write_buffer(request_bytes)
    var serving = echo_one()
    var response = read_response(asking)
    asking.close()
    var as_text = response.read_body_as_string()
    var as_bytes = response.read_body_as_buffer()
    var byte_count = as_bytes.count()
    var last = as_bytes[1]
    crash last
    console.print("binary body: text", not as_text, "bytes", byte_count, "last", last, "served", serving)
    server.close()
}

func read_response(asking: Tcp.Client): Http.Response {
    var status_line = asking.read_line()
    crash status_line
    var body_length = 0
    var ended = false
    while not ended {
        var line = asking.read_line()
        crash line
        ended = line.is_empty()
        if line.starts_with("content-length: ") {
            var line_length = line.length()
            var length_text = line.slice(16, line_length)
            crash length_text
            var length: Integer? = length_text
            crash length
            body_length = length
        }
    }
    var received = Buffer(0)
    while received.count() < body_length {
        var more = asking.read_as_buffer()
        crash more
        var more_count = more.count()
        received.append_buffer(more, 0, more_count)
    }
    var response = Http.Response()
    response.write_body_buffer(received)
    return response
}

func echo_one(): Integer {
    var request = server.next_request()
    crash request
    var response = Http.Response()
    var body = request.read_body_as_buffer()
    response.write_body_buffer(body)
    crash server.respond(request, response)
    return 1
}

func split_character() {
    crash listener.listen_locally(_tcp_port)
    var sender = Tcp.Client()
    crash sender.connect_locally(_tcp_port)
    var character = "é".to_buffer()
    var first = Buffer(0)
    var second = Buffer(0)
    var lead = character[0]
    var rest = character[1]
    crash lead and rest
    first.append(lead)
    second.append(rest)
    crash sender.write_buffer(first)
    crash sender.write_buffer(second)
    var reading = read_one_string()
    console.print("a character sent in two writes reads as", reading)
    sender.close()
    listener.close()
}

func read_one_string(): String {
    var peer = listener.accept()
    crash peer
    var text = peer.read_as_string()
    crash text
    peer.close()
    return text
}

func datagram_text() {
    var receiving = Udp.Server()
    var sending = Udp.Client()
    crash receiving.open_locally(_udp_port)
    crash sending.open()
    var hello = "hello".to_buffer()
    var receiver: IpAddress? = "127.0.0.1"
    crash receiver
    crash sending.send_to(receiver, _udp_port, hello)
    var datagram = receiving.receive()
    crash datagram
    var text = datagram.read_as_string()
    crash text
    console.print("a datagram read as text:", text)
    receiving.close()
    sending.close()
}

func process_output() {
    var echoing = Process("cmd", ["/c", "echo", "ok"])
    crash echoing.run()
    var text = echoing.read_output_as_string()
    crash text
    var trimmed = text.trim()
    var bytes = echoing.read_output_as_buffer()
    crash bytes
    var byte_count = bytes.count()
    console.print("process output:", trimmed, byte_count)
}
