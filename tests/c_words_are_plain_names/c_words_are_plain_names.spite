var console = Console()
var destroy = 1
var discard = 2
var default = 3
var perform = 4
var hot = 5
var slot = 6
var waiting = 7
var read_count = 8

func CWordsArePlainNames() {
    load "../../../spite_standard_library/windows"
    var tool = Tool()
    var made = tool.allocate()
    var other = tool.make()
    var last = tool.release()
    console.print(destroy, discard, default, perform, hot, slot, waiting, read_count)
    console.print(made, other, last)
}
