var operator: Token.TokenKind = 'plus'
var left: Calculator.Expression? = null
var right: Calculator.Expression? = null

func BinaryExpression(
    starting_operator: Token.TokenKind,
    left_expression: Calculator.Expression,
    right_expression: Calculator.Expression,
) {
    operator = starting_operator
    left = left_expression
    right = right_expression
}
