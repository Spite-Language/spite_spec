var console = Console()

func CallAfterAReadInAStatementKeepsIt() {
    var rack = Rack()
    rack.item = Item()
    show(rack, rack)
}

func cleared_count(rack: Rack): Integer {
    rack.item = null
    return 0
}

func show(rack: Rack, alias: Rack) {
    fallback rack.item
    var held = rack.item
    held.number = cleared_count(alias)
    console.print("stored")
    rack.item = Item()
    var sum = rack.item.number + cleared_count(alias)
    console.print(sum)
}
