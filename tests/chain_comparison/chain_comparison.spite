var console = Console()

func ChainComparison() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var made = make("make")
    var nothing_made = make("")
    var first = is_make(made)
    var second = is_make(nothing_made)
    var third = not_make(nothing_made)
    console.print(first, second, third)
}

func make(kind: String): Order? {
    assert not kind.is_empty()
    var order = Order()
    order.kind = kind
    return order
}

func is_make(made: Order?): Boolean {
    return made.kind == "make"
}

func not_make(made: Order?): Boolean {
    return made.kind != "make"
}
