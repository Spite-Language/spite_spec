var console = Console()

func ChainLinks() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var total = 0
    var round = 0
    while round < 100 {
        var head = Link(0, null)
        var index = 1
        while index < 100 {
            var added = Link(index, head)
            head = added
            index = index + 1
        }
        var current: Link? = head
        while current {
            total = total + current.value
            current = current.next
        }
        round = round + 1
    }
    console.print("total", total)
}
