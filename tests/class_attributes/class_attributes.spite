var console = Console()

func ClassAttributes() {
    var declarations = Sticker.attributes.values()
    var index = 0
    while index < declarations.count() {
        var described = declarations[index]
        console.print(described.index, described.name, described.class)
        index = index + 1
    }
    var sticker = Sticker("pinned")
    sticker.attributes.each(show_value)
}

func show_value(attribute: Spite.Attribute<Console.Printable>) {
    var value_text = attribute.value.to_string()
    console.print(value_text)
}
