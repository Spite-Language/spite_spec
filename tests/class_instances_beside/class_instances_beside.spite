var console = Console()
var names = List<String>()

func ClassInstancesBeside() {
    load "../class_instances_beside/side"
    Spite.Class.instances.each(note)
    Spite.Class.instances.each(walk)
    var front = Front()
    var shown = front.render()
    crash not shown
    var joined = names.join(" ")
    console.print(joined)
}

func note(part: Spite.Class) {
    names.append(part.name_with_outer_classes)
}

func walk(space: Spite.Class) {
    names.append(space.name)
    space.nested_classes.each(note)
}
