enum Job {
    'farmer'
    'miner'
}

union Reward {
    Coin
    Gem
}

type Named {
    name: String
}

var trade: Job = 'miner'

func hire(player: Player, wanted: Player.Job) {
    player.job = wanted
}

func pay(player: Player, given: Reward) {
    player.reward = given
}

func meet(player: Player, stranger: Named) {
    player.greet(stranger)
}
