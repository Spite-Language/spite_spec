var console = Console()
var alpha = Part.Alpha()
var beta = Part.Beta()
var gamma = Part.Inner.Gamma()
var kept = List<Spite.Class>()

func ClassNameIsShort() {
    console.print(alpha.first, beta.second, gamma.third)
    var named = Part.Alpha.name
    var dotted = Part.Inner.Gamma.name_with_namespaces
    console.print(named, dotted)
    Part.classes.each(visit)
    Part.Inner.classes.each(visit)
    Spite.Namespace.instances.each(through)
    keep_a_class()
    Part.classes.each(hold_the_name)
}

func through(namespace: Spite.Namespace) {
    namespace.classes.each(visit)
}

func visit(item: Spite.Class) {
    console.print(item.name, item.name_with_namespaces, item)
}

func keep_a_class() {
    kept.append(Part.Beta)
    var item = kept[0]
    console.print(item.name, item.name_with_namespaces)
}

func hold_the_name(item: Spite.Class) {
    var holder = "{item.name}!"
    console.print(holder)
}
