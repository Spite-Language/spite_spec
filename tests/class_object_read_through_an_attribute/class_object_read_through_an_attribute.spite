var console = Console()
var program = Program()

func ClassObjectReadThroughAnAttribute() {
    var monster = Monster()
    monster.hit()
    console.print(monster.health)
    var keeper = Keeper()
    var named = keeper.held_name()
    var alone = keeper.held_alone()
    console.print(named, alone)
    var chooser = Chooser()
    chooser.choose(Keeper)
    var chosen = chooser.chosen_name()
    console.print(chosen)
    var text = high_text()
    var keeper_reads = function_holds("ClassObjectReadThroughAnAttribute.Keeper.held_name(", "Spite.Class.get_", text)
    var chooser_reads = function_holds("ClassObjectReadThroughAnAttribute.Chooser.chosen_name(", "Spite.Class.get_", text)
    console.print("Keeper reads its class object while it runs", keeper_reads)
    console.print("Chooser reads its class object while it runs", chooser_reads)
}

func high_text(): String {
    var path = program.executable_path()
    crash path
    var high_path = path.replace(".exe", ".high_ir.txt")
    var text_path: Path? = high_path
    crash text_path
    var text = File(text_path).read_as_string()
    crash text
    return text
}

func function_holds(function_key: String, wanted: String, text: String): Boolean {
    var lines = text.split("\n")
    var inside = false
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("function ") {
            inside = line.starts_with("function {function_key}")
        }
        if inside and line.contains(wanted) {
            return true
        }
        index = index + 1
    }
    return false
}
