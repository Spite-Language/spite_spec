union Shape {
    Circle
    Square
}

var console = Console()
var favorite: Shape? = null

func ClassTest() {
    load "../../../spite_standard_library/windows"
    var shape: Shape = Circle()
    console.print(shape.class == Circle)
    console.print(shape.class == Square)
    console.print(shape.class != Square)
    console.print(favorite.class == Circle)
    favorite = Square()
    console.print(favorite.class == Square)
    var described_circle = Circle()
    var circle_description = describe(described_circle)
    console.print(circle_description)
    var square = Square()
    var square_description = describe(square)
    console.print(square_description)
}

func describe(shape: Shape): String {
    if shape.class == Circle {
        return "a circle of radius {shape.radius}"
    }
    return "not a circle"
}
