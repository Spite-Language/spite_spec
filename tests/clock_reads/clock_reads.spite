var console = Console()
var clock = Clock()

func ClockReads() {
    load "../../../spite_standard_library/windows"
    var first = clock.elapsed()
    var reads = 0
    while reads < 1000 {
        var reading = clock.elapsed()
        crash reading >= first
        reads = reads + 1
    }
    var last = clock.elapsed()
    var taken = last - first
    var never_back = not taken.is_negative
    console.print(reads, never_back)
}
