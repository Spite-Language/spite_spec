generic $wanted_type

func first(store: Store): $wanted_type? {
    var index = 0
    var found: $wanted_type? = null
    while index < store.items.count() {
        var item = store.items[index]
        if item.class == $wanted_type {
            found = item
        }
        index = index + 1
    }
    return found
}

func nothing_wanted(missing: $wanted_type?): Boolean {
    return missing.class == $wanted_type
}
