generic $value_type

union Shape {
    Circle
    Square
}

type Named {
    name: String
}

func describe(): String {
    if $value_type == Dictionary {
        return "a dictionary"
    } else if $value_type == List {
        return "a list"
    } else if $value_type == Enum {
        return "an enum"
    } else if $value_type == Null {
        return "may be null"
    } else if $value_type.is_number {
        return "a number"
    } else if $value_type == Shape {
        return "a shape: {is_named()}"
    } else if $value_type == Named {
        return "named"
    }
    return "something else"
}

func is_named(): Boolean {
    return $value_type == Named
}
