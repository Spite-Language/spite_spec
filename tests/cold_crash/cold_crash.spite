var console = Console()

func ColdCrash() {
    load "../../../spite_standard_library/windows"
    var values = [3, 1, 4, 1, 5]
    var picks = [4, 0, 2]
    var total = 0
    var index = 0
    while index < picks.count() {
        var pick = picks[index]
        crash values[pick]
        total = total + values[pick]
        index = index + 1
    }
    console.print(total)
}
