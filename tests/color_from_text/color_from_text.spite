var console = Console()

func ColorFromText() {
    var white_text = "#ffffff"
    var white: Color? = white_text
    crash white
    var white_hex = white.to_hexadecimal_string()
    console.print(white, white_hex)
    var orange_text = "#ff8000"
    var orange: Color? = orange_text
    crash orange
    var shown = orange.to_rgb_string()
    console.print(orange.red, orange.green, orange.blue, shown)
    var blue_text = "rgb(0, 0, 255)"
    var blue: Color? = blue_text
    crash blue
    console.print(blue)
    var sky = Color(0.2, 0.5, 0.9, 1.0)
    var sky_text = sky.to_rgb_string()
    console.print(sky, sky_text)
    var maybe_text = "not a colour"
    var maybe: Color? = maybe_text
    var missing = not maybe
    console.print(missing)
    var wrong_text = "chartreuse-ish"
    var wrong: Color? = wrong_text
    crash wrong
    console.print("never printed", wrong)
}
