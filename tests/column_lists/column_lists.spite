var console = Console()
var cells = List<Cell>()
var _cell_count = 3000
var _last_cell_index = 2999

func ColumnLists() {
    load "../../../spite_standard_library/windows"
    var index = 0
    while index < _cell_count {
        var cell = Cell(index, index % 7)
        cells.append(cell)
        index = index + 1
    }
    var position = 0
    while position < cells.count() {
        var cell = cells[position]
        cell.weight = cell.weight + cell.small
        position = position + 1
    }
    var total: Long = 0
    var checked = 0
    while checked < cells.count() {
        var cell = cells[checked]
        total = total + cell.weight * 3 + cell.small + cell.big
        checked = checked + 1
    }
    var weights = cells.sum_weight()
    crash cells[_last_cell_index]
    var last = cells[_last_cell_index]
    console.print("total", total, "weights", weights, "last", last.weight, last.small, last.big)
}
