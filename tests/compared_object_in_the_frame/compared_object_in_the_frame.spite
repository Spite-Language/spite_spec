var console = Console()

func ComparedObjectInTheFrame() {
    var before = Pair(3, 4)
    var same = 0
    var itself = 0
    var different = 0
    var index = 0
    while index < 1000 {
        var pair = Pair(index, index + 1)
        if pair.is_same_instance(before) {
            same = same + 1
        }
        var held = pair
        if held.is_same_instance(pair) {
            itself = itself + 1
        }
        if not pair.is_same_instance(before) {
            different = different + 1
        }
        index = index + 1
    }
    var total = before.total()
    console.print(same, itself, different, total)
}
