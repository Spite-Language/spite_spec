var console = Console()
var _color_type = 6
var _past_a_byte = 262
var _below_zero = -1
var _largest_unsigned_integer: UnsignedInteger = 4294967295
var _beyond_an_integer: Long = 4294967296
var _largest_byte: Byte = 255

func ComparisonInTheWiderType() {
    var encoded = Buffer(2)
    encoded.append(6)
    compare_a_read_byte(encoded, _color_type)
    compare_a_read_byte(encoded, _past_a_byte)
    compare_widths(_color_type)
    compare_signs(_below_zero)
    compare_decimals(_color_type)
}

func compare_a_read_byte(encoded: Buffer, color_type: Integer) {
    var written = encoded[0]
    console.print(
        "read byte",
        written == color_type,
        color_type == written,
        written != color_type,
        color_type != written,
    )
    var missing = encoded[5]
    console.print("missing byte", missing == color_type, color_type != missing)
}

func compare_widths(count: Integer) {
    var small: Byte = 6
    console.print("byte and integer", small == count, count == small, small < count, count > small, small >= count)
    var total = _beyond_an_integer
    console.print("integer and long", count < total, total > count, count == total, count != total)
}

func compare_signs(negative: Integer) {
    var largest = _largest_unsigned_integer
    console.print(
        "unsigned and negative",
        largest == negative,
        negative == largest,
        largest > negative,
        negative < largest,
    )
    var zero: UnsignedInteger = 0
    console.print("unsigned zero", zero > negative, negative < zero, zero >= negative, negative >= zero)
    var full = _largest_byte
    var tiny: Tiny = -1
    console.print("byte and tiny", full == tiny, tiny == full, full > tiny, tiny < full)
}

func compare_decimals(count: Integer) {
    var progress = count - _color_type
    console.print("integer and float", progress > -0.5, -0.5 < progress)
    var real: Float = 0.1
    var exact: Double = 0.1
    console.print("float and double", real == exact, exact == real, real > exact)
}
