var console = Console()
var program = Program()
var folder = ".spite/built_only"

func CompilerBuildDoesNotRun() {
    load "../../../spite_standard_library/windows"
    write_the_program()
    var marker = File("{folder}/ran.txt")
    if marker.exists() {
        crash marker.remove()
    }
    var here = program.working_directory()
    crash here
    var compiler = "{here}\\..\\spite_compiler\\.spite\\spite.exe"
    var arguments = ["--build"]
    var building = Process(compiler, arguments)
    building.working_directory = folder
    var code = building.run()
    crash code
    var executable = File("{folder}/.spite/build/built_only.exe")
    var is_built = executable.exists()
    var has_run = marker.exists()
    console.print("--build", code, "built", is_built, "ran", has_run)
    crash executable.remove()
    var target_folder = Directory("{folder}/placed")
    if not target_folder.exists() {
        crash target_folder.create()
    }
    var placed = ["--build", "--executable-path=placed/elsewhere.exe"]
    var placing = Process(compiler, placed)
    placing.working_directory = folder
    var placed_code = placing.run()
    crash placed_code
    var at_path = File("{folder}/placed/elsewhere.exe")
    var is_at_path = at_path.exists()
    var is_at_default = executable.exists()
    var has_run_again = marker.exists()
    console.print("--executable-path", placed_code, "at the path", is_at_path, "at the default", is_at_default, "ran", has_run_again)
    var no_arguments = List<String>()
    var running = Process(compiler, no_arguments)
    running.working_directory = folder
    var run_code = running.run()
    crash run_code
    var has_run_now = marker.exists()
    console.print("no flag", run_code, "ran", has_run_now)
}

func write_the_program() {
    var made = Directory(folder)
    if not made.exists() {
        crash made.create()
    }
    var lines = List<String>()
    lines.append("var console = Console()")
    lines.append("")
    lines.append("func BuiltOnly() \{")
    lines.append("    load \"../../../spite_standard_library/windows\"")
    lines.append("    var marker = File(\"ran.txt\")")
    lines.append("    crash marker.write_string(\"ran\")")
    lines.append("    console.print(\"ran\")")
    lines.append("}")
    lines.append("")
    var entry = File("{folder}/built_only.spite")
    var joined = lines.join("\n")
    crash entry.write_string(joined)
}
