var console = Console()
var program = Program()
var folder = ".spite/final_with_build"

func CompilerBuildWithFinalClasses() {
    load "../../../spite_standard_library/windows"
    write_the_program()
    var here = program.working_directory()
    crash here
    var compiler = "{here}\\..\\spite_compiler\\.spite\\spite.exe"
    var executable_path: Path? = "{folder}/.spite/build/final_with_build.exe"
    crash executable_path
    var executable = File(executable_path)
    if executable.exists() {
        crash executable.remove()
    }
    var arguments = ["--build", "--final-classes=../written_classes"]
    var building = Process(compiler, arguments)
    building.working_directory = folder
    var code = building.run()
    crash code
    var is_built = executable.exists()
    var marker_path: Path? = "{folder}/../written_classes/.final-classes"
    crash marker_path
    var marker = File(marker_path)
    var is_marked = marker.exists()
    var badge_path: Path? = "{folder}/../written_classes/badge.spite"
    crash badge_path
    var badge = File(badge_path)
    var is_written = badge.exists()
    console.print("exit", code, "executable", is_built, "folder marked", is_marked, "badge written", is_written)
}

func write_the_program() {
    var made_path: Path? = folder
    crash made_path
    var made = Directory(made_path)
    if not made.exists() {
        crash made.create()
    }
    var lines = List<String>()
    lines.append("var console = Console()")
    lines.append("")
    lines.append("func FinalWithBuild() \{")
    lines.append("    var badge = Badge()")
    lines.append("    console.print(badge.name)")
    lines.append("}")
    lines.append("")
    var entry_path: Path? = "{folder}/final_with_build.spite"
    crash entry_path
    var entry = File(entry_path)
    var joined = lines.join("\n")
    crash entry.write_string(joined)
    var badge_path_text: Path? = "{folder}/badge.spite"
    crash badge_path_text
    var badge = File(badge_path_text)
    crash badge.write_string("var name = \"gold\"\n")
}
