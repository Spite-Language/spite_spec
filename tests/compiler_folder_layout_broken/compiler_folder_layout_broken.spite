var console = Console()
var program = Program()
var copy = ".spite/broken_layout"
var compiler_copy = ".spite/broken_layout/spite_compiler"

# ../../../spite_compiler/ARCHITECTURE.md#the-folders
func CompilerFolderLayoutBroken() {
    load "../../../spite_standard_library/windows"
    remove_the_old_copy()
    make_a_folder(".spite")
    make_a_folder(copy)
    copy_a_folder("../spite_compiler", compiler_copy)
    copy_a_folder("../spite_standard_library", "{copy}/spite_standard_library")
    copy_a_folder("../spite_documentation", "{copy}/spite_documentation")
    var printer_folder = "{compiler_copy}/printers/folder_without_printer"
    write_a_folder(printer_folder, "helper")
    var wanted = wanted_error("crash has_a_printer", "Printers.FolderWithoutPrinter")
    judge_a_refusal("--check", wanted)
    judge_a_refusal("--build", wanted)
    remove_a_folder(printer_folder)
    var low_pass_folder = "{compiler_copy}/low_optimization_passes/pass_without_entry"
    write_a_folder(low_pass_folder, "pass")
    var wanted_entry = wanted_error("crash holds_its_entry", "LowOptimizationPasses.PassWithoutEntry")
    judge_a_refusal("--check", wanted_entry)
    remove_a_folder(low_pass_folder)
    var rule_folder = "{compiler_copy}/validators/command_line/rule_with_a_helper"
    write_a_folder(rule_folder, "validator")
    write_a_file(rule_folder, "helper")
    var wanted_alone = wanted_error("crash is_the_rule", "Validators.CommandLine.RuleWithAHelper.Helper")
    judge_a_refusal("--check", wanted_alone)
    remove_the_old_copy()
}

func remove_the_old_copy() {
    remove_a_folder(copy)
}

func remove_a_folder(folder: String) {
    var old_path: Path? = folder
    crash old_path
    var old = Directory(old_path)
    fallback old.exists()
    var no_arguments = List<String>()
    var windows_copy = folder.replace("/", "\\")
    var removing = Process("rmdir /s /q \"{windows_copy}\"", no_arguments)
    var code = removing.run()
    crash code == 0
}

func make_a_folder(path: String) {
    var made_path: Path? = path
    crash made_path
    var made = Directory(made_path)
    fallback not made.exists()
    crash made.create()
}

func copy_a_folder(from: String, to: String) {
    make_a_folder(to)
    var folder_path: Path? = from
    crash folder_path
    var folder = Directory(folder_path)
    var entries = folder.entries()
    crash entries
    var index = 0
    while index < entries.count() {
        var entry = entries[index]
        switch entry {
            Directory: copy_a_subfolder(entry, to)
            File: copy_a_file(entry, to)
        }
        index = index + 1
    }
}

func copy_a_subfolder(folder: Directory, to: String) {
    var name = folder.folder_name
    fallback not name.starts_with(".")
    copy_a_folder(folder.path, "{to}/{name}")
}

func copy_a_file(file: File, to: String) {
    var name = file.file_name
    fallback name.ends_with(".spite") or name.ends_with(".md")
    var text = file.read_as_string()
    crash text
    var written_path: Path? = "{to}/{name}"
    crash written_path
    var written = File(written_path)
    crash written.write_string(text)
}

func write_a_folder(folder: String, file_name: String) {
    var made_path_text: Path? = folder
    crash made_path_text
    var made = Directory(made_path_text)
    crash made.create()
    write_a_file(folder, file_name)
}

func write_a_file(folder: String, file_name: String) {
    var file_path: Path? = "{folder}/{file_name}.spite"
    crash file_path
    var file = File(file_path)
    crash file.write_string("func check_an_answer(): Integer \{\n    return 1\n}\n")
}

func wanted_error(line_wanted: String, folder_shown: String): String {
    var layout_path: Path? = "{compiler_copy}/folder_layout/folder_layout.spite"
    crash layout_path
    var layout = File(layout_path)
    var text = layout.read_as_string()
    crash text
    var lines = text.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.trim() == line_wanted {
            var number = index + 1
            return "folder_layout/folder_layout.spite:{number}: error: '{line_wanted}' always halts over {folder_shown}: its condition is decided while compiling and is false"
        }
        index = index + 1
    }
    console.print("the layout check has no '{line_wanted}'")
    return ""
}

func judge_a_refusal(flag: String, wanted: String) {
    var here = program.working_directory()
    crash here
    var compiler = "{here}\\..\\spite_compiler\\.spite\\spite.exe"
    var arguments = [flag]
    var compiling = Process(compiler, arguments)
    compiling.working_directory = compiler_copy
    compiling.with_errors = true
    var code = compiling.run()
    crash code
    var printed = compiling.read_output_as_string()
    crash printed
    var refused = code != 0
    var says_it = printed.contains(wanted)
    console.print(flag, "refuses", refused, "at the line of the crash", says_it)
    if not says_it {
        console.print(printed)
    }
}
