var console = Console()
var program = Program()
var folder = ".spite/hot_reload_keeps"

func CompilerHotReloadKeepsUnusedFunctions() {
    load "../../../spite_standard_library/windows"
    write_the_program()
    var here = program.working_directory()
    crash here
    var compiler = "{here}\\..\\spite_compiler\\.spite\\spite.exe"
    var plain = run_with(compiler, "plain")
    console.print("a plain run:", plain)
    var reloading = run_with(compiler, "--hot-reload")
    console.print("--hot-reload:", reloading)
}

func run_with(compiler: String, flag: String): String {
    var arguments = [flag]
    if flag == "plain" {
        arguments = List<String>()
    }
    var running = Process(compiler, arguments)
    running.working_directory = folder
    var code = running.run()
    crash code
    var printed = running.read_output_as_string()
    crash printed
    var trimmed = printed.trim()
    return "{trimmed} (exit {code})"
}

func write_the_program() {
    var made_path: Path? = folder
    crash made_path
    var made = Directory(made_path)
    if not made.exists() {
        crash made.create()
    }
    var lines = List<String>()
    lines.append("var console = Console()")
    lines.append("var program = Program()")
    lines.append("")
    lines.append("func HotReloadKeeps() \{")
    lines.append("    load \"../../../spite_standard_library/windows\"")
    lines.append("    var path = program.executable_path()")
    lines.append("    crash path")
    lines.append("    var length = path.length()")
    lines.append("    var stem = path.slice(0, length - 4)")
    lines.append("    crash stem")
    lines.append("    var map_path: Path? = \"\{stem}.functions\"")
    lines.append("    crash map_path")
    lines.append("    var map = File(map_path)")
    lines.append("    var text = map.read_as_string()")
    lines.append("    crash text")
    lines.append("    var kept = text.contains(\"\tHotReloadKeeps.unused\")")
    lines.append("    console.print(\"unused function kept\", kept)")
    lines.append("}")
    lines.append("")
    lines.append("func unused() \{")
    lines.append("    console.print(\"nobody calls this\")")
    lines.append("}")
    lines.append("")
    var entry_path: Path? = "{folder}/hot_reload_keeps.spite"
    crash entry_path
    var entry = File(entry_path)
    var joined = lines.join("\n")
    crash entry.write_string(joined)
}
