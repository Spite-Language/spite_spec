var console = Console()
var root = "../spite_compiler"
var broken = 0
var _lines_from_an_error_to_its_exit = 3
var waiting = {
    "abstract_syntax_tree/lexer/lexer.spite": "the lexer's mistakes decided by spelling (spite_compiler#385, batch 2)"
    "validators/abstract_syntax_tree/spelling/validator.spite": "spelling deciding what the lexer read (spite_compiler#385, batch 2)"
    "abstract_syntax_tree/parser/parser.spite": "the parser's mistakes decided by syntax (spite_compiler#385, batch 3)"
    "validators/abstract_syntax_tree/syntax/validator.spite": "syntax deciding what the parser read (spite_compiler#385, batch 3)"
    "command_line/connect.spite": "the --connect rules in validators/command_line (spite_compiler#385, batch 1)"
    "command_line/settings.spite": "the handed flags rule in validators/command_line (spite_compiler#385, batch 1)"
    "validators/command_line/known_flag/validator.spite": "check_the_type_of deciding on the attribute's class (spite_compiler#385, batch 1)"
    "mapping/pinned_copy.spite": "the git_load rules as checks of the measured facts (spite_compiler#385, batch 1)"
    "symbols/symbol_table.spite": "the git_load rules as checks of the measured facts (spite_compiler#385, batch 1)"
    "high_intermediary_representation/building/values.spite": "the values rules in their own folders (spite_compiler#385, batch 4)"
    "high_intermediary_representation/building/fitting.spite": "the fitting rules in their own folders (spite_compiler#385, batch 4)"
    "high_intermediary_representation/building/constraints.spite": "the fitting rules in their own folders (spite_compiler#385, batch 4)"
    "high_intermediary_representation/building/operators.spite": "the operator rules in their own folders (spite_compiler#385, batch 5)"
    "high_intermediary_representation/building/literals.spite": "the literal rules in their own folders (spite_compiler#385, batch 5)"
    "high_intermediary_representation/building/endings.spite": "the missing return rule in its own folder (spite_compiler#385, batch 5)"
    "high_intermediary_representation/building/calls.spite": "the call rules in their own folders (spite_compiler#385, batch 6)"
    "high_intermediary_representation/building/arguments.spite": "the argument rules in their own folders (spite_compiler#385, batch 6)"
    "high_intermediary_representation/building/known_calls.spite": "the known call rules in their own folders (spite_compiler#385, batch 6)"
    "high_intermediary_representation/building/reads.spite": "the read rules in their own folders (spite_compiler#385, batch 7)"
    "high_intermediary_representation/building/assignments.spite": "the assignment rules in their own folders (spite_compiler#385, batch 7)"
    "high_intermediary_representation/building/collections.spite": "the collection rules in their own folders (spite_compiler#385, batch 7)"
    "high_intermediary_representation/building/walked_lists.spite": "the walked list rules in their own folders (spite_compiler#385, batch 7)"
    "high_intermediary_representation/building/dropping_walks.spite": "the dropping walk rule deciding in its folder (spite_compiler#385, batch 7)"
    "high_intermediary_representation/building/templates.spite": "the template rules in their own folders (spite_compiler#385, batch 8)"
    "high_intermediary_representation/building/questions.spite": "the question rules in their own folders (spite_compiler#385, batch 8)"
    "high_intermediary_representation/building/template_walks.spite": "the template walk rule in its own folder (spite_compiler#385, batch 8)"
    "high_intermediary_representation/building/foreign_constants.spite": "the foreign header rules deciding in their folder (spite_compiler#385, batch 9)"
    "high_intermediary_representation/building/statements.spite": "the return rules in their own folder (spite_compiler#385, batch 9)"
    "proofs/proven_checks/proof.spite": "a proven_check rule of its own instead of typing (spite_compiler#385, batch 10)"
    "validators/high_intermediary_representation/read_attribute/validator.spite": "check deciding on the site the proof found (spite_compiler#385, batch 10)"
    "validators/high_intermediary_representation/lost_write/validator.spite": "its checks deciding on the site the proof found (spite_compiler#385, batch 10)"
    "validators/high_intermediary_representation/present_value/validator.spite": "its checks deciding on the site the proof found (spite_compiler#385, batch 10)"
    "validators/high_intermediary_representation/kept_narrowing/validator.spite": "its checks deciding on the site the proof found (spite_compiler#385, batch 10)"
    "validators/high_intermediary_representation/buildable/validator.spite": "a crash named for the fault (spite_compiler#385, batch 11)"
    "validators/high_intermediary_representation/known_intrinsic/validator.spite": "a crash named for the fault (spite_compiler#385, batch 11)"
    "validators/high_intermediary_representation/embedded_parts/validator.spite": "a crash named for the fault (spite_compiler#385, batch 11)"
    "validators/low_intermediary_representation/handed_calls/validator.spite": "a crash named for the fault (spite_compiler#385, batch 11)"
