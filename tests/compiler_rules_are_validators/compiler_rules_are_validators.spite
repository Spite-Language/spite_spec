# ../../../spite_compiler/ARCHITECTURE.md#validators
func CompilerRulesAreValidators() {
    load "../../../spite_standard_library/windows"
    var top_path: Path? = root
    crash top_path
    var top = Directory(top_path)
    read_a_folder(top, "")
    if broken == 0 {
        console.print("every check of the compiler is a rule of validators/")
    }
}

func read_a_folder(folder: Directory, relative: String) {
    var entries = folder.entries()
    crash entries
    var index = 0
    while index < entries.count() {
        var entry = entries[index]
        switch entry {
            Directory: read_a_subfolder(entry, relative)
            File: read_a_file(entry, relative)
        }
        index = index + 1
    }
}

func read_a_subfolder(folder: Directory, relative: String) {
    var name = folder.folder_name
    fallback not name.starts_with(".")
    read_a_folder(folder, "{relative}{name}/")
}

func read_a_file(file: File, relative: String) {
    var name = file.file_name
    fallback name.ends_with(".spite")
    var text = file.read_as_string()
    crash text
    judge("{relative}{name}", name, text)
}

func judge(path: String, name: String, text: String) {
    var problems = List<String>()
    var lines = text.split("\n")
    var is_a_rule = path.starts_with("validators/")
    var may_define_refusals = is_a_rule or path.starts_with("proofs/")
    if is_a_rule and name == "validator.spite" and not defines_a_check(lines) {
        problems.append("defines no 'check' or 'check_...', so it only words what its caller decided")
    }
    if is_a_rule {
        note_the_checks_that_test_nothing(lines, problems)
        note_the_faults_of_the_compiler(lines, problems)
    }
    if not may_define_refusals {
        note_the_refusals(lines, problems)
    }
    if not is_a_rule {
        note_the_refusals_called(lines, problems)
        note_the_words_handed_to_stop(lines, problems)
    }
    if not is_a_rule and not path.starts_with("diagnostics/") {
        note_the_errors_that_exit(lines, problems)
    }
    var reason = waiting[path]
    if reason and problems.is_empty() {
        broken = broken + 1
        console.print("{path} waits for {reason} on the list, but it breaks no rule now: take it off the list")
    }
    fallback not reason
    var index = 0
    while index < problems.count() {
        var problem = problems[index]
        broken = broken + 1
        console.print("{path} {problem}")
        index = index + 1
    }
}

func defines_a_check(lines: List<String>): Boolean {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("func check") {
            return true
        }
        index = index + 1
    }
    return false
}

func note_the_refusals(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("func refuse") {
            var declared = declared_name(line)
            problems.append("defines '{declared}' outside validators/: hand what it judges to a rule there")
        }
        if line.contains("Diagnostics.Failure()") {
            problems.append("builds a Diagnostics.Failure outside validators/: hand what it judges to a rule there")
        }
        index = index + 1
    }
}

func declared_name(line: String): String {
    var opening = line.index_of("(")
    crash opening
    var declared = line.slice(5, opening)
    crash declared
    return declared
}

func note_the_refusals_called(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if calls_outside_a_text(line, ".refuse") {
            var called = line.trim()
            problems.append("calls a refusal outside validators/, so it decides what a rule should: '{called}'")
        }
        index = index + 1
    }
}

func note_the_words_handed_to_stop(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if calls_outside_a_text(line, ".stop(") and not line.contains(".stop()") {
            var called = line.trim()
            problems.append("hands its own words to a stop outside validators/: '{called}'")
        }
        index = index + 1
    }
}

func calls_outside_a_text(line: String, called: String): Boolean {
    var at = line.index_of(called)
    fallback at
    var before = line.slice(0, at)
    crash before
    return not before.contains("\"")
}

func note_the_errors_that_exit(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var statement = line.trim()
        if statement.starts_with("console.error(") and exits_soon_after(lines, index) {
            problems.append(
                "prints an error and exits outside validators/ and diagnostics/: hand what it judges to a rule",
            )
        }
        index = index + 1
    }
}

func exits_soon_after(lines: List<String>, error_index: Integer): Boolean {
    var index = error_index + 1
    while index < lines.count() and index <= error_index + _lines_from_an_error_to_its_exit {
        var line = lines[index]
        if line.contains(".exit(") and not line.contains("\"") {
            return true
        }
        index = index + 1
    }
    return false
}

func note_the_checks_that_test_nothing(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("func check") and refuses_untested(lines, index) {
            var declared = declared_name(line)
            problems.append(
                "'{declared}' tests nothing before it refuses, so its caller decided: give it the facts to test",
            )
        }
        index = index + 1
    }
}

func refuses_untested(lines: List<String>, header_index: Integer): Boolean {
    var refuses = false
    var index = header_index + 1
    while index < lines.count() and lines[index] != "}" {
        var line = lines[index]
        var statement = line.trim()
        fallback not is_a_test(statement)
        if line.contains("stop") or line.contains("refuse") {
            refuses = true
        }
        index = index + 1
    }
    return refuses
}

func is_a_test(statement: String): Boolean {
    if statement.starts_with("if ") or statement.starts_with("} else") {
        return true
    }
    return statement.starts_with("fallback ") or statement.starts_with("while ") or statement.starts_with("switch ")
}

func note_the_faults_of_the_compiler(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.contains("fault of the compiler") {
            problems.append(
                "words a fault of the compiler: no program reaches it, so it is a crash named for the fault",
            )
        }
        index = index + 1
    }
}
