    "fixes/after_building/terminal_if/fix.spite"
    "fixes/after_building/unread_attribute/fix.spite"
    "fixes/after_building/unread_plain_local/fix.spite"
    "fixes/symbols/platform_load/fix.spite"
    "fixes/symbols/repeated_declaration/fix.spite"
