var console = Console()
var root = "../spite_compiler"
var broken = 0
var _lines_from_an_error_to_its_exit = 3
var _problems_of_the_deciding_validator = 3
var printer_validator = [
    "enum Mistake \{"
    "    'unclosed_brace'"
    "}"
    ""
    "func check(path: String, line: Integer, mistake: Mistake) \{"
    "    if mistake == 'unclosed_brace' \{"
    "        refuse(path, line, \"this brace is never closed\")"
    "    }"
    "}"
]
var printer_caller = [
    "func read_a_brace(line: Integer) \{"
    "    var rule = Validators.AbstractSyntaxTree.Printer.Validator()"
    "    rule.check(path, line, 'unclosed_brace')"
    "}"
]
var deciding_validator = [
    "func check(path: String, written: Boolean) \{"
    "    fallback not written"
    "    var directory = Directory(path)"
    "    problem.is_fix = true"
    "    refuse(path)"
    "}"
]
var wording_caller = [
    "func read_an_index(context: Context) \{"
    "    var rule = Validators.HighIntermediaryRepresentation.NotIndexed.Validator()"
    "    rule.check(context, \"indexing\", \"get_at(index)\")"
    "}"
]
var deciding_fixer = [
    "func fixed(table: Symbols.SymbolTable) \{"
    "    fallback holds_only_files_to_fix(table)"
    "    rename(table)"
    "}"
    ""
    "func holds_only_files_to_fix(table: Symbols.SymbolTable): Boolean \{"
    "    return table.walks.is_empty()"
    "}"
]
var system_calls = [
    "Directory("
    "File("
    "Process("
    ".working_directory("
    ".read_as_string("
    ".write_string("
    ".write_buffer("
]
var rewrites = ["is_fix = true", ".found_later(", ".replaced_later(", ".cut_later(", ".removed_later(", ".moved_later("]
var waiting_for_407 = [
    "validators/abstract_syntax_tree/comments/validator.spite"
    "validators/command_line/handed_flags/validator.spite check"
    "validators/command_line/known_flag/validator.spite check_one"
    "validators/command_line/known_flag/validator.spite check_the_value"
    "validators/high_intermediary_representation/every_rule.spite check_an_evaluation"
    "validators/high_intermediary_representation/argument_count/validator.spite check_a_call"
    "validators/high_intermediary_representation/argument_count/validator.spite check_a_value_call"
    "validators/high_intermediary_representation/compile_time_fact/validator.spite check_a_paradox"
    "validators/high_intermediary_representation/cut_operand/validator.spite check"
    "validators/high_intermediary_representation/division_by_zero/validator.spite check"
    "validators/high_intermediary_representation/dropped_answer/validator.spite check"
    "validators/high_intermediary_representation/dropped_answer/validator.spite check_a_walk"
    "validators/high_intermediary_representation/foreign/validator.spite check_a_void_answer_read"
    "validators/high_intermediary_representation/key_maps/validator.spite check_one_map"
    "validators/high_intermediary_representation/lost_write/validator.spite check_a_lost_write"
    "validators/high_intermediary_representation/member_fit/validator.spite check"
    "validators/high_intermediary_representation/operator_call/validator.spite check_a_name"
    "validators/high_intermediary_representation/passed_function/validator.spite check_a_passed_value"
    "validators/high_intermediary_representation/passed_function/validator.spite check"
    "validators/high_intermediary_representation/read_attribute/validator.spite check"
    "validators/high_intermediary_representation/recursive_default/validator.spite check"
    "validators/high_intermediary_representation/shape_fit/validator.spite check_an_enum_member"
    "validators/high_intermediary_representation/shape_fit/validator.spite check_an_attribute_type"
    "validators/high_intermediary_representation/shape_fit/validator.spite check_an_argument_type"
    "validators/high_intermediary_representation/shape_fit/validator.spite check_an_answer_type"
    "validators/high_intermediary_representation/switch_cover/validator.spite check_the_rest"
    "validators/high_intermediary_representation/switch_cover/validator.spite check_a_case_kind"
    "validators/high_intermediary_representation/switch_cover/validator.spite check_a_rest_case"
    "validators/high_intermediary_representation/switch_cover/validator.spite check"
    "validators/high_intermediary_representation/template_member/validator.spite check_a_member_and_a_value"
    "validators/high_intermediary_representation/vector_fit/validator.spite check_an_item"
    "validators/high_intermediary_representation/walked_kind/validator.spite check_the_first_attribute"
    "fixes/abstract_syntax_tree/after_return/fix.spite"
    "fixes/abstract_syntax_tree/declaration_order/fix.spite"
    "fixes/abstract_syntax_tree/default_guard/disjoint.spite"
    "fixes/abstract_syntax_tree/default_guard/fix.spite"
    "fixes/abstract_syntax_tree/local_names/fix.spite"
    "fixes/abstract_syntax_tree/misplaced_comment/fix.spite"
