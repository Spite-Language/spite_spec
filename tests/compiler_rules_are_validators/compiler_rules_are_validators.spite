    "fixes/tokens/misspelt_keyword/fix.spite"
]
var met_waiting = List<String>()

# ../../../spite_compiler/ARCHITECTURE.md#validators
func CompilerRulesAreValidators() {
    load "../../../spite_standard_library/windows"
    var top_path: Path? = root
    crash top_path
    var top = Directory(top_path)
    read_a_folder(top, "")
    waiting_for_407.each(note_a_stale_wait)
    if broken == 0 {
        console.print("every check of the compiler is a rule of validators/")
    }
    refuse_the_printer_samples()
    refuse_the_deciding_samples()
}

# ../../../spite_compiler/ARCHITECTURE.md#validators
func note_a_stale_wait(waiting: String) {
    fallback not met_waiting.contains(waiting)
    broken = broken + 1
    console.print("'{waiting}' waits for #407 but breaks no rule now: take it off the list")
}

func is_waiting(waiting: String): Boolean {
    fallback waiting_for_407.contains(waiting)
    if not met_waiting.contains(waiting) {
        met_waiting.append(waiting)
    }
    return true
}

# ../../../spite_compiler/ARCHITECTURE.md#validators
func refuse_the_deciding_samples() {
    var validator_text = deciding_validator.join("\n")
    var caller_text = wording_caller.join("\n")
    var fixer_text = deciding_fixer.join("\n")
    var validator_path = "validators/command_line/sample/validator.spite"
    var caller_path = "abstract_syntax_tree/sample.spite"
    var fixer_path = "fixes/symbols/sample/fix.spite"
    var validator_problems = problems_of(validator_path, "validator.spite", validator_text)
    var caller_problems = problems_of(caller_path, "sample.spite", caller_text)
    var fixer_problems = problems_of(fixer_path, "fix.spite", fixer_text)
    var validator_is_refused = validator_problems.count() == _problems_of_the_deciding_validator
    var caller_is_refused = caller_problems.count() == 1
    if validator_is_refused and caller_is_refused and fixer_problems.count() == 2 {
        console.print(
            "a rule handed a Boolean or words, doing IO or rewriting is refused, and so is a fixer that decides",
        )
        return
    }
    console.print("the deciding samples were not refused as they should be:")
    validator_problems.each(print_a_sample_problem)
    caller_problems.each(print_a_sample_problem)
    fixer_problems.each(print_a_sample_problem)
}

# ../../../spite_compiler/AGENTS.md#rules
func refuse_the_printer_samples() {
    var validator_text = printer_validator.join("\n")
    var caller_text = printer_caller.join("\n")
    var validator_path = "validators/abstract_syntax_tree/printer/validator.spite"
    var caller_path = "abstract_syntax_tree/printer.spite"
    var validator_problems = problems_of(validator_path, "validator.spite", validator_text)
    var caller_problems = problems_of(caller_path, "printer.spite", caller_text)
    if validator_problems.count() == 2 and caller_problems.count() == 1 {
        console.print("a validator handed the kind of its mistake is refused, and so is its caller")
        return
    }
    console.print("the printer samples were not refused as they should be:")
    validator_problems.each(print_a_sample_problem)
    caller_problems.each(print_a_sample_problem)
}

func print_a_sample_problem(problem: String) {
    console.print("    {problem}")
}

func read_a_folder(folder: Directory, relative: String) {
    var entries = folder.entries()
    crash entries
    var index = 0
    while index < entries.count() {
        var entry = entries[index]
        switch entry {
            Directory: read_a_subfolder(entry, relative)
            File: read_a_file(entry, relative)
        }
        index = index + 1
    }
}

func read_a_subfolder(folder: Directory, relative: String) {
    var name = folder.folder_name
    fallback not name.starts_with(".")
    read_a_folder(folder, "{relative}{name}/")
}

func read_a_file(file: File, relative: String) {
    var name = file.file_name
    fallback name.ends_with(".spite")
    var text = file.read_as_string()
    crash text
    judge("{relative}{name}", name, text)
}

func judge(path: String, name: String, text: String) {
    var problems = problems_of(path, name, text)
    var index = 0
    while index < problems.count() {
        var problem = problems[index]
        broken = broken + 1
        console.print("{path} {problem}")
        index = index + 1
    }
}

func problems_of(path: String, name: String, text: String): List<String> {
    var problems = List<String>()
    var lines = text.split("\n")
    var is_a_rule = path.starts_with("validators/")
    var may_define_refusals = is_a_rule or path.starts_with("proofs/")
    if is_a_rule and name == "validator.spite" and not defines_a_check(lines) {
        problems.append("defines no 'check' or 'check_...', so it only words what its caller decided")
    }
    if is_a_rule {
        note_the_checks_that_test_nothing(lines, problems)
        note_the_faults_of_the_compiler(lines, problems)
        note_the_kinds_handed_in(lines, problems)
        note_the_booleans_handed_in(path, lines, problems)
        note_the_system_calls(path, lines, problems)
        note_the_rewrites(lines, problems)
    }
    if not may_define_refusals {
        note_the_refusals(lines, problems)
    }
    if not is_a_rule {
        note_the_refusals_called(lines, problems)
        note_the_words_handed_to_stop(lines, problems)
        note_the_kinds_handed_out(lines, problems)
    }
    var segments = path.split("/")
    if path.starts_with("fixes/") and segments.count() > 2 {
        note_the_decisions(path, name, lines, problems)
    }
    if not is_a_rule and not path.starts_with("diagnostics/") {
        note_the_errors_that_exit(lines, problems)
    }
    return problems
}

func defines_a_check(lines: List<String>): Boolean {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("func check") {
            return true
        }
        index = index + 1
    }
    return false
}

func note_the_refusals(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("func refuse") {
            var declared = declared_name(line)
            problems.append("defines '{declared}' outside validators/: hand what it judges to a rule there")
        }
        if line.contains("Diagnostics.Failure()") {
            problems.append("builds a Diagnostics.Failure outside validators/: hand what it judges to a rule there")
        }
        index = index + 1
    }
}

func declared_name(line: String): String {
    var opening = line.index_of("(")
    crash opening
    var declared = line.slice(5, opening)
    crash declared
    return declared
}

func note_the_refusals_called(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if calls_outside_a_text(line, ".refuse") {
            var called = line.trim()
            problems.append("calls a refusal outside validators/, so it decides what a rule should: '{called}'")
        }
        index = index + 1
    }
}

func note_the_words_handed_to_stop(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if calls_outside_a_text(line, ".stop(") and not line.contains(".stop()") {
            var called = line.trim()
            problems.append("hands its own words to a stop outside validators/: '{called}'")
        }
        index = index + 1
    }
}

func calls_outside_a_text(line: String, called: String): Boolean {
    var at = line.index_of(called)
    fallback at
    var before = line.slice(0, at)
    crash before
    return not before.contains("\"")
}

func note_the_errors_that_exit(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var statement = line.trim()
        if statement.starts_with("console.error(") and exits_soon_after(lines, index) {
            problems.append(
                "prints an error and exits outside validators/ and diagnostics/: hand what it judges to a rule",
            )
        }
        index = index + 1
    }
}

func exits_soon_after(lines: List<String>, error_index: Integer): Boolean {
    var index = error_index + 1
    while index < lines.count() and index <= error_index + _lines_from_an_error_to_its_exit {
        var line = lines[index]
        if line.contains(".exit(") and not line.contains("\"") {
            return true
        }
        index = index + 1
    }
    return false
}

func note_the_checks_that_test_nothing(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("func check") and refuses_untested(lines, index) {
            var declared = declared_name(line)
            problems.append(
                "'{declared}' tests nothing before it refuses, so its caller decided: give it the facts to test",
            )
        }
        index = index + 1
    }
}

func refuses_untested(lines: List<String>, header_index: Integer): Boolean {
    var refuses = false
    var index = header_index + 1
    while index < lines.count() and lines[index] != "}" {
        var line = lines[index]
        var statement = line.trim()
        fallback not is_a_test(statement)
        if line.contains("stop") or line.contains("refuse") {
            refuses = true
        }
        index = index + 1
    }
    return refuses
}

func is_a_test(statement: String): Boolean {
    if statement.starts_with("if ") or statement.starts_with("} else") {
        return true
    }
    return statement.starts_with("fallback ") or statement.starts_with("while ") or statement.starts_with("switch ")
}

func note_the_faults_of_the_compiler(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.contains("fault of the compiler") {
            problems.append(
                "words a fault of the compiler: no program reaches it, so it is a crash named for the fault",
            )
        }
        index = index + 1
    }
}

# ../../../spite_compiler/AGENTS.md#rules
func note_the_kinds_handed_in(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("enum Mistake") {
            problems.append("lists the kinds of mistake its callers pick from, so a caller decides and it only prints")
        }
        var is_an_entry = line.starts_with("func check") or line.starts_with("func refuse")
        if is_an_entry and takes_a_mistake(lines, index) {
            var declared = declared_name(line)
            problems.append(
                "'{declared}' is handed the kind of its mistake, so its caller decided: hand it what was written",
            )
        }
        index = index + 1
    }
}

func takes_a_mistake(lines: List<String>, header_index: Integer): Boolean {
    var index = header_index
    while index < lines.count() {
        var line = lines[index]
        if line.contains("Mistake") or line.contains("mistake:") {
            return true
        }
        fallback not line.ends_with("\{")
        index = index + 1
    }
    return false
}

# ../../../spite_compiler/AGENTS.md#rules
func note_the_kinds_handed_out(lines: List<String>, problems: List<String>) {
    var rules = List<String>()
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var statement = line.trim()
        var bound = rule_bound_by(statement)
        if not bound.is_empty() {
            rules.append(bound)
        }
        var called = rule_called_by(statement, rules)
        if not called.is_empty() and hands_a_kind(lines, index, called) {
            problems.append(
                "names the kind of mistake for the rule '{called}': hand it what was written and let it decide",
            )
        }
        if not called.is_empty() and hands_words(lines, index, called) {
            problems.append("hands its own words to the rule '{called}': hand it what was written and let it word them")
        }
        index = index + 1
    }
}

func rule_bound_by(statement: String): String {
    fallback statement.starts_with("var ") and statement.ends_with(".Validator()")
    fallback statement.contains(" = Validators.")
    var equals = statement.index_of(" = ")
    crash equals
    var bound = statement.slice(4, equals)
    crash bound
    return bound
}

func rule_called_by(statement: String, rules: List<String>): String {
    var index = 0
    while index < rules.count() {
        var rule = rules[index]
        if statement.starts_with("{rule}.check") or statement.contains(" {rule}.check") {
            return rule
        }
        index = index + 1
    }
    return ""
}

func hands_a_kind(lines: List<String>, call_index: Integer, rule: String): Boolean {
    var line = lines[call_index]
    crash line
    var at = line.index_of("{rule}.check")
    crash at
    var length = line.length()
    var arguments = line.slice(at, length)
    crash arguments
    if names_a_symbol(arguments) {
        return true
    }
    fallback arguments.ends_with("(")
    var index = call_index + 1
    while index < lines.count() {
        var following = lines[index]
        var argument = following.trim()
        fallback not argument.starts_with(")")
        if argument.starts_with("'") {
            return true
        }
        index = index + 1
    }
    return false
}

func names_a_symbol(arguments: String): Boolean {
    var quote = arguments.index_of("'")
    fallback quote
    var before = arguments.slice(0, quote)
    crash before
    return not before.contains("\"")
}

func hands_words(lines: List<String>, call_index: Integer, rule: String): Boolean {
    var line = lines[call_index]
    crash line
    var at = line.index_of("{rule}.check")
    crash at
    var length = line.length()
    var arguments = line.slice(at, length)
    crash arguments
    if arguments.contains("\"") {
        return true
    }
    fallback arguments.ends_with("(")
    var index = call_index + 1
    while index < lines.count() {
        var following = lines[index]
        var argument = following.trim()
        fallback not argument.starts_with(")")
        if argument.starts_with("\"") {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../../spite_compiler/AGENTS.md#rules
func note_the_booleans_handed_in(path: String, lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("func check") and takes_a_boolean(lines, index) {
            var declared = declared_name(line)
            if not is_waiting("{path} {declared}") {
                problems.append(
                    "'{declared}' is handed a Boolean its caller decided: hand it the state the Boolean is computed from",
                )
            }
        }
        index = index + 1
    }
}

func takes_a_boolean(lines: List<String>, header_index: Integer): Boolean {
    var index = header_index
    while index < lines.count() {
        var line = lines[index]
        if line.contains(": Boolean,") or line.contains(": Boolean)") {
            return true
        }
        fallback not line.ends_with("\{")
        index = index + 1
    }
    return false
}

# ../../../spite_compiler/AGENTS.md#rules
func note_the_system_calls(path: String, lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if calls_the_system(line) and not is_waiting(path) {
            var called = line.trim()
            problems.append("does IO in a validator: the step reads or writes and hands it what it found: '{called}'")
        }
        index = index + 1
    }
}

func calls_the_system(line: String): Boolean {
    var index = 0
    while index < system_calls.count() {
        var called = system_calls[index]
        if calls_outside_a_text(line, called) and starts_a_call(line, called) {
            return true
        }
        index = index + 1
    }
    return false
}

func starts_a_call(line: String, called: String): Boolean {
    var at = line.index_of(called)
    fallback at
    if at == 0 or called.starts_with(".") {
        return true
    }
    var before = line[at - 1]
    crash before
    var name_characters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_."
    return not name_characters.contains(before)
}

# ../../../spite_compiler/AGENTS.md#rules
func note_the_rewrites(lines: List<String>, problems: List<String>) {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if rewrites_a_program(line) {
            var written = line.trim()
            problems.append(
                "rewrites in a validator: it answers that a fix can be done, and its fixer rewrites: '{written}'",
            )
        }
        index = index + 1
    }
}

func rewrites_a_program(line: String): Boolean {
    var index = 0
    while index < rewrites.count() {
        var rewrite = rewrites[index]
        if calls_outside_a_text(line, rewrite) {
            return true
        }
        index = index + 1
    }
    return false
}

# ../../../spite_compiler/AGENTS.md#rules
func note_the_decisions(path: String, name: String, lines: List<String>, problems: List<String>) {
    var found = List<String>()
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("func ") and answers_a_boolean(lines, index) {
            var declared = declared_name(line)
            found.append(
                "the fixer decides with '{declared}': its validator answers whether the fix can be done, and the fixer only rewrites",
            )
        }
        index = index + 1
    }
    var text = lines.join("\n")
    if name == "fix.spite" and not text.contains("is_fixable()") {
        found.append(
            "no validator's answer tells this fixer the fix can be done: ask its rule, and fix what it answers fixable",
        )
    }
    fallback not found.is_empty()
    fallback not is_waiting(path)
    found.each(problems.append)
}

func answers_a_boolean(lines: List<String>, header_index: Integer): Boolean {
    var index = header_index
    while index < lines.count() {
        var line = lines[index]
        if line.ends_with("\{") {
            return line.ends_with("): Boolean \{")
        }
        index = index + 1
    }
    return false
}
