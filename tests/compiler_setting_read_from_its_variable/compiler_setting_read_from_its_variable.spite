var console = Console()
var program = Program()
var folder = ".spite/optimized_variable"

func CompilerSettingReadFromItsVariable() {
    load "../../../spite_standard_library/windows"
    write_the_program()
    var no_variables = Dictionary<String, String>()
    console.print("no variable")
    compile_and_run(no_variables)
    var variables = Dictionary<String, String>()
    variables["OPTIMIZED"] = "true"
    console.print("OPTIMIZED=true")
    compile_and_run(variables)
}

func compile_and_run(variables: Dictionary<String, String>) {
    var here = program.working_directory()
    crash here
    var compiler = "{here}\\..\\spite_compiler\\.spite\\spite.exe"
    var no_arguments = List<String>()
    var running = Process(compiler, no_arguments)
    running.working_directory = folder
    running.environment_variables = variables
    running.with_errors = true
    var code = running.run()
    crash code
    var printed_text = running.read_output_as_string()
    crash printed_text
    var printed = printed_text.trim()
    console.print(printed)
    console.print("exit code", code)
}

func write_the_program() {
    var made_path: Path? = folder
    crash made_path
    var made = Directory(made_path)
    if not made.exists() {
        crash made.create()
    }
    var lines = List<String>()
    lines.append("var console = Console()")
    lines.append("var build = Build()")
    lines.append("")
    lines.append("func OptimizedVariable() \{")
    lines.append("    load \"../../../spite_standard_library/windows\"")
    lines.append("    console.print(\"optimized\", build.optimized)")
    lines.append("}")
    lines.append("")
    var entry_path: Path? = "{folder}/optimized_variable.spite"
    crash entry_path
    var entry = File(entry_path)
    var joined = lines.join("\n")
    crash entry.write_string(joined)
}
