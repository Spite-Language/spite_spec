var program = Program()

func run(): Integer {
    var first = Concurrent(nap)
    var second = Concurrent(nap)
    var one: Integer = first
    var two: Integer = second
    return one + two
}

func nap(): Integer {
    var twenty_milliseconds = Duration(20, 'milliseconds')
    program.sleep(twenty_milliseconds)
    return 1
}
