var console = Console()
var server = Tcp.Server()
var _server_port = 47311

func ConcurrentSockets() {
    load "../../../spite_standard_library/windows"
    crash server.listen_locally(_server_port)
    var ada = Tcp.Client()
    ask(ada, "ada")
    var grace = Tcp.Client()
    ask(grace, "grace")
    var serving = serve_two()
    var first = answer_of(ada)
    var second = answer_of(grace)
    console.print(first, second)
    console.print("served", serving, "clients")
    server.close()
}

func serve_two(): Integer {
    var served = 0
    while served < 2 {
        var client = server.accept()
        crash client
        var line = client.read_line()
        crash line
        crash client.write_line("hello {line}")
        client.close()
        served = served + 1
    }
    return served
}

func ask(connection: Tcp.Client, name: String) {
    crash connection.connect_locally(_server_port)
    crash connection.write_line(name)
}

func answer_of(connection: Tcp.Client): String {
    var answer = connection.read_line()
    connection.close()
    crash answer
    return answer
}
