var console = Console()
var server = Tcp.Server()

func ConcurrentSockets() {
    load "../../../spite_standard_library/windows"
    crash server.listen_locally(47311)
    var serving = Concurrent(serve_two)
    var first = Concurrent(ask_ada)
    var second = Concurrent(ask_grace)
    console.print(first, second)
    console.print("served", serving, "clients")
    server.close()
}

func serve_two(): Integer {
    var served = 0
    while served < 2 {
        var client = server.accept()
        crash client
        var line = client.read_line()
        crash line
        crash client.write_line("hello {line}")
        client.close()
        served = served + 1
    }
    return served
}

func ask_ada(): String {
    return ask("ada")
}

func ask_grace(): String {
    return ask("grace")
}

func ask(name: String): String {
    var connection = Tcp.Client()
    crash connection.connect_locally(47311)
    crash connection.write_line(name)
    var answer = connection.read_line()
    connection.close()
    crash answer
    return answer
}
