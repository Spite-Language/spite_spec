var console = Console()
var shelf = Shelf()

func ConcurrentUnfinishedAtExit() {
    load "../../../SpiteCompiler/.spite/library/common"
    load "../../../SpiteCompiler/.spite/library/windows"
    var job = Concurrent(shelf.ring)
