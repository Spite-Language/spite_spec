var console = Console()
var another = Console()
var local_console = Console()

func ConsoleClass() {
    var namespace_text = ""
    if console.class.outer_class {
        namespace_text = console.class.outer_class.name_with_outer_classes
    }
    console.print(console == another, console.class.name, "{namespace_text}|")
    another.write('output', "", "written")
    another.write('output', "", " and written again")
    console.print("")
    var greeter = Greeter()
    greeter.greet()
    local_console.print("a Console bound in a function prints too")
}
