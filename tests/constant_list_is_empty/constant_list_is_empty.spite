var console = Console()

func ConstantListIsEmpty() {
    Gear.nested_classes.each(check)
}

func check(part: Spite.Class) {
    if Gear.nested_classes.is_empty() {
        never_declared()
    } else {
        console.print(part.name_with_outer_classes, "Gear has classes")
    }
    if part.nested_classes.is_empty() {
        console.print(part.name_with_outer_classes, "holds no classes")
    } else {
        never_declared_either()
    }
}
