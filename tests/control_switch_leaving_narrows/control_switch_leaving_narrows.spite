enum Light {
    'red'
    'green'
}

var console = Console()

func ControlSwitchLeavingNarrows() {
    load "../../../spite_standard_library/windows"
    var first = describe(null, 'red')
    var second = describe("found", 'green')
    console.print(first, second)
}

func describe(found: String?, light: Light): String {
    if not found {
        switch light {
            'red': return "stop"
            'green': return "go"
        }
    }
    return found
}
