var console = Console()
var calls = 0

func ControlSwitchSubjectOnce() {
    load "../../../spite_standard_library/windows"
    var name = name_of(2)
    console.print(name, calls)
}

func next_number(number: Integer): Integer {
    calls = calls + 1
    return number + 1
}

func name_of(number: Integer): String {
    var switched_16 = next_number(number)
    if switched_16 == 1 {
        return "one"
    } else if switched_16 == 2 {
        return "two"
    } else if switched_16 == 3 {
        return "three"
    } else {
        return "many"
    }
}
