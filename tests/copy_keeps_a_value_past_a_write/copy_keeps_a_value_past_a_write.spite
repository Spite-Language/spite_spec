var console = Console()

func CopyKeepsAValuePastAWrite() {
    var shelf = kept_shelf()
    var other = Item()
    other.number = 2
    show(shelf, shelf, other)
}

func kept_shelf(): Shelf {
    var shelf = Shelf()
    shelf.item = Item()
    return shelf
}

func show(shelf: Shelf, alias: Shelf, other: Item) {
    var copy = shelf.item
    fallback copy
    alias.item = other
    console.print(copy.number)
}
