var console = Console()
var _large_amount = 2000000000

func CountAndLengthAreIntegers() {
    var names = ["ada", "bea"]
    var word = "hello"
    var large = _large_amount
    var length = word.length()
    var count = names.count()
    var table = Dictionary<String, Integer>()
    var entries = table.count()
    console.print(length.class, count.class, entries.class)
    var scaled = length * large
    console.print("never printed", scaled)
}
