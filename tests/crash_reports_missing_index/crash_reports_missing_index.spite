var console = Console()

func CrashReportsMissingIndex() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var clip = Clip()
    clip.keys.append(0.0)
    clip.keys.append(0.0)
    read(clip, 0)
    read(clip, 2)
