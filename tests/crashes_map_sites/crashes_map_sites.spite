var console = Console()

func CrashesMapSites() {
    load "../../../spite_standard_library/windows"
    var one = both(3, 4)
    var two = narrowed("ada")
    var three = guarded(2)
    console.print(one, two, three)
    var map = File("tests/crashes_map_sites/.spite/build/crashes_map_sites.crashes")
    var text = map.read_as_string()
    crash text
    show(text)
}

func both(left: Integer, right: Integer): Integer {
    fallback left > 0 and right > 0
    return left + right
}

func narrowed(name: String): Integer {
    var names = Dictionary<String, Integer>()
    names["ada"] = 1
    var found = names[name]
    fallback found
    return found
}

func guarded(value: Integer): Integer {
    crash value < 10
    return value
}

func never_called(value: Integer): Integer {
    crash value < 10
    return value
}

func show(text: String) {
    var lines = text.lines()
    var previous = ""
    var ordered = true
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.contains("crashes_map_sites.spite") {
            console.print(line)
            var id = line.slice(0, 8)
            crash id
            if id < previous {
                ordered = false
            }
            previous = id
        }
        index = index + 1
    }
    console.print("ordered by id", ordered)
}
