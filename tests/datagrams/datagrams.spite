var console = Console()
var _server_port = 47811

func Datagrams() {
    load "../../../spite_standard_library/windows"
    var server = Udp.Server()
    var client = Udp.Client()
    var server_open = server.open_locally(_server_port)
    var client_open = client.open()
    console.print("server open: {server_open}, client open: {client_open}")
    var server_port = server.port
    var client_port = client.port
    var picked = client_port > 0
    console.print("server port: {server_port}, the client was given a port: {picked}")
    var ping_text = "ping"
    var ping = ping_text.to_buffer()
    var server_address: IpAddress? = "127.0.0.1"
    crash server_address
    var sent = client.send_to(server_address, _server_port, ping)
    console.print("sent: {sent}")
    var arrived = server.receive()
    crash arrived
    var arrived_buffer = arrived.read_as_buffer()
    var arrived_bytes = joined(arrived_buffer)
    var from_address = arrived.sender_address
    console.print("server got {arrived_bytes} from {from_address}")
    var pong_text = "pong!"
    var pong = pong_text.to_buffer()
    var reply_port = arrived.sender_port
    var same_port = reply_port == client_port
    console.print("the datagram came from the client's port: {same_port}")
    var replied = server.send_to(from_address, reply_port, pong)
    var answer = client.receive()
    crash answer
    var answer_buffer = answer.read_as_buffer()
    var answer_count = answer_buffer.count()
    console.print("replied: {replied}, client got {answer_count} bytes")
    var empty = Buffer(0)
    var local_host: IpAddress? = "localhost"
    crash local_host
    crash client.send_to(local_host, _server_port, empty)
    var empty_arrived = server.receive()
    crash empty_arrived
    var empty_buffer = empty_arrived.read_as_buffer()
    var empty_count = empty_buffer.count()
    console.print("an empty datagram arrives as {empty_count} bytes")
    var taken = Udp.Server()
    var twice = taken.open_locally(_server_port)
    console.print("a second server on the same port: {twice}")
    server.close()
    var after_close = server.receive()
    if not after_close {
        console.print("a closed server receives nothing")
    }
}

func joined(bytes: Buffer): String {
    var text = ""
    var index = 0
    while index < bytes.count() {
        var held = bytes[index]
        crash held
        var value: Integer = held
        if index > 0 {
            text = "{text},"
        }
        text = "{text}{value}"
        index = index + 1
    }
    return text
}
