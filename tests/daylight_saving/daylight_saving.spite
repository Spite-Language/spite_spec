var console = Console()
var zones = TimeZones()
var _last_winter_second_since_1970: Long = 1710053999
var _railway_time_seconds_before_1970: Long = 5364662400
var _sample_year = 2024

func DaylightSaving() {
    load "../../../spite_standard_library/windows"
    var new_york = zones.find("America/New_York")
    crash new_york
    around_the_change(new_york)
    the_gap(new_york)
    the_overlap(new_york)
    other_zones()
}

func around_the_change(zone: TimeZone) {
    var last_winter_second = Duration(_last_winter_second_since_1970, 'seconds')
    var before = Instant(last_winter_second)
    var after = before + Duration(1, 'seconds')
    var before_text = before.to_string_in(zone)
    var after_text = after.to_string_in(zone)
    var before_offset = zone.offset_at(before)
    var after_offset = zone.offset_at(after)
    console.print(zone.identifier, before_text, before_offset)
    console.print(zone.identifier, after_text, after_offset)
    var railway_time = Duration(-_railway_time_seconds_before_1970, 'seconds')
    var history = Instant(railway_time)
    var history_text = history.to_string_in(zone)
    console.print("before railway time", history_text)
}

func the_gap(zone: TimeZone) {
    var missing_day = Date(_sample_year, 3, 10)
    var missing_time = Time(2, 30, 0, 0)
    var missing = DateTime(missing_day, missing_time)
    show(zone, missing, 'compatible')
    show(zone, missing, 'earlier')
    show(zone, missing, 'later')
}

func the_overlap(zone: TimeZone) {
    var twice_day = Date(_sample_year, 11, 3)
    var twice_time = Time(1, 30, 0, 0)
    var twice = DateTime(twice_day, twice_time)
    show(zone, twice, 'compatible')
    show(zone, twice, 'earlier')
    show(zone, twice, 'later')
    var summer_day = Date(_sample_year, 7, 4)
    var summer_time = Time(12, 0, 0, 0)
    var summer = DateTime(summer_day, summer_time)
    show(zone, summer, 'compatible')
    var instant = summer.to_instant_in(zone, 'compatible')
    var back = instant.to_date_time_in(zone)
    var round_trip = back == summer
    console.print("round trip", round_trip)
}

func other_zones() {
    var london = zones.find("Europe/London")
    crash london
    var lord_howe = zones.find("Australia/Lord_Howe")
    crash lord_howe
    var british_gap_day = Date(_sample_year, 3, 31)
    var british_gap_time = Time(1, 30, 0, 0)
    var british_gap = DateTime(british_gap_day, british_gap_time)
    var half_hour_gap_day = Date(_sample_year, 10, 6)
    var half_hour_gap_time = Time(2, 15, 0, 0)
    var half_hour_gap = DateTime(half_hour_gap_day, half_hour_gap_time)
    var half_hour_overlap_day = Date(_sample_year, 4, 7)
    var half_hour_overlap_time = Time(1, 45, 0, 0)
    var half_hour_overlap = DateTime(half_hour_overlap_day, half_hour_overlap_time)
    show(london, british_gap, 'compatible')
    show(lord_howe, half_hour_gap, 'compatible')
    show(lord_howe, half_hour_overlap, 'earlier')
    show(lord_howe, half_hour_overlap, 'later')
    var mars = zones.find("Mars/Olympus_Mons")
    if mars {
        console.print("found", mars.identifier)
    } else {
        console.print("no zone is called Mars/Olympus_Mons")
    }
}

func show(zone: TimeZone, local: DateTime, ambiguity: TimeZone.Ambiguity) {
    var instant = local.to_instant_in(zone, ambiguity)
    var shown = instant.to_string_in(zone)
    console.print(zone.identifier, local, ambiguity, instant, shown)
}
