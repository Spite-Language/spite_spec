var console = Console()

func DebugHandles() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var dialer = Dialer()
    console.debug(dialer)
    var counting = Parallel(three)
    var total = counting + 1
    dialer.counting = counting
    console.print(total)
    console.debug(dialer)
}

func three(): Integer {
    return 3
}
