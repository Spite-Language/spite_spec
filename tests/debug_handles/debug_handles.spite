var console = Console()

func DebugHandles() {
    load "../../../spite_standard_library/windows"
    var dialer = Dialer()
    console.debug(dialer)
    var counting = three()
    var total = counting + 1
    dialer.counting = counting
    console.print(total)
    console.debug(dialer)
}

func three(): Integer {
    return 3
}
