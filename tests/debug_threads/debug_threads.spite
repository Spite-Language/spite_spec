var console = Console()
var _describe_rounds = 3000

func DebugThreads() {
    load "../../../spite_standard_library/windows"
    var first_text = describe()
    var second_text = describe()
    var third_text = describe()
    console.print(first_text)
    console.print(first_text == second_text and second_text == third_text)
}

func describe(): String {
    var room = Room()
    var text = ""
    var index = 0
    while index < _describe_rounds {
        text = room.to_debug()
        index = index + 1
    }
    return text
}
