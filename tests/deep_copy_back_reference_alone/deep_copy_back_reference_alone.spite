var console = Console()

func DeepCopyBackReferenceAlone() {
    var root = Node("root")
    var child = Node("child")
    root.children.append(child)
    child.parent = root
    var copied = child.deep_copy()
    crash copied.parent
    var holds_original = copied.parent == root
    console.print(copied.name, copied.parent.name, holds_original)
}
