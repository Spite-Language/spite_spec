var console = Console()

func DeepCopyGraphs() {
    load "../../../spite_standard_library/windows"
    var root = Node("root")
    var child = Node("child")
    root.children.append(child)
    child.parent = root
    var copied = root.deep_copy()
    var copied_child = copied.children.first()
    crash copied_child
    crash copied_child.parent
    var back_to_copy = copied_child.parent == copied
    var back_to_original = copied_child.parent == root
    console.print(copied_child.parent.name, back_to_copy, back_to_original)
    var holder = Holder()
    var lamp = Item("lamp")
    holder.items.append(lamp)
    lamp.holder = holder
    holder.favorite = lamp
    var copied_holder = holder.deep_copy()
    var first = copied_holder.items.first()
    crash first
    crash first.holder
    crash copied_holder.favorite
    var own_lamp = copied_holder.favorite == first
    var original_lamp = copied_holder.favorite == lamp
    var own_holder = first.holder == copied_holder
    console.print(copied_holder.favorite.name, own_lamp, original_lamp, own_holder)
}
