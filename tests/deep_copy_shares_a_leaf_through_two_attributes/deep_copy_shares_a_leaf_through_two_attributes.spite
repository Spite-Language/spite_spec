var console = Console()

func DeepCopySharesALeafThroughTwoAttributes() {
    var leaf = Leaf("shared")
    var box = Box(leaf, leaf)
    var copied = box.deep_copy()
    var one_leaf = copied.left === copied.right
    var is_the_original = copied.left === leaf
    copied.left.name = "changed"
    console.print("one leaf:", one_leaf, is_the_original, copied.right.name, leaf.name)
    var original_one_leaf = box.left === box.right
    console.print("original:", original_one_leaf, box.left.name, box.right.name)
}
