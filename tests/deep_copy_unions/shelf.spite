union Cargo {
    Crate
    Badge
}

type Labeled {
    label: String
}

type Describable {
    describe(): String
}

var cargo: Cargo = Crate("empty")
var spare: Cargo? = null
var held = List<Cargo>()
var tagged: Labeled = Badge("none", 0)
var described: Describable = Crate("plain")
var points = List<Point>()
var marks = List<Point>()
