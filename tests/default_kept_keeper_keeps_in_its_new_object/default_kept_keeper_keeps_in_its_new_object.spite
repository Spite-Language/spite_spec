var console = Console()

func DefaultKeptKeeperKeepsInItsNewObject() {
    var other = Counter()
    var keeper = Keeper(other)
    var writer = Writer(keeper)
    var holder = Holder(keeper, writer)
    console.print(holder.counter.touched)
    console.print(holder.keeper.box.held.touched, holder.writer.kept.box.held.touched)
    console.print(holder.writer.spare.touched, holder.keeper.box.spare.touched)
}
