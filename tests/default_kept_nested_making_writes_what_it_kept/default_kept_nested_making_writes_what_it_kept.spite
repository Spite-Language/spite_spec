var console = Console()

func DefaultKeptNestedMakingWritesWhatItKept() {
    var other = Counter()
    var keeper = Keeper(other)
    var writer = Writer(keeper)
    var holder = Holder(keeper, writer)
    console.print(holder.counter.touched)
    console.print(holder.keeper.held.touched, holder.writer.kept.held.touched, holder.writer.inner.seen)
}
