type Counted {
    hundred: Integer
}

var console = Console()

func DefaultReadBelowIsMovedKeptSlot() {
    load "../../../spite_standard_library/windows"
    var box = Box()
    console.print(box.early, box.grown)
    show(box)
    box.grow()
    console.print(box.size)
}

func show(counted: Counted) {
    console.print(counted.hundred)
}
