var console = Console()
var program = Program()

func DefaultReplacedRunsThroughItsOwnBuffer() {
    var shared = Rack(40)
    var total = 0
    var made = 0
    while made < 1000 {
        var worker = Worker(shared)
        total = total + worker.total()
        made = made + 1
    }
    console.print("total", total)
    var path = program.executable_path()
    crash path
    var length = path.length()
    var stem = path.slice(0, length - 4)
    crash stem
    var map_path: Path? = "{stem}.functions"
    crash map_path
    var map = File(map_path)
    var text = map.read_as_string()
    crash text
    var lines = text.split("\n")
    var whole = size_of(lines, "\tDefaultReplacedRunsThroughItsOwnBuffer.Worker._attribute_defaults")
    var left = size_of(lines, "\tDefaultReplacedRunsThroughItsOwnBuffer.Worker.Worker$defaults")
    var is_trimmed = whole > 0 and left < whole
    console.print("Worker makes less than its whole defaults", is_trimmed)
}

func size_of(lines: List<String>, ending: String): Integer {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var trimmed = line.replace("\r", "")
        if trimmed.ends_with(ending) {
            return size_of_a_line(trimmed)
        }
        index = index + 1
    }
    return 0
}

func size_of_a_line(line: String): Integer {
    var columns = line.split("\t")
    var start = columns[0]
    crash start
    var end = columns[1]
    crash end
    return number_of(end) - number_of(start)
}

func number_of(hexadecimal: String): Integer {
    var digits = "0123456789abcdef"
    var total = 0
    var index = 0
    while index < hexadecimal.length() {
        var digit = hexadecimal.slice(index, index + 1)
        crash digit
        var value = digits.index_of(digit)
        crash value
        total = total * 16 + value
        index = index + 1
    }
    return total
}
