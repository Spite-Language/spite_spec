var console = Console()
var program = Program()

func DefaultUnreadIsNotMade() {
    load "../../../spite_standard_library/windows"
    var context = Context(1, null)
    var gone = Gone(context)
    var stays = Stays(context)
    var kept = stays.read_it()
    var empty = gone.context.is_empty()
    console.print(gone.context.value, stays.context.value, kept, empty)
    var path = program.executable_path()
    crash path
    var length = path.length()
    var stem = path.slice(0, length - 4)
    crash stem
    var map = File("{stem}.functions")
    var text = map.read_as_string()
    crash text
    var lines = text.split("\n")
    var gone_size = size_of(lines, "\tGone.Gone$defaults")
    var stays_size = size_of(lines, "\tStays.Stays$defaults")
    var is_smaller = gone_size > 0 and gone_size < stays_size
    console.print("makes less than its twin", is_smaller)
}

func size_of(lines: List<String>, ending: String): Integer {
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var trimmed = line.replace("\r", "")
        if trimmed.ends_with(ending) {
            return size_of_a_line(trimmed)
        }
        index = index + 1
    }
    return 0
}

func size_of_a_line(line: String): Integer {
    var columns = line.split("\t")
    var start = columns[0]
    crash start
    var end = columns[1]
    crash end
    return number_of(end) - number_of(start)
}

func number_of(hexadecimal: String): Integer {
    var digits = "0123456789abcdef"
    var total = 0
    var index = 0
    while index < hexadecimal.length() {
        var digit = hexadecimal.slice(index, index + 1)
        crash digit
        var value = digits.index_of(digit)
        crash value
        total = total * 16 + value
        index = index + 1
    }
    return total
}
