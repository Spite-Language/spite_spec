var console = Console()

func DefaultUnreadNestedMaking() {
    load "../../../spite_standard_library/windows"
    var given = Context(null)
    console.print("start")
    var top = Top(given)
    var held = top.context.holds()
    console.print(held)
    var quiet_given = QuietContext(null)
    var quiet = QuietTop(quiet_given)
    var quiet_held = quiet.context.holds()
    console.print(quiet_held)
}
