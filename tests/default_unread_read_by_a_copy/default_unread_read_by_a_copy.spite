var console = Console()

func DefaultUnreadReadByACopy() {
    var context = Context(1)
    var holder = Holder(context)
    var copied = holder.copy()
    var deep = holder.deep_copy()
    console.print(copied.context.value, deep.context.value)
    holder.context.value = 2
    console.print(copied.context.value, deep.context.value)
}
