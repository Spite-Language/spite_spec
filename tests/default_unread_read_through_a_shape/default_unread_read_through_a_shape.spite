type Holding {
    no_part: Part
}

var console = Console()

func DefaultUnreadReadThroughAShape() {
    load "../../../spite_standard_library/windows"
    var given = Part(1)
    var holder = Holder(given)
    console.print(holder.kept.value)
    read_it(holder)
}

func read_it(holding: Holding) {
    console.print(holding.no_part.value)
}
