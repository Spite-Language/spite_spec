var console = Console()
var tally = Tally()

func DefaultUnreadWritesASingleton() {
    load "../../../spite_standard_library/windows"
    console.print("start")
    var given = Reader(null)
    var first = Holder(given)
    var second = Holder(given)
    var first_empty = first.reader.is_empty()
    var second_empty = second.reader.is_empty()
    console.print(tally.count, first_empty, second_empty)
}
