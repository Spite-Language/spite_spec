var console = Console()
var program = Program()

func DevelopmentKeepsAPackagesUnusedFunction() {
    load "paint"
    var tint = Tint()
    var shown = tint.describe()
    console.print(shown)
    var path = program.executable_path()
    crash path
    var length = path.length()
    var stem = path.slice(0, length - 4)
    crash stem
    var map_path: Path? = "{stem}.functions"
    crash map_path
    var map = File(map_path)
    var text = map.read_as_string()
    crash text
    var kept = text.contains("\tTint.unused")
    console.print("unused kept", kept)
}
