var console = Console()

func DictionaryNotANumberKey() {
    load "../../../spite_standard_library/windows"
    var weights = Dictionary<Double, String>()
    var zero = 0.0
    var first = zero / zero
    var second = Double.NotANumber()
    weights[first] = "first"
    weights[second] = "second"
    weights[1.5] = "one and a half"
    var count = weights.count()
    var found = weights[Double.NotANumber()]
    crash found
    console.print(count, found)
}
