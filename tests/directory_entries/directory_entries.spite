var console = Console()

func DirectoryEntries() {
    load "../../../spite_standard_library/windows"
    var tree = Directory("tests/directory_entries/tree")
    console.print(tree.path)
    walk(tree, "")
    var files_seen = count_files(tree)
    console.print("files", files_seen)
}

func walk(directory: Directory, indent: String) {
    var entries = directory.entries()
    var index = 0
    while index < entries.count() {
        var entry = entries[index]
        switch entry {
            Directory: show_folder(entry, indent)
            File: show_file(entry, indent)
        }
        index = index + 1
    }
}

func show_folder(folder: Directory, indent: String) {
    console.print("{indent}folder {folder.path}")
    walk(folder, "{indent}  ")
}

func show_file(file: File, indent: String) {
    var content = file.read()
    crash content
    var trimmed = content.trim()
    console.print("{indent}file {file.path}: {trimmed}")
}

func count_files(directory: Directory): Integer {
    var total = 0
    var entries = directory.entries()
    var index = 0
    while index < entries.count() {
        var entry = entries[index]
        switch entry {
            Directory: total = total + count_files(entry)
            File: total = total + 1
        }
        index = index + 1
    }
    return total
}
