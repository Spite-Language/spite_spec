var console = Console()

func DivisionsApart() {
    load "../../../spite_standard_library/windows"
    var first_line = console.read_line()
    crash first_line
    var parsed: Long? = first_line.trim()
    crash parsed
    var base_line = console.read_line()
    crash base_line
    var base: Long? = base_line.trim()
    crash base
    var negative = 0 - parsed
    var positive_digits = digit_sum(parsed, base)
    var negative_digits = digit_sum(negative, base)
    console.print("digits", positive_digits, negative_digits)
    var parts = parts_of(parsed, base)
    console.print("parts", parts)
    var small = parsed % 1000000000
    var seconds: Integer = small
    var few: Integer = base
    var backwards = 0 - seconds
    var forward_clock = clock(seconds)
    var backward_clock = clock(backwards)
    var few_clock = clock(few)
    console.print("clock", forward_clock, backward_clock, few_clock)
}

func digit_sum(value: Long, base: Long): Long {
    var rest = value
    var total: Long = 0
    var steps: Long = 0
    while rest != 0 {
        var digit = rest % base
        total = total + digit
        steps = steps + 1
        rest = rest / base
    }
    return total * 100 + steps
}

func parts_of(value: Long, divisor: Long): Long {
    var left = value / divisor
    var doubled = left * 2
    var kept = value % divisor
    return doubled * 1000 + kept
}

func clock(seconds: Integer): Integer {
    var rest = seconds % 60
    var minutes = seconds / 60
    var hours = minutes / 60
    var minute = minutes % 60
    return hours % 1000 * 1000000 + minute * 1000 + rest
}
