var console = Console()
var parts = 4

func DivisorProofEndsByAttributeWrite() {
    load "../../../spite_standard_library/windows"
    var shared = share(100)
    console.print(shared)
    console.print("never printed")
}

func share(total: Integer): Integer {
    if parts != 0 {
        parts = 0
        return total / parts
    }
    return 0
}
