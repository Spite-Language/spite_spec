var console = Console()

func DropHook() {
    load "../../../SpiteCompiler/.spite/library/common"
    load "../../../SpiteCompiler/.spite/library/windows"
    console.print("before")
    make_and_drop()
    console.print("after")
}

func make_and_drop() {
    var resource = Resource("file handle")
    console.print("using {resource.label}")
}
