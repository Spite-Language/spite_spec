var console = Console()
var first = DynamicLibrary("ucrtbase.dll", "", {})
var second = DynamicLibrary("ucrtbase.dll", "", {})
var other_rule = DynamicLibrary(
    "ucrtbase.dll",
    "",
    {"size_of": DynamicLibrary.FunctionDeclaration("strlen", [DynamicLibrary.Argument("text", String)], Integer)},
)
var other_file = DynamicLibrary(
    "kernel32.dll",
    "",
    {"current_process_identifier": DynamicLibrary.FunctionDeclaration("GetCurrentProcessId", [], Integer)},
)

func DynamicLibraryIsOneObject() {
    var keeper = Keeper()
    var kept = keeper.library
    console.print(first == second, first == kept, first == other_rule, first == other_file)
    console.print(first.handle == other_file.handle, first.file_name)
    var text_length = keeper.text_length("spite")
    var text_size = size_of("spite")
    var process = current_process_identifier()
    console.print(text_length, text_size, process > 0)
}

func size_of(text: String): Integer {
    var call = DynamicLibrary.Call(other_rule.functions["size_of"])
    call.arguments["text"] = text
    return call.call()
}

func current_process_identifier(): Integer {
    var call = DynamicLibrary.Call(other_file.functions["current_process_identifier"])
    return call.call()
}
