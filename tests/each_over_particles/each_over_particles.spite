var console = Console()

func EachOverParticles() {
    load "../../../spite_standard_library/windows"
    var particles = List<Particle>()
    var index = 0
    while index < 10000 {
        var particle = Particle(index)
        particles.append(particle)
        index = index + 1
    }
    particles.each_step()
    particles.each_step()
    var moved = particles.sum_position()
    console.print("after two steps the positions add up to", moved)
    particles.filter_awake().each_step()
    var after_filter = particles.sum_position()
    console.print("after a step of the awake ones only", after_filter)
    var few = List<Particle>()
    var only_particle = Particle(1)
    few.append(only_particle)
    few.each_step()
    var empty = List<Particle>()
    empty.each_step()
    var few_moved = few.sum_position()
    var empty_moved = empty.sum_position()
    console.print("a list of one and an empty list:", few_moved, empty_moved)
}
