var console = Console()

func EntryUnionNamedThrough() {
    load "../../../spite_standard_library/windows"
    var cat = Shelter.Cat()
    var keeper = Shelter.Keeper()
    var room = Shelter.Rooms.Room()
    var shelter = Shelter.Shelter()
    var first = keeper.named(cat)
    var second = room.named(cat)
    var third = shelter.named(cat)
    console.print(first, second, third)
}
