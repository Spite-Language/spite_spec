enum Part {
    'wing'
    'tail' = 7
}

var console = Console()

func EnumConversions() {
    load "../../../spite_standard_library/windows"
    var tag: Part = 'wing'
    var name = tag.to_string()
    var length = name.length()
    var number_of_wing: Integer = tag
    console.print(tag, length, number_of_wing, tag.class)
    var text = "tail"
    var found: Part? = text
    var missing_text = "fin"
    var missing: Part? = missing_text
    crash found
    var is_tail = found == 'tail'
    var number_of_tail: Integer = found
    console.print(is_tail, number_of_tail, not missing)
    var number = 7
    var numbered: Part? = number
    var unnumbered_value = 3
    var unnumbered: Part? = unnumbered_value
    crash numbered
    var values = Part.values
    var count = values.count()
    console.print(numbered, not unnumbered, count)
}
