var console = Console()

func EnumQualifiedNames() {
    var hero = Player()
    var named: Player.Job = 'archer'
    var plain: Player.Job = 'magician'
    hero.assign_job(named)
    console.print(hero.current_job)
    hero.assign_job(plain)
    console.print(hero.current_job)
    hero.assign_job('knight')
    console.print(hero.current_job)
}
