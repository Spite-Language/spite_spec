var console = Console()

func EnumReadInsideOwner() {
    var barracks = Barracks()
    var word = "captain"
    var from_text = barracks.read_text(word)
    var from_number = barracks.read_number(1)
    var unknown = barracks.read_text("general")
    console.print(from_text, from_number, unknown)
    barracks.assign(word)
    console.print(barracks.rank)
}
