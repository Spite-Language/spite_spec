var today: Weather.Sky = 'rain'
var console = Console()

func EnumReopening() {
    load "../../../SpiteCompiler/.spite/library/windows"
    load "package"
    load "mod"
    Weather.Sky.values.each(show_sky)
    var weather = Weather()
    weather.sky = 'snow'
    console.print("now", weather.sky)
}

func show_sky(sky: Weather.Sky) {
    var is_today = sky == today
    console.print(sky, is_today)
}
