enum Role {
    'guest'
    'admin' = 99
    'owner'
}

enum Phase {
    'early'
    'late'
}

var console = Console()

func EnumToInteger() {
    load "../../../spite_standard_library/windows"
    var role: Role = 'admin'
    var owner: Role = 'owner'
    var guest: Role = 'guest'
    var phase: Phase = 'late'
    var guest_number: Integer = guest
    var role_number: Integer = role
    var owner_number: Integer = owner
    var phase_number: Integer = phase
    var numbers = [guest_number, role_number, owner_number, phase_number]
    var shown = numbers.join(" ")
    console.print(shown)
}
