var console = Console()
var environment = Environment()

func EnvironmentFileMalformed() {
    load "../../../spite_standard_library/windows"
    var folder = Directory(".spite/environment_file_malformed")
    crash folder.create()
    var settings = File(".spite/environment_file_malformed/.env")
    crash settings.write_string("WORKERS=many\n")
    console.print(environment.workers)
    var loaded = environment.load_from_file(".spite/environment_file_malformed/.env")
    console.print(loaded, environment.workers)
}
