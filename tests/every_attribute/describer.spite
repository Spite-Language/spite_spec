generic $described_type

var _lines = List<String>()

func describe(_value: $described_type): String {
    _lines.clear()
    $described_type.attributes.each(describe_one)
    return _lines.join(", ")
}

func describe_one(attribute: Spite.AttributeDeclaration) {
    var kind = Kind<attribute.class>()
    var kind_name = kind.name()
    _lines.append("{attribute.name} is {kind_name}")
}

func reset_attribute(attribute: Spite.AttributeDeclaration, value: $described_type, fresh: $described_type) {
    value.attributes[attribute] = fresh.attributes[attribute]
}

func show_attribute(attribute: Spite.AttributeDeclaration, value: $described_type): String {
    return "{attribute.name} = {value.attributes[attribute]}"
}
