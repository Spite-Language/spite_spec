var console = Console()

func EveryClass() {
    load "../../../spite_standard_library/windows"
    var classes = Spite.Class.instances
    var index = 0
    while index < classes.count() {
        var described = classes[index]
        var text = ""
        if described.namespace {
            text = described.namespace.name_with_namespaces
        }
        var joined_map_name = described.functions.map_names().join(",")
        console.print(described.name, "{text}|", joined_map_name)
        index = index + 1
    }
    index = 0
    while index < classes.count() {
        var zoo_namespace = classes[index].namespace
        if zoo_namespace and zoo_namespace.name_with_namespaces == "Zoo" {
            run_speakers(classes[index])
        }
        index = index + 1
    }
}

func run_speakers(described: Spite.Class) {
    var speaker = described()
    var functions = described.functions.values()
    var index = 0
    while index < functions.count() {
        var declaration = functions[index]
        if declaration.name == "speak" {
            var call = Spite.Call(declaration, speaker)
            call.call()
        }
        index = index + 1
    }
}
