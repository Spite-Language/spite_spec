# ../../specs/style.md#the-file-content-budget
func FileContentBudget() {
    load "../../../spite_standard_library/common"
    var name = name_of('shade_0007')
    console.print(name)
    var held = words.count()
    console.print(held)
    nested(1)
    fill_part_1()
    fill_part_2()
    fill_part_3()
    fill_part_4()
    fill_part_5()
    fill_part_6()
    console.print(total)
}

