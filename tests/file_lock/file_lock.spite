var console = Console()

func FileLock() {
    load "../../../spite_standard_library/windows"
    var guard = File(".spite/file_lock.lock")
    if guard.exists() {
        crash guard.remove()
    }
    var held = guard.lock()
    crash held
    var made = guard.exists()
    held.unlock()
    var again = guard.lock()
    crash again
    again.unlock()
    crash guard.remove()
    console.print(made, "locked twice")
}
