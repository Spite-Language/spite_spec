var console = Console()

func FileReadBufferNegativeCount() {
    var file = File("tests/file_read_buffer_negative_count/file_read_buffer_negative_count.spite")
    var piece = file.read_buffer_at(0, 4)
    crash piece
    var size = piece.count()
    console.print("four bytes", size)
    var bad = file.read_buffer_at(0, -1)
    crash bad
    console.print("never printed")
}
