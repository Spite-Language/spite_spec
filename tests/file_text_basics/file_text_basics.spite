var console = Console()

func FileTextBasics() {
    load "../../../spite_standard_library/windows"
    var note = File(".spite/file_text_basics.txt")
    var written = note.write_string("one\n")
    var appended = note.append_string("two\n")
    var exists = note.exists()
    var content = note.read_as_string()
    crash content
    var lines = content.lines()
    var first = lines[0]
    crash first
    console.print(written, appended, exists, first, note.file_name)
    var removed = note.remove()
    var gone = note.exists()
    var nothing = note.read_as_string()
    var removed_again = note.remove()
    console.print(removed, gone, nothing, removed_again)
}
