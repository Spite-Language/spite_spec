var console = Console()

func FilesBesideAClass() {
    load "kitchen"
    var recipe = Recipe()
    var notes = recipe.notes()
    console.print(notes)
    var sauce = Sauces.Sauce()
    var sauce_notes = sauce.notes()
    console.print(sauce_notes)
    var shelf = Shelf<Sauces.Sauce>()
    var labelled = shelf.label()
    console.print(labelled)
    var kind: Spite.Class = Recipe
    var asked = kind.source_files.first()
    var folded = Recipe.source_files.first()
    crash asked and folded
    console.print("asked at run time, the same file:", asked.path == folded.path)
    var ends = folded.path.ends_with("/files_beside_a_class/kitchen/recipe.spite")
    console.print("the file of the package:", ends)
}
