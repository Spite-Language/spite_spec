generic $item_type

func label(): String {
    var written = $item_type.source_files.first()
    crash written
    var path: Path? = written.path
    crash path
    var folder = path.parent
    var text_path: Path? = "{folder}/sauce.txt"
    crash text_path
    var text = File(text_path).read_as_string()
    crash text
    var trimmed = text.trim()
    return "the shelf's item: {trimmed}"
}
