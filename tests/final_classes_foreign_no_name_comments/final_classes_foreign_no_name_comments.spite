var console = Console()
var build = Build()
var fixture = DynamicLibrary(
    "tests/final_classes_foreign_no_name_comments/fixture.dll",
    "",
    {
        "add_numbers": DynamicLibrary.FunctionDeclaration("add_numbers", [DynamicLibrary.Argument("first", Integer), DynamicLibrary.Argument("second", Integer)], Integer)
    },
)
var _two = 2
var _three = 3

func FinalClassesForeignNoNameComments() {
    var sum = add_numbers(_two, _three)
    console.print("the call answered", sum)
    var printed_path: Path? = "{build.program}/.spite/final_classes_foreign_no_name_comments/dynamic_library/dynamic_library.spite"
    crash printed_path
    var printed = File(printed_path)
    var text = printed.read_as_string()
    crash text
    var has_its_functions = text.contains("func open_library")
    var has_a_comment = text.contains("resolved")
    console.print("the class was printed with its own functions:", has_its_functions)
    console.print("a resolved name is written as a comment:", has_a_comment)
}

func add_numbers(first: Integer, second: Integer): Integer {
    var call = DynamicLibrary.Call(fixture.functions["add_numbers"])
    call.arguments["first"] = first
    call.arguments["second"] = second
    return call.call()
}
