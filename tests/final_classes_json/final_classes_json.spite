var console = Console()
var build = Build()

func FinalClassesJson() {
    load "../../../spite_standard_library/windows"
    var order = Order()
    var writer = JsonWriter<Order>()
    var text = writer.write(order)
    console.print(text)
    var template = File("{build.program}/.spite/final_classes_json/json_writer.spite")
    var template_text = template.read_as_string()
    crash template_text
    var template_lines = template_text.split("\n")
    var first_line = template_lines[0]
    console.print("the generic class is printed once:", first_line)
    var instance = File("{build.program}/.spite/final_classes_json/instantiated/json_writer_order.spite")
    var instance_text = instance.read_as_string()
    crash instance_text
    var instance_lines = instance_text.split("\n")
    var instance_first = instance_lines[0]
    var shows_the_type = instance_text.contains("write(value: Order?): String")
    console.print("the JsonWriter<Order> copy is printed as a type:", instance_first, shows_the_type)
}
