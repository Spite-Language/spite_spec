var console = Console()

var build = Build()

func FinalClassesPlatformFunctions() {
    load "../../../spite_standard_library/windows"
    var file_path: Path? = "{build.program}/monster.txt"
    crash file_path
    var file = File(file_path)
    var found = file.exists()
    var printed_path: Path? = "{build.program}/.spite/final_platform/file.spite"
    crash printed_path
    var printed = File(printed_path)
    var text = printed.read_as_string()
    crash text
    var from_windows = text.contains("ucrtbase.dll")
    console.print("exists:", found, "the printed File holds the platform's calls:", from_windows)
}
