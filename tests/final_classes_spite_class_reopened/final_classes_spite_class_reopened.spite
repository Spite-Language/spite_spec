var console = Console()

var build = Build()

func FinalClassesSpiteClassReopened() {
    var gadget = Gadget()
    var gadget_class = gadget.class
    var is_a_gadget = gadget_class.is_a_gadget()
    console.print("Gadget is a gadget:", is_a_gadget, gadget.size)
    var printed_path: Path? = "{build.program}/.spite/final_spite_class/spite/class.spite"
    crash printed_path
    var printed = File(printed_path)
    var text = printed.read_as_string()
    crash text
    var lines = text.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("func is_a_gadget") {
            var comment = lines[index - 1]
            crash comment
            var from_library = comment.contains("spite_standard_library")
            console.print("the function printed in Spite.Class comes from the library:", from_library)
        }
        index = index + 1
    }
}
