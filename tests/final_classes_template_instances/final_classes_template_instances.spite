var console = Console()

var build = Build()

func FinalClassesTemplateInstances() {
    var one = Runner<Mover>()
    one.run_one(1)
    var steps = one.read_steps()
    console.print("steps", steps)
    var printed_path: Path? = "{build.program}/.spite/final_template_instances/instantiated/runner_mover.spite"
    crash printed_path
    var printed = File(printed_path)
    var text = printed.read_as_string()
    crash text
    var has_render = text.contains("run_render_all(amount: Integer)")
    var has_update = text.contains("run_update_all")
    console.print("the called instance is printed:", has_render, "an instance nobody called:", has_update)
}
