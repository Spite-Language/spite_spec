var program = Program()
var opened = false

func open() {
    opened = true
}

func is_open(): Boolean {
    return opened
}

func wait_until_open(): Integer {
    var spins = 0
    while not is_open() {
        spins = spins + 1
    }
    return 42
}

func nap(): Integer {
    program.sleep(20)
    return 20
}
