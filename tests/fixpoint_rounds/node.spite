var distance = 0
var reach = 0
var _far = 1000000
var _last_position = 39
var name: String
var position: Integer

func Node(starting_position: Integer) {
    position = starting_position
    name = "node {starting_position}"
    start()
}

func start() {
    distance = _far
    if position == _last_position {
        distance = 0
    }
    reach = 0
}
