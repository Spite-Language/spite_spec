enum Weather {
    'sunny'
    'rainy'
}

var console = Console()
var _today: Weather = 'rainy'

func FnAnythingEnum() {
    var today: Weather = _today
    describe(today)
    var things = List<Anything>()
    things.append(today)
    var first = things[0]
    crash first
    console.print(first.class.name)
}

func describe(component: Anything) {
    console.print(component.class.name, component)
}
