var console = Console()

func FnAttributeValueIsAnything() {
    load "../../../spite_standard_library/windows"
    var hero = Hero("ada", 3)
    var held = hero.attributes.values()
    var index = 0
    while index < held.count() {
        var attribute = held[index]
        if attribute.value {
            var class_name = attribute.value.class.name
            console.print(attribute.name, class_name)
        }
        index = index + 1
    }
}
