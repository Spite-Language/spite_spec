var console = Console()

func FnAttributeValueKeepsItsClass() {
    var hero = Hero("ada", 3)
    hero.attributes.each(show_class)
}

func show_class(attribute: Spite.Attribute<Console.Debuggable>) {
    var class_name = attribute.value.class.name
    console.print(attribute.name, class_name, attribute.value)
}
