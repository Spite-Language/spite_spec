var console = Console()

func FnLibraryOperatorsReflected() {
    var summing = Integer.functions["sum"]
    crash summing
    var indexing = String.functions["get_at"]
    crash indexing
    var comparing = List<Integer>.functions["get_at"]
    crash comparing
    console.print(summing.name, indexing.name, comparing.name)
    var summed_arguments = summing.arguments.count()
    var indexed_returns = indexing.returns.name
    console.print(summed_arguments, indexed_returns)
}
