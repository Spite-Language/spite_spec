enum Mode {
    'quiet'
    'loud'
}

var console = Console()
var plain = DynamicLibrary(
    "tests/foreign_argument_kinds/fixture.dll",
    "",
    {
        "fill_bytes": DynamicLibrary.FunctionDeclaration(
            "fill_bytes",
            [
                DynamicLibrary.Argument("bytes", Buffer),
                DynamicLibrary.Argument("count", Integer),
            ],
            Integer,
        ),
        "choose": DynamicLibrary.FunctionDeclaration("choose", [DynamicLibrary.Argument("chosen", Boolean)], Integer),
        "mode_number": DynamicLibrary.FunctionDeclaration(
            "mode_number",
            [
                DynamicLibrary.Argument("mode", Mode),
            ],
            Integer,
        ),
        "whole_of_float": DynamicLibrary.FunctionDeclaration(
            "whole_of_float",
            [
                DynamicLibrary.Argument("value", Float),
            ],
            Integer,
        ),
        "whole_of_double": DynamicLibrary.FunctionDeclaration(
            "whole_of_double",
            [
                DynamicLibrary.Argument("value", Double),
            ],
            Integer,
        ),
    },
)
var windows = DynamicLibrary(
    "tests/foreign_argument_kinds/fixture.dll",
    "fixture.h",
    {
        "widths_added": DynamicLibrary.FunctionDeclaration(
            "WidthsAdded",
            [
                DynamicLibrary.Argument("tiny", Tiny),
                DynamicLibrary.Argument("small", Short),
                DynamicLibrary.Argument("byte", Byte),
                DynamicLibrary.Argument("port", UnsignedShort),
                DynamicLibrary.Argument("big", UnsignedInteger),
                DynamicLibrary.Argument("huge", UnsignedLong),
            ],
            Long,
        ),
        "forget": DynamicLibrary.FunctionDeclaration("Forget", [DynamicLibrary.Argument("value", Integer)], Nothing),
    },
)

func ForeignArgumentKinds() {
    buffer_is_filled_by_c()
    boolean_and_enum_arguments()
    floats_without_a_header()
    widths_with_a_header()
}

func buffer_is_filled_by_c() {
    var bytes = Buffer(8)
    var index = 0
    while index < 4 {
        bytes.append(0)
        index = index + 1
    }
    var count = bytes.count()
    var filled = fill_bytes(bytes, count)
    var first = bytes[0]
    var last = bytes[3]
    crash first
    crash last
    console.print("C filled", filled, "bytes:", first, last)
}

func boolean_and_enum_arguments() {
    var yes = true
    var no = false
    var loud: Mode = 'loud'
    var chosen_yes = choose(yes)
    var chosen_no = choose(no)
    var loudness = mode_number(loud)
    console.print("Boolean arguments", chosen_yes, chosen_no, "enum argument", loudness)
}

func floats_without_a_header() {
    var narrow: Float = 2.5
    var wide: Double = 2.5
    var from_float = whole_of_float(narrow)
    var from_double = whole_of_double(wide)
    console.print("a Float and a Double each pass as themselves:", from_float, from_double)
}

func widths_with_a_header() {
    var tiny: Tiny = -1
    var small: Short = -2
    var byte: Byte = Byte.Largest()
    var port: UnsignedShort = UnsignedShort.Largest()
    var big: UnsignedInteger = UnsignedInteger.Largest()
    var huge: UnsignedLong = 5
    var added = widths_added(tiny, small, byte, port, big, huge)
    forget(1)
    console.print("each width reaches its C type:", added)
}

func fill_bytes(bytes: Buffer, count: Integer): Integer {
    var call = DynamicLibrary.Call(plain.functions["fill_bytes"])
    call.arguments["bytes"] = bytes
    call.arguments["count"] = count
    return call.call()
}

func choose(chosen: Boolean): Integer {
    var call = DynamicLibrary.Call(plain.functions["choose"])
    call.arguments["chosen"] = chosen
    return call.call()
}

func mode_number(mode: Mode): Integer {
    var call = DynamicLibrary.Call(plain.functions["mode_number"])
    call.arguments["mode"] = mode
    return call.call()
}

func whole_of_float(value: Float): Integer {
    var call = DynamicLibrary.Call(plain.functions["whole_of_float"])
    call.arguments["value"] = value
    return call.call()
}

func whole_of_double(value: Double): Integer {
    var call = DynamicLibrary.Call(plain.functions["whole_of_double"])
    call.arguments["value"] = value
    return call.call()
}

func widths_added(
    tiny: Tiny,
    small: Short,
    byte: Byte,
    port: UnsignedShort,
    big: UnsignedInteger,
    huge: UnsignedLong,
): Long {
    var call = DynamicLibrary.Call(windows.functions["widths_added"])
    call.arguments["tiny"] = tiny
    call.arguments["small"] = small
    call.arguments["byte"] = byte
    call.arguments["port"] = port
    call.arguments["big"] = big
    call.arguments["huge"] = huge
    return call.call()
}

func forget(value: Integer) {
    var call = DynamicLibrary.Call(windows.functions["forget"])
    call.arguments["value"] = value
    call.call()
}
