var console = Console()
var program = Program()
var fixture = DynamicLibrary(
    "tests/foreign_call_without_callbacks_carries_no_trampoline/fixture.dll",
    "",
    {
        "add_numbers": DynamicLibrary.FunctionDeclaration("add_numbers", [DynamicLibrary.Argument("first", Integer), DynamicLibrary.Argument("second", Integer)], Integer)
    },
)
var _two = 2
var _three = 3

func ForeignCallWithoutCallbacksCarriesNoTrampoline() {
    var sum = add_numbers(_two, _three)
    console.print("the foreign call answered", sum)
    var path = program.executable_path()
    crash path
    var low_path = path.replace(".exe", ".low_ir.txt")
    var written_path: Path? = low_path
    crash written_path
    var written = File(written_path).read_as_string()
    crash written
    var lines = written.split("\n")
    var foreign_symbols = 0
    var trampolines = 0
    var callback_classes = 0
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.contains("address of 'add_numbers'") {
            foreign_symbols = foreign_symbols + 1
        }
        if line.starts_with("function _called_from_c_") {
            trampolines = trampolines + 1
        }
        if line.starts_with("function ForeignCallback.") {
            callback_classes = callback_classes + 1
        }
        index = index + 1
    }
    console.print("the called symbol is looked up in the build:", foreign_symbols > 0)
    console.print("trampolines:", trampolines, "callback class functions:", callback_classes)
}

func add_numbers(first: Integer, second: Integer): Integer {
    var call = DynamicLibrary.Call(fixture.functions["add_numbers"])
    call.arguments["first"] = first
    call.arguments["second"] = second
    return call.call()
}
