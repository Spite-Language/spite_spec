var console = Console()
var plain = DynamicLibrary("tests/foreign_callback_after_call/fixture.dll", 'identity', "")

func ForeignCallbackAfterCall() {
    load "../../../SpiteCompiler/.spite/library/windows"
    plain.keep_click(clicked)
    console.print("the call that handed it over has returned")
    plain.click(2)
}

func clicked(count: Integer) {
    console.print("clicked", count)
}
