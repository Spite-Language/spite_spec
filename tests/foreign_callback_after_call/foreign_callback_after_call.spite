var console = Console()
var plain = DynamicLibrary(
    "tests/foreign_callback_after_call/fixture.dll",
    "",
    {
        "keep_click": DynamicLibrary.FunctionDeclaration("keep_click", [DynamicLibrary.Argument("clicking", Spite.Function<Integer, Nothing>)], Nothing)
        "click": DynamicLibrary.FunctionDeclaration("click", [DynamicLibrary.Argument("count", Integer)], Nothing)
    },
)

func ForeignCallbackAfterCall() {
    var keeping = DynamicLibrary.Call(plain.functions["keep_click"])
    keeping.arguments["clicking"] = clicked
    keeping.call()
    console.print("the call that handed it over has returned")
    click(2)
}

func clicked(count: Integer) {
    console.print("clicked", count)
}

func click(count: Integer) {
    var call = DynamicLibrary.Call(plain.functions["click"])
    call.arguments["count"] = count
    call.call()
}
