var console = Console()
var plain = DynamicLibrary("tests/foreign_callback_dropped/fixture.dll", 'identity', "")
var clicks = Clicks()

func ForeignCallbackDropped() {
    load "../../../SpiteCompiler/.spite/library/common"
    load "../../../SpiteCompiler/.spite/library/windows"
    keep_and_click()
    console.print("the callback is dropped")
    plain.click(3)
}

func keep_and_click() {
    var clicking = ForeignCallback(clicks.clicked, 'no_context')
    plain.keep_click(clicking.address)
    plain.click(1)
}
