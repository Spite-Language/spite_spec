var console = Console()
var plain = DynamicLibrary("tests/foreign_callback_dropped/fixture.dll", 'identity', "")
var clicks = Clicks()

func ForeignCallbackDropped() {
    keep_and_click()
    console.print("the callback is dropped")
    click(3)
}

func keep_and_click() {
    var clicking = ForeignCallback(clicks.clicked, 'no_context')
    keep_click(clicking.address)
    click(1)
}

func keep_click(click: Long) {
    plain.keep_click(click)
}

func click(count: Integer) {
    plain.click(count)
}
