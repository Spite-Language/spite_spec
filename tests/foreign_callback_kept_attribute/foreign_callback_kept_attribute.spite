var plain = DynamicLibrary(
    "tests/foreign_callback_kept_attribute/fixture.dll",
    "",
    {
        "keep_click": DynamicLibrary.FunctionDeclaration(
            "keep_click",
            [
                DynamicLibrary.Argument("clicking", Long),
            ],
            Nothing,
        ),
        "click": DynamicLibrary.FunctionDeclaration("click", [DynamicLibrary.Argument("count", Integer)], Nothing),
    },
)
var clicks = Clicks()
var clicking: ForeignCallback? = null

func ForeignCallbackKeptAttribute() {
    hand_over()
    click(4)
}

func hand_over() {
    var made = ForeignCallback(clicks.clicked, 'no_context')
    keep_click(made.address)
    clicking = made
}

func keep_click(clicking: Long) {
    var call = DynamicLibrary.Call(plain.functions["keep_click"])
    call.arguments["clicking"] = clicking
    call.call()
}

func click(count: Integer) {
    var call = DynamicLibrary.Call(plain.functions["click"])
    call.arguments["count"] = count
    call.call()
}
