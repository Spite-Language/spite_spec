var console = Console()
var plain = DynamicLibrary(
    "tests/foreign_callback_kept_by_its_owner_is_freed/fixture.dll",
    "",
    {
        "tick": DynamicLibrary.FunctionDeclaration("tick", [DynamicLibrary.Argument("count", Integer)], Nothing),
    },
)
var _first = 1
var _second = 2

func ForeignCallbackKeptByItsOwnerIsFreed() {
    listen_and_let_go()
    console.print("the listener is gone")
    tick(_second)
    console.print("C called nothing after the listener unregistered")
}

func listen_and_let_go() {
    var listener = Listener("first")
    tick(_first)
    console.print(listener.name, "heard", listener.heard)
}

func tick(count: Integer) {
    var call = DynamicLibrary.Call(plain.functions["tick"])
    call.arguments["count"] = count
    call.call()
}
