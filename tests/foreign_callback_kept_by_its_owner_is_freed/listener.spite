var console = Console()
var plain = DynamicLibrary(
    "tests/foreign_callback_kept_by_its_owner_is_freed/fixture.dll",
    "",
    {
        "keep_tick": DynamicLibrary.FunctionDeclaration(
            "keep_tick",
            [
                DynamicLibrary.Argument("ticking", Long),
                DynamicLibrary.Argument("context", Long),
            ],
            Nothing,
        ),
        "tick": DynamicLibrary.FunctionDeclaration("tick", [DynamicLibrary.Argument("count", Integer)], Nothing),
        "forget_tick": DynamicLibrary.FunctionDeclaration("forget_tick", [], Nothing),
    },
)
var heard = 0
var _ticking: ForeignCallback? = null
var _last = 9
var name: String

func Listener(starting_name: String) {
    name = starting_name
    var ticking = ForeignCallback(ticked, 'context_last')
    _ticking = ticking
    keep_tick(ticking.address, ticking.context)
}

func ticked(count: Integer) {
    heard = heard + count
    console.print(name, "ticked", count)
}

func drop() {
    console.print("drop begins")
    tick(_last)
    forget_tick()
    console.print("drop ends")
}

func keep_tick(ticking: Long, context: Long) {
    var call = DynamicLibrary.Call(plain.functions["keep_tick"])
    call.arguments["ticking"] = ticking
    call.arguments["context"] = context
    call.call()
}

func tick(count: Integer) {
    var call = DynamicLibrary.Call(plain.functions["tick"])
    call.arguments["count"] = count
    call.call()
}

func forget_tick() {
    var call = DynamicLibrary.Call(plain.functions["forget_tick"])
    call.call()
}
