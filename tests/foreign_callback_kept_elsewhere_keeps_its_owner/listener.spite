var console = Console()
var plain = DynamicLibrary("tests/foreign_callback_kept_by_its_owner_is_freed/fixture.dll", 'identity', "")
var _ticking: ForeignCallback? = null
var name: String

func Listener(starting_name: String) {
    name = starting_name
    var ticking = ForeignCallback(ticked, 'context_last')
    _ticking = ticking
    keep_tick(ticking.address, ticking.context)
}

func hand_to(keeper: Keeper) {
    fallback _ticking
    keeper.keep(_ticking)
}

func ticked(count: Integer) {
    console.print(name, "ticked", count)
}

func keep_tick(ticking: Long, context: Long) {
    plain.keep_tick(ticking, context)
}
