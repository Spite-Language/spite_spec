var console = Console()
var plain = DynamicLibrary(
    "tests/foreign_callback_owner_drops_before_its_attributes/fixture.dll",
    "",
    {"click": DynamicLibrary.FunctionDeclaration("click", [DynamicLibrary.Argument("count", Integer)], Nothing)},
)
var _first = 1
var _second = 2

func ForeignCallbackOwnerDropsBeforeItsAttributes() {
    make_and_lose_a_speaker()
    console.print("the owner is gone")
    click(_second)
    console.print("C called nothing after the owner unregistered")
}

func make_and_lose_a_speaker() {
    var speaker = Speaker()
    click(_first)
    console.print("speaker made, clicked", speaker.heard)
}

func click(count: Integer) {
    var call = DynamicLibrary.Call(plain.functions["click"])
    call.arguments["count"] = count
    call.call()
}
