var console = Console()
var plain = DynamicLibrary(
    "tests/foreign_callback_owner_drops_before_its_attributes/fixture.dll",
    "",
    {
        "keep_click": DynamicLibrary.FunctionDeclaration(
            "keep_click",
            [
                DynamicLibrary.Argument("clicking", Long),
            ],
            Nothing,
        ),
        "click": DynamicLibrary.FunctionDeclaration("click", [DynamicLibrary.Argument("count", Integer)], Nothing),
        "forget_click": DynamicLibrary.FunctionDeclaration("forget_click", [], Nothing),
    },
)
var clicks = Clicks()
var clicking = ForeignCallback(clicks.clicked, 'no_context')
var heard = 1
var _last = 9

func Speaker() {
    keep_click(clicking.address)
}

func drop() {
    console.print("drop begins")
    click(_last)
    forget_click()
    console.print("drop ends")
}

func keep_click(clicking: Long) {
    var call = DynamicLibrary.Call(plain.functions["keep_click"])
    call.arguments["clicking"] = clicking
    call.call()
}

func click(count: Integer) {
    var call = DynamicLibrary.Call(plain.functions["click"])
    call.arguments["count"] = count
    call.call()
}

func forget_click() {
    var call = DynamicLibrary.Call(plain.functions["forget_click"])
    call.call()
}
