var console = Console()
var plain = DynamicLibrary("tests/foreign_callback_owner_drops_before_its_attributes/fixture.dll", 'identity', "")
var clicks = Clicks()
var clicking = ForeignCallback(clicks.clicked, 'no_context')
var heard = 1
var _last = 9

func Speaker() {
    keep_click(clicking.address)
}

func drop() {
    console.print("drop begins")
    click(_last)
    forget_click()
    console.print("drop ends")
}

func keep_click(clicking: Long) {
    plain.keep_click(clicking)
}

func click(count: Integer) {
    plain.click(count)
}

func forget_click() {
    plain.forget_click()
}
