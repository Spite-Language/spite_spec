var console = Console()
var library = DynamicLibrary(
    "tests/foreign_callback_reentered_site/fixture.dll",
    "",
    {
        "call_with": DynamicLibrary.FunctionDeclaration("call_with", [DynamicLibrary.Argument("value", Integer), DynamicLibrary.Argument("function", Spite.Function<Integer, Integer>)], Integer)
    },
)

func ForeignCallbackReenteredSite() {
    var total = count_down(4)
    console.print("the same call site reached again from inside its own callback:", total)
}

func count_down(value: Integer): Integer {
    fallback value > 0
    var below = call_with(value - 1, count_down)
    return below + value
}

func call_with(value: Integer, function: Spite.Function<Integer, Integer>): Integer {
    var call = DynamicLibrary.Call(library.functions["call_with"])
    call.arguments["value"] = value
    call.arguments["function"] = function
    return call.call()
}
