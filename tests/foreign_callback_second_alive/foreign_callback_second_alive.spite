var plain = DynamicLibrary(
    "tests/foreign_callback_second_alive/fixture.dll",
    "",
    {
        "keep_click": DynamicLibrary.FunctionDeclaration("keep_click", [DynamicLibrary.Argument("clicking", Long)], Nothing)
        "click": DynamicLibrary.FunctionDeclaration("click", [DynamicLibrary.Argument("count", Integer)], Nothing)
    },
)
var clicks = Clicks()

func ForeignCallbackSecondAlive() {
    var first = ForeignCallback(clicks.clicked, 'no_context')
    keep_click(first.address)
    click(1)
    var second = ForeignCallback(clicks.clicked, 'no_context')
    keep_click(second.address)
    click(2)
}

func keep_click(clicking: Long) {
    var call = DynamicLibrary.Call(plain.functions["keep_click"])
    call.arguments["clicking"] = clicking
    call.call()
}

func click(count: Integer) {
    var call = DynamicLibrary.Call(plain.functions["click"])
    call.arguments["count"] = count
    call.call()
}
