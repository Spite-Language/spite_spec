var plain = DynamicLibrary("tests/foreign_callback_second_alive/fixture.dll", 'identity', "")
var clicks = Clicks()

func ForeignCallbackSecondAlive() {
    load "../../../spite_standard_library/windows"
    var first = ForeignCallback(clicks.clicked, 'no_context')
    plain.keep_click(first.address)
    plain.click(1)
    var second = ForeignCallback(clicks.clicked, 'no_context')
    plain.keep_click(second.address)
    plain.click(2)
}
