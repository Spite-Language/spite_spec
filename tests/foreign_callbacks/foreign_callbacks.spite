var console = Console()
var plain = DynamicLibrary(
    "tests/foreign_callbacks/fixture.dll",
    "",
    {
        "sum_mapped": DynamicLibrary.FunctionDeclaration("sum_mapped", [DynamicLibrary.Argument("count", Integer), DynamicLibrary.Argument("mapping", Spite.Function<Integer, Integer>)], Integer)
        "visit_each": DynamicLibrary.FunctionDeclaration("visit_each", [DynamicLibrary.Argument("count", Integer), DynamicLibrary.Argument("visitor", Long), DynamicLibrary.Argument("context", Long)], Integer)
        "run_on_thread": DynamicLibrary.FunctionDeclaration("run_on_thread", [DynamicLibrary.Argument("reporter", Long), DynamicLibrary.Argument("context", Long), DynamicLibrary.Argument("value", Integer)], Nothing)
    },
)
var declared = DynamicLibrary(
    "tests/foreign_callbacks/fixture.dll",
    "fixture.h",
    {
        "declared_sum_mapped": DynamicLibrary.FunctionDeclaration("sum_mapped", [DynamicLibrary.Argument("count", Integer), DynamicLibrary.Argument("mapping", Spite.Function<Integer, Integer>)], Integer)
        "keep_procedure": DynamicLibrary.FunctionDeclaration("keep_procedure", [DynamicLibrary.Argument("procedure", Long)], Nothing)
        "send_message": DynamicLibrary.FunctionDeclaration("send_message", [DynamicLibrary.Argument("window", Long), DynamicLibrary.Argument("message", UnsignedInteger), DynamicLibrary.Argument("parameter", Long)], Long)
    },
)
var scale = 3
var windows = Windows()

func ForeignCallbacks() {
    var mapped = sum_mapped(4, scaled)
    var declared_mapped = declared_sum_mapped(2, scaled)
    console.print(mapped, declared_mapped)
    window_messages()
    visits()
    thread_reports()
}

func scaled(value: Integer): Integer {
    return value * scale
}

func window_messages() {
    windows.open(7, "main")
    windows.open(9, "tools")
    var procedure = ForeignCallback(windows.handle_message, 'no_context')
    keep_procedure(procedure.address)
    var answer = send_message(7, 15, 21)
    var other = send_message(9, 16, 5)
    console.print(answer, other)
}

func visits() {
    var visitor = Visitor(1.2)
    var visiting = ForeignCallback(visitor.visit, 'context_last')
    var visited = visit_each(4, visiting.address, visiting.context)
    console.print("visited", visited)
}

func thread_reports() {
    var tally = Tally("tally")
    var reporting = ForeignCallback(tally.report, 'context_first')
    run_on_thread(reporting.address, reporting.context, 10)
    console.print("total", tally.total)
}

func sum_mapped(count: Integer, mapping: Spite.Function<Integer, Integer>): Integer {
    var call = DynamicLibrary.Call(plain.functions["sum_mapped"])
    call.arguments["count"] = count
    call.arguments["mapping"] = mapping
    return call.call()
}

func declared_sum_mapped(count: Integer, mapping: Spite.Function<Integer, Integer>): Integer {
    var call = DynamicLibrary.Call(declared.functions["declared_sum_mapped"])
    call.arguments["count"] = count
    call.arguments["mapping"] = mapping
    return call.call()
}

func keep_procedure(procedure: Long) {
    var call = DynamicLibrary.Call(declared.functions["keep_procedure"])
    call.arguments["procedure"] = procedure
    call.call()
}

func send_message(window: Long, message: UnsignedInteger, parameter: Long): Long {
    var call = DynamicLibrary.Call(declared.functions["send_message"])
    call.arguments["window"] = window
    call.arguments["message"] = message
    call.arguments["parameter"] = parameter
    return call.call()
}

func visit_each(count: Integer, visitor: Long, context: Long): Integer {
    var call = DynamicLibrary.Call(plain.functions["visit_each"])
    call.arguments["count"] = count
    call.arguments["visitor"] = visitor
    call.arguments["context"] = context
    return call.call()
}

func run_on_thread(reporter: Long, context: Long, value: Integer) {
    var call = DynamicLibrary.Call(plain.functions["run_on_thread"])
    call.arguments["reporter"] = reporter
    call.arguments["context"] = context
    call.arguments["value"] = value
    call.call()
}
