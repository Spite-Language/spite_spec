var console = Console()
var plain = DynamicLibrary("tests/foreign_callbacks/fixture.dll", 'identity', "")
var declared = DynamicLibrary("tests/foreign_callbacks/fixture.dll", 'identity', "fixture.h")
var scale = 3
var windows = Windows()

func ForeignCallbacks() {
    var mapped = sum_mapped(4, scaled)
    var declared_mapped = declared_sum_mapped(2, scaled)
    console.print(mapped, declared_mapped)
    window_messages()
    visits()
    thread_reports()
}

func scaled(value: Integer): Integer {
    return value * scale
}

func window_messages() {
    windows.open(7, "main")
    windows.open(9, "tools")
    var procedure = ForeignCallback(windows.handle_message, 'no_context')
    keep_procedure(procedure.address)
    var answer = send_message(7, 15, 21)
    var other = send_message(9, 16, 5)
    console.print(answer, other)
}

func visits() {
    var visitor = Visitor(1.2)
    var visiting = ForeignCallback(visitor.visit, 'context_last')
    var visited = visit_each(4, visiting.address, visiting.context)
    console.print("visited", visited)
}

func thread_reports() {
    var tally = Tally("tally")
    var reporting = ForeignCallback(tally.report, 'context_first')
    run_on_thread(reporting.address, reporting.context, 10)
    console.print("total", tally.total)
}

func sum_mapped(count: Integer, mapping: Spite.Function<Integer, Integer>): Integer {
    return plain.sum_mapped(count, mapping)
}

func declared_sum_mapped(count: Integer, mapping: Spite.Function<Integer, Integer>): Integer {
    return declared.sum_mapped(count, mapping)
}

func keep_procedure(procedure: Long) {
    declared.keep_procedure(procedure)
}

func send_message(window: Long, message: UnsignedInteger, parameter: Long): Long {
    return declared.send_message(window, message, parameter)
}

func visit_each(count: Integer, visitor: Long, context: Long): Integer {
    return plain.visit_each(count, visitor, context)
}

func run_on_thread(reporter: Long, context: Long, value: Integer) {
    plain.run_on_thread(reporter, context, value)
}
