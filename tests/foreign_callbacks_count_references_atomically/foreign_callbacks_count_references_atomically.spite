var console = Console()
var hits = Hits()
var fixture = DynamicLibrary(
    "tests/foreign_callbacks_count_references_atomically/fixture.dll",
    "",
    {
        "report_from_threads": DynamicLibrary.FunctionDeclaration("report_from_threads", [DynamicLibrary.Argument("threads", Integer), DynamicLibrary.Argument("calls", Integer), DynamicLibrary.Argument("report", Long), DynamicLibrary.Argument("context", Long)], Nothing)
    },
)
var _threads = 4
var _calls = 2000

func ForeignCallbacksCountReferencesAtomically() {
    var ledger = Ledger("ledger")
    var reporting = ForeignCallback(ledger.report, 'context_first')
    report_from_threads(_threads, _calls, reporting.address, reporting.context)
    console.print("no call was lost:", hits.total)
}

func report_from_threads(threads: Integer, calls: Integer, report: Long, context: Long) {
    var call = DynamicLibrary.Call(fixture.functions["report_from_threads"])
    call.arguments["threads"] = threads
    call.arguments["calls"] = calls
    call.arguments["report"] = report
    call.arguments["context"] = context
    call.call()
}
