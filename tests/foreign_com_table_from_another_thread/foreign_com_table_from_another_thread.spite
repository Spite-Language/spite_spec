var console = Console()
var fixture = DynamicLibrary(
    "tests/foreign_com_table_from_another_thread/fixture.dll",
    "",
    {
        "keep_table": DynamicLibrary.FunctionDeclaration("keep_table", [DynamicLibrary.Argument("started", Long), DynamicLibrary.Argument("ended", Long)], Nothing)
        "play_on_a_thread": DynamicLibrary.FunctionDeclaration("play_on_a_thread", [DynamicLibrary.Argument("voice", Integer)], Nothing)
    },
)
var voices = Voices()
var starting = ForeignCallback(voices.started, 'no_context')
var ending = ForeignCallback(voices.ended, 'no_context')
var _first_voice = 7
var _second_voice = 9

func ForeignComTableFromAnotherThread() {
    keep_table(starting.address, ending.address)
    play_on_a_thread(_first_voice)
    play_on_a_thread(_second_voice)
    console.print("the table's entries were called:", voices.started_count, voices.ended_count)
    console.print("the second entry got its buffer:", voices.last_buffer)
}

func keep_table(started: Long, ended: Long) {
    var call = DynamicLibrary.Call(fixture.functions["keep_table"])
    call.arguments["started"] = started
    call.arguments["ended"] = ended
    call.call()
}

func play_on_a_thread(voice: Integer) {
    var call = DynamicLibrary.Call(fixture.functions["play_on_a_thread"])
    call.arguments["voice"] = voice
    call.call()
}
