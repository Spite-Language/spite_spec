var console = Console()
var c_runtime = DynamicLibrary("ucrtbase.dll", 'identity', "")

func ForeignDeclarations() {
    var measurer = Measurer()
    var measured = measurer.length_of("spite")
    var magnitude = magnitude_of(-7)
    var measuring = magnitude_of
    var through_a_value = measuring(-3)
    console.print(measured, magnitude, through_a_value)
}

func magnitude_of(value: Integer): Integer {
    return c_runtime.abs(value)
}
