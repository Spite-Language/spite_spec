var c_runtime = DynamicLibrary(
    "ucrtbase.dll",
    "",
    {
        "length_of": DynamicLibrary.FunctionDeclaration("strlen", [DynamicLibrary.Argument("text", String)], Long),
    },
)

func length_of(text: String): Long {
    var call = DynamicLibrary.Call(c_runtime.functions["length_of"])
    call.arguments["text"] = text
    return call.call()
}
