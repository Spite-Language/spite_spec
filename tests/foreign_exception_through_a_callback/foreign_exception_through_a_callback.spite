var console = Console()
var fixture = DynamicLibrary(
    "tests/foreign_exception_through_a_callback/fixture.dll",
    "",
    {
        "throwing": DynamicLibrary.FunctionDeclaration(
            "throw_now",
            [
                DynamicLibrary.Argument("count", Integer),
            ],
            Nothing,
        ),
        "call_and_catch": DynamicLibrary.FunctionDeclaration(
            "call_and_catch",
            [
                DynamicLibrary.Argument("callback", Spite.Function<Integer, Nothing>),
            ],
            Integer,
        ),
    },
)

func ForeignExceptionThroughACallback() {
    console.print("before the throw")
    var answer = call_and_catch(throwing)
    console.print("never printed", answer)
}

func throwing(count: Integer) {
    var call = DynamicLibrary.Call(fixture.functions["throwing"])
    call.arguments["count"] = count
    call.call()
}

func call_and_catch(callback: Spite.Function<Integer, Nothing>): Integer {
    var call = DynamicLibrary.Call(fixture.functions["call_and_catch"])
    call.arguments["callback"] = callback
    return call.call()
}
