var console = Console()
var fixture = DynamicLibrary(
    "tests/foreign_fault_the_library_handles/fixture.dll",
    "",
    {
        "read_or_answer": DynamicLibrary.FunctionDeclaration("read_or_answer", [DynamicLibrary.Argument("address", Long)], Integer)
    },
)

func ForeignFaultTheLibraryHandles() {
    var nowhere: Long = 0
    var answer = read_or_answer(nowhere)
    console.print("the library handled its own fault", answer)
}

func read_or_answer(address: Long): Integer {
    var call = DynamicLibrary.Call(fixture.functions["read_or_answer"])
    call.arguments["address"] = address
    return call.call()
}
