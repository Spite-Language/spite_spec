singleton

var console = Console()
var fixture = DynamicLibrary(
    "tests/foreign_fault_under_a_function_ending_in_a_stop/fixture.dll",
    "",
    {"largest_integer": DynamicLibrary.FunctionDeclaration("largest_integer", [], Integer)},
)

func add_one() {
    var largest = largest_integer()
    var bigger = largest + 1
    console.print(bigger)
}

func largest_integer(): Integer {
    var call = DynamicLibrary.Call(fixture.functions["largest_integer"])
    return call.call()
}
