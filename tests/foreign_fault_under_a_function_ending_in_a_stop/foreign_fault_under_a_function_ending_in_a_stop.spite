var console = Console()
var fixture = DynamicLibrary(
    "tests/foreign_fault_under_a_function_ending_in_a_stop/fixture.dll",
    "",
    {
        "call_back_guarded": DynamicLibrary.FunctionDeclaration(
            "call_back_guarded",
            [
                DynamicLibrary.Argument("callback", Long),
            ],
            Integer,
        ),
    },
)
var adder = Adder()
var adding = ForeignCallback(adder.add_one, 'no_context')

func ForeignFaultUnderAFunctionEndingInAStop() {
    console.print("before the fault")
    var answer = call_back_guarded(adding.address)
    console.print("never printed", answer)
}

func call_back_guarded(callback: Long): Integer {
    var call = DynamicLibrary.Call(fixture.functions["call_back_guarded"])
    call.arguments["callback"] = callback
    return call.call()
}
