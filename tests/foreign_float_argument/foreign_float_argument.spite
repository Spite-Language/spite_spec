var console = Console()
var windows = DynamicLibrary(
    "tests/foreign_float_argument/fixture.dll",
    "fixture.h",
    {
        "scaled": DynamicLibrary.FunctionDeclaration("Scaled", [DynamicLibrary.Argument("factor", Float), DynamicLibrary.Argument("count", Integer)], Integer)
        "wide_sum": DynamicLibrary.FunctionDeclaration("WideSum", [DynamicLibrary.Argument("first", Long), DynamicLibrary.Argument("second", UnsignedLong)], Long)
    },
)

func ForeignFloatArgument() {
    var factor: Float = 1.5
    var from_a_float = scaled(factor, 4)
    var from_a_literal = scaled(2.5, 4)
    var wide: Double = 0.25
    var single: Float? = wide
    crash single
    var from_a_double = scaled(single, 8)
    var declared_sum = wide_sum(-1, 3)
    console.print(from_a_float, from_a_literal, from_a_double, declared_sum)
}

func scaled(factor: Float, count: Integer): Integer {
    var call = DynamicLibrary.Call(windows.functions["scaled"])
    call.arguments["factor"] = factor
    call.arguments["count"] = count
    return call.call()
}

func wide_sum(first: Long, second: UnsignedLong): Long {
    var call = DynamicLibrary.Call(windows.functions["wide_sum"])
    call.arguments["first"] = first
    call.arguments["second"] = second
    return call.call()
}
