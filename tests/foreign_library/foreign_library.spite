type PointPair {
    across: Integer
    down: Integer
}

var console = Console()
var plain = DynamicLibrary(
    "tests/foreign_library/fixture.dll",
    "",
    {
        "sum_of_numbers": DynamicLibrary.FunctionDeclaration("add_numbers", [DynamicLibrary.Argument("first", Integer), DynamicLibrary.Argument("second", Integer)], Integer)
        "half_of": DynamicLibrary.FunctionDeclaration("half_of", [DynamicLibrary.Argument("value", Integer)], Double)
        "big_number": DynamicLibrary.FunctionDeclaration("big_number", [], Long)
        "greeting": DynamicLibrary.FunctionDeclaration("greeting", [], String)
        "length_of": DynamicLibrary.FunctionDeclaration("text_length", [DynamicLibrary.Argument("text", String)], Integer)
        "point_sum": DynamicLibrary.FunctionDeclaration("sum_point", [DynamicLibrary.Argument("point", PointPair)], Integer)
        "values_sum": DynamicLibrary.FunctionDeclaration("sum_values", [DynamicLibrary.Argument("values", List<Integer>), DynamicLibrary.Argument("count", Integer)], Integer)
        "double_values": DynamicLibrary.FunctionDeclaration("double_values", [DynamicLibrary.Argument("values", List<Integer>), DynamicLibrary.Argument("count", Integer)], Nothing)
        "guessed_wide_sum": DynamicLibrary.FunctionDeclaration("wide_sum", [DynamicLibrary.Argument("first", Long), DynamicLibrary.Argument("second", Long)], Long)
    },
)
var camel = DynamicLibrary(
    "tests/foreign_library/fixture.dll",
    "",
    {
        "product_of_numbers": DynamicLibrary.FunctionDeclaration("multiplyNumbers", [DynamicLibrary.Argument("first", Integer), DynamicLibrary.Argument("second", Integer)], Integer)
    },
)
var headerless = DynamicLibrary(
    "tests/foreign_library/fixture.dll",
    "",
    {"answer_position": DynamicLibrary.FunctionDeclaration("GetAnswerPos", [], Integer)},
)
var windows = DynamicLibrary(
    "tests/foreign_library/fixture.dll",
    "fixture.h",
    {
        "move_point": DynamicLibrary.FunctionDeclaration("MovePoint", [DynamicLibrary.Argument("point", PointPair)], Nothing)
        "declared_wide_sum": DynamicLibrary.FunctionDeclaration("WideSum", [DynamicLibrary.Argument("first", Long), DynamicLibrary.Argument("second", UnsignedLong)], Long)
        "scaled_value": DynamicLibrary.FunctionDeclaration("Scaled", [DynamicLibrary.Argument("factor", Float), DynamicLibrary.Argument("value", Integer)], Integer)
        "doubled_handle": DynamicLibrary.FunctionDeclaration("HandleTwice", [DynamicLibrary.Argument("handle", Long)], Long)
        "forget": DynamicLibrary.FunctionDeclaration("Forget", [DynamicLibrary.Argument("value", Integer)], Nothing)
    },
)

func ForeignLibrary() {
    var add_numbers = sum_of_numbers(2, 3)
    var multiply_numbers = product_of_numbers(4, 5)
    var windows_answer_position = answer_position()
    console.print(add_numbers, multiply_numbers, windows_answer_position)
    var half_of_as_double = half_of(7)
    var big_number_as_long = big_number()
    var greeting_as_text = greeting()
    console.print(half_of_as_double, big_number_as_long, greeting_as_text)
    var text_length = length_of("spite")
    console.print(text_length, windows.fixture_answer, windows.fixture_limit)
    var spot: PointPair = Spot()
    var sum_point = point_sum(spot)
    console.print(sum_point)
    move_point(spot)
    console.print(spot.across, spot.down)
    var values = [1, 2, 3]
    var values_count = values.count()
    var sum_values = values_sum(values, values_count)
    console.print(sum_values)
    values_count = values.count()
    double_values(values, values_count)
    var joined_values = values.join(",")
    console.print(joined_values)
    wide_arguments()
}

func wide_arguments() {
    var guessed_sum = guessed_wide_sum(-1, 0)
    var declared_sum = declared_wide_sum(-1, 3)
    var scaled = scaled_value(1.5, 4)
    var handle: Long = 21
    var handle_twice = doubled_handle(handle)
    forget(1)
    console.print(guessed_sum, declared_sum, scaled, handle_twice)
}

func sum_of_numbers(first: Integer, second: Integer): Integer {
    var call = DynamicLibrary.Call(plain.functions["sum_of_numbers"])
    call.arguments["first"] = first
    call.arguments["second"] = second
    return call.call()
}

func product_of_numbers(first: Integer, second: Integer): Integer {
    var call = DynamicLibrary.Call(camel.functions["product_of_numbers"])
    call.arguments["first"] = first
    call.arguments["second"] = second
    return call.call()
}

func answer_position(): Integer {
    var call = DynamicLibrary.Call(headerless.functions["answer_position"])
    return call.call()
}

func half_of(value: Integer): Double {
    var call = DynamicLibrary.Call(plain.functions["half_of"])
    call.arguments["value"] = value
    return call.call()
}

func big_number(): Long {
    var call = DynamicLibrary.Call(plain.functions["big_number"])
    return call.call()
}

func greeting(): String {
    var call = DynamicLibrary.Call(plain.functions["greeting"])
    return call.call()
}

func length_of(text: String): Integer {
    var call = DynamicLibrary.Call(plain.functions["length_of"])
    call.arguments["text"] = text
    return call.call()
}

func point_sum(point: PointPair): Integer {
    var call = DynamicLibrary.Call(plain.functions["point_sum"])
    call.arguments["point"] = point
    return call.call()
}

func move_point(point: PointPair) {
    var call = DynamicLibrary.Call(windows.functions["move_point"])
    call.arguments["point"] = point
    call.call()
}

func values_sum(values: List<Integer>, count: Integer): Integer {
    var call = DynamicLibrary.Call(plain.functions["values_sum"])
    call.arguments["values"] = values
    call.arguments["count"] = count
    return call.call()
}

func double_values(values: List<Integer>, count: Integer) {
    var call = DynamicLibrary.Call(plain.functions["double_values"])
    call.arguments["values"] = values
    call.arguments["count"] = count
    call.call()
}

func guessed_wide_sum(first: Long, second: Long): Long {
    var call = DynamicLibrary.Call(plain.functions["guessed_wide_sum"])
    call.arguments["first"] = first
    call.arguments["second"] = second
    return call.call()
}

func declared_wide_sum(first: Long, second: UnsignedLong): Long {
    var call = DynamicLibrary.Call(windows.functions["declared_wide_sum"])
    call.arguments["first"] = first
    call.arguments["second"] = second
    return call.call()
}

func scaled_value(factor: Float, value: Integer): Integer {
    var call = DynamicLibrary.Call(windows.functions["scaled_value"])
    call.arguments["factor"] = factor
    call.arguments["value"] = value
    return call.call()
}

func doubled_handle(handle: Long): Long {
    var call = DynamicLibrary.Call(windows.functions["doubled_handle"])
    call.arguments["handle"] = handle
    return call.call()
}

func forget(value: Integer) {
    var call = DynamicLibrary.Call(windows.functions["forget"])
    call.arguments["value"] = value
    call.call()
}
