var console = Console()
var absent = DynamicLibrary(
    "tests/foreign_missing_library/absent.dll",
    "",
    {"click": DynamicLibrary.FunctionDeclaration("click", [DynamicLibrary.Argument("times", Integer)], Nothing)},
)

func ForeignMissingLibrary() {
    console.print("before the library is used")
    click(1)
    console.print("never printed")
}

func click(times: Integer) {
    var call = DynamicLibrary.Call(absent.functions["click"])
    call.arguments["times"] = times
    call.call()
}
