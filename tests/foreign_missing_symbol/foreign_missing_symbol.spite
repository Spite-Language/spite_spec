var console = Console()
var plain = DynamicLibrary(
    "tests/foreign_missing_symbol/fixture.dll",
    "",
    {
        "ring_bell": DynamicLibrary.FunctionDeclaration("ring_bell", [DynamicLibrary.Argument("times", Integer)], Nothing)
    },
)

func ForeignMissingSymbol() {
    console.print("before the library is used")
    ring_bell(1)
    console.print("never printed")
}

func ring_bell(times: Integer) {
    var call = DynamicLibrary.Call(plain.functions["ring_bell"])
    call.arguments["times"] = times
    call.call()
}
