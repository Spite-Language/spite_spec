var console = Console()
var kernel = DynamicLibrary(
    "kernel32.dll",
    "",
    {
        "tick_count": DynamicLibrary.FunctionDeclaration("GetTickCount64", [], Long)
        "current_process_identifier": DynamicLibrary.FunctionDeclaration("GetCurrentProcessId", [], Integer)
    },
)

func ForeignNames() {
    var tick = tick_count()
    var running = current_process_identifier()
    console.print("asked", tick > 0, running > 0)
}

func tick_count(): Long {
    var call = DynamicLibrary.Call(kernel.functions["tick_count"])
    return call.call()
}

func current_process_identifier(): Integer {
    var call = DynamicLibrary.Call(kernel.functions["current_process_identifier"])
    return call.call()
}
