type PointPair {
    down: Integer
    across: Integer
}

var console = Console()
var windows = DynamicLibrary(
    "tests/foreign_struct_field_order_is_not_checked/fixture.dll",
    "fixture.h",
    {
        "move_point": DynamicLibrary.FunctionDeclaration("MovePoint", [DynamicLibrary.Argument("point", PointPair)], Nothing)
    },
)

func ForeignStructFieldOrderIsNotChecked() {
    var spot: PointPair = Spot()
    move_point(spot)
    console.print("C moved the first field by 10 and the second by 20:", spot.down, spot.across)
}

func move_point(point: PointPair) {
    var call = DynamicLibrary.Call(windows.functions["move_point"])
    call.arguments["point"] = point
    call.call()
}
