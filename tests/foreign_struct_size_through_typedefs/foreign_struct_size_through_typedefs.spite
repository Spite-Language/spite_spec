type PointPair {
    down: Integer
    across: Integer
}

var console = Console()
var windows = DynamicLibrary(
    "tests/foreign_struct_size_through_typedefs/fixture.dll",
    "fixture.h",
    {
        "move_point": DynamicLibrary.FunctionDeclaration(
            "MovePoint",
            [
                DynamicLibrary.Argument("point", PointPair),
            ],
            Nothing,
        ),
    },
)

func ForeignStructSizeThroughTypedefs() {
    var spot: PointPair = {down: 1, across: 2}
    move_point(spot)
    console.print("a struct named through a pointer typedef measures the same:", spot.down, spot.across)
}

func move_point(point: PointPair) {
    var call = DynamicLibrary.Call(windows.functions["move_point"])
    call.arguments["point"] = point
    call.call()
}
