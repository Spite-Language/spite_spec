var console = Console()
var c_runtime = DynamicLibrary(
    "ucrtbase.dll",
    "stdlib.h",
    {
        "magnitude_of": DynamicLibrary.FunctionDeclaration("abs", [DynamicLibrary.Argument("value", Integer)], Integer),
    },
)

func ForeignSystemHeader() {
    var magnitude = magnitude_of(-7)
    console.print("abs through stdlib.h:", magnitude)
}

func magnitude_of(value: Integer): Integer {
    var call = DynamicLibrary.Call(c_runtime.functions["magnitude_of"])
    call.arguments["value"] = value
    return call.call()
}
