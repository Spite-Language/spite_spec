var console = Console()
var c_runtime = DynamicLibrary(
    "ucrtbase.dll",
    "",
    {"length_of": DynamicLibrary.FunctionDeclaration("strlen", [DynamicLibrary.Argument("text", String)], Integer)},
)

func ForeignTextEndByte() {
    var written = "plain"
    var plain = length_of(written)
    console.print("a written text:", plain)
    var count = 12
    var joined = "count {count}"
    var joined_length = length_of(joined)
    console.print("a joined text:", joined_length)
    var sliced = joined.slice(0, 3)
    crash sliced
    var sliced_length = length_of(sliced)
    console.print("a slice:", sliced_length)
    var grown = "ab"
    var letter = "c"
    var index = 0
    while index < 40 {
        grown = grown + letter
        index = index + 1
    }
    var grown_length = length_of(grown)
    var counted = grown.length()
    console.print("a grown text:", grown_length, counted)
}

func length_of(text: String): Integer {
    var call = DynamicLibrary.Call(c_runtime.functions["length_of"])
    call.arguments["text"] = text
    return call.call()
}
