var console = Console()
var fixture = DynamicLibrary(
    "tests/foreign_threads_call_into_a_singleton/fixture.dll",
    "",
    {
        "hit_from_threads": DynamicLibrary.FunctionDeclaration(
            "hit_from_threads",
            [
                DynamicLibrary.Argument("threads", Integer),
                DynamicLibrary.Argument("calls", Integer),
                DynamicLibrary.Argument("hit", Long),
            ],
            Nothing,
        ),
    },
)
var hits = Hits()
var counting = ForeignCallback(hits.hit, 'no_context')
var _threads = 4
var _calls = 5000

func ForeignThreadsCallIntoASingleton() {
    hit_from_threads(_threads, _calls, counting.address)
    console.print("no call was lost:", hits.total)
}

func hit_from_threads(threads: Integer, calls: Integer, hit: Long) {
    var call = DynamicLibrary.Call(fixture.functions["hit_from_threads"])
    call.arguments["threads"] = threads
    call.arguments["calls"] = calls
    call.arguments["hit"] = hit
    call.call()
}
