var console = Console()
var library = DynamicLibrary("tests/foreign_unreached_symbol_is_not_imported/fixture.dll", 'identity', "")

func ForeignUnreachedSymbolIsNotImported() {
    var sum = sum_of(2, 3)
    console.print("the library answered", sum)
}

func never_called() {
    symbol_the_library_does_not_export()
}

func sum_of(first: Integer, second: Integer): Integer {
    return library.add_numbers(first, second)
}

func symbol_the_library_does_not_export() {
    library.symbol_the_library_does_not_export()
}
