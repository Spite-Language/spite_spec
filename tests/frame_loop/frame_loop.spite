var console = Console()
var program = Program()
var frame = 0
var running = true

func FrameLoop() {
    load "../../../spite_standard_library/windows"
    var ten_milliseconds = Duration(10, 'milliseconds')
    while running and frame < 200 {
        frame = frame + 1
        program.sleep(ten_milliseconds)
    }
    console.print("stopped")
}
