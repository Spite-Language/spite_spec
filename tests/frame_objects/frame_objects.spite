var console = Console()
var kept = List<Point>()

func FrameObjects() {
    load "../../../spite_standard_library/windows"
    var moved = stepped(1000)
    console.print("stepped to", moved)
    var measured = measured_length()
    console.print("length squared", measured)
    keep_one()
    show_sharing()
    show_turns()
    show_kept()
    show_copies()
}

func show_copies() {
    var original = Point(3.0, 4.0)
    var snapshot = original.copy()
    var deep = original.deep_copy()
    snapshot.x = 10.0
    deep.move_by(snapshot)
    var total = snapshot.length_squared() + deep.length_squared()
    console.print("copies total", total, "original", original.x, original.y)
}

func stepped(count: Integer): Point {
    var position = Point(0.0, 0.0)
    var velocity = Point(1.0, 0.5)
    var step = 0
    while step < count {
        var nudge = velocity.scaled(0.25)
        position = position + nudge
        position.move_by(nudge)
        step = step + 1
    }
    return position
}

func measured_length(): Float {
    var first = Point(1.0, 2.0)
    var second = Point(3.0, 4.0)
    var third = Point(-1.0, 0.5)
    var total = first + second + -third
    var pair = first + second
    return total.length_squared() + pair.length_squared()
}

func keep_one() {
    var stored = Point(3.0, 4.0)
    kept.append(stored)
}

func show_sharing() {
    var first = Point(1.0, 1.0)
    var second = first
    second.x = 5.0
    console.print("shared:", first, second)
}

func show_turns() {
    var start = Point(2.0, 1.0)
    var quarter = start.turned()
    var half = quarter.turned()
    console.print("turned", quarter, "twice", half, "start", start)
}

func show_kept() {
    var first = kept.first()
    crash first
    first.move_by(first)
    var again = kept.first()
    crash again
    console.print("kept point moved to", again)
}
