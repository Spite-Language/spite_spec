var console = Console()
var mover = Mover()

func FunctionDeclarationHandedOnPerPattern() {
    run_update_each()
    tell_update_each()
    console.print(mover.steps)
}

func run_phase_each(phase: Spite.FunctionDeclaration) {
    report(phase)
    mover.phase_each()
}

func tell_kind(kind: Spite.FunctionDeclaration) {
    report(kind)
    mover.kind()
}

func report(declaration: Spite.FunctionDeclaration) {
    console.print(declaration.name, declaration.hole)
}
