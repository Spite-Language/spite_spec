var console = Console()
var label = "the program"

func FunctionOwner() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var change = shouted
    var owner = change.owner
    var quiet = change("quiet")
    console.print(owner.label, quiet)
    var shouter = Shouter("the shouter")
    var shout = shouter.shout
    var bound = shout.owner
    var loud = shout("loud")
    console.print(bound.label, loud)
}

func shouted(text: String): String {
    return text.upper_case()
}
