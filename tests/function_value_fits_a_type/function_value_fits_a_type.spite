type Shown {
    to_string: Spite.Function<String>
}

var console = Console()

func FunctionValueFitsAType() {
    var button = Button()
    button.on_press = shout
    show(button)
    var named: Shown = shout
    console.print("named", named.class.name, "'{named}'")
}

func shout() {
    console.print("pressed")
}

func show(fresh: Button) {
    fresh.attributes.each(show_text)
    fresh.attributes.each(show_function)
}

func show_text(attribute: Spite.Attribute<String>) {
    console.print(attribute.name, attribute.value.class.name, "'{attribute.value}'")
}

func show_function(attribute: Spite.Attribute<Spite.Function<Nothing>?>) {
    var named: Shown? = attribute.value
    if named.class == Spite.Function {
        console.print(attribute.name, named.class.name, "'{named}'")
        named.call_function()
    } else {
        console.print(attribute.name, "is null")
    }
}
