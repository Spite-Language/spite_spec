type Held {
    to_debug: Spite.Function<String>
}

var console = Console()

func FunctionValueReadThroughATypeIsFreed() {
    var button = Button()
    button.on_press = shout
    var attribute = button.attributes["on_press"]
    crash attribute
    crash attribute.value
    if attribute.value.class == Spite.Function {
        attribute.value.call_function()
    }
    var pressed = button.on_press
    crash pressed
    var held: Held = pressed
    if held.class == Spite.Function {
        held.call_function()
    }
}

func shout() {
    console.print("pressed")
}
