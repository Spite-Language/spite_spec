var console = Console()

func FunctionValues() {
    var robot = Robot("unit")
    var functions = robot.functions.values()
    var index = 0
    while index < functions.count() {
        var function = functions[index]
        var arguments_count = function.declaration.arguments.count()
        console.print(function.name, arguments_count, function.declaration.returns)
        if function.name.starts_with("step_") {
            function.call_function()
        }
        index = index + 1
    }
    var joined_log = robot.log.join(",")
    console.print(joined_log)
    crash robot.functions["describe"]
    var describe = robot.functions["describe"]
    crash describe.declaration.arguments.count() == 2
    console.print(describe.declaration.arguments[0].name, describe.declaration.arguments[0].class, describe.declaration.arguments[1].class)
    var log_count = robot.log.count()
    console.print(log_count)
    robot.name = "renamed"
    var joined_map_name = robot.functions.map_names().join(" ")
    console.print(joined_map_name)
}
