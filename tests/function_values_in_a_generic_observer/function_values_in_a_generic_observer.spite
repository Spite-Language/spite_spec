var console = Console()

func FunctionValuesInAGenericObserver() {
    var scores = Observer<Integer>()
    var left = Screen("left")
    var right = Screen("right")
    scores.subscribe(left.show)
    scores.subscribe(right.show)
    scores.subscribe(left.show)
    var subscribed = scores.listeners.count()
    console.print("subscribed", subscribed)
    scores.tell(1)
    scores.unsubscribe(left.show)
    var after_one = scores.listeners.count()
    console.print("unsubscribed", after_one)
    scores.tell(2)
    scores.unsubscribe(left.show)
    var after_again = scores.listeners.count()
    console.print("again", after_again)
    var names = Observer<String>()
    names.subscribe(right.show_text)
    var also_right = Screen("right")
    names.unsubscribe(also_right.show_text)
    var named = names.listeners.count()
    console.print("an equal screen", named)
}
