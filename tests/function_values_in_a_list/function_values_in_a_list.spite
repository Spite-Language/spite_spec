var console = Console()
var handlers = List<Spite.Function<Integer, Nothing>>()

func FunctionValuesInAList() {
    var ada = Listener("ada")
    var bob = Listener("bob")
    var also_ada = Listener("ada")
    handlers.append(ada.heard)
    handlers.append(bob.heard)
    handlers.append(bob.ignored)
    tell(1)
    var heard_at = handlers.index_of(bob.heard)
    var ignored_at = handlers.index_of(bob.ignored)
    console.print("index of", heard_at, ignored_at)
    var equal_at = handlers.index_of(also_ada.heard)
    var holds_equal = handlers.contains(also_ada.heard)
    console.print("an equal owner", equal_at, holds_equal)
    var missing_at = handlers.index_of(ada.ignored)
    var holds_missing = handlers.contains(ada.ignored)
    console.print("missing", missing_at, holds_missing)
    handlers.remove(bob.heard)
    handlers.remove(ada.ignored)
    tell(2)
    var left = handlers.count()
    var holds_heard = handlers.contains(bob.heard)
    var holds_ignored = handlers.contains(bob.ignored)
    console.print("removed", left, holds_heard, holds_ignored)
    handlers.remove(also_ada.heard)
    var after_equal = handlers.count()
    var holds_ada = handlers.contains(ada.heard)
    console.print("an equal owner removed", after_equal, holds_ada)
    handlers.append(ada.heard)
    var kept = List<Spite.Function<Integer, Nothing>>()
    kept.append(bob.ignored)
    kept.append(ada.heard)
    console.print("lists", handlers == kept)
}

func tell(amount: Integer) {
    var index = 0
    while index < handlers.count() {
        handlers[index](amount)
        index = index + 1
    }
}
