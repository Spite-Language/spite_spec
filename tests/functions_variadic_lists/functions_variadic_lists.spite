var console = Console()

func FunctionsVariadicLists() {
    load "../../../spite_standard_library/windows"
    var first = [1, 2]
    var second = [3]
    var total = count_all(first, second)
    console.print(total)
}

func count_all(...groups: List<List<Integer>>): Integer {
    var total = 0
    var index = 0
    while index < groups.count() {
        var group = groups[index]
        crash group
        total = total + group.count()
        index = index + 1
    }
    return total
}
