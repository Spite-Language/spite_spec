var console = Console()

func FunctionsVariadicLists() {
    load "../../../spite_standard_library/windows"
    var first = [1, 2]
    var second = [3]
    var total = count_all(first, second)
    console.print(total)
}

func count_all(...groups: List<List<Integer>>): Integer {
    return groups.sum_count()
}
