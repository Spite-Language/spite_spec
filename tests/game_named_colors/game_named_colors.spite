var console = Console()
var palette = Color(0.0, 0.0, 0.0, 1.0)

func GameNamedColors() {
    load "../../../spite_standard_library/windows"
    var tomato = palette.named_hex("tomato")
    var unknown = palette.named_hex("not a colour")
    var unknown_is_empty = unknown == ""
    console.print(tomato, unknown_is_empty)
    show(" TOMATO ")
    show("transparent")
}

func show(text: String) {
    var color = text.to_color()
    crash color
    var hex = color.to_hex()
    console.print(hex)
}
