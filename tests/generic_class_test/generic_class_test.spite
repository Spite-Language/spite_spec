var console = Console()

func GenericClassTest() {
    load "../../../spite_standard_library/windows"
    var healths = Column<Health>("health")
    var first = healths.storage()
    var health = Health()
    first.append(health)
    var labels = Column<Label>("label")
    var label_storage = labels.storage()
    var label = Label()
    label_storage.append(label)
    var again = Column<Health>("health")
    var second = again.storage()
    var stored = second.count()
    var health_holds = healths.holds_health()
    var label_holds = labels.holds_health()
    console.print(stored, first == second, health_holds, label_holds)
}
