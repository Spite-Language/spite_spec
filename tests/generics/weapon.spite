generic $damage_type

var is_magic: Boolean
var damage: $damage_type

func Weapon(new_damage: $damage_type, magic: Boolean) {
    damage = new_damage
    is_magic = magic
}

func hit(): Integer {
    if is_magic {
        return 1
    } else {
        return 2
    }
}

func describe(): String {
    if not is_magic {
        return "plain {damage}"
    }
    return "magic {damage}"
}
