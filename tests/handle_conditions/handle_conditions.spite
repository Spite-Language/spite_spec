var console = Console()

func HandleConditions() {
    load "../../../spite_standard_library/windows"
    var limit = three()
    var index = 0
    while index < limit {
        index = index + 1
    }
    console.print("the while ran", index, "times")
    check_ready()
    var going = is_ready()
    while not going {
        console.print("never printed")
    }
    console.print("a while on a Boolean handle")
}

func check_ready() {
    var ready = is_ready()
    fallback ready
    console.print("fallback read the handle's value")
}

func three(): Integer {
    return 3
}

func is_ready(): Boolean {
    return true
}
