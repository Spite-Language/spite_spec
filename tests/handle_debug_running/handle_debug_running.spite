var console = Console()
var program = Program()

func HandleDebugRunning() {
    load "../../../spite_standard_library/windows"
    var napping = Concurrent(nap)
    console.debug(napping)
    var napped: Integer = napping
    console.debug(napping)
    console.print(napped)
}

func nap(): Integer {
    program.sleep(20)
    return 20
}
