var console = Console()

func HandleListLiteral() {
    load "../../../spite_standard_library/windows"
    var counting = three()
    var waiting = four()
    var values: List<Integer> = [counting, waiting, 5]
    var joined = values.join(",")
    console.print(joined)
}

func three(): Integer {
    return 3
}

func four(): Integer {
    return 4
}
