var console = Console()
var program = Program()
var _words = [
    "Scheduler"
    "scheduler"
    "Collector"
    "collector"
    "Interpreter"
    "interpreter"
    "Registry"
    "registry"
    "Garbage"
    "garbage"
    "Thread"
    "_parallel_"
]

func HelloProgramShipsNothingBesideIt() {
    load "../../../spite_standard_library/windows"
    console.print("hello")
    var path = program.executable_path()
    crash path
    var low_path = path.replace(".exe", ".low_ir.txt")
    var written_path: Path? = low_path
    crash written_path
    var written = File(written_path).read_as_string()
    crash written
    var lines = written.split("\n")
    var functions = 0
    var beside = 0
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("function ") {
            functions = functions + 1
            beside = beside + named_for_a_helper(line)
        }
        index = index + 1
    }
    console.print("the built program has functions:", functions > 0)
    console.print("functions that are a scheduler, collector, interpreter or registry:", beside)
}

func named_for_a_helper(line: String): Integer {
    var index = 0
    while index < _words.count() {
        var word = _words[index]
        if line.contains(word) {
            return 1
        }
        index = index + 1
    }
    return 0
}
