var console = Console()
var build = Build()

func HotReloadChangesAnAttributeDefault() {
    console.print("started")
    var folder = build.program.replace("/", "\\")
    var no_arguments = List<String>()
    var copying = Process("copy /y {folder}\\changed.txt {folder}\\counter.spite", no_arguments)
    var copied = copying.run()
    if copied != 0 {
        console.print("counter.spite could not be written")
    }
}

func fresh_step(): Integer {
    var counter = Counter()
    return counter.step
}
