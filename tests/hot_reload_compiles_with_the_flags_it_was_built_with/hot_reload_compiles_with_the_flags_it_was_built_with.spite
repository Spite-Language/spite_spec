var console = Console()
var program = Program()
var build = Build()
var greeter = Greeter()
var _most_waits = 600

func HotReloadCompilesWithTheFlagsItWasBuiltWith() {
    load "../../../spite_standard_library/windows"
    greeter.check(-1)
    console.print("checked before the reload")
    write_greeter()
    var fifty_milliseconds = Duration(50, 'milliseconds')
    var now = greeter.which()
    var waited = 0
    while now == "old" and waited < _most_waits {
        program.sleep(fifty_milliseconds)
        now = greeter.which()
        waited = waited + 1
    }
    console.print("which:", now)
    greeter.check(-1)
    console.print("checked after the reload")
}

func write_greeter() {
    var changed_path: Path? = "{build.program}/changed.txt"
    crash changed_path
    var changed = File(changed_path)
    var text = changed.read_as_string()
    crash text
    var file_path: Path? = "{build.program}/greeter.spite"
    crash file_path
    var file = File(file_path)
    crash file.write_string(text)
}
