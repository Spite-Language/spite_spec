var console = Console()

# A --hot-reload build proves ranges as every build does: the counter's step, the
# remainder and the division by a local tested not zero carry no check, and only
# the product of two values of any size is reported as keeping its check.
func HotReloadProvesRanges() {
    load "../../../spite_standard_library/windows"
    var total = 0
    var index = 0
    while index < 10 {
        var digit = index % 7
        total = total + digit
        index = index + 1
    }
    console.print(total)
    share(100, 7)
    share(100, 0)
    var product = multiplied(46341, 46340)
    console.print(product)
    print_report()
}

func share(amount: Integer, parts: Integer) {
    if parts == 0 {
        console.print("no parts")
        return
    }
    var each = amount / parts
    console.print(each)
}

func multiplied(first: Integer, second: Integer): Integer {
    return first * second
}

func print_report() {
    var report = File(".spite/reports/hot_reload_proves_ranges.md").read()
    crash report
    var lines = report.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var is_kept = line.starts_with("- [") and line.contains("keeps its overflow check")
        if is_kept and line.contains("hot_reload_proves_ranges.spite") {
            var parts = line.split("): ")
            var last = parts.last()
            crash last
            console.print(last)
        }
        index = index + 1
    }
}
