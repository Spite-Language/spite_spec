var console = Console()
var program = Program()
var choice = Choice()

func HotReloadReadsProgramBuildFields() {
    var answered = choice.answer()
    console.print(answered)
    var path = program.executable_path()
    crash path
    var high_path = path.replace(".exe", ".high_ir.txt")
    var text_path: Path? = high_path
    crash text_path
    var text = File(text_path).read_as_string()
    crash text
    var reads_the_field = function_holds("Choice.answer(", ".serve", text)
    var has_the_other_branch = function_holds("Choice.answer(", "not serving", text)
    console.print("reads build.serve while it runs", reads_the_field)
    console.print("holds the branch it did not take", has_the_other_branch)
}

func function_holds(function_key: String, wanted: String, text: String): Boolean {
    var lines = text.split("\n")
    var inside = false
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("function ") {
            inside = line.starts_with("function {function_key}")
        }
        if inside and line.contains(wanted) {
            return true
        }
        index = index + 1
    }
    return false
}
