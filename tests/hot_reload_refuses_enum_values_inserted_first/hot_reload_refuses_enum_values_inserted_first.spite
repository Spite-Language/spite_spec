var console = Console()
var build = Build()
var gauge = Gauge()

func HotReloadRefusesEnumValuesInsertedFirst() {
    load "../../../spite_standard_library/windows"
    var said = gauge.describe()
    console.print(said)
    var folder = build.program.replace("/", "\\")
    var no_arguments = List<String>()
    var copying = Process("copy /y {folder}\\changed.txt {folder}\\gauge.spite", no_arguments)
    var copied = copying.run()
    if copied != 0 {
        console.print("gauge.spite could not be written")
    }
}
