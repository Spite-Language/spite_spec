var console = Console()
var build = Build()
var greeter = Greeter()

func HotReloadSwapsAFunction() {
    load "../../../spite_standard_library/windows"
    var said = greeter.greeting()
    console.print(said)
    save_greeter_from("goodbye.txt")
}

func restore() {
    save_greeter_from("hello.txt")
}

# ../../../spite_documentation/repl.md#remote---repl-port
func save_greeter_from(name: String) {
    var folder = build.program.replace("/", "\\")
    var no_arguments = List<String>()
    var copying = Process("copy /y {folder}\\{name} {folder}\\greeter.spite", no_arguments)
    var copied = copying.run()
    if copied != 0 {
        console.print("greeter.spite could not be written")
    }
}
