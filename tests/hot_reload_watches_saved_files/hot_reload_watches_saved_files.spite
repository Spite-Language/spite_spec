var console = Console()
var build = Build()
var program = Program()
var reload = Reload()
var greeter = Greeter()
var _most_waits = 600

func HotReloadWatchesSavedFiles() {
    load "../../../spite_standard_library/windows"
    var fifty_milliseconds = Duration(50, 'milliseconds')
    var first = greeter.greeting()
    console.print(first)
    write_greeter("goodbye")
    var waited = 0
    var now = greeter.greeting()
    while now == first and waited < _most_waits {
        program.sleep(fifty_milliseconds)
        now = greeter.greeting()
        waited = waited + 1
    }
    console.print(now)
    var generation = reload.generation()
    console.print("generation {generation}")
    var rebuilt = reload.rebuilt_since(0)
    var joined = rebuilt.join(", ")
    console.print("rebuilt {joined}")
}

func write_greeter(word: String) {
    var file = File("{build.program}/greeter.spite")
    var text = "func greeting(): String \{\n    return \"{word}\"\n}\n"
    var written = file.write_string(text)
    if not written {
        console.print("greeter.spite could not be written")
    }
}
