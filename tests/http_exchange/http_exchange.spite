var console = Console()
var server = Http.Server()
var client = Http.Client()

func HttpExchange() {
    load "../../../spite_standard_library/windows"
    crash server.listen_locally(47911)
    var serving = Concurrent(serve_three)
    var hello = Concurrent(ask_hello)
    var echoed = Concurrent(ask_echo)
    var missing = Concurrent(ask_missing)
    console.print(hello)
    console.print(echoed)
    console.print(missing)
    console.print("served", serving)
    server.close()
}

func serve_three(): Integer {
    var served = 0
    while served < 3 {
        var request = server.next_request()
        crash request
        var response = Http.Response()
        if request.path == "/hello" {
            response.write_body_string("hello there")
        } else if request.path == "/echo" and request.method == "POST" {
            var kind = request.header("Content-Type")
            crash kind
            response.set_header("Content-Type", kind)
            var body = request.read_body_as_buffer()
            response.write_body_buffer(body)
            response.status = 201
        } else {
            response.status = 404
        }
        server.respond(request, response)
        served = served + 1
    }
    return served
}

func ask_hello(): String {
    var request = Http.Request()
    request.path = "/hello"
    return ask(request)
}

func ask_echo(): String {
    var request = Http.Request()
    request.method = "POST"
    request.path = "/echo"
    request.set_header("Content-Type", "application/json")
    request.write_body_string("\{\"name\": \"ada\"}")
    return ask(request)
}

func ask_missing(): String {
    var request = Http.Request()
    request.path = "/nowhere"
    return ask(request)
}

func ask(request: Http.Request): String {
    var response = client.send("127.0.0.1", 47911, request)
    crash response
    var kind = response.header("content-type")
    var shown_kind = "none"
    if kind {
        shown_kind = kind
    }
    var body = response.read_body_as_string()
    crash body
    return "{request.path}: {response.status} {response.reason()}, type {shown_kind}, body '{body}'"
}
