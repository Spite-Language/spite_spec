var console = Console()
var program = Program()
var server = Http.Server()
var client = Http.Client()

func HttpKeepAlive() {
    load "../../../spite_standard_library/windows"
    var four_hundred_milliseconds = Duration(400, 'milliseconds')
    var idle_limit = Duration(100, 'milliseconds')
    server.idle_limit = idle_limit
    crash server.listen_locally(47912)
    var serving = Concurrent(serve_four)
    ask("/first")
    ask("/second")
    program.sleep(four_hundred_milliseconds)
    ask("/after-the-server-let-go")
    var closing = Http.Request()
    closing.path = "/last"
    closing.set_header("connection", "close")
    var loopback: IpAddress? = "127.0.0.1"
    crash loopback
    var answer = client.send(loopback, 47912, closing)
    crash answer
    var said = answer.header("connection")
    crash said
    var answer_body = answer.read_body_as_string()
    crash answer_body
    console.print("{closing.path}: {answer_body}, connection: {said}")
    console.print("served", serving)
    server.close()
}

func serve_four(): Integer {
    var served = 0
    while served < 4 {
        var request = server.next_request()
        crash request
        var response = Http.Response()
        response.write_body_string("served {request.path}")
        crash server.respond(request, response)
        served = served + 1
    }
    return served
}

func ask(path: String) {
    var request = Http.Request()
    request.path = path
    var loopback: IpAddress? = "127.0.0.1"
    crash loopback
    var response = client.send(loopback, 47912, request)
    crash response
    var said = response.header("connection")
    crash said
    var body = response.read_body_as_string()
    crash body
    console.print("{path}: {body}, connection: {said}")
}
