var console = Console()
var program = Program()
var server = Http.Server()
var served = 0
var _past_the_idle_limit_milliseconds: Long = 400
var _server_port = 47912

func HttpKeepAlive() {
    load "../../../spite_standard_library/windows"
    var four_hundred_milliseconds = Duration(_past_the_idle_limit_milliseconds, 'milliseconds')
    var idle_limit = Duration(100, 'milliseconds')
    server.idle_limit = idle_limit
    crash server.listen_locally(_server_port)
    var first_connection = connected()
    ask(first_connection, "/first", "")
    ask(first_connection, "/second", "")
    program.sleep(four_hundred_milliseconds)
    var second_connection = connected()
    ask(second_connection, "/after-the-server-let-go", "")
    ask(second_connection, "/last", "connection: close\r\n")
    console.print("served", served)
    first_connection.close()
    second_connection.close()
    server.close()
}

func serve_one() {
    var request = server.next_request()
    crash request
    var response = Http.Response()
    response.write_body_string("served {request.path}")
    crash server.respond(request, response)
    served = served + 1
}

func connected(): Tcp.Client {
    var loopback: IpAddress? = "127.0.0.1"
    crash loopback
    var client = Tcp.Client()
    crash client.connect(loopback, _server_port)
    return client
}

func ask(client: Tcp.Client, path: String, headers: String) {
    var request = "GET {path} HTTP/1.1\r\nhost: 127.0.0.1\r\n{headers}content-length: 0\r\n\r\n"
    crash client.write_string(request)
    serve_one()
    var status_line = client.read_line()
    crash status_line
    var said = ""
    var body_length = 0
    var ended = false
    while not ended {
        var line = client.read_line()
        crash line
        ended = line.is_empty()
        if not ended {
            var colon = line.index_of(":")
            crash colon
            var line_length = line.length()
            var name = line.slice(0, colon)
            crash name
            var raw_value = line.slice(colon + 1, line_length)
            crash raw_value
            var value = raw_value.trim()
            if name == "connection" {
                said = value
            } else if name == "content-length" {
                var length: Integer? = value
                crash length
                body_length = length
            }
        }
    }
    var body_bytes = Buffer(0)
    while body_bytes.count() < body_length {
        var more = client.read_as_buffer()
        crash more
        var more_count = more.count()
        body_bytes.append_buffer(more, 0, more_count)
    }
    var body = body_bytes.read_as_string()
    crash body
    console.print("{path}: {body}, connection: {said}")
}
