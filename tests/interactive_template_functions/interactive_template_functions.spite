var console = Console()
var monsters = List<Monster>()

func InteractiveTemplateFunctions() {
    var rat = Monster("rat", 3)
    monsters.append(rat)
    var bat = Monster("bat", 5)
    monsters.append(bat)
    var ant = Monster("ant", 1)
    monsters.append(ant)
    monsters.each(announce)
    console.print("ready")
}

func announce(monster: Monster) {
    console.print("seen", monster.name)
}
