var console = Console()
var ipv4 = Socket()
var ipv6 = Socket()

# notes.md#why-nothing-listens-on-every-interface
func Ipv6Addresses() {
    load "../../../spite_standard_library/windows"
    if not ipv6.listen_at("::1", 47322) {
        console.print("skipped: this machine has no IPv6, so nothing can listen on ::1")
        return
    }
    crash ipv4.listen_at("127.0.0.1", 47321)
    reach(ipv4, "127.0.0.1", 47321)
    reach(ipv6, "::1", 47322)
    reach(ipv6, "localhost", 47322)
    var unknown = Socket()
    var refused = unknown.connect("::1", 47323)
    console.print("nobody on ::1 port 47323:", refused)
    ipv4.close()
    ipv6.close()
    datagrams()
}

func reach(server: Socket, host: String, port: Integer) {
    var client = Socket()
    var connected = client.connect(host, port)
    crash connected
    var peer = server.accept_client()
    crash peer
    crash client.write_line("over {host}")
    var line = peer.read_line()
    crash line
    console.print("connected to {host}: {connected}, the server read '{line}'")
    client.close()
    peer.close()
}

func datagrams() {
    var server6 = Udp.Socket()
    var client6 = Udp.Socket()
    crash server6.open_at("::1", 47324)
    crash client6.open_at("::1", 0)
    send(client6, "::1", 47324)
    receive(server6)
    var server4 = Udp.Socket()
    var client4 = Udp.Socket()
    crash server4.open_at("127.0.0.1", 47325)
    crash client4.open_locally(0)
    send(client4, "127.0.0.1", 47325)
    receive(server4)
    var text = "ping"
    var bytes = text.to_buffer()
    var unreachable = client4.send_to("::1", 47324, bytes)
    console.print("an IPv4 socket sends to ::1:", unreachable)
}

func send(client: Udp.Socket, host: String, port: Integer) {
    var text = "to {host}"
    var bytes = text.to_buffer()
    crash client.send_to(host, port, bytes)
}

func receive(server: Udp.Socket) {
    var arrived = server.receive()
    crash arrived
    var bytes = arrived.read_as_buffer()
    var count = bytes.count()
    var sender = arrived.sender_host
    console.print("{count} bytes from {sender}")
}
