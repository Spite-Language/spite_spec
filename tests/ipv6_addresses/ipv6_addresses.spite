var console = Console()
var ipv4 = Tcp.Server()
var ipv6 = Tcp.Server()
var _ipv4_tcp_port = 47321
var _ipv6_tcp_port = 47322
var _unused_port = 47323
var _ipv6_udp_port = 47324
var _ipv4_udp_port = 47325

# notes.md#why-nothing-listens-on-every-interface
func Ipv6Addresses() {
    load "../../../spite_standard_library/windows"
    var loopback6 = address_of("::1")
    var loopback4 = address_of("127.0.0.1")
    if not ipv6.listen_at(loopback6, _ipv6_tcp_port) {
        console.print("skipped: this machine has no IPv6, so nothing can listen on ::1")
        return
    }
    crash ipv4.listen_at(loopback4, _ipv4_tcp_port)
    reach(ipv4, "127.0.0.1", _ipv4_tcp_port)
    reach(ipv6, "::1", _ipv6_tcp_port)
    reach(ipv4, "localhost", _ipv4_tcp_port)
    var unknown = Tcp.Client()
    var refused = unknown.connect(loopback6, _unused_port)
    console.print("nobody on ::1 port 47323:", refused)
    ipv4.close()
    ipv6.close()
    datagrams(loopback4, loopback6)
}

func address_of(text: String): IpAddress {
    var address: IpAddress? = text
    crash address
    return address
}

func reach(server: Tcp.Server, host: String, port: Integer) {
    var client = Tcp.Client()
    var address: IpAddress? = host
    crash address
    var connected = client.connect(address, port)
    crash connected
    var peer = server.accept()
    crash peer
    crash client.write_line("over {host}")
    var line = peer.read_line()
    crash line
    console.print("connected to {host}: {connected}, the server read '{line}'")
    client.close()
    peer.close()
}

func datagrams(loopback4: IpAddress, loopback6: IpAddress) {
    var server6 = Udp.Server()
    var client6 = Udp.Client()
    crash server6.open_at(loopback6, _ipv6_udp_port)
    crash client6.open()
    var text6 = "to ::1"
    var bytes6 = text6.to_buffer()
    crash client6.send_to(loopback6, _ipv6_udp_port, bytes6)
    receive(server6)
    var server4 = Udp.Server()
    var client4 = Udp.Server()
    crash server4.open_at(loopback4, _ipv4_udp_port)
    crash client4.open_locally(0)
    var text4 = "to 127.0.0.1"
    var bytes4 = text4.to_buffer()
    crash client4.send_to(loopback4, _ipv4_udp_port, bytes4)
    receive(server4)
    var text = "ping"
    var bytes = text.to_buffer()
    var unreachable = client4.send_to(loopback6, _ipv6_udp_port, bytes)
    console.print("an IPv4 socket sends to ::1:", unreachable)
}

func receive(server: Udp.Server) {
    var arrived = server.receive()
    crash arrived
    var bytes = arrived.read_as_buffer()
    var count = bytes.count()
    var sender = arrived.sender_address
    console.print("{count} bytes from {sender}")
}
