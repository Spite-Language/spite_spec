var console = Console()
var tracks = Items<Track>()

func ItemsPresence() {
    load "../../../spite_standard_library/windows"
    var index = 0
    while index < 5 {
        var track = Track(index)
        tracks.append(track)
        index = index + 1
    }
    var found = 0
    var missing = 0
    var at = -2
    while at < 9 {
        if tracks[at] {
            found = found + 1
        } else {
            missing = missing + 1
        }
        at = at + 1
    }
    console.print("found", found, "missing", missing)
}
