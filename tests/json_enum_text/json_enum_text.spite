enum Color {
    'red'
    'blue'
}

var console = Console()

func JsonEnumText() {
    load "../../../spite_standard_library/windows"
    var marker = Marker()
    var text = "blue"
    var found: Color? = text
    crash found
    marker.tag = found
    marker.color = 'blue'
    var writer = JsonWriter<Marker>()
    var written = writer.write(marker)
    console.print(written)
    var reader = JsonReader<Marker>()
    var read_back = reader.read(written)
    crash read_back
    crash read_back.tag
    console.print(read_back.tag, read_back.color)
    var unknown_reader = JsonReader<Marker>()
    var unknown = unknown_reader.read("\{\"tag\":\"green\"}")
    if unknown {
        console.print("read a colour the enum does not have")
    } else {
        console.print("a name the enum does not have is no Color")
    }
}
