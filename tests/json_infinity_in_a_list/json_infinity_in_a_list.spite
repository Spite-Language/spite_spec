var console = Console()

func JsonInfinityInAList() {
    load "../../../spite_standard_library/windows"
    var order = Order()
    var zero: Double = 0.0
    var one: Double = 1.0
    order.prices.append(2.5)
    order.prices.append(one / zero)
    var writer = JsonWriter<Order>()
    var text = writer.write(order)
    console.print("never printed", text)
}
