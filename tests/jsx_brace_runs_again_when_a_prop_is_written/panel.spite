union Holder {
    Panel
    Slot
}

var title = ""
var parent: Holder? = null
var children = List<Panel>()

func describe(): String {
    var parts = List<String>()
    var index = 0
    while index < children.count() {
        var child = children[index]
        var shown = child.describe()
        parts.append(shown)
        index = index + 1
    }
    if parts.is_empty() {
        return title
    }
    var inside = parts.join(", ")
    return "{title} [{inside}]"
}
