var console = Console()

func JsxLowercaseTagCallsRenderFunction() {
    var made = built()
    var shown = made.describe()
    console.print(shown)
}

func built(): View {
    var health = 7
    var missing = 3
    return <View title="parts">
        <health_bar missing={missing} filled={health} />
        <framed title="box" />
    </View>
}

func render_health_bar(filled: Integer, missing: Integer): Label {
    var whole = filled + missing
    var bar = Label()
    bar.content = "{filled} of {whole}"
    return bar
}

func render_framed(title: String): View {
    return <View title={title}>
        <Label content="inside" />
    </View>
}
