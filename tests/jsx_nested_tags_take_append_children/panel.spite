var title = ""
var items = List<Anything>()

func append_children(children: List<Anything?>) {
    children.each(add)
}

func add(child: Anything?) {
    fallback child
    items.append(child)
}

func describe(): String {
    var parts = List<String>()
    var index = 0
    while index < items.count() {
        var item = items[index]
        var shown = shown_item(item)
        parts.append(shown)
        index = index + 1
    }
    var inside = parts.join(", ")
    return "Panel '{title}' [{inside}]"
}

func shown_item(item: Anything): String {
    if item.class == Panel {
        return item.describe()
    }
    if item.class == Note {
        return "Note '{item.content}'"
    }
    return "something else"
}
