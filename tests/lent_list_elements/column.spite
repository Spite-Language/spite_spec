singleton

generic $component_type

var values = List<$component_type>()
var references = List<$component_type>()

func insert(value: $component_type) {
    if $component_type.fits_vector() {
        values.append(value)
    } else {
        references.append(value)
    }
}

func at(row: Integer): $component_type {
    crash references[row]
    return references[row]
}

func remove_last_reference() {
    crash references.remove_last()
}
