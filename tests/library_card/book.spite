enum Shelf {
    'fiction'
    'reference'
    'childrens'
}

var borrowed_by: String? = null
var title: String
var shelf: Shelf

func Book(starting_title: String, starting_shelf: Shelf) {
    title = starting_title
    shelf = starting_shelf
}

func label(): String {
    return "{title} ({shelf})"
}

func is_available(): Boolean {
    fallback not borrowed_by
    return true
}
