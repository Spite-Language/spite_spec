var console = Console()

func LibraryReflection() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var holder = Holder()
    show_attributes(holder)
}

func show_attribute(attribute: Spite.AttributeDeclaration, holder: Holder) {
    var reader = Reader<attribute.class>()
    var text = reader.name_of(holder.attributes[attribute])
    console.print(attribute.name, text)
}
