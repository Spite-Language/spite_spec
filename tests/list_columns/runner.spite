generic $row_type

var missing = false

func run(mover: Mover, entity_count: Integer) {
    var entity = 0
    while entity < entity_count {
        missing = false
        var row: $row_type = null
        fill_attributes(row, entity)
        if not missing {
            mover.update_each(row)
        }
        entity = entity + 1
    }
}

func fill_attribute(attribute: Spite.AttributeDeclaration, row: $row_type, entity: Integer) {
    if attribute.class == Entity {
        row.attributes[attribute] = Entity(entity)
    } else {
        var column = Column<attribute.class>()
        var dense = column.dense_index(entity)
        missing = missing or dense < 0
        fallback dense >= 0
        crash column.values[dense]
        row.attributes[attribute] = column.values[dense]
    }
}
