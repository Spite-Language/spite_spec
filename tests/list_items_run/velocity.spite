var moving = false
var across: Float
var down: Float
var name: String

func Velocity(new_across: Float, new_down: Float, new_name: String) {
    across = new_across
    down = new_down
    name = new_name
}

func integrate() {
    across = across + 1.0
    moving = true
}

func speed(): Float {
    return across + down
}
