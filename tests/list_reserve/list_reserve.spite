var console = Console()

func ListReserve() {
    load "../../../spite_standard_library/windows"
    var numbers = List<Integer>()
    numbers.reserve(100)
    var empty_count = numbers.count()
    var empty = numbers.is_empty()
    numbers.append(4)
    var after = numbers.count()
    console.print(empty_count, empty, after)
}
