var moved = 0

func update_each(moving: ListRows.Moving) {
    moving.position.left = moving.position.left + moving.velocity.across
    var position = moving.position
    position.top = position.top + moving.velocity.down
    if moving.position.left > 20.0 {
        moving.velocity.slow_down()
    }
    report_speed(moving)
    moved = moved + 1
}

func report_speed(moving: ListRows.Moving) {
    if moving.velocity.across > 100.0 {
        moved = moved + 1000
    }
}
