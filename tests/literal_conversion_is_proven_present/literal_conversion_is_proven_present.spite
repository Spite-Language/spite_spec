var console = Console()

func LiteralConversionIsProvenPresent() {
    var held: Color? = "#ffffff"
    console.print(held.red)
    var answer = answered()
    console.print(answer.green)
    var other: Color = answered_plain()
    console.print(other.blue)
}

func answered(): Color? {
    return "#00ff00"
}

func answered_plain(): Color {
    return "#0000ff"
}
