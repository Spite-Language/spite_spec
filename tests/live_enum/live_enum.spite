enum Mood {
    'calm'
    'angry'
}

var console = Console()
var mood: Mood = 'angry'
var other: Mood = 'calm'

func LiveEnum() {
    load "../../../spite_standard_library/windows"
    var described = describe()
    console.print(described)
}

func describe(): String {
    return "{mood} and {other}"
}

func verdict(): String {
    switch mood {
        'calm': return "fine"
        'angry': return "careful"
    }
}
