var build = Build()
var console = Console()

func LoadOnBuild() {
    load "../../../SpiteCompiler/.spite/library/windows"
    load "kitchen"
    if build.flavor == "sweet" {
        load "sweet"
    } else {
        load "salty"
    }
    var snack = Snack()
    var described = snack.describe()
    console.print(described)
    var chef = Chef()
    var served = chef.serve()
    console.print(served)
}
