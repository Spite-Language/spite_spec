singleton

var program = Program()
var _entries = List<String>()

func record(name: String) {
    var five_milliseconds = Duration(5, 'milliseconds')
    _entries.append("{name} starts")
    program.sleep(five_milliseconds)
    _entries.append("{name} ends")
}

func count(): Integer {
    return _entries.count()
}

func shown(): String {
    return _entries.join(", ")
}
