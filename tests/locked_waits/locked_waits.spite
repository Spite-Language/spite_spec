var console = Console()
var ledger = Ledger()
var program = Program()

func LockedWaits() {
    load "../../../spite_standard_library/windows"
    var counted_entries = counted()
    var first_done = record_first()
    var second_done = record_second()
    var shown = ledger.shown()
    console.print(shown)
    console.print(counted_entries >= 0, first_done, second_done)
}

func counted(): Integer {
    return ledger.count()
}

func record_first(): Boolean {
    var one_millisecond = Duration(1, 'milliseconds')
    program.sleep(one_millisecond)
    ledger.record("first")
    return true
}

func record_second(): Boolean {
    var one_millisecond = Duration(1, 'milliseconds')
    program.sleep(one_millisecond)
    ledger.record("second")
    return true
}
