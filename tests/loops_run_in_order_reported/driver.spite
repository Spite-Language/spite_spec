var picked = true
var tally = List<Integer>()

func reshape(shapes: List<Shape>) {
    var index = 0
    while index < shapes.count() {
        var shape = shapes[index]
        if picked {
            var worker = Worker(shape)
            shapes[index] = worker.transformed()
        }
        index = index + 1
    }
}

func reshape_with_a_fallback(shapes: List<Shape>) {
    var index = 0
    while index < shapes.count() {
        var shape = shapes[index]
        if picked {
            var worker = Worker(shape)
            shapes[index] = worker.checked()
        }
        index = index + 1
    }
}

func reshape_into_a_tally(shapes: List<Shape>) {
    var index = 0
    while index < shapes.count() {
        var shape = shapes[index]
        if picked {
            var worker = Worker(shape)
            shapes[index] = worker.tallied(tally)
        }
        index = index + 1
    }
}
