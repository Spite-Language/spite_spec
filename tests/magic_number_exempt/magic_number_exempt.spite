var console = Console()
var _days_in_400_years = 146097

func MagicNumberExempt() {
    load "../../../spite_standard_library/windows"
    var days_per_cycle = _days_in_400_years
    var count = 3
    var next = count + 1
    var previous = count - 1
    var flipped = count * -1
    var ratio = 2.5
    var scaled = ratio * 1.0 + 0.0
    var cycles = days_per_cycle * count
    console.print(next, previous, flipped, scaled, cycles)
}
