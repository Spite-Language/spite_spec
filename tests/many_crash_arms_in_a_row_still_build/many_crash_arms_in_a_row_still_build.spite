var console = Console()
var program = Program()

func ManyCrashArmsInARowStillBuild() {
    var written = program.environment("CHOSEN_KIND")
    var index = 0
    if written {
        index = written.length()
    }
    var kinds = Kind.values
    var kind = kinds[index]
    crash kind
    var rank = rank_of(kind)
    console.print(rank)
}

func rank_of(kind: Kind): Integer {
    switch kind {
        'first': return 1
        'second': return 2
