var console = Console()
var _sample_tiny: Tiny = -127
var _sample_byte: Byte = 200
var _larger_byte: Byte = 250
var _sample_long: Long = -9000000000

func MathsFunctions() {
    load "../../../spite_standard_library/windows"
    decimals()
    edges()
    constants()
    whole_numbers()
}

func decimals() {
    var two: Double = 2.0
    var nine: Double = 9.0
    console.print("square_root {two.square_root()} {nine.square_root()}")
    var zero: Double = 0.0
    var one: Double = 1.0
    console.print("sine {zero.sine()} cosine {zero.cosine()} tangent {zero.tangent()}")
    var angle: Double = 0.5
    var sine = angle.sine()
    var cosine = angle.cosine()
    var tangent = angle.tangent()
    console.print("sine {rounded(sine)} cosine {rounded(cosine)} tangent {rounded(tangent)}")
    var arc_sine = angle.arc_sine()
    var arc_cosine = angle.arc_cosine()
    var arc_tangent = one.arc_tangent()
    console.print("arc_sine {rounded(arc_sine)} arc_cosine {rounded(arc_cosine)} arc_tangent {rounded(arc_tangent)}")
    var minus_one: Double = -1.0
    var first_quarter = one.arc_tangent_over(one)
    var second_quarter = one.arc_tangent_over(minus_one)
    var third_quarter = minus_one.arc_tangent_over(minus_one)
    var fourth_quarter = minus_one.arc_tangent_over(one)
    console.print(
        "arc_tangent_over {rounded(first_quarter)} {rounded(second_quarter)} {rounded(third_quarter)} {rounded(fourth_quarter)}",
    )
    console.print("arc_tangent_over of zeros {zero.arc_tangent_over(zero)} {zero.arc_tangent_over(minus_one)}")
    var ten: Double = 10.0
    console.print("power {two.power(ten)} {nine.power(angle)} {two.power(minus_one)}")
    var euler = one.exponential()
    console.print("exponential {zero.exponential()} {rounded(euler)}")
    var eight: Double = 8.0
    var thousand: Double = 1000.0
    console.print(
        "logarithm {one.logarithm()} base 2 {eight.logarithm_base_2()} base 10 {thousand.logarithm_base_10()}",
    )
    var up: Double = 2.5
    var down: Double = -2.5
    console.print("floor {up.floor()} {down.floor()} ceiling {up.ceiling()} {down.ceiling()}")
    console.print("round {up.round()} {down.round()} truncate {up.truncate()} {down.truncate()}")
    console.print("absolute {down.absolute()} {up.absolute()}")
    console.print("minimum {up.minimum(down)} maximum {up.maximum(down)}")
    console.print("clamp {ten.clamp(down, up)} {minus_one.clamp(zero, up)} {one.clamp(zero, up)}")
    var third: Float = 2.5
    var less: Float = 0.5
    console.print("Float {third.floor()} {third.round()} {less.minimum(third)} {third.clamp(0.0, 1.0)}")
}

func edges() {
    var negative: Double = -1.0
    var zero: Double = 0.0
    var not_a_number = negative.square_root()
    console.print("square_root of -1 {not_a_number}, logarithm of 0 {zero.logarithm()}, of -1 {negative.logarithm()}")
    console.print("arc_sine of pi {Double.Pi().arc_sine()} {not_a_number.is_not_a_number()}")
    var huge: Double = 1000.0
    var overflowed = huge.exponential()
    console.print(
        "exponential of 1000 {overflowed} finite {overflowed.is_finite()} infinite {overflowed.is_infinite()}",
    )
    console.print("minimum passes not a number on: {not_a_number.minimum(zero)} {zero.maximum(not_a_number)}")
    console.print("clamp of not a number {not_a_number.clamp(zero, huge)}")
    console.print("clamp with low above high {zero.clamp(huge, negative)}")
    var float_negative: Float = -4.0
    var float_nothing = float_negative.square_root()
    console.print(
        "Float square_root of -4 {float_nothing} {float_nothing.is_not_a_number()} {float_negative.is_finite()}",
    )
    var negative_zero: Double = -0.0
    console.print("negative zero {negative_zero.absolute()} {negative_zero.square_root()}")
}

func constants() {
    var float_pi = Float.Pi()
    var float_tau = Float.Tau()
    console.print("Float pi {float_pi} tau {float_tau} euler_number {Float.EulerNumber()}")
    var double_pi = Double.Pi()
    var double_tau = Double.Tau()
    console.print("Double pi {double_pi} tau {double_tau} euler_number {Double.EulerNumber()}")
    var float_infinity = Float.Infinity()
    console.print("Float infinity {float_infinity} not a number {Float.NotANumber()}")
    var float_largest = Float.Largest()
    console.print("Float largest {float_largest} smallest {Float.Smallest()}")
    var double_largest = Double.Largest()
    console.print("Double largest {double_largest} smallest {Double.Smallest()}")
    var infinite = Double.Infinity()
    var negative_infinite = -infinite
    console.print(
        "Double infinity {infinite} {negative_infinite} {infinite.is_infinite()} {Double.NotANumber().is_finite()}",
    )
}

func whole_numbers() {
    var count = -7
    var other = 3
    console.print(
        "Integer absolute {count.absolute()} minimum {count.minimum(other)} maximum {count.maximum(other)} clamp {count.clamp(-3, 3)}",
    )
    var integer_largest = Integer.Largest()
    console.print("Integer largest {integer_largest} smallest {Integer.Smallest()}")
    var near_lowest = Integer.Smallest() + 1
    console.print("absolute of one above the smallest: {near_lowest.absolute()}")
    var tiny: Tiny = _sample_tiny
    var tiny_largest = Tiny.Largest()
    console.print("Tiny {tiny_largest} {Tiny.Smallest()} {tiny.absolute()}")
    var byte: Byte = _sample_byte
    var byte_largest = Byte.Largest()
    console.print("Byte {byte_largest} {Byte.Smallest()} {byte.absolute()} {byte.clamp(10, 100)} {byte.minimum(_larger_byte)}")
    var long: Long = _sample_long
    var long_largest = Long.Largest()
    console.print("Long {long_largest} {Long.Smallest()} {long.absolute()} {long.maximum(4)}")
    var unsigned_long_largest = UnsignedLong.Largest()
    var short_smallest = Short.Smallest()
    console.print("UnsignedLong {unsigned_long_largest} Short {short_smallest} UnsignedShort {UnsignedShort.Largest()}")
    var high = 10
    console.print("clamp with low above high {other.clamp(high, 1)}")
}

func rounded(value: Double): Double {
    var scaled = value * 1000000.0
    return scaled.round() / 1000000.0
}
