var console = Console()

func MemoryCountsBuffers() {
    load "../../../spite_standard_library/windows"
    var total = 0
    var round = 0
    while round < 100 {
        var bytes = Buffer(64)
        var index = 0
        while index < 64 {
            bytes.append(index)
            index = index + 1
        }
        var last = bytes[63]
        crash last
        total = total + last
        round = round + 1
    }
    console.print("summed:", total)
}
