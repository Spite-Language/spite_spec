var console = Console()
var c_runtime = DynamicLibrary(
    "ucrtbase.dll",
    "",
    {"length_of": DynamicLibrary.FunctionDeclaration("strlen", [DynamicLibrary.Argument("text", String)], Integer)},
)

func MemoryDebugMemoryFill() {
    var grown = Buffer()
    var index = 0
    while index < 65 {
        grown.append(7)
        index = index + 1
    }
    var kept = grown[64]
    crash kept
    var grown_count = grown.count()
    console.print("kept", kept, "grown to", grown_count)
    var joined = "count {index}"
    var counted = length_of(joined)
    console.print("a joined text ends where its bytes end:", counted)
    var words = List<String>()
    words.insert(0, "second")
    words.insert(0, "first")
    words.insert(2, "fourth")
    words.insert(2, "third")
    var listed = words.join(" ")
    console.print(listed)
}

func length_of(text: String): Integer {
    var call = DynamicLibrary.Call(c_runtime.functions["length_of"])
    call.arguments["text"] = text
    return call.call()
}
