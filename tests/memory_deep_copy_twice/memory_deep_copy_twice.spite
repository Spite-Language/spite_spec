var console = Console()

func MemoryDeepCopyTwice() {
    var pair = Pair()
    var leaf = Leaf(3)
    pair.left = leaf
    pair.right = leaf
    var copied = pair.deep_copy()
    copied.left.weight = 9
    var shared_before = pair.left.is_same_instance(pair.right)
    var shared_after = copied.left.is_same_instance(copied.right)
    console.print(shared_before, shared_after, copied.right.weight, pair.left.weight)
}
