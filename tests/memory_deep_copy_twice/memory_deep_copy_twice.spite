var console = Console()

func MemoryDeepCopyTwice() {
    var pair = Pair()
    var leaf = Leaf(3)
    pair.left = leaf
    pair.right = leaf
    var copied = pair.deep_copy()
    copied.left.weight = 9
    var shared_before = pair.left === pair.right
    var shared_after = copied.left === copied.right
    console.print(shared_before, shared_after, copied.right.weight, pair.left.weight)
}
