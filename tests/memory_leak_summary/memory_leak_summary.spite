var console = Console()

func MemoryLeakSummary() {
    make_a_cycle()
    console.print("the cycle is out of reach")
}

func make_a_cycle() {
    var first = Person("ann")
    var second = Person("bob")
    first.join(second)
    second.join(first)
    first.marks.append(1)
    var named = first.partner_name()
    console.print(first.name, "is with", named)
}
