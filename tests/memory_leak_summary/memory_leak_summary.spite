var console = Console()
var program = Program()
var waiter = Waiter()
var frames = 0

func MemoryLeakSummary() {
    make_a_cycle()
    var one_millisecond = Duration(1, 'milliseconds')
    while not waiter.finished {
        frames = frames + 1
        if frames == 1 {
            waiter.run()
        }
        program.sleep(one_millisecond)
    }
    console.print("the cycle is out of reach")
}

func make_a_cycle() {
    var first = Person("ann")
    var second = Person("bob")
    first.join(second)
    second.join(first)
    first.marks.append(1)
    var named = first.partner_name()
    console.print(first.name, "is with", named)
}
