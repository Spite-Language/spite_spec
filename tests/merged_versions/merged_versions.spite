var console = Console()

func MergedVersions() {
    load "../../../spite_standard_library/windows"
    load "../..@b561721/tests/merged_versions/.packages/engine"
    load "../..@b561721/tests/merged_versions/.packages/physics"
    var physics = Physics()
    var world = physics.made()
    world.add_body()
    show(world)
    var gravity = world.gravity()
    console.print(gravity)
    console.print(world.class.name)
}

func show(world: World) {
    var description = world.describe()
    console.print(description)
}
