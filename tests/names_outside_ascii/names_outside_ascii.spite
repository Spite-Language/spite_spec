var console = Console()
var program = Program()

func NamesOutsideAscii() {
    load "../../../spite_standard_library/windows"
    var folder = Directory(".spite/names_outside_ascii_café")
    crash folder.create()
    var file_path: Path? = "{folder.path}/crème brûlée €.txt"
    crash file_path
    var file = File(file_path)
    var moved_path: Path? = "{folder.path}/naïve 日本.txt"
    crash moved_path
    var moved = File(moved_path)
    if moved.exists() {
        crash moved.remove()
    }
    crash file.write_string("ünïcödé")
    crash file.exists()
    var entries = folder.entries()
    crash entries
    var index = 0
    while index < entries.count() {
        var entry = entries[index]
        if entry.class == File {
            console.print(entry.file_name)
        }
        index = index + 1
    }
    var read = file.read_as_string()
    crash read
    console.print(read)
    var old_path = file.path
    var moved_path: Path? = moved.path
    crash moved_path
    crash file.move_to(moved_path)
    crash moved.exists()
    var left_path: Path? = old_path
    crash left_path
    var left = File(left_path)
    crash not left.exists()
    var executable = program.executable_path()
    crash executable
    var is_an_executable = executable.ends_with(".exe")
    console.print(is_an_executable)
    crash moved.remove()
    console.print("done")
}
