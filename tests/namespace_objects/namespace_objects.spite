var console = Console()

func NamespaceObjects() {
    var gadget = Pack.Widgets.Gadget()
    var second_gadget = Pack.Widgets.Gadget()
    var cog = Pack.Widgets.Cog()
    var gear = Pack.Gear()
    console.print(gadget.class.name, second_gadget.class.name, cog.class.name, gear.class.name)
    crash gadget.class.outer_class
    crash second_gadget.class.outer_class
    crash gear.class.outer_class
    console.print(gadget.class.outer_class.name_with_outer_classes, gadget.class.outer_class.name)
    console.print(gear.class.outer_class.name_with_outer_classes, gear.class.outer_class.name)
    crash gadget.class.outer_class.outer_class
    console.print(gadget.class.outer_class.outer_class.name)
    crash gadget.class.outer_class == second_gadget.class.outer_class
    if gadget.class.outer_class == gear.class.outer_class {
        crash
    }
    console.print(
        gadget.class.outer_class.outer_class.name_with_outer_classes,
        gadget.class.outer_class.outer_class.name,
    )
    if gadget.class.outer_class.outer_class.outer_class.outer_class {
        crash
    }
    console.print(gadget.class.outer_class)
    var tree_classes = gadget.class.outer_class.nested_classes
    crash tree_classes.find_by_name("Cog")
    var tree_classes_count = tree_classes.count()
    console.print(tree_classes_count)
    var child_namespaces = gadget.class.outer_class.outer_class.nested_classes
    crash child_namespaces.find_by_name("Widgets")
    var child_namespaces_count = child_namespaces.count()
    console.print(child_namespaces_count)
}
