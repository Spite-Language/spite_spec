var console = Console()
var stage = Stages.First()
var first = Proofs.One.Proof()
var second = Proofs.Two.Proof()
var rule = Rules.One.Validator()

func NamespaceWalkDecided() {
    rule.check_it()
    var stage_runs = stage.count()
    console.print(stage_runs, first.runs, second.runs, rule.runs)
    Spite.Class.instances.each(check_a_folder)
    console.print("the layout holds")
}

func check_a_folder(folder: Spite.Class) {
    var path = folder.name_with_outer_classes
    var depth = path.split(".").count()
    if depth == 2 and path.starts_with("Stages.") {
        var has_the_entry = not folder.functions.is_empty()
        crash has_the_entry
    }
    var names = folder.nested_classes.map_names()
    fallback not names.is_empty()
    check_a_rule_folder(folder, path, depth)
    check_a_proof_folder(folder, path, names, depth)
    check_a_named_folder(path, names, depth)
}

func check_a_rule_folder(folder: Spite.Class, path: String, depth: Integer) {
    fallback path.starts_with("Rules.") and depth == 2
    folder.nested_classes.each(check_a_validator)
}

func check_a_validator(validator: Spite.Class) {
    fallback validator.name == "Validator"
    var checks = validator.functions.count_name_starts_with("check")
    var has_a_check = checks > 0
    crash has_a_check
}

func check_a_proof_folder(folder: Spite.Class, path: String, names: List<String>, depth: Integer) {
    fallback depth == 2 and path.starts_with("Proofs.")
    var has_a_proof = names.contains("Proof")
    crash has_a_proof
    var is_named_for_its_folder = not folder.functions.is_empty()
    crash not is_named_for_its_folder
}

func check_a_named_folder(path: String, names: List<String>, depth: Integer) {
    fallback path.starts_with("Rules.")
    if depth == 2 {
        var has_a_validator = names.contains("Validator")
        crash has_a_validator
    }
}
