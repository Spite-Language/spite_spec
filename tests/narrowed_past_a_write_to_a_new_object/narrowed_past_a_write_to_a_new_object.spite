var console = Console()

func NarrowedPastAWriteToANewObject() {
    load "../../../spite_standard_library/windows"
    var shelf = Shelf()
    shelf.item = Item()
    show(shelf)
}

func show(shelf: Shelf) {
    fallback shelf.item
    var other = Shelf()
    other.item = null
    shelf.item = Item()
    console.print(shelf.item.number)
    if other.item {
        console.print("never")
    }
}
