var console = Console()

func NarrowedPathKept() {
    load "../../../spite_standard_library/windows"
    var outer = Box()
    outer.inner = Box()
    show(outer)
}

func show(outer: Box) {
    assert outer.inner
    outer.inner = Box()
    outer.inner.label = "replaced"
    console.print(outer.inner.label)
}
