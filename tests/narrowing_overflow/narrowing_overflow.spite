var console = Console()
var _byte_sized_value = 200

func NarrowingOverflow() {
    load "../../../spite_standard_library/windows"
    var wide = _byte_sized_value
    var fits: Byte = wide
    console.print(fits)
    var small = shrunk(wide)
    console.print("never printed", small)
}

func shrunk(value: Integer): Tiny {
    return value
}
