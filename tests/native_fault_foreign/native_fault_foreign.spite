var console = Console()
var fixture = DynamicLibrary("tests/native_fault_foreign/fixture.dll", 'identity', "")

func NativeFaultForeign() {
    var sum = add_numbers(2, 3)
    console.print("before the fault", sum)
    read_nothing()
    console.print("never printed")
}

func read_nothing() {
    var nowhere: Long = 0
    var value = read_integer_at(nowhere)
    console.print(value)
}

func add_numbers(first: Integer, second: Integer): Integer {
    return fixture.add_numbers(first, second)
}

func read_integer_at(address: Long): Integer {
    return fixture.read_integer_at(address)
}
