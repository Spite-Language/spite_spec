var console = Console()
var fixture = DynamicLibrary(
    "tests/native_fault_foreign_hot_reload/fixture.dll",
    "",
    {
        "add_numbers": DynamicLibrary.FunctionDeclaration("add_numbers", [DynamicLibrary.Argument("first", Integer), DynamicLibrary.Argument("second", Integer)], Integer)
        "read_integer_at": DynamicLibrary.FunctionDeclaration("read_integer_at", [DynamicLibrary.Argument("address", Long)], Integer)
    },
)

func NativeFaultForeignHotReload() {
    var sum = add_numbers(2, 3)
    console.print("before the fault", sum)
    read_nothing()
    console.print("never printed")
}

func read_nothing() {
    var nowhere: Long = 0
    var value = read_integer_at(nowhere)
    console.print(value)
}

func add_numbers(first: Integer, second: Integer): Integer {
    var call = DynamicLibrary.Call(fixture.functions["add_numbers"])
    call.arguments["first"] = first
    call.arguments["second"] = second
    return call.call()
}

func read_integer_at(address: Long): Integer {
    var call = DynamicLibrary.Call(fixture.functions["read_integer_at"])
    call.arguments["address"] = address
    return call.call()
}
