var console = Console()
var fixture = DynamicLibrary(
    "tests/native_fault_heap/fixture.dll",
    "",
    {"free_inside": DynamicLibrary.FunctionDeclaration("free_inside", [], Nothing)},
)

func NativeFaultHeap() {
    console.print("before the fault")
    corrupt()
}

func corrupt() {
    free_inside()
}

func free_inside() {
    var call = DynamicLibrary.Call(fixture.functions["free_inside"])
    call.call()
}
