var console = Console()
var fixture = DynamicLibrary(
    "tests/native_fault_illegal/fixture.dll",
    "",
    {
        "stop_here": DynamicLibrary.FunctionDeclaration("stop_here", [], Nothing),
    },
)

func NativeFaultIllegal() {
    console.print("before the fault")
    halt()
}

func halt() {
    stop_here()
}

func stop_here() {
    var call = DynamicLibrary.Call(fixture.functions["stop_here"])
    call.call()
}
