var recipes = List<Recipes.Buildable>()

func CookTask(chosen: List<Recipes.Buildable>) {
    recipes = chosen.copy()
}

func add(recipe: Recipes.Buildable) {
    recipes.append(recipe)
}

func run() {
    var index = 0
    while index < recipes.count() {
        recipes[index].build()
        index = index + 1
    }
}
