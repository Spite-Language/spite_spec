type Buildable {
    build()
}

var recipes = List<Buildable>()

func CookTask(chosen: List<Buildable>) {
    recipes = chosen.copy()
}

func add(recipe: Buildable) {
    recipes.append(recipe)
}

func run() {
    var index = 0
    while index < recipes.count() {
        recipes[index].build()
        index = index + 1
    }
}
