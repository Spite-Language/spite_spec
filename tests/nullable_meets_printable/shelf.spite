generic $item_type: Printable

type Printable {
    to_string: Spite.Function<String>
}

var console = Console()
var items = List<$item_type>()

func add(item: $item_type) {
    items.append(item)
}

func show() {
    var index = 0
    while index < items.count() {
        var item = items[index]
        console.print(item)
        index = index + 1
    }
}
