generic $number_type: Counted

type Counted {
    sum(Counted): Counted
    subtract(Counted): Counted
    remainder(Counted): Counted
    less_than(Counted): Boolean
    greater_than(Counted): Boolean
}

func largest(values: List<$number_type>): $number_type {
    crash values[0]
    var best = values[0]
    var index = 1
    while index < values.count() {
        if values[index] > best {
            best = values[index]
        }
        index = index + 1
    }
    return best
}

func total(values: List<$number_type>): Double {
    var sum: $number_type = 0
    var index = 0
    while index < values.count() {
        sum = sum + values[index]
        index = index + 1
    }
    return sum
}

func span(values: List<$number_type>): Long {
    crash values[0]
    var low = values[0]
    var high = values[0]
    var index = 1
    while index < values.count() {
        var value = values[index]
        if value < low {
            low = value
        }
        if value > high {
            high = value
        }
        index = index + 1
    }
    return high - low
}

func leftover(value: $number_type, divisor: $number_type): $number_type {
    return value % divisor
}
