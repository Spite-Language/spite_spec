generic $number_type: Arithmetic

type Arithmetic {
    sum: Spite.Function<Arithmetic, Arithmetic>
    subtract: Spite.Function<Arithmetic, Arithmetic>
    multiply: Spite.Function<Arithmetic, Arithmetic>
    divide: Spite.Function<Arithmetic, Arithmetic>
    remainder: Spite.Function<Arithmetic, Arithmetic>
    less_than: Spite.Function<Arithmetic, Boolean>
    greater_than: Spite.Function<Arithmetic, Boolean>
    equals: Spite.Function<Arithmetic, Boolean>
}

func combine(first: $number_type, second: $number_type): String {
    var product = first * second
    var quotient = first / second
    var rest = first % second
    var same = first == second
    var smaller = first < second
    return "{product} {quotient} {rest} {same} {smaller}"
}
