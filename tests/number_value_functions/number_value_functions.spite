var console = Console()

func NumberValueFunctions() {
    load "../../../spite_standard_library/windows"
    var numbers = List<Number>()
    numbers.append(-3)
    numbers.append(-2.5)
    var index = 0
    while index < numbers.count() {
        var value = numbers[index]
        var shown = value.to_string()
        var positive = value.absolute()
        var is_three = positive == 3
        var is_half_five = positive == 2.5
        console.print(shown, is_three, is_half_five)
        index = index + 1
    }
}
