func Numbers(): Integer {
    load "../../../spite_standard_library/common"
    var holder = Holder()
    holder.small = 5
    holder.large = 9
    holder.negative = -1
    holder.positive = 5
    holder.whole = 1000
    holder.bigger = 2000
    var total = 0
    if holder.small < holder.large {
        total = total + 1
    }
    if holder.large > holder.small {
        total = total + 2
    }
    if holder.small == holder.small {
        total = total + 4
    }
    if holder.small == holder.large {
        total = total + 8
    }
    if holder.negative < holder.positive {
        total = total + 16
    }
    if holder.whole < holder.bigger {
        total = total + 32
    }
    if holder.whole == holder.whole {
        total = total + 64
    }
    if holder.small.to_integer() == 5 {
        total = total + 128
    }
    if holder.small.to_byte() == 5 {
        total = total + 256
    }
    if holder.whole + holder.bigger == 3000 {
        total = total + 512
    }
    if holder.small.minimum(holder.large) == 5 {
        total = total + 1024
    }
    if holder.whole.maximum(holder.bigger) == 2000 {
        total = total + 2048
    }
    if holder.negative.absolute() == 1 {
        total = total + 4096
    }
    if holder.whole - holder.bigger == -1000 {
        total = total + 8192
    }
    if holder.small * holder.large == 45 {
        total = total + 16384
    }
    if holder.whole / holder.bigger == 0 {
        total = total + 32768
    }
    if holder.whole % holder.bigger == 1000 {
        total = total + 65536
    }
    return total
}
