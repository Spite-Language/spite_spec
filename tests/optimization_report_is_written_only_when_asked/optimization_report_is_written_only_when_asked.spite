var console = Console()
var program = Program()
var folder = ".spite/report_when_asked"

func OptimizationReportIsWrittenOnlyWhenAsked() {
    write_the_program()
    var here = program.working_directory()
    crash here
    var compiler = "{here}\\..\\spite_compiler\\.spite\\spite.exe"
    var report_path: Path? = "{folder}/report.md"
    crash report_path
    var report = File(report_path)
    console.print("asked for nothing")
    run_with(compiler, "--check")
    var without = report.exists()
    console.print("report written", without)
    console.print("asked for --optimization-report=report.md with --check")
    run_with(compiler, "--check --optimization-report=report.md")
    var with_it = report.exists()
    console.print("report written", with_it)
}

func run_with(compiler: String, flags: String) {
    var arguments = flags.split(" ")
    var running = Process(compiler, arguments)
    running.working_directory = folder
    running.with_errors = true
    var code = running.run()
    crash code
    var printed = running.read_output_as_string()
    crash printed
    console.print("exit code", code)
}

func write_the_program() {
    var made_path: Path? = folder
    crash made_path
    var made = Directory(made_path)
    if not made.exists() {
        crash made.create()
    }
    var lines = List<String>()
    lines.append("var console = Console()")
    lines.append("")
    lines.append("func ReportWhenAsked() \{")
    lines.append("    console.print(\"compiled\")")
    lines.append("}")
    lines.append("")
    var entry_path: Path? = "{folder}/report_when_asked.spite"
    crash entry_path
    var entry = File(entry_path)
    var joined = lines.join("\n")
    crash entry.write_string(joined)
    var stale_path: Path? = "{folder}/report.md"
    crash stale_path
    var stale = File(stale_path)
    if stale.exists() {
        crash stale.remove()
    }
}
