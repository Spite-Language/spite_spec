var console = Console()

func blend(seed: Integer): Double {
    var total: Double = 0.0
    var step: Double = seed
    var index = 0
    while index < 3000000 {
        total = total * 0.999999 + step
        index = index + 1
    }
    return total
}

func scaled(amount: Double): Double {
    var total: Double = 0.0
    var index = 0
    while index < 3000000 {
        total = total * 0.999999 + amount * 0.001
        index = index + 1
    }
    return total
}

func blend_loudly(seed: Integer): Double {
    console.print("blending", seed)
    return blend(seed)
}

func light(seed: Integer): Double {
    var total: Double = 0.0
    var step: Double = seed
    var index = 0
    while index < 10 {
        total = total * 0.5 + step
        index = index + 1
    }
    return total
}

func tripled(seed: Integer): Integer {
    var total = seed
    var index = 0
    while index < 3000000 {
        total = total * 3 % 1000003
        index = index + 1
    }
    return total
}
