func blend(seed: Integer): Double {
    var total: Double = 0.0
    var step: Double = seed
    var index = 0
    while index < 1_000_000 {
        total = total * 0.999999 + step
        index = index + 1
    }
    return total
}

func checked_blend(seed: Integer): Double {
    var total: Double = 0.0
    var step: Double = seed
    var index = 0
    while index < 1_000_000 {
        total = total * 0.999999 + step
        index = index + 1
    }
    crash total < 1000.0
    return total
}
