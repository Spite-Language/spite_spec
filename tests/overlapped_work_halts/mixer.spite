func blend(seed: Integer): Double {
    var total: Double = 0.0
    var step: Double = seed
    var index = 0
    while index < 1_000_000 {
        total = total * 0.999999 + step
        index = index + 1
    }
    return total
}

func grown(seed: Integer): Integer {
    var total = seed
    var index = 0
    while index < 100 {
        total = total * 3
        index = index + 1
    }
    return total
}
