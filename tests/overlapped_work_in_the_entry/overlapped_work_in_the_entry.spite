var console = Console()
var program = Program()

func OverlappedWorkInTheEntry() {
    load "../../../spite_standard_library/windows"
    var left = blend(3)
    var right = blend(5)
    console.print(left, right)
    var started = started_on_the_pool()
    console.print("started on the pool:", started)
}

func blend(seed: Integer): Double {
    var total: Double = 0.0
    var step: Double = seed
    var index = 0
    while index < 3000000 {
        total = total * 0.999999 + step
        index = index + 1
    }
    return total
}

func started_on_the_pool(): Integer {
    var path = program.executable_path()
    crash path
    var low_path = path.replace(".exe", ".low_ir.txt")
    var written = File(low_path).read_as_string()
    crash written
    var lines = written.split("\n")
    var in_the_entry = false
    var started = 0
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("function ") {
            in_the_entry = line.starts_with("function OverlappedWorkInTheEntry.OverlappedWorkInTheEntry:")
        } else if in_the_entry and line.contains("address of _parallel_") {
            started = started + 1
        }
        index = index + 1
    }
    return started
}
