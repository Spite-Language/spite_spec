func best_member(member: Spite.AttributeDeclaration): List<$element_type> {
    var best = List<$element_type>()
    var index = 0
    while index < count() {
        var item = get_at(index)
        crash item
        if item.attributes[member] > 2 {
            best.append(item)
        }
        index = index + 1
    }
    return best
}

func average_member(member: Spite.AttributeDeclaration): Float? {
    assert not is_empty()
    var total = 0.0
    var index = 0
    while index < count() {
        var item = get_at(index)
        crash item
        total = total + item.attributes[member]
        index = index + 1
    }
    var item_count = count()
    return total / item_count
}

func largest_member(member: Spite.AttributeDeclaration): member.class {
    var largest: member.class = 0
    var index = 0
    while index < count() {
        var item = get_at(index)
        crash item
        if item.attributes[member] > largest {
            largest = item.attributes[member]
        }
        index = index + 1
    }
    return largest
}
