var console = Console()
var _first_numbers_end = 400

func ParallelHandover() {
    load "../../../spite_standard_library/windows"
    var crafting = List<Integer>()
    var first = 0
    while first < _first_numbers_end {
        var crafter = Crafter(first)
        crafter.want(1)
        crafter.want(2)
        crafter.want(3)
        var result = crafter.craft()
        crafting.append(result)
        first = first + 100
    }
    var index = 0
    while index < crafting.count() {
        var result: Integer = crafting[index]
        console.print("crafter", index, "made", result / 1000, "recipes adding up to", result % 1000)
        index = index + 1
    }
}
