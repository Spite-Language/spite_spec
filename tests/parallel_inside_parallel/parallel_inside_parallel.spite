var console = Console()
var _upper_half_end = 2000

func ParallelInsideParallel() {
    load "../../../spite_standard_library/windows"
    var outer = sum_of_halves()
    console.print("the halves add up to", outer)
}

func sum_of_halves(): Long {
    var lower = lower_half()
    var upper = upper_half()
    return lower + upper
}

func lower_half(): Long {
    var total: Long = 0
    var index = 0
    while index < 1000 {
        total = total + index
        index = index + 1
    }
    return total
}

func upper_half(): Long {
    var total: Long = 0
    var index = 1000
    while index < _upper_half_end {
        total = total + index
        index = index + 1
    }
    return total
}
