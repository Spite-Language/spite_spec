var console = Console()
var names = List<String>()
var _large_sum_limit = 3000000

func ParallelWork() {
    load "../../../spite_standard_library/windows"
    var small = Summer(1000000)
    var large = Summer(_large_sum_limit)
    var small_sum = small.total()
    var large_sum = large.total()
    console.print(small_sum, large_sum)
    var greeting = greet()
    var nobody = nobody_found()
    if nobody {
        console.print(nobody)
    } else {
        console.print(greeting, "and nobody")
    }
    var index = 0
    while index < 20 {
        var namer = Namer(index)
        var naming = namer.name()
        names.append(naming)
        index = index + 1
    }
    var last_name = names.last()
    crash last_name
    console.print(last_name)
    say_done()
}

func greet(): String {
    return "hello"
}

func nobody_found(): String? {
    return null
}

func say_done() {
    console.print("joined when dropped")
}
