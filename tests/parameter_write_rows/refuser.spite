generic $system_type

enum Phase {
    'update'
    'keep'
}

var console = Console()

func refuse() {
    refuse_phases_each()
}

func refuse_phase_each(phase: Spite.FunctionDeclaration) {
    if $system_type.argument_count("<phase>_each") > 0 {
        refuse_snapshot_arguments()
    }
}

func refuse_snapshot_argument(argument: Spite.Argument) {
    crash not $system_type.function_writes_parameter("<phase>_each", argument.index) or not argument.class.any_attribute_fits_vector(Entity)
    console.print(argument.name, "may run on a snapshot")
}
