var console = Console()

func ParentBackReference() {
    load "../../../spite_standard_library/windows"
    var kept = grow_family()
    if kept.parent {
        console.print("still reachable", kept.parent.name)
    } else {
        console.print("the parent is gone, and", kept.name, "knows it")
    }
    show_living_family()
}

func grow_family(): Child {
    var parent = Parent("ada")
    parent.adopt("grace")
    parent.adopt("linus")
    var first = parent.children.first()
    crash first
    crash first.parent
    console.print(first.name, "belongs to", first.parent.name)
    return first
}

func show_living_family() {
    var parent = Parent("barbara")
    parent.adopt("edsger")
    var child = parent.children.first()
    crash child
    crash child.parent
    console.print(child.name, "belongs to", child.parent.name, "while both live")
}
