var console = Console()
var partner: Person? = null
var name: String

func Person(new_name: String) {
    name = new_name
}

func partner_name(): String {
    fallback partner
    return partner.name
}

func drop() {
    if partner {
        console.print(name, "is freed, still with", partner.name)
    } else {
        console.print(name, "is freed alone")
    }
}
