var console = Console()

func PinnedComponents() {
    load "../../../spite_standard_library/windows"
    var systems = Draw.functions.filter_name_ends_with("_each")
    systems.each(place)
}

func place(function: Spite.Function) {
    var mutated = function.arguments.filter_is_mutated()
    var mutated_count = mutated.count()
    console.print(function.name, "writes", mutated_count)
    function.arguments.each(check)
}

func check(target: Spite.Argument) {
    var pinned = target.class.functions["pinned_to_creating_thread"]
    if pinned {
        console.print(" ", target.name, "runs on the thread that made it")
    } else {
        console.print(" ", target.name, "runs on any thread")
    }
}
