generic $system_type

enum Phase {
    'update'
}

var system = $system_type()
var found = List<Integer>()
var missing = false
var built = 0

func run(entity_count: Integer) {
    run_phases_each(entity_count)
}

func run_phase_each(phase: Spite.FunctionDeclaration, entity_count: Integer) {
    var entity = 0
    while entity < entity_count {
        found.clear()
        missing = false
        find_arguments(entity)
        if not missing {
            system.phase_each(made_arguments(found))
        }
        entity = entity + 1
    }
}

func find_argument(argument: Spite.Argument, entity: Integer) {
    var column = Column<argument.class>()
    var dense = column.dense_index(entity)
    note(dense)
}

func note(dense: Integer) {
    if dense < 0 {
        missing = true
    }
    found.append(dense)
}

func made_argument(argument: Spite.Argument, rows: List<Integer>): argument.class {
    built = built + 1
    crash rows[argument.index]
    var stored_row = rows[argument.index]
    crash Column<argument.class>().values[stored_row]
    return Column<argument.class>().values[stored_row]
}
