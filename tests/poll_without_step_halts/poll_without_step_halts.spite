var console = Console()
var program = Program()

func PollWithoutStepHalts() {
    load "../../../spite_standard_library/windows"
    var napping = Concurrent(nap)
    var polls = 0
    while not napping.finished {
        polls = counted(polls)
    }
    console.print("never printed", polls)
}

func counted(polls: Integer): Integer {
    return polls + 1
}

func nap() {
    var five_milliseconds = Duration(5, 'milliseconds')
    program.sleep(five_milliseconds)
}
