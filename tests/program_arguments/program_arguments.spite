var console = Console()
var program = Program()
var environment = Environment()

func ProgramArguments() {
    load "../../../spite_standard_library/windows"
    var arguments = program.arguments()
    greet(arguments)
}

func greet(arguments: List<String>) {
    var arguments_count = arguments.count()
    var argument = arguments[0]
    crash argument
    console.print(arguments_count, argument)
    fallback not environment.player.is_empty()
    console.print("player", environment.player)
}
