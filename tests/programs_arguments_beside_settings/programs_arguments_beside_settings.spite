var console = Console()
var environment = Environment()
var program = Program()

func ProgramsArgumentsBesideSettings() {
    load "../../../spite_standard_library/windows"
    var arguments = program.arguments()
    var given = arguments.count()
    console.print(environment.workers, given)
    var player_name = program.argument_named("player-name")
    if player_name {
        console.print("given", player_name)
    } else {
        console.print("not given")
    }
}
