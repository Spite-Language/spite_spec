var console = Console()

func ProofAgainInLoop() {
    load "../../../SpiteCompiler/.spite/library/common"
    load "../../../SpiteCompiler/.spite/library/windows"
    var hunter = Hunter()
    var rounds = 0
    var index = 0
    while index < 1000 {
        var monster = Monster(index % 60)
        hunter.target = monster
        rounds = rounds + hunter.hunt()
        index = index + 1
    }
    console.print("rounds", rounds, "hits", hunter.hits)
}
