type Component {
    to_debug: Spite.Function<String>
}

var positions = Column<Position>()
var component: Component?
var entity: Integer

func AddComponent(new_entity: Integer, new_component: Component) {
    entity = new_entity
    component = new_component
}

func apply() {
    crash component
    if component.class == Position {
        positions.insert(entity, component)
    }
}
