enum Mood {
    'calm'
    'angry'
}

var alive = true
var mood: Mood = 'angry'
var friends = List<Monster>()
var name: String
var health: Integer

func Monster(starting_name: String, starting_health: Integer) {
    name = starting_name
    health = starting_health
}

func kind_of_attribute(attribute: Spite.AttributeDeclaration): String {
    return "{attribute.name}:{attributes[attribute].class.name}"
}
