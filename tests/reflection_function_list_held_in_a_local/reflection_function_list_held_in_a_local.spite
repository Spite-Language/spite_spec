var console = Console()

func ReflectionFunctionListHeldInALocal() {
    load "../../../spite_standard_library/windows"
    var listed = Integer.functions
    var has_equals = listed.contains("equals")
    console.print("equals", has_equals)
    var has_flying = listed.contains("fly")
    console.print("fly", has_flying)
    var count = listed.count()
    console.print("more than ten", count > 10)
    var looked_up = Integer.functions
    var asked = "absolute"
    var has_asked = looked_up.contains(asked)
    console.print("absolute", has_asked)
    var passed = Integer.functions
    var counted = counted_functions(passed)
    console.print("counted alike", counted == count)
}

func counted_functions(listed: Dictionary<String, Spite.FunctionDeclaration>): Integer {
    return listed.count()
}
