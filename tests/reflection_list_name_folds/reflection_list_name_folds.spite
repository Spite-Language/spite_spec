var console = Console()
var program = Program()

func ReflectionListNameFolds() {
    load "../../../spite_standard_library/windows"
    var axle = Gear.classes["Axle"]
    var outer = Gear.namespaces["Outer"]
    console.print(axle.name_with_namespaces, outer.name_with_namespaces)
    if Gear.classes["Wheel"] {
        console.print(Gear.classes["Wheel"].name)
    }
    var built = lists_built_in("ReflectionListNameFolds.ReflectionListNameFolds")
    console.print("lists built:", built)
    look_for_a_pulley()
}

func look_for_a_pulley() {
    var missing = Gear.classes["Pulley"]
    if missing {
        console.print("never printed", missing.name)
    } else {
        console.print("no Pulley")
    }
}

func lists_built_in(function_key: String): Integer {
    var path = program.executable_path()
    crash path
    var high_path = path.replace(".exe", ".high_ir.txt")
    var text_path: Path? = high_path
    crash text_path
    var text = File(text_path).read_as_string()
    crash text
    var lines = text.split("\n")
    var inside = false
    var built = 0
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("function ") {
            inside = line.starts_with("function {function_key}(")
        }
        if inside and line.contains("get_classes(") {
            built = built + 1
        }
        if inside and line.contains("get_namespaces(") {
            built = built + 1
        }
        index = index + 1
    }
    return built
}
