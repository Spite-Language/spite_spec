var console = Console()

func ReflectionNameWithHoles() {
    var ending = "unt"
    var found = Monster.attributes["co{ending}"]
    crash found
    console.print("found", found.name)
    var missing = Monster.attributes["zz{ending}"]
    console.print("missing", missing)
    var monster = Monster(2)
    console.print("count", monster.count)
}
