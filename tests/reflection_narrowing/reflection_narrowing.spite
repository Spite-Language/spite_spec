var console = Console()

func ReflectionNarrowing() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var walker = Walker()
    var walkers = Caller<Walker>()
    var walked = walkers.call(walker)
    console.print(walked, walker.steps)
    var rock = Rock()
