var console = Console()
var program = Program()

func ReflectionUnreadFieldHasNoSlot() {
    var roar = Monster.functions["roar"]
    crash roar
    var file = roar.source_file
    console.print(roar.name, file.file_name)
    var path = program.executable_path()
    crash path
    var high_path = path.replace(".exe", ".high_ir.txt")
    var text_path: Path? = high_path
    crash text_path
    var text = File(text_path).read_as_string()
    crash text
    var constructor = "Spite.FunctionDeclaration.FunctionDeclaration("
    var keeps_the_name = function_holds(constructor, "_name", text)
    var keeps_the_file = function_holds(constructor, "_source_path", text)
    var keeps_the_signature = function_holds(constructor, "_signature", text)
    var keeps_the_reads = function_holds(constructor, "_reads", text)
    console.print("keeps what it reads", keeps_the_name, keeps_the_file)
    console.print("keeps what it does not", keeps_the_signature, keeps_the_reads)
}

func function_holds(function_key: String, wanted: String, text: String): Boolean {
    var lines = text.split("\n")
    var inside = false
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("function ") {
            inside = line.starts_with("function {function_key}")
        }
        if inside and line.contains(wanted) {
            return true
        }
        index = index + 1
    }
    return false
}
