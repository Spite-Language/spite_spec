union Pet {
    Cat
    Dog
}

var console = Console()

func RepeatedKeepsApart() {
    var cat = Cat()
    var vet = Vet()
    var groomer = Groomer()
    var pet: Pet = cat
    var checked = vet.check(pet)
    var groomed = groomer.groom(pet)
    var narrowed = vet.narrowed(cat)
    console.print(checked, groomed, narrowed)
}
