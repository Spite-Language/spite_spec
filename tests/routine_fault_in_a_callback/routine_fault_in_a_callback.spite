var console = Console()
var fixture = DynamicLibrary(
    "tests/routine_fault_in_a_callback/fixture.dll",
    "",
    {
        "call_back_broken": DynamicLibrary.FunctionDeclaration(
            "call_back_broken",
            [
                DynamicLibrary.Argument("callback", Long),
            ],
            Nothing,
        ),
    },
)
var filler = Filler()
var filling = ForeignCallback(filler.fill, 'no_context')

func RoutineFaultInACallback() {
    console.print("before the fault")
    call_back_broken(filling.address)
    console.print("never printed")
}

func call_back_broken(callback: Long) {
    var call = DynamicLibrary.Call(fixture.functions["call_back_broken"])
    call.arguments["callback"] = callback
    call.call()
}
