var console = Console()
var kept = List<Spite.Function>()

func RunTimeAccesses() {
    load "../../../spite_standard_library/windows"
    var movement = Movement()
    var update = Movement.functions['update_each']
    crash update
    kept.append(update)
    var remember = movement.remember
    kept.append(remember)
    kept.each(describe)
    var anything: Anything = movement
    var kind = anything.class
    var functions = kind.functions
    var first = functions['update_each']
    crash first
    describe(first)
}

func describe(function: Spite.Function) {
    var reads = function.reads
    var writes = function.writes
    var read_count = reads.count()
    var written_count = writes.count()
    console.print(function.name, read_count, "written:", written_count)
    reads.each(describe_read)
    writes.each(describe_write)
}

func describe_read(attribute: Spite.AttributeDeclaration) {
    console.print("  reads", attribute.name)
}

func describe_write(attribute: Spite.AttributeDeclaration) {
    console.print("  writes", attribute.name)
}
