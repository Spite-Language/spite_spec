var console = Console()

func RunTimeCallAnswersAFunctionValue() {
    var picker = Picker()
    var held: Anything = picker
    var declaration = held.class.functions["picked"]
    crash declaration
    var call = Spite.Call(declaration, held)
    console.print("built")
    var answer = call.call()
    crash answer
    var answered = answer.class.name
    console.print(answered)
}
