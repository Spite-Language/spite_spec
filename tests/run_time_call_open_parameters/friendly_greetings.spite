var console = Console()

func FriendlyGreetings() {
    console.print("made")
}

func greet_all(pet: Pet, named: Named, times: Integer?) {
    var count = 1
    if times {
        count = times
    }
    switch pet {
        Cat: console.print("cat", pet.name, count)
        Dog: console.print("dog", pet.name, count)
    }
    console.print("named", named.name)
}
