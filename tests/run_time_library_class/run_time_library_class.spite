var console = Console()

func RunTimeLibraryClass() {
    var kinds = List<Spite.Class>()
    kinds.append(Http.Response)
    kinds.append(Integer)
    kinds.each(make)
}

func make(kind: Spite.Class) {
    var made = kind()
    if made.class == Http.Response {
        console.print(kind.name, "status", made.status)
    } else {
        console.print(kind.name, "made")
    }
}
