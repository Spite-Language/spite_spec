var console = Console()
var stock = Stock.Shelf()
var ticks = List<Tick>()
var timers = Timers()

func SameNameCallEffects() {
    load "../../../spite_standard_library/windows"
    var tick = Tick()
    ticks.append(tick)
    ticks.each(timers.advance)
    console.print(timers.total, stock.count, timers.last)
}
