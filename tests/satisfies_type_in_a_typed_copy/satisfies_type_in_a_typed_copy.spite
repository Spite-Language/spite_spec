type Component {
    render: Spite.Function<Component?>
}

type AnyCustom {
    key: String
}

var console = Console()

func SatisfiesTypeInATypedCopy() {
    var glow = Custom<Glow>()
    var plain = Plain()
    var glow_key = key_of(glow)
    var plain_key = key_of(plain)
    console.print(glow_key, plain_key, plain.shown)
}

func key_of(value: Component): String {
    if value.class.satisfies_type(AnyCustom) {
        return value.key
    }
    return "none"
}
