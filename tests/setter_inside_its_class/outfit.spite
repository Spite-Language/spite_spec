var console = Console()
var writes = 0
var helmet = "none"

func Outfit(starting_helmet: String) {
    helmet = starting_helmet
}

func set_helmet(value: String) {
    writes = writes + 1
    console.print("was", attributes["helmet"].value)
    attributes["helmet"].value = value.upper_case()
}

func get_helmet(): String {
    var stored = attributes["helmet"].value
    return "[{stored}]"
}

func wear(value: String) {
    helmet = value
    console.print("wearing", helmet, writes)
}

func lend(other: Outfit) {
    other.helmet = helmet
}
