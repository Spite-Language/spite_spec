var console = Console()
var build = Build()

func SettingsAndLibrariesReflected() {
    var check = build.attributes["check"]
    var check_text = text_of(check)
    console.print(check_text)
    var optimized = build.attributes["optimized"]
    var optimized_text = text_of(optimized)
    console.print(optimized_text)
    var shelf = Shelf()
    var shelf_attributes = Shelf.attributes
    var functions = console.class.functions
    var shelf_count = shelf_attributes.count()
    var held = shelf.libraries.count()
    var function_count = functions.count()
    console.print("shelf", shelf_count, held, function_count > 0)
}

func text_of(attribute: Spite.Attribute<Boolean>): String {
    var shown = attribute.value.to_debug()
    return "{attribute.name} {shown}"
}
