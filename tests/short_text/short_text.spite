var console = Console()
var names = List<String>()
var label = ""

func ShortText() {
    load "../../../spite_standard_library/windows"
    var letters = "abcdefghijklmn"
    var fifteen = "{letters}o"
    var sixteen = "{fifteen}p"
    var fifteen_length = fifteen.length()
    var sixteen_length = sixteen.length()
    var last_of_fifteen = fifteen.byte_at(14)
    var last_of_sixteen = sixteen.byte_at(15)
    console.print(fifteen_length, sixteen_length, last_of_fifteen, last_of_sixteen)
    console.print(fifteen == "abcdefghijklmno", sixteen == "abcdefghijklmnop", fifteen < sixteen)
    var grown = ""
    var index = 0
    while index < 20 {
        grown = "{grown}{index % 10}"
        index = index + 1
    }
    var grown_length = grown.length()
    console.print(grown, grown_length)
    var kept = grown.slice(0, 15)
    crash kept
    var before = kept
    kept = "{kept}!"
    console.print(before, kept)
    var twice = "ab"
    twice = twice + twice
    twice = twice + twice + twice
    console.print(twice)
    names.append(fifteen)
    names.append(sixteen)
    var shouted = "x".upper_case()
    names.append(shouted)
    var sliced_label = fifteen.slice(0, 3)
    crash sliced_label
    label = sliced_label
    var joined = names.join(",")
    console.print(joined, label)
    var counts = Dictionary<String, Integer>()
    counts["{label}1"] = 1
    counts[sixteen] = 2
    var short_count = counts["abc1"]
    var long_count = counts["abcdefghijklmnop"]
    if short_count and long_count {
        console.print(short_count, long_count)
    }
    var nothing_longer = longer_than(20)
    var some = longer_than(15)
    if nothing_longer {
        console.print("a name longer than 20")
    }
    if some {
        console.print("longer than 15:", some)
    }
    console.debug(fifteen, sixteen)
}

func longer_than(limit: Integer): String? {
    var index = 0
    while index < names.count() {
        var name = names[index]
        if name.length() > limit {
            return name
        }
        index = index + 1
    }
    return null
}
