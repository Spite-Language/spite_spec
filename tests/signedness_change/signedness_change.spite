var console = Console()
var _largest_unsigned_short: UnsignedShort = 65535

func SignednessChange() {
    load "../../../spite_standard_library/windows"
    var count = 0 - 3
    var minus_one: Long = -1
    var top = UnsignedLong.Largest()
    var tiny: Tiny = -128
    console.print(
        "{count.bits_as_unsigned()} {minus_one.bits_as_unsigned()} {top.bits_as_signed()} {tiny.bits_as_unsigned()}",
    )
    var small: UnsignedShort = _largest_unsigned_short
    var widened: Integer = small
    console.print(widened)
    var unsigned_count: UnsignedInteger = count
    console.print("never printed", unsigned_count)
}
