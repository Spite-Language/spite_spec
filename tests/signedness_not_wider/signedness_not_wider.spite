var console = Console()

func SignednessNotWider() {
    load "../../../spite_standard_library/windows"
    var signed = 5
    var unsigned: UnsignedInteger = 7
    var total = signed + unsigned
    var small: Byte = 200
    var next = small + 1
    var above = small > 1
    console.print(total, next, above)
}
