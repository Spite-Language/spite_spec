var cache = TextureCache()
var first = 0
var _textures_per_loader = 2000

func Loader(starting_first: Integer) {
    first = starting_first
}

func load_many(): Integer {
    var index = 0
    while index < _textures_per_loader {
        var number = first + index
        cache.remember("texture {number}", number)
        index = index + 1
    }
    return index
}
