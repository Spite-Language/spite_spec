var console = Console()
var cache = TextureCache()
var _all_textures = 8000
var _textures_per_loader = 2000

func SingletonGuard() {
    load "../../../spite_standard_library/windows"
    var loading = List<Integer>()
    var start = 0
    while start < _all_textures {
        var loader = Loader(start)
        var loading_run = loader.load_many()
        loading.append(loading_run)
        start = start + _textures_per_loader
    }
    var frames = 0
    while frames < 1000 {
        cache.remember("frame texture", frames)
        frames = frames + 1
    }
    var loaded = 0
    var index = 0
    while index < loading.count() {
        var count: Integer = loading[index]
        loaded = loaded + count
        index = index + 1
    }
    var known = cache.known()
    var total = cache.total_loads()
    console.print("loaded", loaded, "on the pool while", frames, "frames ran")
    console.print("the cache knows", known, "textures after", total, "loads")
}
