var console = Console()
var census = Census()

func SingletonRace() {
    load "../../../spite_standard_library/windows"
    var first_toucher = Toucher()
    var second_toucher = Toucher()
    var first = first_toucher.touch_many()
    var second = second_toucher.touch_many()
    var touched = first + second
    console.print("touched", touched, "made", census.made)
}
