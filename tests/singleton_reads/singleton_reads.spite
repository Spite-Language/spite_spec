var console = Console()
var transforms = Column<Transform>()
var _first_rows = 2000
var _all_rows = 6000

func SingletonReads() {
    load "../../../spite_standard_library/windows"
    add_rows(0, _first_rows)
    var first = Reader(_first_rows)
    var first_run = first.run()
    var second = Reader(_first_rows)
    var second_run = second.run()
    var third = Reader(_first_rows)
    var third_run = third.run()
    add_rows(_first_rows, _all_rows)
    var read = first_run + second_run + third_run
    var last = Reader(_all_rows)
    var everything: Integer = last.run()
    console.print("three readers saw", read, "while rows were added, and all rows add up to", everything)
}

func add_rows(first: Integer, end: Integer) {
    var row = first
    while row < end {
        var transform = Transform(row)
        transforms.insert(transform)
        row = row + 1
    }
}
