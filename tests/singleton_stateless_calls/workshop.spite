singleton

var program = Program()
var pieces = List<Integer>()
var _most_polls = 5000

func build(): Integer {
    var one_millisecond = Duration(1, 'milliseconds')
    var helper = Helper()
    var working = Parallel(helper.work)
    var polls = 0
    var made = 0
    while made == 0 and polls < _most_polls {
        polls = polls + 1
        var finished = working.finished_value()
        if finished {
            made = finished
        } else {
            program.sleep(one_millisecond)
        }
    }
    pieces.append(made)
    return made
}

func make_piece(size: Integer): Integer {
    return size * 2
}

func count(): Integer {
    return pieces.count()
}
