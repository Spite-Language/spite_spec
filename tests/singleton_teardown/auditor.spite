singleton

var console = Console()
var clerk = Clerk()
var plain = DynamicLibrary(
    "tests/foreign_library/fixture.dll",
    "",
    {
        "sum_of": DynamicLibrary.FunctionDeclaration(
            "add_numbers",
            [
                DynamicLibrary.Argument("first", Integer),
                DynamicLibrary.Argument("second", Integer),
            ],
            Integer,
        ),
    },
)
var ledger = Ledger()

func check(): Integer {
    return sum_of(2, 3)
}

func drop() {
    ledger.note("audited")
    clerk.file("audited")
    var sum = sum_of(4, 5)
    console.print("auditor dropped, the library still answers", sum)
}

func sum_of(first: Integer, second: Integer): Integer {
    var call = DynamicLibrary.Call(plain.functions["sum_of"])
    call.arguments["first"] = first
    call.arguments["second"] = second
    return call.call()
}
