singleton

var console = Console()
var clerk = Clerk()
var plain = DynamicLibrary("tests/foreign_library/fixture.dll", 'identity', "")
var ledger = Ledger()

func check(): Integer {
    return sum_of(2, 3)
}

func drop() {
    ledger.note("audited")
    clerk.file("audited")
    var sum = sum_of(4, 5)
    console.print("auditor dropped, the library still answers", sum)
}

func sum_of(first: Integer, second: Integer): Integer {
    return plain.add_numbers(first, second)
}
