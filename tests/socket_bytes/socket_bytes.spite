var console = Console()
var server = Tcp.Server()

func SocketBytes() {
    load "../../../spite_standard_library/windows"
    var address = "127.0.0.1".to_ip_address()
    crash address
    crash server.listen_at(address, 47313)
    var client = Tcp.Client()
    var local_host = "localhost".to_ip_address()
    crash local_host
    crash client.connect(local_host, 47313)
    var peer = server.accept()
    crash peer
    console.print("the peer is open:", not peer.closed)
    send(client, 1, 2, 250)
    var received = receive(peer, 3)
    var first = received[0]
    crash first
    var third = received[2]
    crash third
    var received_count = received.count()
    console.print("peer received:", received_count, first, third)
    var answer = Buffer(0)
    answer.append(7)
    answer.append(8)
    answer.append(9)
    crash peer.write_buffer(answer)
    var from_peer = Buffer(0)
    while from_peer.count() < 3 and not client.closed {
        var more = client.read_as_buffer()
        if more {
            var more_count = more.count()
            from_peer.append_buffer(more, 0, more_count)
        }
    }
    var second = from_peer[1]
    crash second
    received_count = from_peer.count()
    console.print("client received:", received_count, second)
    crash peer.write_line("hello over the wire")
    var line = client.read_line()
    crash line
    console.print("client read the line:", line)
    var not_text = Buffer(0)
    not_text.append(255)
    not_text.append(10)
    crash peer.write_buffer(not_text)
    crash peer.write_line("after it")
    var refused = client.read_line()
    if not refused {
        console.print("a line that is not UTF-8 is null, open:", not client.closed)
    }
    var following = client.read_line()
    crash following
    console.print("then the next line:", following)
    client.close()
    var after = peer.read_as_buffer()
    if not after {
        console.print("peer closed:", peer.closed)
    }
    var last_line = peer.read_line()
    if not last_line {
        console.print("no line after the close")
    }
    peer.close()
    server.close()
}

func send(client: Tcp.Client, first: Byte, second: Byte, third: Byte) {
    var message = Buffer(0)
    message.append(first)
    message.append(second)
    message.append(third)
    var sent = client.write_buffer(message)
    console.print("sent:", sent)
}

func receive(connection: Tcp.Connection, wanted: Integer): Buffer {
    var received = Buffer(0)
    while received.count() < wanted and not connection.closed {
        var more = connection.read_as_buffer()
        if more {
            var more_count = more.count()
            received.append_buffer(more, 0, more_count)
        }
    }
    return received
}
