var console = Console()
var server = Tcp.Server()

func SocketWaits() {
    load "../../../spite_standard_library/windows"
    var local_host = "localhost".to_ip_address()
    crash local_host
    crash server.listen_at(local_host, 47314)
    var serving = Concurrent(echo_once)
    var client = Tcp.Client()
    var address = "127.0.0.1".to_ip_address()
    crash address
    crash client.connect(address, 47314)
    var message = Buffer(0)
    message.append(10)
    message.append(20)
    message.append(30)
    message.append(40)
    crash client.write_buffer(message)
    var answer = Buffer(0)
    while answer.count() < 4 and not client.closed {
        var more = client.read_as_buffer()
        if more {
            var more_count = more.count()
            answer.append_buffer(more, 0, more_count)
        }
    }
    var received = answer.count()
    var last = answer[3]
    crash last
    console.print("the client read back", received, "bytes, the last", last)
    var line = client.read_line()
    if not line {
        console.print("no line: the server closed", client.closed)
    }
    console.print("the server echoed", serving, "bytes")
    client.close()
    server.close()
}

func echo_once(): Integer {
    var peer = server.accept()
    crash peer
    var buffer = Buffer(0)
    while buffer.count() < 4 and not peer.closed {
        var more = peer.read_as_buffer()
        if more {
            var more_count = more.count()
            buffer.append_buffer(more, 0, more_count)
        }
    }
    var echoed = peer.write_buffer(buffer)
    peer.close()
    if echoed {
        return buffer.count()
    }
    return 0
}
