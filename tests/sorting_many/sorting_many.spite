var console = Console()

func SortingMany() {
    load "../../../spite_standard_library/windows"
    var numbers = List<Integer>()
    var index = 0
    while index < 5000 {
        var scrambled = index * 7919 % 5000
        numbers.append(scrambled)
        index = index + 1
    }
    var sorted = numbers.sort_by(tens_of)
    var sorted_count = sorted.count()
    var ascending = ascends(sorted)
    console.print("sorted", sorted_count, "numbers, ascending by tens:", ascending)
    var stable = keeps_ties(sorted)
    console.print("ties keep their order:", stable)
    var folder = Directory(".spite/sorting_many")
    crash folder.create()
    index = 0
    while index < 300 {
        var scrambled = index * 37 % 300
        var file = File("{folder.path}/file_{scrambled}.txt")
        crash file.write_string("")
        index = index + 1
    }
    var listed = folder.entries()
    crash listed
    var names = listed.filter_files().map_file_names()
    var name_count = names.count()
    var ordered = in_order(names)
    console.print("listed", name_count, "files, in order:", ordered)
}

func tens_of(number: Integer): Integer {
    return number / 10
}

func ascends(numbers: List<Integer>): Boolean {
    var index = 1
    while index < numbers.count() {
        crash numbers[index - 1]
        var before = numbers[index - 1] / 10
        var here = numbers[index] / 10
        fallback before <= here
        index = index + 1
    }
    return true
}

func keeps_ties(numbers: List<Integer>): Boolean {
    var index = 1
    while index < numbers.count() {
        crash numbers[index - 1]
        var before = numbers[index - 1]
        var here = numbers[index]
        fallback before / 10 != here / 10 or first_position(before) < first_position(here)
        index = index + 1
    }
    return true
}

func first_position(number: Integer): Integer {
    var index = 0
    while index < 5000 {
        if index * 7919 % 5000 == number {
            return index
        }
        index = index + 1
    }
    return -1
}

func in_order(names: List<String>): Boolean {
    var index = 1
    while index < names.count() {
        crash names[index - 1]
        var before = names[index - 1]
        var here = names[index]
        fallback before < here
        index = index + 1
    }
    return true
}
