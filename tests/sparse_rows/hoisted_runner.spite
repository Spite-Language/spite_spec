generic $row_type

var world = World()
var missing = false

func run(mover: Mover) {
    var entity = 0
    while entity < world.entity_count {
        missing = false
        var row: $row_type = null
        fill_attributes(row, entity)
        if not missing {
            mover.update_each(row)
        }
        entity = entity + 1
    }
}

func fill_attribute(attribute: Spite.AttributeDeclaration, row: $row_type, entity: Integer) {
    if attribute.class == Entity {
        row.attributes[attribute] = Entity(entity)
    } else if attribute.class.fits_vector() and attribute.class != Entity {
        var column = Column<attribute.class>()
        var dense = column.set.dense_index(entity)
        missing = missing or dense < 0
        fallback dense >= 0
        crash column.values[dense]
        row.attributes[attribute] = column.values[dense]
    } else {
        var references = ReferenceColumn<attribute.class>()
        var dense = references.set.dense_index(entity)
        missing = missing or dense < 0
        fallback dense >= 0
        row.attributes[attribute] = references.at(dense)
    }
}
