var console = Console()
var program = Program()
var machine = Machine()
var frames = 0

func StateMachineKeepsWrittenOrder() {
    load "../../../spite_standard_library/windows"
    var one_millisecond = Duration(1, 'milliseconds')
    while not machine.finished {
        frames = frames + 1
        if frames == 1 {
            machine.run()
        }
        program.sleep(one_millisecond)
    }
    console.print("the frame went on while the machine waited:", frames > 1)
}
