singleton

var limit = 7
var step = 0
var total = 0
var twice = 0

func Limits() {
    step = 3
}

func allowed(value: Integer): Integer {
    if value > limit {
        return limit
    }
    return value
}

func add(value: Integer) {
    total = total + value
}

func add_twice(value: Integer) {
    twice = twice + value
    twice = twice + value
}
