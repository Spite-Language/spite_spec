generic $system_type

enum Phase {
    'update'
}

var system = $system_type()

func run(entity_count: Integer) {
    run_phases_each(entity_count)
}

func run_phase_each(phase: Spite.FunctionDeclaration, entity_count: Integer) {
    if $system_type.argument_count("<phase>_each") == 1 {
        stream_arguments(entity_count)
    }
}

func stream_argument(argument: Spite.Argument, entity_count: Integer) {
    var stream = Stream<$system_type, argument.class>()
    stream.run(system, entity_count)
}
