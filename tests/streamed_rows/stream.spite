generic $system_type
generic $row_type

enum Phase {
    'update'
}

func run(system: $system_type, entity_count: Integer) {
    run_phases_each(system, entity_count)
}

func run_phase_each(phase: Spite.FunctionDeclaration, system: $system_type, entity_count: Integer) {
    var entity = 0
    while entity < entity_count {
        system.phase_each(streamed_arguments(entity))
        entity = entity + 1
    }
}

func streamed_argument(argument: Spite.Argument, entity: Integer): argument.class {
    if argument.class == $row_type {
        var row: $row_type = null
        fill_attributes(row, entity)
        return row
    }
    var other: argument.class = null
    return other
}

func fill_attribute(attribute: Spite.AttributeDeclaration, row: $row_type, entity: Integer) {
    var column = Column<attribute.class>()
    var dense = column.dense_index(entity)
    crash column.values[dense]
    row.attributes[attribute] = column.values[dense]
}
