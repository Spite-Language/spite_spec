var console = Console()
var build = Build()

func StridedLoopsKeepOrDropChecks() {
    var size = 0
    while size < 5 {
        var values = List<Integer>()
        var index = 0
        while index < size {
            values.append(index * 10 + 1)
            index = index + 1
        }
        var windows = window_sums(values)
        var smoothed = smooth(values)
        console.print("size", size, "windows", windows, "smoothed", smoothed)
        size = size + 1
    }
    print_report()
}

func window_sums(values: List<Integer>): Integer {
    var total = 0
    var at = 0
    while at + 2 < values.count() {
        total = total + values[at] + values[at + 1] * 2 + values[at + 2] * 3
        at = at + 1
    }
    return total
}

func smooth(values: List<Integer>): Integer {
    var at = 0
    while at + 1 < values.count() {
        values[at + 1] = values[at] + values[at + 1]
        at = at + 1
    }
    var ending = values.last()
    if ending {
        return ending
    }
    return 0
}

func print_report() {
    var report_path: Path? = "{build.program}/.spite/reports/strided_loops_keep_or_drop_checks.md"
    crash report_path
    var report = File(report_path).read_as_string()
    crash report
    var lines = report.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        var is_kept = line.starts_with("- [") and line.contains("keeps its overflow check")
        if is_kept and line.contains("strided_loops_keep_or_drop_checks.spite") {
            var parts = line.split("): ")
            var last = parts.last()
            crash last
            console.print(last)
        }
        index = index + 1
    }
}
