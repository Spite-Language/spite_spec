var console = Console()

func StringCasing() {
    load "../../../spite_standard_library/windows"
    var samples = [
        "total_count",
        "TotalCount",
        "totalCount",
        "HTTPHelper",
        "userID",
        "XMLHttpRequest",
        "Vector2D",
        "vector_2d",
        "version2Beta",
        "_private",
        "kit__x",
        "trailing_",
        "tool-helper",
        "tool.helper",
        "tool helper",
        "ID",
        "",
        "__",
        "2kit",
        "Kit2Go",
        "café_au_lait",
        "ABC",
        "a_b_c",
    ]
    var index = 0
    while index < samples.count() {
        var sample = samples[index]
        var snake = sample.snake_case()
        var camel = sample.camel_case()
        var pascal = sample.pascal_case()
        console.print("[{sample}] [{snake}] [{camel}] [{pascal}]")
        index = index + 1
    }
}
