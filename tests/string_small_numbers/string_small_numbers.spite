var console = Console()

func StringSmallNumbers() {
    load "../../../spite_standard_library/windows"
    var tiny_top: Tiny? = "127"
    var tiny_over: Tiny? = "128"
    var tiny_bottom: Tiny? = "-128"
    var short_over: Short? = "32768"
    var short_top: Short? = " 32767 "
    console.print(tiny_top, tiny_over, tiny_bottom, short_over, short_top)
    var unsigned_short_top: UnsignedShort? = "65535"
    var unsigned_short_negative: UnsignedShort? = "-1"
    var byte_top: Byte? = "255"
    var unsigned_long_top: UnsignedLong? = "18446744073709551615"
    var unsigned_long_over: UnsignedLong? = "18446744073709551616"
    console.print(unsigned_short_top, unsigned_short_negative, byte_top, unsigned_long_top, unsigned_long_over)
    var half: Float? = ".5"
    var spaced: Float? = " 2 "
    var signed: Double? = "+1.5e1"
    var no_digits: Double? = "."
    console.print(half, spaced, signed, no_digits)
}
