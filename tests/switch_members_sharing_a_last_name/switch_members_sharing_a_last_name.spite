union Held {
    First.Item
    Second.Item
}

var console = Console()

func SwitchMembersSharingALastName() {
    var first: Held = First.Item()
    var second: Held = Second.Item()
    describe(first)
    describe(second)
}

func describe(held: Held) {
    switch held {
        First.Item: console.print(held.label)
        Second.Item: console.print("the second item weighs", held.weight)
    }
}
