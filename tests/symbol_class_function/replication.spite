var lines = List<String>()

func encode_component(component: Spite.Class) {
    var codec = Codec<component>()
    if component.has_function("mirrored_from") {
        codec.mirror(lines)
    }
    if component.has_function("sent_from") {
        codec.send(lines)
    }
    if not component.has_function("mirrored_from") and not component.has_function("sent_from") {
        lines.append("{component.name} stays local")
    }
}

func encode(): String {
    lines.clear()
    Component.classes.each(encode_component)
    return lines.join("\n")
}
