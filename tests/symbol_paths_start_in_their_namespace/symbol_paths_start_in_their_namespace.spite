var console = Console()

func SymbolPathsStartInTheirNamespace() {
    var owner = Gpu()
    var shader = Gpu.Shader()
    var picked: Gpu.DataKind = 'storage'
    var stage: Gpu.Stage = shader
    var staged = owner.stage_name(stage)
    var kinds = owner.first_kind()
    var shader_stage = shader.staged()
    console.print(kinds, shader.kind, picked, staged, shader_stage)
}
