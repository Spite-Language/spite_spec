type Runnable {
    run()
}

var runners = List<Runnable>()
var console = Console()

func Schedule() {
    System.classes.each(add_system)
}

func add_system(system: Spite.Class) {
    var runner = Runner<system>()
    runners.append(runner)
    console.print("found", system.name)
}

func tick() {
    runners.each_run()
}
