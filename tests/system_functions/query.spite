singleton

generic $row_type

var rows = List<$row_type>()
var matched = true
var world = World()

func refresh() {
    rows.clear()
    var entity = 0
    while entity < world.entity_count {
        take(entity)
        entity = entity + 1
    }
}

func take(entity: Integer) {
    matched = true
    var row: $row_type = null
    match_attributes(row, entity)
    fallback matched
    fill_attributes(row, entity)
    rows.append(row)
}

func match_attribute(attribute: Spite.AttributeDeclaration, _row: $row_type, entity: Integer) {
    var store = Store<attribute.class>()
    var stored = store.has(entity)
    matched = matched and stored
}

func fill_attribute(attribute: Spite.AttributeDeclaration, row: $row_type, entity: Integer) {
    var store = Store<attribute.class>()
    row.attributes[attribute] = store.of(entity)
}
