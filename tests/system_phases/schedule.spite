enum Phase {
    'update'
    'render'
}

type Runnable {
    placed_in: Phase
    run()
}

var runners = List<Runnable>()
var console = Console()

func Schedule() {
    System.classes.each(add_system)
}

func add_system(system: Spite.Class) {
    var runner = Runner<system>()
    runners.append(runner)
    console.print("placed", system.name, "in", runner.placed_in)
}

func tick() {
    Phase.values.each(run_phase)
}

func run_phase(phase: Phase) {
    var index = 0
    while index < runners.count() {
        run_placed(runners[index], phase)
        index = index + 1
    }
}

func run_placed(runner: Runnable, phase: Phase) {
    if runner.placed_in == phase {
        runner.run()
    }
}
