enum Level {
    'low'
    'high'
}

type Tagged {
    to_debug: Spite.Function<String>
}

var console = Console()
var kinds = List<String>()
var _sample_total: Long = 40000000000

func TaggedValues() {
    var count = 3
    var total: Long = _sample_total
    var ratio = 0.5
    var level: Level = 'high'
    console.print(count, total, ratio, true, level)
    var held = List<Tagged>()
    held.append(count)
    held.append(total)
    held.append(level)
    held.append(true)
    var crate = Crate()
    held.append(crate)
    held.each(add_kind)
    var joined = kinds.join(" ")
    console.print(joined)
    var first: Tagged? = held.first()
    if first.class == Integer {
        var doubled = first * 2
        console.print("first doubled", doubled)
    }
    console.debug(count, level, crate)
}

func add_kind(item: Tagged) {
    if item.class == Integer {
        kinds.append("integer {item}")
    } else if item.class == Long {
        kinds.append("long")
    } else if item.class == Boolean {
        kinds.append("boolean")
    } else {
        kinds.append("object")
    }
}
