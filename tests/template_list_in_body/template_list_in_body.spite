var console = Console()

func TemplateListInBody() {
    var troll = Monster()
    show_first_attributes(troll)
}

func show_first_attribute(attribute: Spite.AttributeDeclaration, monster: Monster) {
    var listed = List<Monster>()
    listed.append(monster)
    var first = listed[0]
    crash first
    console.print("listed", attribute.name, first[attribute])
}
