var console = Console()
var account = Bank.Account()
var _balance_after_deposit = 105

func AccountTests() {
    account.deposit(100)
    console.print("set up an account holding", account.balance)
}

func test_withdraws() {
    account.withdraw(30)
    crash account.balance == 70
}

func test_starts_from_its_own_setup() {
    crash account.balance == 100
    account.deposit(5)
    crash account.balance == _balance_after_deposit
}
