type Item {
    to_debug: Spite.Function<String>
}

var console = Console()

func TestedClasses() {
    var held = List<Item>()
    var coin = Coin()
    held.append(coin)
    held.append(3)
    var index = 0
    while index < held.count() {
        var text = described(held[index])
        console.print(text)
        index = index + 1
    }
}

func described(item: Item): String {
    if item.class == Ghost {
        return item.haunt()
    }
    if item.class == Coin {
        return item.shine()
    }
    return "something else"
}
