var console = Console()
var tally = Tally()

func TestedOnce() {
    load "../../../spite_standard_library/windows"
    var worker = Worker()
    var first = worker.run()
    var index = 0
    while index < 1000 {
        index = tally.add(index)
    }
    var total = tally.sum()
    console.print("first", first, "reached", index, "total", total)
}
