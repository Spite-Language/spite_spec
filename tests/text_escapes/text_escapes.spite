var console = Console()

func TextEscapes() {
    var plain = plain_texts()
    var after_a_hole = texts_after_a_hole()
    var in_a_hole = texts_in_a_hole()
    var in_a_nested_hole = texts_in_a_nested_hole()
    var index = 0
    while index < plain.count() {
        var alone = plain[index]
        print_shown(alone)
        var held = after_a_hole[index]
        crash held
        print_shown(held)
        var shown_in_a_hole = in_a_hole[index]
        crash shown_in_a_hole
        console.print(shown_in_a_hole)
        var shown_in_a_nested_hole = in_a_nested_hole[index]
        crash shown_in_a_nested_hole
        console.print(shown_in_a_nested_hole)
        index = index + 1
    }
}

