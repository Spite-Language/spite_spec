var console = Console()

func TextToEachNumber() {
    load "../../../spite_standard_library/windows"
    var tiny = "-128".to_tiny()
    crash tiny
    var short = "32767".to_short()
    crash short
    var unsigned_short = "65535".to_unsigned_short()
    crash unsigned_short
    var unsigned_long = "18446744073709551615".to_unsigned_long()
    crash unsigned_long
    var decimal = "2.5".to_float()
    crash decimal
    var wide = "0.1".to_double()
    crash wide
    console.print(tiny, short, unsigned_short, unsigned_long, decimal, wide)
    var too_small = "128".to_tiny()
    var too_long = "40000".to_short()
    var negative = "-1".to_unsigned_short()
    var too_wide = "18446744073709551616".to_unsigned_long()
    console.print(not too_small, not too_long, not negative, not too_wide)
}
