var console = Console()

func TextToEachNumber() {
    load "../../../spite_standard_library/windows"
    var tiny: Tiny? = "-128"
    crash tiny
    var short: Short? = "32767"
    crash short
    var unsigned_short: UnsignedShort? = "65535"
    crash unsigned_short
    var unsigned_long: UnsignedLong? = "18446744073709551615"
    crash unsigned_long
    var decimal: Float? = "2.5"
    crash decimal
    var wide: Double? = "0.1"
    crash wide
    console.print(tiny, short, unsigned_short, unsigned_long, decimal, wide)
    var too_small: Tiny? = "128"
    var too_long: Short? = "40000"
    var negative: UnsignedShort? = "-1"
    var too_wide: UnsignedLong? = "18446744073709551616"
    console.print(not too_small, not too_long, not negative, not too_wide)
}
