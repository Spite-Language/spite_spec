var console = Console()
var settings = Dictionary<String, Integer>()

func TextToNumber() {
    whole("42")
    whole(" -12 ")
    whole("0")
    whole("+7 days")
    whole("forty two")
    whole("")
    whole("9000000000")
    decimal("2.5")
    decimal("-1.5e2")
    decimal("1e")
    decimal("nan")
    var wide_text = "9000000000"
    var wide: Long? = wide_text
    var small_text = "300"
    var small: Byte? = small_text
    var unsigned_text = "-1"
    var unsigned: UnsignedInteger? = unsigned_text
    crash wide
    console.print("long", wide)
    if small {
        console.print("byte", small)
    } else {
        console.print("300 is not a Byte")
    }
    if unsigned {
        console.print("unsigned", unsigned)
    } else {
        console.print("-1 is not an UnsignedInteger")
    }
    var typed_text = "12"
    var typed: Integer? = typed_text
    var mistyped_text = "twelve"
    var mistyped: Integer? = mistyped_text
    crash typed
    console.print("typed", typed, not mistyped)
    read_setting("width=640")
    read_setting("height=tall")
    crash settings["width"]
    var setting_count = settings.count()
    console.print("width", settings["width"], setting_count)
}

func whole(text: String) {
    var number: Integer? = text
    if number {
        console.print("[{text}] is", number)
    } else {
        console.print("[{text}] is not an Integer")
    }
}

func decimal(text: String) {
    var number: Double? = text
    if number {
        console.print("[{text}] is", number)
    } else {
        console.print("[{text}] is not a Double")
    }
}

func read_setting(line: String) {
    var parts = line.split("=")
    crash parts.count() == 2
    var value: Integer? = parts[1]
    fallback value
    var name = parts[0]
    settings[name] = value
}
