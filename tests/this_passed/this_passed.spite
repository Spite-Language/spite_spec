var console = Console()

func ThisPassed() {
    var registry = Registry()
    var first = Member("ada")
    first.join(registry)
    var second = Member("bea")
    second.join(registry)
    var count = registry.members.count()
    console.print(count)
    registry.members.each(show)
}

func show(member: Member) {
    console.print(member.name)
}
