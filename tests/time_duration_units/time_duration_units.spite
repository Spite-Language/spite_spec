var console = Console()
var _nearly_two_microseconds: Long = 1999

func TimeDurationUnits() {
    load "../../../spite_standard_library/windows"
    var span = Duration(90, 'minutes')
    var hours = span.total('hours')
    var minutes = span.part('minutes')
    var seconds = span.total('seconds')
    console.print(hours, minutes, seconds)
    var tiny = Duration(_nearly_two_microseconds, 'nanoseconds')
    var micro = tiny.total('microseconds')
    console.print(micro)
}
