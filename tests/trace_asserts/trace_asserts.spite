var console = Console()
var names = ["ada", "bo"]

func TraceAsserts() {
    load "../../../spite_standard_library/windows"
    greet(0)
    greet(5)
    greet(1)
    greet(-1)
    console.print("done")
}

func greet(index: Integer) {
    fallback index >= 0 and index < names.count()
    console.print("hello", names[index])
}
