var left: TreeBasics.TreeNode?
var right: TreeBasics.TreeNode?

func Branch(left_node: TreeBasics.TreeNode, right_node: TreeBasics.TreeNode) {
    left = left_node
    right = right_node
}

func total(): Integer {
    var result = 0
    if left {
        result = result + left.total()
    }
    if right {
        result = result + right.total()
    }
    return result
}
