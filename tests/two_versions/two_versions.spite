var console = Console()

func TwoVersions() {
    load "../../../spite_standard_library/windows"
    load "../..@e67e4e2/tests/two_versions/.packages/older"
    load "../..@e67e4e2/tests/two_versions/.packages/newer"
    var older = Older()
    var newer = Newer()
    var first = older.made()
    var second = newer.made()
    var first_text = first.describe()
    var second_text = second.describe()
    var greeting = older.greeting()
    var shouted = "both".with_bang()
    console.print(first_text, first.class.name_with_namespaces)
    console.print(second_text, second.class.name_with_namespaces)
    console.print(older.class.name_with_namespaces, greeting)
    console.print(shouted)
}
