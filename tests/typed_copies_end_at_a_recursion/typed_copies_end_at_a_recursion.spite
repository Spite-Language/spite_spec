var console = Console()

func TypedCopiesEndAtARecursion() {
    var counted = wrapped("seed", 12)
    console.print(counted)
}

func wrapped(value: Anything, rounds: Integer): Integer {
    fallback rounds != 0
    var listed = [value]
    var fewer = rounds - 1
    var deeper = wrapped(listed, fewer)
    return deeper + 1
}
