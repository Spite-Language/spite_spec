generic $item_type

var console = Console()

func key_of(value: UnbuiltClassTestSatisfies.Component): String {
    if $item_type == Cat {
        console.print("a cat box")
        if value.class.satisfies_type(UnbuiltClassTestSatisfies.AnyCustom) {
            return value.key
        }
    }
    return "none"
}
