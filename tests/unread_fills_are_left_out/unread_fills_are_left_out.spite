var console = Console()
var program = Program()
var kept = List<Spite.Class>()

func UnreadFillsAreLeftOut() {
    var gear = Gear()
    var turned = gear.turn()
    console.print(turned)
    kept.append(Gear)
    var first = kept[0]
    console.print(first.name)
    var text = functions_text()
    var gear_filled = text.contains("\tSpite.Class._fill_Gear\n")
    var wheel_filled = text.contains("\tSpite.Class._fill_Wheel\n")
    console.print("Gear filled:", gear_filled)
    console.print("Wheel filled:", wheel_filled)
}

func functions_text(): String {
    var path = program.executable_path()
    crash path
    var functions_path = path.replace(".exe", ".functions")
    var text_path: Path? = functions_path
    crash text_path
    var text = File(text_path).read_as_string()
    crash text
    return text
}
