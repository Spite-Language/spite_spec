var console = Console()
var program = Program()
var kept = List<Spite.Class>()

func UnreadFillsAreLeftOut() {
    var gear = Gear()
    var turned = gear.turn()
    console.print(turned)
    kept.append(Gear)
    var first = kept[0]
    console.print(first.name)
    var text = high_text()
    var gear_filled = text.contains("function Spite.Class._fill_Gear(")
    var wheel_filled = text.contains("function Spite.Class._fill_Wheel(")
    console.print("Gear filled:", gear_filled)
    console.print("Wheel filled:", wheel_filled)
}

func high_text(): String {
    var path = program.executable_path()
    crash path
    var high_path = path.replace(".exe", ".high_ir.txt")
    var text_path: Path? = high_path
    crash text_path
    var text = File(text_path).read_as_string()
    crash text
    return text
}
