var console = Console()
var program = Program()
var sources = "tests/unread_reflection_field_keeps_its_effects"
var copy = ".spite/unread_reflection_field"
var library_copy = ".spite/unread_reflection_field/spite_standard_library"
var program_copy = ".spite/unread_reflection_field/written"

# ../../../spite_documentation/reflection.md#what-the-compiler-leaves-out
func UnreadReflectionFieldKeepsItsEffects() {
    remove_a_folder(copy)
    make_a_folder(".spite")
    make_a_folder(copy)
    copy_a_folder("../spite_standard_library", library_copy)
    add_the_writes()
    make_a_folder(program_copy)
    copy_a_source("program.txt", "{program_copy}/written.spite")
    copy_a_source("monster.txt", "{program_copy}/monster.spite")
    build()
    run()
    remove_a_folder(copy)
}

func add_the_writes() {
    var attribute_path = "{library_copy}/common/spite/attribute.spite"
    var library_text = read_a_file(attribute_path)
    var added = read_a_file("{sources}/attribute_writes.txt")
    write_a_file(attribute_path, "{library_text}\n{added}")
    copy_a_source("shout.txt", "{library_copy}/common/spite/shout.spite")
}

func copy_a_source(name: String, to: String) {
    var text = read_a_file("{sources}/{name}")
    write_a_file(to, text)
}

func read_a_file(path: String): String {
    var read_path: Path? = path
    crash read_path
    var file = File(read_path)
    var text = file.read_as_string()
    crash text
    return text
}

func write_a_file(path: String, text: String) {
    var written_path: Path? = path
    crash written_path
    var written = File(written_path)
    crash written.write_string(text)
}

func remove_a_folder(folder: String) {
    var old_path: Path? = folder
    crash old_path
    var old = Directory(old_path)
    fallback old.exists()
    var no_arguments = List<String>()
    var windows_copy = folder.replace("/", "\\")
    var removing = Process("rmdir /s /q \"{windows_copy}\"", no_arguments)
    var code = removing.run()
    crash code == 0
}

func make_a_folder(path: String) {
    var made_path: Path? = path
    crash made_path
    var made = Directory(made_path)
    fallback not made.exists()
    crash made.create()
}

func copy_a_folder(from: String, to: String) {
    make_a_folder(to)
    var folder_path: Path? = from
    crash folder_path
    var folder = Directory(folder_path)
    var entries = folder.entries()
    crash entries
    var index = 0
    while index < entries.count() {
        var entry = entries[index]
        switch entry {
            Directory: copy_a_subfolder(entry, to)
            File: copy_a_file(entry, to)
        }
        index = index + 1
    }
}

func copy_a_subfolder(folder: Directory, to: String) {
    var name = folder.folder_name
    fallback not name.starts_with(".") and name != "docs"
    copy_a_folder(folder.path, "{to}/{name}")
}

func copy_a_file(file: File, to: String) {
    var name = file.file_name
    fallback name.ends_with(".spite")
    var text = file.read_as_string()
    crash text
    write_a_file("{to}/{name}", text)
}

func build() {
    var here = program.working_directory()
    crash here
    var compiler = "{here}\\..\\spite_compiler\\.spite\\spite.exe"
    var arguments = ["--build", "--debug-memory", "--standard-library-path=../spite_standard_library"]
    var compiling = Process(compiler, arguments)
    compiling.working_directory = program_copy
    compiling.with_errors = true
    var code = compiling.run()
    crash code
    var printed = compiling.read_output_as_string()
    crash printed
    var compiled = code == 0
    console.print("the program builds", compiled)
    if not compiled {
        console.print(printed)
    }
}

func run() {
    var here = program.working_directory()
    crash here
    var windows_copy = program_copy.replace("/", "\\")
    var built = "{here}\\{windows_copy}\\.spite\\build\\written.exe"
    var no_arguments = List<String>()
    var running = Process(built, no_arguments)
    running.working_directory = program_copy
    running.with_errors = true
    var code = running.run()
    crash code
    var printed = running.read_output_as_string()
    crash printed
    var lines = printed.lines()
    lines.each(show)
    console.print("exit", code)
}

func show(line: String) {
    var shown = line.trim()
    fallback not shown.is_empty()
    if shown.starts_with("allocations:") {
        var words = shown.split(" ")
        var made = words[1]
        var freed = words[3]
        console.print("every object made is freed", made == freed)
    } else {
        console.print(shown)
    }
}
