var console = Console()

func UnsignedLongDecimals() {
    load "../../../spite_standard_library/windows"
    var big: Double = 10000000000000000000.0
    var whole: UnsignedLong = big
    console.print(whole)
    var low: Double = 12345.0
    var plain: UnsignedLong = low
    console.print(plain)
    var top: UnsignedLong = whole + whole - 2000000000000000000
    var back: Double = top
    console.print(back)
    var half: Float = top
    console.print(half)
}
