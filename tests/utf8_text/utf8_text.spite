var console = Console()
var _two_byte_lead = 195
var _overlong_two_byte_lead = 192
var _slash_continuation = 175
var _three_byte_lead = 224
var _surrogate_lead = 237
var _surrogate_continuation = 160
var _highest_four_byte_lead = 244
var _past_highest_second_byte = 144
var _highest_second_byte = 143
var _last_continuation = 191
var _letter_h_code = 104
var _letter_i_code = 105

func Utf8Text() {
    load "../../../spite_standard_library/windows"
    var greeting = "olá, 世界 😀"
    var bytes = greeting.to_buffer()
    var back = bytes.read_as_string()
    crash back
    console.print(back, back == greeting)
    var nothing = Buffer(0)
    show("empty", nothing)
    var lone = of(128)
    show("a lone continuation byte", lone)
    var cut = of(_two_byte_lead)
    show("a cut sequence", cut)
    var overlong_slash = of(_overlong_two_byte_lead, _slash_continuation)
    show("an overlong slash", overlong_slash)
    var overlong_three = of(_three_byte_lead, 128, _slash_continuation)
    show("an overlong three-byte form", overlong_three)
    var surrogate = of(_surrogate_lead, _surrogate_continuation, 128)
    show("a surrogate", surrogate)
    var past = of(_highest_four_byte_lead, _past_highest_second_byte, 128, 128)
    show("past U+10FFFF", past)
    var highest = of(_highest_four_byte_lead, _highest_second_byte, _last_continuation, _last_continuation)
    show("U+10FFFF", highest)
    var zero_byte = of(_letter_h_code, 0, _letter_i_code)
    show("a zero byte", zero_byte)
    var plain = of(_letter_h_code, _letter_i_code)
    show("plain", plain)
}

func of(...values: List<Integer>): Buffer {
    var bytes = Buffer(0)
    var index = 0
    while index < values.count() {
        var value: Byte = values[index]
        bytes.append(value)
        index = index + 1
    }
    return bytes
}

func show(label: String, bytes: Buffer) {
    var text = bytes.read_as_string()
    if text {
        var length = text.length()
        console.print(label, "is text of", length, "bytes")
    } else {
        console.print(label, "is not UTF-8")
    }
}
