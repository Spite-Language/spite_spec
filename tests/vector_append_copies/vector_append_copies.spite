var console = Console()
var points = Vector<Point>()

func VectorAppendCopies() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var point = Point(1, "first")
    points.append(point)
    point.across = 5
    point.name = "changed"
    crash points[0]
    console.print(points[0].across, points[0].name, point.across, point.name)
    points.set_at(0, point)
    point.across = 9
    crash points[0]
    console.print(points[0].across, points[0].name, point.across)
}
