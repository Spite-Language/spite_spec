var console = Console()

func VectorOutOfRange() {
    load "../../../spite_standard_library/windows"
    var velocities = Vector<Velocity>()
    var slow = Velocity(1.5)
    velocities.append(slow)
    var missing = velocities[1]
    var before = velocities[-1]
    console.print(missing, before)
    var fast = Velocity(3.0)
    velocities[0] = fast
    var first = velocities[0]
    crash first
    console.print(first.across)
    velocities[1] = fast
    console.print("never printed")
}
