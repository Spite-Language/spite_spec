var console = Console()
var program = Program()
var slot = 0
var values = [0, 0, 0]

func WaitIndexOrder() {
    load "../../../spite_standard_library/windows"
    var written = write_late()
    var moved = move_slot()
    var shown = values.join(" ")
    console.print(shown, written, moved)
}

func write_late(): Integer {
    crash slot < values.count()
    values[slot] = napped(5)
    return 1
}

func move_slot(): Integer {
    slot = 2
    return 2
}

func napped(milliseconds: Integer): Integer {
    var pause = Duration(milliseconds, 'milliseconds')
    program.sleep(pause)
    return milliseconds
}
