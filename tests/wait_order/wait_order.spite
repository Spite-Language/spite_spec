var console = Console()
var program = Program()
var counter = 0
var name = "before"
var current = List<String>()
var earlier = List<String>()

func WaitOrder() {
    load "../../../spite_standard_library/windows"
    var sum = sum_in_order()
    var text = text_in_order()
    var passed = arguments_in_order()
    var appended = receiver_in_order()
    console.print("counter + bump(): the counter was read first:", sum)
    console.print(text)
    console.print("arguments around a join:", passed)
    var kept = earlier.join(", ")
    var now = current.join(", ")
    console.print("the list read before the wait got the item:", kept, "| the new list:", now, appended)
}

func bump_after(milliseconds: Integer): Integer {
    counter = 100
    var pause = Duration(milliseconds, 'milliseconds')
    program.sleep(pause)
    return milliseconds
}

func rename_after(milliseconds: Integer): Integer {
    name = "after"
    var pause = Duration(milliseconds, 'milliseconds')
    program.sleep(pause)
    return milliseconds
}

func sum_in_order(): Integer {
    counter = 1
    return counter + bump_after(2)
}

func text_in_order(): String {
    return "{name} then {rename_after(2)} then {name}"
}

func arguments_in_order(): String {
    counter = 2
    var first = counter
    var bumped = bump_later()
    return pair(first, bumped, counter)
}

func bump_later(): Integer {
    var two_milliseconds = Duration(2, 'milliseconds')
    program.sleep(two_milliseconds)
    counter = counter + 100
    return counter
}

func pair(first: Integer, second: Integer, third: Integer): String {
    return "{first} {second} {third}"
}

func receiver_in_order(): Integer {
    earlier = current
    current.append("the {replace_after(2)}")
    return current.count()
}

func replace_after(milliseconds: Integer): String {
    current = List<String>()
    var pause = Duration(milliseconds, 'milliseconds')
    program.sleep(pause)
    return "item"
}
