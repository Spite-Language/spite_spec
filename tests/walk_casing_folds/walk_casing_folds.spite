var console = Console()
var program = Program()

func WalkCasingFolds() {
    var price = Price()
    price.attributes.each(show)
    Price.attributes.each(declared)
    var path = program.executable_path()
    crash path
    var high_path = path.replace(".exe", ".high_ir.txt")
    var text_path: Path? = high_path
    crash text_path
    var text = File(text_path).read_as_string()
    crash text
    var calls_camel = function_holds("WalkCasingFolds.show_over_", "String.camel_case(", text)
    var calls_pascal = function_holds("WalkCasingFolds.show_over_", "String.pascal_case(", text)
    var calls_snake = function_holds("WalkCasingFolds.declared_over_", "String.snake_case(", text)
    var holds_camel = function_holds("WalkCasingFolds.show_over_", "text=sellPriceEach", text)
    var holds_pascal = function_holds("WalkCasingFolds.show_over_", "text=SellPriceEach", text)
    var holds_snake = function_holds("WalkCasingFolds.declared_over_", "text=buy_price", text)
    console.print("a walk calls camel_case", calls_camel, "pascal_case", calls_pascal, "snake_case", calls_snake)
    console.print("a walk holds the cased names", holds_camel, holds_pascal, holds_snake)
}

func show(attribute: Spite.Attribute) {
    var camel = attribute.name.camel_case()
    var pascal = attribute.declaration.name.pascal_case()
    console.print(camel, pascal, attribute.value)
}

func declared(attribute: Spite.AttributeDeclaration) {
    var snake = attribute.name.snake_case()
    var pascal = attribute.name.pascal_case()
    console.print(snake, pascal)
}

func function_holds(function_key: String, wanted: String, text: String): Boolean {
    var lines = text.split("\n")
    var inside = false
    var index = 0
    while index < lines.count() {
        var line = lines[index]
        if line.starts_with("function ") {
            inside = line.starts_with("function {function_key}")
        }
        if inside and line.contains(wanted) {
            return true
        }
        index = index + 1
    }
    return false
}
