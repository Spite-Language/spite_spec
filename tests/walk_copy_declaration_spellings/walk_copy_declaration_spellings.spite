var console = Console()

func WalkCopyDeclarationSpellings() {
    load "../../../spite_standard_library/windows"
    var troll = Troll()
    troll.attributes.each(describe)
}

func describe(attribute: Spite.Attribute) {
    var pascal = attribute.declaration.name.pascal_case()
    console.print(
        attribute.declaration.name,
        pascal,
        attribute.declaration.class,
        attribute.value,
    )
}
