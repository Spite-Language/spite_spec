var console = Console()
var walked_given: Anything? = null
var found = List<String>()

func WalkedClassFold() {
    load "../../../SpiteCompiler/.spite/library/windows"
    var targeting = Targeting()
    targeting.target.id = 7
    var translator = Translator<Targeting>()
    translator.translate(targeting)
    console.print(targeting.target.id, targeting.range, targeting.label, translator.plain_count)
    var other = Targeting()
    var same = same_kind(other, targeting)
    var entity = Entity()
    var different = same_kind(entity, targeting)
    console.print(same, different)
    var hero = Bundle.Hero()
    var fallen = Bundle.Fallen(3)
    var potion = Bundle.Potion()
    describe(hero)
    describe(fallen)
    describe(potion)
    describe(entity)
    var mark = hero.alive.mark()
    console.print(hero.health, mark, fallen.health, potion.owner.id)
}

func same_kind(given: Anything, known: Targeting): Boolean {
    return given == known.class
}

func describe(given: Anything) {
    walked_given = given
    found.clear()
    Bundle.classes.each(queue_bundle)
    var joined = found.join(" ")
    console.print("[{joined}]")
}

func queue_bundle(bundle: Spite.Class) {
    crash walked_given
    var by_class = walked_given == bundle
    var by_kind = BundleKind<bundle>().is_kind(walked_given)
    found.append("{bundle.name}:{by_class}:{by_kind}")
}
