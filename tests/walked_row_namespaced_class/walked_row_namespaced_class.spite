type Pair {
    tag: Component.Tag
    point: Component.Point
}

var points = Store<Component.Point>()
var tags = Store<Component.Tag>()

func WalkedRowNamespacedClass() {
    var index = 0
    while index < 3 {
        var point = Component.Point()
        point.across = index * 7
        points.values.append(point)
        var tag = Component.Tag()
        tag.id = index + 1
        tags.values.append(tag)
        index = index + 1
    }
    var filler = Filler<Pair>()
    index = 0
    while index < 3 {
        filler.fill(index)
        index = index + 1
    }
}
