generic $row_type

var console = Console()
var filled = 0

func fill(index: Integer) {
    var row = $row_type()
    fill_attributes(row, index)
    console.print("tag", row.tag.id, "across", row.point.across)
}

func fill_attribute(attribute: Spite.AttributeDeclaration, row: $row_type, index: Integer) {
    filled = filled + 1
    crash Store<attribute.class>().values[index]
    row.attributes[attribute] = Store<attribute.class>().values[index]
}
