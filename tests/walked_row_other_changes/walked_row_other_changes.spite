type Pair {
    tag: Tag
    point: Point
}

var console = Console()
var store = Store<Point>()
var tags = Store<Tag>()

func WalkedRowOtherChanges() {
    var index = 0
    while index < 3 {
        var point = Point()
        point.across = index * 7
        store.values.append(point)
        var tag = Tag()
        tag.id = index
        tags.values.append(tag)
        index = index + 1
    }
    var filler = Filler<Pair>()
    index = 0
    while index < 3 {
        filler.fill(index)
        index = index + 1
    }
    console.print("attributes filled", filler.filled)
}
