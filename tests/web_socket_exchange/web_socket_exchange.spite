var console = Console()
var server = Http.Server()
var sockets = WebSocket.Server(server)
var log = List<String>()

func WebSocketExchange() {
    load "../../../spite_standard_library/windows"
    crash server.listen_locally(47913)
    var serving = Concurrent(serve_three)
    refused_plain_request()
    talk()
    talk_raw()
    console.print("served", serving)
    var joined = log.join("\n")
    console.print(joined)
    server.close()
}

func serve_three(): Integer {
    var served = 0
    while served < 3 {
        var request = server.next_request()
        crash request
        if sockets.asks_to_upgrade(request) {
            var socket = sockets.accept(request)
            crash socket
            log.append("server: accepted {request.path}")
            converse(socket)
        } else {
            log.append("server: refused {request.path}")
            var refused = Http.Response()
            refused.status = 400
            crash server.respond(request, refused)
        }
        served = served + 1
    }
    return served
}

func converse(socket: WebSocket.Connection) {
    var message = socket.receive()
    while message {
        if message.is_text() {
            answer_text(socket, message)
        } else {
            answer_binary(socket, message)
        }
        message = socket.receive()
    }
    crash socket.close_code
    log.append("server: closed with {socket.close_code} '{socket.close_reason}'")
}

func answer_text(socket: WebSocket.Connection, message: WebSocket.Message) {
    var text = message.read_as_string()
    crash text
    log.append("server: text '{text}'")
    crash socket.send_string("echo: {text}")
}

func answer_binary(socket: WebSocket.Connection, binary: WebSocket.Message) {
    var bytes = binary.read_as_buffer()
    var counted = bytes.count()
    log.append("server: {counted} bytes")
    var reversed = bytes.copy()
    var index = 0
    while index < counted {
        var held = reversed[counted - index - 1]
        crash held
        reversed[index] = held
        index = index + 1
    }
    crash socket.send_buffer(reversed)
}

func refused_plain_request() {
    var client = Http.Client()
    var request = Http.Request()
    request.path = "/plain"
    var loopback = "127.0.0.1".to_ip_address()
    crash loopback
    var response = client.send(loopback, 47913, request)
    crash response
    console.print("plain request: {response.status} {response.reason()}")
}

func talk() {
    var socket = WebSocket.Client()
    var request = Http.Request()
    request.path = "/chat"
    request.set_header("Origin", "http://127.0.0.1")
    var server_address = "127.0.0.1".to_ip_address()
    crash server_address
    crash socket.connect(server_address, 47913, request)
    crash socket.send_string("hello")
    show(socket)
    crash socket.send_string("héllo ✓")
    show(socket)
    var small = counting_bytes(5)
    crash socket.send_buffer(small)
    show(socket)
    var medium = counting_bytes(300)
    crash socket.send_buffer(medium)
    show(socket)
    var large = counting_bytes(70000)
    crash socket.send_buffer(large)
    show(socket)
    var empty = Buffer(0)
    crash socket.send_buffer(empty)
    show(socket)
    var question = "are you there".to_buffer()
    crash socket.send_ping(question)
    crash socket.send_string("after the ping")
    show(socket)
    crash socket.last_pong
    var pong = socket.last_pong.read_as_string()
    crash pong
    console.print("client: pong '{pong}'")
    socket.close()
    var sent = socket.send_string("too late")
    console.print("client: sending after close:", sent)
    var after = socket.receive()
    var nothing_after = not after
    console.print("client: nothing after the close:", nothing_after, "closed:", socket.closed)
    crash socket.close_code
    console.print("client: closed with {socket.close_code} '{socket.close_reason}'")
}

func show(socket: WebSocket.Client) {
    var message = socket.receive()
    crash message
    if message.is_text() {
        var text = message.read_as_string()
        crash text
        console.print("client: text '{text}'")
    } else {
        show_bytes(message)
    }
}

func show_bytes(binary: WebSocket.Message) {
    var bytes = binary.read_as_buffer()
    var counted = bytes.count()
    if counted == 0 {
        console.print("client: 0 bytes")
    } else {
        var first = bytes[0]
        var last = bytes[counted - 1]
        crash first
        crash last
        console.print("client: {counted} bytes, first {first}, last {last}")
    }
}

func counting_bytes(count: Integer): Buffer {
    var bytes = Buffer(0)
    var index = 0
    while index < count {
        var value: Byte = index % 256
        bytes.append(value)
        index = index + 1
    }
    return bytes
}

func talk_raw() {
    var socket = Tcp.Client()
    crash socket.connect_locally(47913)
    var handshake = "GET /raw HTTP/1.1\r\nhost: 127.0.0.1\r\nupgrade: websocket\r\nconnection: keep-alive, Upgrade\r\n"
    write_text(socket, "{handshake}sec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\nsec-websocket-version: 13\r\n\r\n")
    var status = socket.read_line()
    crash status
    console.print("raw: {status}")
    var ended = false
    while not ended {
        var line = socket.read_line()
        crash line
        if line.starts_with("sec-websocket-accept") {
            console.print("raw: {line}")
        }
        ended = line.is_empty()
    }
    write_frame(socket, 1, true, "frag")
    write_frame(socket, 137, true, "p")
    write_frame(socket, 128, true, "mented")
    write_frame(socket, 129, false, "no mask")
    var received = Buffer(0)
    while not socket.closed {
        var got = socket.read_as_buffer()
        if got {
            var got_count = got.count()
            received.append_buffer(got, 0, got_count)
        }
    }
    describe_frames(received)
}

func write_text(socket: Tcp.Client, text: String) {
    var text_bytes = text.to_buffer()
    write_list(socket, text_bytes)
}

func write_list(socket: Tcp.Client, list: Buffer) {
    crash socket.write_buffer(list)
}

func write_frame(socket: Tcp.Client, first: Integer, masked: Boolean, payload: String) {
    var text_bytes = payload.to_buffer()
    var counted = text_bytes.count()
    var frame = Buffer(0)
    var opening: Byte = first
    frame.append(opening)
    var second: Byte = counted
    if masked {
        second = counted + 128
    }
    frame.append(second)
    if masked {
        var zero: Byte = 0
        frame.append(zero)
        frame.append(zero)
        frame.append(zero)
        frame.append(zero)
    }
    var index = 0
    while index < counted {
        var held = text_bytes[index]
        crash held
        frame.append(held)
        index = index + 1
    }
    write_list(socket, frame)
}

func describe_frames(received: Buffer) {
    var at = 0
    var total = received.count()
    while at + 2 <= total {
        var first: Integer = received[at]
        var length: Integer = received[at + 1]
        var payload = Buffer(0)
        var index = at + 2
        while index < at + 2 + length {
            crash received[index]
            payload.append(received[index])
            index = index + 1
        }
        if first == 136 {
            crash payload[0]
            crash payload[1]
            var high: Integer = payload[0]
            var low: Integer = payload[1]
            var code = high * 256 + low
            console.print("raw: close frame, code {code}")
        } else {
            var text = payload.read_as_string()
            crash text
            console.print("raw: frame {first}, '{text}'")
        }
        at = index
    }
}
