var console = Console()

func WholeLibrary() {
    load "../../../spite_standard_library/windows"
    var classes = List<Spite.Class>()
    classes.append(Argon2)
    classes.append(AxisAlignedBox)
    classes.append(Base64)
    classes.append(Boolean)
    classes.append(Buffer)
    classes.append(Build)
    classes.append(Byte)
    classes.append(Clock)
    classes.append(Color)
    classes.append(Console)
    classes.append(CubicBezier)
    classes.append(Date)
    classes.append(DateTime)
    classes.append(Deflate)
    classes.append(Directory)
    classes.append(Double)
    classes.append(Duration)
    classes.append(DynamicLibrary)
    classes.append(Easing)
    classes.append(Environment)
    classes.append(File)
    classes.append(FileSystemWatcher)
    classes.append(Float)
    classes.append(ForeignCallback)
    classes.append(Frustum)
    classes.append(Gzip)
    classes.append(Http.Client)
    classes.append(Http.Request)
    classes.append(Http.Response)
    classes.append(Http.Server)
    classes.append(Instant)
    classes.append(Integer)
    classes.append(IpAddress)
    classes.append(LockedFile)
    classes.append(Long)
    classes.append(Noise)
    classes.append(Period)
    classes.append(Plane)
    classes.append(Process)
    classes.append(Program)
    classes.append(Ray)
    classes.append(Reload)
    classes.append(SecureRandom)
    classes.append(Sha256)
    classes.append(Short)
    classes.append(Spite.Access)
    classes.append(Spite.Argument)
    classes.append(Spite.Attribute)
    classes.append(Spite.AttributeDeclaration)
    classes.append(Spite.Call)
    classes.append(Spite.Class)
    classes.append(Spite.Function)
    classes.append(Spite.FunctionDeclaration)
    classes.append(Spite.Namespace)
    classes.append(String)
    classes.append(Tcp.Client)
    classes.append(Tcp.Connection)
    classes.append(Tcp.Server)
    classes.append(Time)
    classes.append(TimeZone)
    classes.append(TimeZones)
    classes.append(Tiny)
    classes.append(Udp.Client)
    classes.append(Udp.Datagram)
    classes.append(Udp.Server)
    classes.append(UnsignedInteger)
    classes.append(UnsignedLong)
    classes.append(UnsignedShort)
    classes.append(WebSocket.Client)
    classes.append(WebSocket.Connection)
    classes.append(WebSocket.Message)
    classes.append(WebSocket.Server)
    classes.append(Zlib)
    var benchmark = Benchmark<Integer>(measured)
    classes.append(benchmark.class)
    var binary_reader = BinaryReader<Integer>()
    classes.append(binary_reader.class)
    var binary_writer = BinaryWriter<Integer>()
    classes.append(binary_writer.class)
    var debug = Spite.Debug<Integer>()
    classes.append(debug.class)
    var dictionary = Dictionary<String, Integer>()
    classes.append(dictionary.class)
    var json_reader = JsonReader<Integer>()
    classes.append(json_reader.class)
    var json_writer = JsonWriter<Integer>()
    classes.append(json_writer.class)
    var list = List<String>()
    classes.append(list.class)
    var matrix3 = Matrix3<Float>()
    classes.append(matrix3.class)
    var matrix4 = Matrix4<Float>()
    classes.append(matrix4.class)
    var quaternion = Quaternion<Float>()
    classes.append(quaternion.class)
    var vector2 = Vector2<Float>(1.0, 2.0)
    classes.append(vector2.class)
    var vector3 = Vector3<Float>(1.0, 2.0, 3.0)
    classes.append(vector3.class)
    var vector4 = Vector4<Float>(1.0, 2.0, 3.0, 4.0)
    classes.append(vector4.class)
    var index = 0
    while index < classes.count() {
        var described = classes[index]
        console.print(described.name_with_namespaces)
        index = index + 1
    }
}

func measured(): Integer {
    return 1
}
