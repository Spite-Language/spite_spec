var console = Console()
var zones = TimeZones()

func ZoneFiles() {
    load "../../../spite_standard_library/windows"
    var eastern = read("Test/Eastern", "eastern")
    var sydney = read("Test/Sydney", "sydney")
    var lord_howe = read("Test/Lord_Howe", "lord_howe")
    var eastern_moments: List<Long> = [
        -5364662400
        1205045999
        1205046000
        1225605599
        1225605600
        1710053999
        1710054000
    ]
    var southern_moments: List<Long> = [1712415599, 1712415600, 1728143999, 1728144000, 1719792000, 1704067200]
    var half_hour_moments: List<Long> = [1712415599, 1712415600, 1728142199, 1728142200]
    show_all(eastern, eastern_moments)
    show_all(sydney, southern_moments)
    show_all(lord_howe, half_hour_moments)
    var southern_gap_day = Date(2024, 10, 6)
    var southern_gap_time = Time(2, 30, 0, 0)
    var southern_gap = DateTime(southern_gap_day, southern_gap_time)
    var southern_overlap_day = Date(2024, 4, 7)
    var southern_overlap_time = Time(2, 30, 0, 0)
    var southern_overlap = DateTime(southern_overlap_day, southern_overlap_time)
    choose(sydney, southern_gap)
    choose(sydney, southern_overlap)
    refused("TZif2")
    refused("not a zone at all")
}

func read(name: String, file_name: String): TimeZone {
    var file = File("tests/zone_files/{file_name}.tzif")
    var data = file.read_as_buffer()
    crash data
    var zone = zones.read_tzif(name, data)
    crash zone
    return zone
}

func show_all(zone: TimeZone, moments: List<Long>) {
    var index = 0
    while index < moments.count() {
        var since_1970 = Duration(moments[index], 'seconds')
        var moment = Instant(since_1970)
        var shown = moment.to_string_in(zone)
        console.print(zone.identifier, moment, shown)
        index = index + 1
    }
}

func choose(zone: TimeZone, local: DateTime) {
    var earlier = local.to_instant_in(zone, 'earlier')
    var later = local.to_instant_in(zone, 'later')
    var earlier_text = earlier.to_string_in(zone)
    var later_text = later.to_string_in(zone)
    console.print(zone.identifier, local, earlier_text, later_text)
}

func refused(data: String) {
    var bytes = data.to_buffer()
    var zone = zones.read_tzif("Broken", bytes)
    if zone {
        console.print("read", zone.identifier)
    } else {
        console.print("refused {data.length()} bytes that are not a zone file")
    }
}
